# --- error.cyr ---

# error.cyr — unified error type with errno mapping
# Ported from rust-old/src/error.rs
#
# In Cyrius, errors are integer codes. The SysError "enum" becomes
# integer constants, and error messages are string pointers.
#
# Error representation: a Result (tagged union from lib/tagged.cyr)
# where Err payload is a pointer to an error struct:
#   { kind: i64, errno: i64, message: *str }
#
# Convention: all agnodrm functions return Result values.
# Ok(value) on success, Err(err_ptr) on failure.

# ================================================================
# Error kind constants (maps to Rust SysError variants)
# ================================================================

enum SysErrorKind {
    DRM_ERR_SYSCALL_FAILED = 1;
    DRM_ERR_INVALID_ARGUMENT = 2;
    DRM_ERR_PERMISSION_DENIED = 3;
    DRM_ERR_WOULD_BLOCK = 4;
    DRM_ERR_MODULE_NOT_LOADED = 5;
    DRM_ERR_NOT_SUPPORTED = 6;
    DRM_ERR_UNKNOWN = 7;
    DRM_ERR_IO = 8;
}

# ================================================================
# Errno constants (Linux x86_64)
# ================================================================

enum Errno {
    EPERM = 1;
    ENOENT = 2;
    ESRCH = 3;
    EINTR = 4;
    EIO = 5;
    ENXIO = 6;
    EBADF = 9;
    EAGAIN = 11;
    ENOMEM = 12;
    EACCES = 13;
    EFAULT = 14;
    EBUSY = 16;
    EEXIST = 17;
    ENODEV = 19;
    ENOTDIR = 20;
    EISDIR = 21;
    EINVAL = 22;
    EMFILE = 24;
    ENOTTY = 25;
    ENOSPC = 28;
    EPIPE = 32;
    ERANGE = 34;
    ENOSYS = 38;
    ENOTEMPTY = 39;
    ELOOP = 40;
    ENODATA = 61;
    EOVERFLOW = 75;
    EMSGSIZE = 90;
    EOPNOTSUPP = 95;
    EADDRINUSE = 98;
    ENOBUFS = 105;
    ECONNREFUSED = 111;
    ETIMEDOUT = 110;
}

# ================================================================
# Error struct: { kind, errno, message_ptr }
# Layout: kind at +0, errno at +8, message at +16. Total: 24 bytes.
# ================================================================

# ================================================================
# Error representation — dual encoding
# ================================================================
#
# Packed error: kind << 16 | errno (no message, no heap, value < 0x100000)
# Heap error:   pointer to { kind, errno, message_ptr } (24 bytes, value >= 0x100000)
#
# drm_syserr_kind/errno/message dispatch on the value automatically.

# Pack kind + errno into a single integer (zero allocation). The mask keeps a
# stray value in its own 16 bits: unmasked, a ret of -0xF0000 read back as kind 15
# and -0x100000 crossed into the heap-pointer range and crashed the next reader.
fn drm_syserr_pack(kind, errno): i64 {
    return kind << 16 | (errno & 0xFFFF);
}

# Create a new error with message (heap-allocated, cold path)
fn drm_syserr_new(kind, errno, message): i64 {
    var e = alloc(24);
    store64(e, kind);
    store64(e + 8, errno);
    store64(e + 16, message);
    return e;
}

# Get error kind (works for both packed and heap errors)
fn drm_syserr_kind(e): i64 {
    if (e < 0x100000) { return e >> 16; }
    return load64(e);
}

# Get errno value (works for both packed and heap errors)
fn drm_syserr_errno(e): i64 {
    if (e < 0x100000) { return e & 0xFFFF; }
    return load64(e + 8);
}

# Get error message pointer (0 for packed errors)
fn drm_syserr_message(e): i64 {
    if (e < 0x100000) { return 0; }
    return load64(e + 16);
}

# ================================================================
# Error constructors — packed (fast, no alloc)
# ================================================================

fn drm_err_syscall_failed_nr(errno): i64 {
    return Err(drm_syserr_pack(DRM_ERR_SYSCALL_FAILED, errno));
}

fn drm_err_permission_denied_nr(errno): i64 {
    return Err(drm_syserr_pack(DRM_ERR_PERMISSION_DENIED, errno));
}

fn drm_err_would_block(): i64 {
    return Err(drm_syserr_pack(DRM_ERR_WOULD_BLOCK, EAGAIN));
}

fn drm_err_invalid_argument_nr(): i64 {
    return Err(drm_syserr_pack(DRM_ERR_INVALID_ARGUMENT, EINVAL));
}

fn drm_err_not_supported_nr(): i64 {
    return Err(drm_syserr_pack(DRM_ERR_NOT_SUPPORTED, ENOSYS));
}

# ================================================================
# Error constructors — with message (heap, cold path)
# ================================================================

fn drm_err_syscall_failed(errno, message): i64 {
    return Err(drm_syserr_new(DRM_ERR_SYSCALL_FAILED, errno, message));
}

fn drm_err_invalid_argument(message): i64 {
    return Err(drm_syserr_new(DRM_ERR_INVALID_ARGUMENT, EINVAL, message));
}

fn drm_err_permission_denied(operation): i64 {
    return Err(drm_syserr_new(DRM_ERR_PERMISSION_DENIED, EPERM, operation));
}

fn drm_err_module_not_loaded(module): i64 {
    return Err(drm_syserr_new(DRM_ERR_MODULE_NOT_LOADED, ENODEV, module));
}

fn drm_err_not_supported(feature): i64 {
    return Err(drm_syserr_new(DRM_ERR_NOT_SUPPORTED, ENOSYS, feature));
}

fn drm_err_unknown(message): i64 {
    return Err(drm_syserr_new(DRM_ERR_UNKNOWN, 0, message));
}

fn drm_err_io(errno, message): i64 {
    return Err(drm_syserr_new(DRM_ERR_IO, errno, message));
}

# ================================================================
# Errno-based error creation — packed (zero alloc, hot path)
# ================================================================

fn drm_err_from_errno(errno): i64 {
    if (errno == EPERM) { return drm_err_permission_denied_nr(EPERM); }
    if (errno == EACCES) { return drm_err_permission_denied_nr(EACCES); }
    if (errno == EAGAIN) { return drm_err_would_block(); }
    if (errno == EINVAL) { return drm_err_invalid_argument_nr(); }
    if (errno == ENOSYS) { return drm_err_not_supported_nr(); }
    return drm_err_syscall_failed_nr(errno);
}

fn drm_err_from_syscall_ret(ret): i64 {
    var errno = 0 - ret;
    return drm_err_from_errno(errno);
}

# ================================================================
# Error printing
# ================================================================

fn drm_syserr_print(e): i64 {
    var kind = drm_syserr_kind(e);
    var msg = drm_syserr_message(e);
    var msglen = 0;
    if (msg != 0) { msglen = strlen(msg); }

    # Exhaustive match — every SysErrorKind variant explicit so cyrius
    # lint catches any future addition that misses a handler. No
    # `_ =>` opt-out: a missing variant should fail loud (fall through
    # to the trailing newline + return) rather than silently degrade.
    match kind {
        DRM_ERR_SYSCALL_FAILED => {
            sys_write(2, "syscall failed (errno ", 22);
            var ebuf[24];
            var elen = fmt_int_buf(drm_syserr_errno(e), &ebuf);
            sys_write(2, &ebuf, elen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_INVALID_ARGUMENT => {
            sys_write(2, "invalid argument: ", 18);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_PERMISSION_DENIED => {
            sys_write(2, "permission denied: ", 19);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_WOULD_BLOCK => {
            sys_write(2, "resource temporarily unavailable", 32);
        }
        DRM_ERR_MODULE_NOT_LOADED => {
            sys_write(2, "kernel module not loaded: ", 26);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_NOT_SUPPORTED => {
            sys_write(2, "feature not supported: ", 23);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_UNKNOWN => {
            sys_write(2, "unknown error: ", 15);
            sys_write(2, msg, msglen);
        }
        DRM_ERR_IO => {
            sys_write(2, "io error (errno ", 16);
            var ibuf[24];
            var ilen = fmt_int_buf(drm_syserr_errno(e), &ibuf);
            sys_write(2, &ibuf, ilen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
    }
    sys_write(2, "\n", 1);
    return 0;
}

# Print error from a Result if it's Err, then return a nonzero code: its errno, or
# its kind when it carries none. Returns 0 only if the Result is Ok. (Through 1.7.1
# an Err with errno 0, which every drm_err_unknown is, returned 0 and read as success.)
# 6.6.0 value form: a Result is a register PAIR, so both halves must be passed —
# `var t, v = f(); result_print_err(t, v);`. Was 1-arg over the boxed form.
# Signature matches sigil's `result_print_err`, which made this same move first.
fn result_print_err(res_tag, res): i64 {
    if (is_ok(res_tag) == 1) { return 0; }
    var e = res;
    drm_syserr_print(e);
    var code = drm_syserr_errno(e);
    if (code != 0) { return code; }
    return drm_syserr_kind(e);
}

# ================================================================
# Result helpers for agnodrm convention
# ================================================================

# Propagate error: if res is Err, return it immediately.
# 6.6.0 value form — a Result is a register PAIR (tag in rax, payload in rdx),
# so BOTH halves are bound and an Err is RE-WRAPPED on the way out.
# Pattern:
#   var res_t, res_v = some_call();
#   if (is_err_result(res_t) == 1) { return Err(res_v); }
#   var val = res_v;
# ⛔ NOT `return res_t;` and NOT `return res_v;`. Returning the payload alone
#    delivers Err(77) to the caller as tag=77 / is_err_result==0 — an error that
#    reads as SUCCESS. That shape cost yukti 19 silent defects at the flip.
# Fds and temp files in a Result-returning fn are released explicitly on each exit
#    path. cyrius 6.6.0 – 6.6.6 skipped `defer` on a value-form Result return, and
#    agnodrm leaked one fd per call in nine fns through 1.6.1. It is fixed at 6.6.7,
#    which has been the consumer floor since 1.7.1, so `defer` is usable again;
#    test_fd_hygiene guards either form. See
#    docs/development/issues/archive/2026-09-22-cyrius-defer-skipped-on-result-return.md.

# Check if a syscall return value indicates error (negative = errno)
fn is_syscall_err(ret): i64 {
    return ret < 0;
}

# Wrap a raw syscall return: Ok(ret) if >= 0, Err(from_errno) if < 0
fn wrap_syscall(ret): i64 {
    if (ret < 0) { return drm_err_from_syscall_ret(ret); }
    return Ok(ret);
}

# --- util.cyr ---

# agnodrm — shared cross-module utilities
#
# Small helpers that several modules need identically. Kept here (rather
# than copied per-module) so a single definition is audited and tested
# once. Public `agnodrm_*` prefix per the project's prefix discipline.
#
# Placed in [lib.core] so the device-model bundle resolves these. (Several
# of these were shared with the trust/security modules that moved out in
# the agnosys → agnodrm decomposition; udev/drm + the deferred group (roadmap.md Scope) still
# use them.)

# For the per-target O_* and STAT_* names and the scratch mapping; include-once, so
# includers pay nothing.
include "lib/syscalls.cyr"
include "lib/mmap.cyr"

# Emit a JSON value for a possibly-null C string into a str_builder:
# `null` when the pointer is 0, otherwise a JSON-quoted/escaped string.
# Replaces the per-module `_<mod>_emit_cstr_or_null` shims (mac, dmverity,
# drm, certpin, update) that were byte-identical.
fn agnodrm_json_emit_cstr_or_null(sb, c): i64 {
    if (c == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_json_str(sb, str_from(c));
    }
    return 0;
}

# Is `ch` an ASCII hex digit (0-9, a-f, A-F)? Single definition shared by
# the hash/digest validators in ima, dmverity, tpm, update.
fn agnodrm_is_hex_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 70) { return 1; }   # A-F
    if (ch >= 97 && ch <= 102) { return 1; }  # a-f
    return 0;
}

# Is `ch` valid in a device-mapper / volume name (alphanumeric, `-`, `_`)?
# Single source for the dm-name allowlist shared by dmverity and luks.
fn agnodrm_is_name_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 90) { return 1; }   # A-Z
    if (ch >= 97 && ch <= 122) { return 1; }  # a-z
    if (ch == 45) { return 1; }               # -
    if (ch == 95) { return 1; }               # _
    return 0;
}

# Does C string `str` start with C string `prefix`? Single-pass: walks
# `prefix` and compares, stopping at the first mismatch, the prefix
# terminator, or the str terminator — no up-front strlen of either side
# (the previous per-module copies scanned both strings fully first).
fn agnodrm_cstr_starts_with(str, prefix): i64 {
    var i = 0;
    var pc = load8(prefix);
    while (pc != 0) {
        var sc = load8(str + i);
        if (sc == 0) { return 0; }
        if (sc != pc) { return 0; }
        i = i + 1;
        pc = load8(prefix + i);
    }
    return 1;
}

# ================================================================
# JSON, as far as this library reads it
# ================================================================
#
# Three modules read JSON: the update state, journalctl's export and bootctl's list. Nothing
# here builds a tree. These walk bytes, so a caller reads the fields it wants.

fn _agnodrm_json_ws(p, n, i): i64 {
    while (i < n) {
        var c = load8(p + i);
        if (c != 32) { if (c != 9) { if (c != 10) { if (c != 13) { break; } } } }
        i = i + 1;
    }
    return i;
}

# The index just past the string opening at `i`, or -1.
fn _agnodrm_json_skip_str(p, n, i): i64 {
    i = i + 1;
    while (i < n) {
        var c = load8(p + i);
        if (c == 34) { return i + 1; }
        if (c < 32) { return 0 - 1; }
        if (c == 92) { i = i + 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# The index just past the value starting at `i`, or -1.
fn _agnodrm_json_skip_value(p, n, i): i64 {
    if (i >= n) { return 0 - 1; }
    var c = load8(p + i);
    if (c == 34) { return _agnodrm_json_skip_str(p, n, i); }
    if (c == 123 || c == 91) {
        var closers[64];    # what each open bracket must close with; deeper is refused
        var depth = 0;
        while (i < n) {
            c = load8(p + i);
            if (c == 34) {
                i = _agnodrm_json_skip_str(p, n, i);
                if (i < 0) { return 0 - 1; }
                continue;
            }
            if (c == 123 || c == 91) {
                if (depth >= 64) { return 0 - 1; }
                store8(&closers + depth, c + 2);
                depth = depth + 1;
            }
            if (c == 125 || c == 93) {
                depth = depth - 1;
                if (load8(&closers + depth) != c) { return 0 - 1; }
                if (depth == 0) { return i + 1; }
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    var start = i;
    while (i < n) {
        c = load8(p + i);
        if (c == 44 || c == 125 || c == 93) { break; }
        if (c == 32 || c == 9 || c == 10 || c == 13) { break; }
        i = i + 1;
    }
    if (i == start) { return 0 - 1; }
    return i;
}

# The offset of top-level `key`'s value in the JSON object at `p`, -1 if it has none, or
# -2 if the text is not one whole object. Always walks to the end, so a file cut short
# is caught even when the key comes first. The first of a repeated key wins.
fn _agnodrm_json_field(p, n, key): i64 {
    var found = 0 - 1;
    var klen = strlen(key);
    var i = _agnodrm_json_ws(p, n, 0);
    if (i >= n) { return 0 - 2; }
    if (load8(p + i) != 123) { return 0 - 2; }
    i = _agnodrm_json_ws(p, n, i + 1);
    if (i < n) {
        if (load8(p + i) == 125) {
            if (_agnodrm_json_ws(p, n, i + 1) != n) { return 0 - 2; }
            return found;
        }
    }
    while (i < n) {
        if (load8(p + i) != 34) { return 0 - 2; }
        var kstart = i + 1;
        var kend = _agnodrm_json_skip_str(p, n, i);
        if (kend < 0) { return 0 - 2; }
        i = _agnodrm_json_ws(p, n, kend);
        if (i >= n) { return 0 - 2; }
        if (load8(p + i) != 58) { return 0 - 2; }
        i = _agnodrm_json_ws(p, n, i + 1);
        var vstart = i;
        i = _agnodrm_json_skip_value(p, n, i);
        if (i < 0) { return 0 - 2; }
        if (found < 0) {
            if (kend - kstart - 1 == klen) {
                if (memeq(p + kstart, key, klen) == 1) { found = vstart; }
            }
        }
        i = _agnodrm_json_ws(p, n, i);
        if (i >= n) { return 0 - 2; }
        var sep = load8(p + i);
        if (sep == 125) {
            if (_agnodrm_json_ws(p, n, i + 1) != n) { return 0 - 2; }
            return found;
        }
        if (sep != 44) { return 0 - 2; }
        i = _agnodrm_json_ws(p, n, i + 1);
    }
    return 0 - 2;
}

# 1 if the value at `i` is exactly the bare word `word`.
fn _agnodrm_json_is(p, n, i, word): i64 {
    var end = _agnodrm_json_skip_value(p, n, i);
    if (end < 0) { return 0; }
    var wlen = strlen(word);
    if (end - i != wlen) { return 0; }
    return memeq(p + i, word, wlen);
}

# The value of a hex digit, or -1.
fn _agnodrm_json_hex(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

# The four hex digits at `p` as a number, or -1.
fn _agnodrm_json_hex4(p): i64 {
    var v = 0;
    var i = 0;
    while (i < 4) {
        var d = _agnodrm_json_hex(load8(p + i));
        if (d < 0) { return 0 - 1; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

# Store code point `v` (at most 0xFFFF) at out + o as UTF-8. Returns the new offset.
fn _agnodrm_json_put_utf8(out, o, v): i64 {
    if (v < 0x80) {
        store8(out + o, v);
        return o + 1;
    }
    if (v < 0x800) {
        store8(out + o, 0xC0 | (v >> 6));
        store8(out + o + 1, 0x80 | (v & 63));
        return o + 2;
    }
    store8(out + o, 0xE0 | (v >> 12));
    store8(out + o + 1, 0x80 | ((v >> 6) & 63));
    store8(out + o + 2, 0x80 | (v & 63));
    return o + 3;
}

# A heap Str of the JSON string body at `p`, `n` bytes, escapes decoded. Always a copy:
# the capture buffer it came from is gone once the query returns.
fn _agnodrm_json_unescape(p, n): i64 {
    var out = alloc(n + 1);
    var o = 0;
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        i = i + 1;
        if (c != 92) {
            store8(out + o, c);
            o = o + 1;
            continue;
        }
        if (i >= n) { break; }
        c = load8(p + i);
        i = i + 1;
        if (c == 117) {             # \u and four hex digits
            var v = 0 - 1;
            if (i + 4 <= n) { v = _agnodrm_json_hex4(p + i); }
            if (v >= 0) {
                i = i + 4;
                o = _agnodrm_json_put_utf8(out, o, v);
                continue;
            }
        }
        if (c == 110) { c = 10; }   # \n
        elif (c == 116) { c = 9; }  # \t
        elif (c == 114) { c = 13; } # \r
        elif (c == 98) { c = 8; }   # \b
        elif (c == 102) { c = 12; } # \f
        store8(out + o, c);
        o = o + 1;
    }
    store8(out + o, 0);
    return str_new(out, o);
}

# A heap cstring of the JSON string at `i`, unescaped, or 0 if there is no string there. An
# escaped NUL is refused: past one a cstring would hide the rest of the value.
fn _agnodrm_json_cstr(p, n, i): i64 {
    if (i < 0) { return 0; }
    if (i >= n) { return 0; }
    if (load8(p + i) != 34) { return 0; }
    var end = _agnodrm_json_skip_str(p, n, i);
    if (end < 0) { return 0; }
    var val = _agnodrm_json_unescape(p + i + 1, end - i - 2);
    var text = str_cstr(val);
    if (strlen(text) != str_len(val)) { return 0; }
    return text;
}

# ================================================================
# Deadlines on the tools this library runs
# ================================================================

enum AgnodrmDeadline {
    # lib/process.cyr's default is no deadline, so a hung tool blocks its caller forever. This
    # is for a tool that answers a question, and a quick one should finish well inside it.
    AGNODRM_TOOL_DEADLINE_MS = 60000;
}

# Test seam, 0 outside tests/tcyr: a deadline a test can wait out, in place of any tool's.
var _agnodrm_deadline_ms = 0;

# Set the deadline for one tool call: `ms`, or the process's own if that is tighter, since a
# caller's bound must not be widened behind its back. 0 leaves the process's own alone.
# Returns what _agnodrm_deadline_end puts back.
fn _agnodrm_deadline_begin(ms): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;                   # agnos has no deadline to set, and runs none of these tools
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var outer = proc_timeout_ms();
    if (ms == 0) { return outer; }
    var limit = ms;
    if (_agnodrm_deadline_ms != 0) { limit = _agnodrm_deadline_ms; }
    if (outer > 0) {
        if (outer < limit) { limit = outer; }
    }
    proc_set_timeout_ms(limit);
    return outer;
    #endif
}

fn _agnodrm_deadline_end(outer): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    proc_set_timeout_ms(outer);
    #endif
    return 0;
}

# Run a subprocess (cstr argv vec) and capture stdout into a caller buffer, under deadline
# `ms`, 0 for none. On a capture that means silence: a tool printing nothing for `ms` is cut
# and the call is an Err (ETIMEDOUT). The stdlib then gives it as long again before killing
# it, so the caller waits up to twice `ms`.
# Returns Ok(bytes_read), or Err(errmsg) unless the tool ran and exited 0: a failed
# tool must not read as a tool that said nothing, and output from one that failed
# may be partial. `errmsg` is the per-tool diagnostic. status[0] is the exit code,
# 127 if execve failed, -2 on a deadline, or -1 if the end was never observed;
# exec_capture_status is why the consumer floor reached 6.6.7.
#
# A full buffer is the exception. The reader stops there and closes the pipe, so a
# tool with more to say dies of SIGPIPE, which says nothing about the tool. That comes
# back as Ok(buflen), and bytes_read >= buflen is how a caller sees truncation: the
# bootctl path refuses a cut list on it, and an Err here would skip that check.
fn _agnodrm_capture_within(args, buf, buflen, errmsg, ms): i64 {
    var status[16];
    var outer = _agnodrm_deadline_begin(ms);
    var n = exec_capture_status(args, buf, buflen, &status);
    _agnodrm_deadline_end(outer);
    if (load64(&status) == (0 - 2)) { return drm_err_io(ETIMEDOUT, errmsg); }
    if (n < 0) {
        return drm_err_unknown(errmsg);
    }
    if (buflen > 0) {
        if (n >= buflen) { return Ok(n); }
    }
    if (load64(&status) != 0) {
        return drm_err_unknown(errmsg);
    }
    return Ok(n);
}

# _agnodrm_capture_within with no deadline of its own. A caller's tool may be slow for good
# reason, so only the process's own proc_set_timeout_ms applies.
fn agnodrm_run_capture(args, buf, buflen, errmsg): i64 {
    return _agnodrm_capture_within(args, buf, buflen, errmsg, 0);
}

# Run a subprocess under deadline `ms`, 0 for none, here on the whole run. Returns its exit
# code, -2 if the deadline killed it, or -1.
fn _agnodrm_exec_within(args, ms): i64 {
    var outer = _agnodrm_deadline_begin(ms);
    var rc = exec_vec(args);
    _agnodrm_deadline_end(outer);
    return rc;
}

# Run a subprocess (cstr argv vec) under deadline `ms`, 0 for none, and check for a zero exit
# code. Returns Ok(0), Err(ETIMEDOUT) on the deadline, or Err(errmsg) on a non-zero exit or
# an exec failure.
fn _agnodrm_checked_within(args, errmsg, ms): i64 {
    var rc = _agnodrm_exec_within(args, ms);
    if (rc == (0 - 2)) { return drm_err_io(ETIMEDOUT, errmsg); }
    if (rc != 0) {
        return drm_err_unknown(errmsg);
    }
    return Ok(0);
}

# _agnodrm_checked_within with no deadline of its own, as for agnodrm_run_capture.
fn agnodrm_run_checked(args, errmsg): i64 {
    return _agnodrm_checked_within(args, errmsg, 0);
}

# Read from `fd` until EOF or `cap` bytes, draining short reads and retrying EINTR.
# Returns the byte count, or a negative errno: a read that fails part way must not
# pass for a short file.
fn _agnodrm_read_all(fd, buf, cap): i64 {
    var total = 0;
    while (total < cap) {
        var n = file_read(fd, buf + total, cap - total);
        if (n == 0) { break; }
        if (n == 0 - EINTR) { continue; }
        if (n < 0) { return n; }
        total = total + n;
    }
    return total;
}

# Write all `len` bytes, retrying EINTR. Returns 0 or a negative errno. A write that
# makes no progress is -EIO, so a 0 from the kernel cannot spin the loop.
fn _agnodrm_write_all(fd, data, len): i64 {
    var off = 0;
    while (off < len) {
        var w = file_write(fd, data + off, len - off);
        if (w == 0 - EINTR) { continue; }
        if (w < 0) { return w; }
        if (w == 0) { return 0 - EIO; }
        off = off + w;
    }
    return 0;
}

# Read up to `cap` bytes from `fd` into a fresh heap buffer, NUL-terminate,
# and return it as a Str (also valid as a cstr). The buffer is `cap + 1` bytes
# so the terminator never writes past the end even at a full read. A read error
# ends the text early: a caller that must tell the two apart uses _agnodrm_read_all.
fn agnodrm_read_fd_to_str(fd, cap): i64 {
    if (cap < 0) { cap = 0; }
    var buf = alloc(cap + 1);
    var total = _agnodrm_read_all(fd, buf, cap);
    if (total < 0) { total = 0; }
    store8(buf + total, 0);
    return str_new(buf, total);
}

# 1 if a caller's result array can take `max` entries.
fn _agnodrm_out_ok(arr, max): i64 {
    if (max < 0) { return 0; }
    if (max > 0) {
        if (arr == 0) { return 0; }
    }
    return 1;
}

# Scratch that a call gives back on return. alloc() never frees, so a buffer taken
# from it stays for the life of the process: a 5 s poller of udev_list_devices reached
# 1 GiB in 15 minutes (audit F-40), and arena_free does not help, because an arena is
# carved from alloc(). Nothing may keep a pointer into this past the free. Returns 0
# on failure. The agnos arm is alloc(), since mmap_anon always fails there, and agnos
# has no udev, journal or FUSE to reach these; its cyr_munmap is a no-op.
fn _agnodrm_scratch_new(size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return alloc(size);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return mmap_anon(size);
    #endif
}

fn _agnodrm_scratch_free(p, size): i64 {
    if (p != 0) { cyr_munmap(p, size); }
    return 0;
}

# Durability pair for update.cyr's atomic write (write tmp -> fsync ->
# rename), formerly raw syscall(74) / syscall(82) with the x86_64 numbers
# inlined. They now delegate to lib/io.cyr's portable helpers, which reach
# the per-target sys_* wrappers, so this file names no syscall number. The
# raw pair was latent on agnos, where 74 is shm_free and 82 is gpu_dispatch.
# lib/io.cyr is in both profiles' .deps, so the bundles already carry it.
#
# Return convention is the syscall's: 0 on success, negative on failure
# (-errno on Linux; agnos returns -1).

# Flush `fd` to stable storage. Linux: fsync(2) via sys_fsync. agnos has no
# per-fd fsync, so xfsync issues agnos's sys_sync, a whole-filesystem flush
# that also covers `fd` (coarser, and it does not validate `fd`).
fn agnodrm_fsync(fd): i64 {
    return xfsync(fd);
}

# Rename `oldpath` to `newpath` (C strings). Linux: sys_rename (rename(2) on
# x86_64, renameat(AT_FDCWD, ...) on aarch64). agnos: its length-carrying
# 4-arg sys_rename, with file_rename computing both lengths.
fn agnodrm_rename(oldpath, newpath): i64 {
    return file_rename(oldpath, newpath);
}

# The permission bits of what `path` resolves to, or -1 if it cannot be stat'd. 0x1FF is
# 0777: set-id bits are not carried across, as the stdlib's own atomic write does not
# carry them.
fn _agnodrm_file_mode(path): i64 {
    var st = alloc(STAT_BUFSZ);
    if (xstat(path, st) != 0) { return 0 - 1; }
    return load32(st + STAT_MODE) & 0x1FF;
}

# Flush the directory holding `path`, so a rename reaches the disk before anything that
# depends on it does. A rename is only durable once its directory is: without this, a
# power cut can undo the rename after a later step, such as firmware BootNext, has
# landed. Returns 0 or a negative errno. EINVAL is a filesystem with no directory fsync,
# which has nothing more to offer.
fn _agnodrm_fsync_parent(path): i64 {
    var slash = strlen(path) - 1;
    while (slash >= 0) {
        if (load8(path + slash) == 47) { break; }
        slash = slash - 1;
    }
    var dir = ".";
    if (slash == 0) { dir = "/"; }
    if (slash > 0) {
        dir = alloc(slash + 1);
        memcpy(dir, path, slash);
        store8(dir + slash, 0);
    }
    var fd = file_open(dir, O_RDONLY | O_DIRECTORY, 0);
    if (fd < 0) { return fd; }
    var ret = xfsync(fd);
    file_close(fd);
    if (ret == 0 - EINVAL) { return 0; }
    if (ret < 0) { return ret; }
    return 0;
}

enum AgnodrmTmp {
    AGNODRM_TMP_MAX_TRIES = 64;
}

# Next candidate suffix; 0 until the first call seeds it. It need not be atomic
# or secret: the exclusive create below is what arbitrates, so a lost update or
# a guessed name only costs a retry.
var _agnodrm_tmp_ctr = 0;

# Start the counter somewhere random, so a process that always has the same pid
# (PID 1, a container) does not walk the same names after each restart: at a
# fixed start, AGNODRM_TMP_MAX_TRIES crashed runs would leave every candidate
# taken and refuse all later writes. Linux flags, unnamed in the stdlib: this can
# run at early boot, so GRND_INSECURE (4) never blocks on the entropy pool, with
# GRND_NONBLOCK (1) for kernels before 5.6. The value only has to differ between
# runs. On failure the counter stays 0, which only gives up that protection.
fn _agnodrm_tmp_seed(): i64 {
    var seed = 0;
    #ifdef CYRIUS_TARGET_LINUX
    if (sys_getrandom(&seed, 4, 4) == 0 - EINVAL) { sys_getrandom(&seed, 4, 1); }
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    sys_getrandom(&seed, 4, 0);
    #endif
    _agnodrm_tmp_ctr = seed;
    return 0;
}

# Create a new file named `<base>.tmp.<pid>.<ctr>`, mode 0644 before umask.
# Returns the write fd and stores the path through `path_out`, or returns a
# negative errno and leaves `path_out` alone.
fn agnodrm_tmp_create(base, path_out): i64 {
    return _agnodrm_tmp_open(base, path_out, 0x1A4);  # mode 0644
}

# agnodrm_tmp_create with a chosen mode. A temp that will replace a 0600 file must be
# born 0600: created wider and tightened later, its bytes are readable in between.
#
# The name must be treated as predictable, so it is never opened with O_TRUNC:
# file_create_exclusive refuses a name that exists as anything, including a
# dangling symlink, so a link planted at the name is never written through
# (audit F-1). A taken name moves on to the next counter, and after
# AGNODRM_TMP_MAX_TRIES the call fails with -EEXIST rather than touch one.
# On agnos before cyrius 6.6.9 that create is a non-atomic pre-check that follows
# links; agnodrm's own callers return not_supported on agnos before reaching it.
#
# A crash between this and the caller's rename or unlink leaves the temp behind.
# It is not reused or cleaned up. The suffix takes up to about 23 bytes of the
# file name, so a `base` file name over about 232 bytes fails with -ENAMETOOLONG.
fn _agnodrm_tmp_open(base, path_out, mode): i64 {
    if (base == 0 || path_out == 0) { return 0 - EINVAL; }
    if (_agnodrm_tmp_ctr == 0) { _agnodrm_tmp_seed(); }
    var baselen = strlen(base);
    # 24 bytes at each fmt_int_buf position, not a digit count: before cyrius
    # 6.6.18 it wrote 24 bytes whatever the number's length.
    var path = alloc(baselen + 64);
    if (path == 0) { return 0 - ENOMEM; }
    memcpy(path, base, baselen);
    memcpy(path + baselen, ".tmp.", 5);
    var pos = baselen + 5;
    pos = pos + fmt_int_buf(sys_getpid(), path + pos);
    store8(path + pos, 46);  # '.'
    pos = pos + 1;

    var tries = 0;
    while (tries < AGNODRM_TMP_MAX_TRIES) {
        var end = pos + fmt_int_buf(_agnodrm_tmp_ctr, path + pos);
        store8(path + end, 0);
        _agnodrm_tmp_ctr = _agnodrm_tmp_ctr + 1;
        #ifdef CYRIUS_TARGET_AGNOS
        var fd = file_create_exclusive(path, mode);
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        # file_create_exclusive's flags plus O_CLOEXEC, so no helper a caller forks
        # later inherits the write end. agnos has no exec to leak it through, and its
        # refusal needs the classification that helper does.
        var fd = file_open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, mode);
        #endif
        if (fd >= 0) {
            store64(path_out, path);
            return fd;
        }
        if (fd != 0 - EEXIST) { return fd; }
        tries = tries + 1;
    }
    return 0 - EEXIST;
}

# --- udev.cyr ---

# udev.cyr — udev device enumeration and rule validation
# Ported from rust-old/src/udev.rs
#
# Shells out to udevadm for device info. Parses output into structs.
# Rule validation rejects dangerous action keys (RUN, PROGRAM, etc).
#
# Requires: src/error.cyr, src/util.cyr, lib/syscalls.cyr, lib/process.cyr

# ================================================================
# Device subsystem constants
# ================================================================

enum DeviceSubsystem {
    SUBSYS_BLOCK = 1;
    SUBSYS_NET = 2;
    SUBSYS_INPUT = 3;
    SUBSYS_USB = 4;
    SUBSYS_PCI = 5;
    SUBSYS_TTY = 6;
    SUBSYS_GPU = 7;
    SUBSYS_SOUND = 8;
    SUBSYS_OTHER = 9;
}

# ================================================================
# DeviceInfo struct
# 9 fields * 8 = 72 bytes. prop_keys and prop_vals are arrays of
# string pointers. Per-field accessors auto-generated; the named
# multi-field setter `set_props(d, keys, vals, count)/4` keeps its
# public signature and delegates through the per-field setters.
# ================================================================

#derive(accessors)
struct udev_devinfo {
    syspath;
    devpath;
    subsystem;
    devtype;
    driver;
    devnode;
    prop_keys;
    prop_vals;
    prop_count;
}

fn udev_devinfo_new(): i64 {
    var d = alloc(72);
    memset(d, 0, 72);
    return d;
}

fn udev_devinfo_set_props(d, keys, vals, count): i64 {
    udev_devinfo_set_prop_keys(d, keys);
    udev_devinfo_set_prop_vals(d, vals);
    udev_devinfo_set_prop_count(d, count);
    return 0;
}

# ================================================================
# Parse udevadm info output for a single device
# ================================================================

# Test seam, 0 outside tests/tcyr: a stub to run in place of /usr/bin/udevadm.
var _udev_tool = 0;

enum UdevLimits {
    UDEV_DB_CHUNK = 1048576;       # first capture of --export-db
    UDEV_DB_MAX = 67108864;        # past this the listing fails rather than cut the db
    UDEV_INFO_MAX = 65536;         # one device's `udevadm info`
}

# A NUL-terminated heap copy of `n` bytes at `p`.
fn _udev_copy(p, n): i64 {
    var v = alloc(n + 1);
    memcpy(v, p, n);
    store8(v + n, 0);
    return v;
}

# 1 if the `n` bytes at `p` hold a ".." path component.
fn _udev_has_dotdot(p, n): i64 {
    var i = 0;
    while (i + 1 < n) {
        if (load8(p + i) == 46) { if (load8(p + i + 1) == 46) {
                var head = 1;
                if (i > 0) { head = load8(p + i - 1) == 47; }
                var tail = 1;
                if (i + 2 < n) { tail = load8(p + i + 2) == 47; }
                if (head == 1) { if (tail == 1) { return 1; } }
            } }
        i = i + 1;
    }
    return 0;
}

# Parse one device block of udevadm info output: `textlen` bytes at `text`, whose
# P:/N:/U:/T:/V:/E: prefixed lines end in LF. Returns Result: Ok(devinfo_ptr) or Err.
#
# udevadm prints a line of each single-valued kind once, so a repeat is not a real
# device. E: values are device-supplied text, and a USB name holding a newline can
# forge a whole line, so a line never overrides one before it: the first P: stands and
# a second one fails the block, the first N: stands, and the U:/T:/V: lines udevadm
# writes itself outrank the E: properties. A device node that climbs out of /dev is
# refused, because the caller is about to open it (audit F-36). Every property is
# kept, as many as the device has. A value holding a blank line still ends this block and
# starts another, which no parser of this format can tell from a real device: a listing
# is what udevadm printed, not proof a device exists.
fn _udev_parse_block(text, textlen): i64 {
    var devpath = 0;
    var devnode = 0;
    var subsystem = 0;
    var devtype = 0;
    var driver = 0;

    # A property takes a line, so the line count bounds them.
    var max_props = 1;
    var scan = 0;
    while (scan < textlen) {
        if (load8(text + scan) == 10) { max_props = max_props + 1; }
        scan = scan + 1;
    }
    var prop_keys = alloc(max_props * 8);
    var prop_vals = alloc(max_props * 8);
    var prop_count = 0;

    var pos = 0;
    while (pos < textlen) {
        # Find end of line
        var linestart = pos;
        while (pos < textlen) {
            if (load8(text + pos) == 10) { break; }
            pos = pos + 1;
        }
        var linelen = pos - linestart;
        if (pos < textlen) { pos = pos + 1; }

        # Skip leading whitespace
        var ls = linestart;
        while (ls < linestart + linelen) {
            var ch = load8(text + ls);
            if (ch != 32) { if (ch != 9) { break; } }
            ls = ls + 1;
        }
        var eff_len = linestart + linelen - ls;
        if (eff_len < 3) { continue; }
        if (load8(text + ls + 1) != 58) { continue; }   # ':'
        if (load8(text + ls + 2) != 32) { continue; }   # ' '

        var kind = load8(text + ls);
        var vstart = ls + 3;
        var vlen = eff_len - 3;

        if (kind == 80) {           # P: devpath
            if (devpath != 0) {
                return drm_err_invalid_argument("udevadm block has more than one P: line");
            }
            if (_udev_has_dotdot(text + vstart, vlen) == 1) {
                return drm_err_invalid_argument("udevadm P: line climbs out of /sys");
            }
            devpath = _udev_copy(text + vstart, vlen);
        } elif (kind == 78) {       # N: devnode, relative to /dev
            if (devnode == 0) {
                if (_udev_has_dotdot(text + vstart, vlen) == 1) {
                    return drm_err_invalid_argument("udevadm N: line leaves /dev");
                }
                var node = alloc(vlen + 6);
                memcpy(node, "/dev/", 5);
                memcpy(node + 5, text + vstart, vlen);
                store8(node + 5 + vlen, 0);
                devnode = node;
            }
        } elif (kind == 85) {       # U: subsystem
            if (subsystem == 0) { subsystem = _udev_copy(text + vstart, vlen); }
        } elif (kind == 84) {       # T: devtype
            if (devtype == 0) { devtype = _udev_copy(text + vstart, vlen); }
        } elif (kind == 86) {       # V: driver
            if (driver == 0) { driver = _udev_copy(text + vstart, vlen); }
        } elif (kind == 69) {       # E: key=value property
            var eq_pos = 0;
            var j = 0;
            while (j < vlen) {
                if (load8(text + vstart + j) == 61) {  # '='
                    eq_pos = j;
                    break;
                }
                j = j + 1;
            }
            if (eq_pos > 0) {
                store64(prop_keys + prop_count * 8, _udev_copy(text + vstart, eq_pos));
                store64(prop_vals + prop_count * 8, _udev_copy(text + vstart + eq_pos + 1, vlen - eq_pos - 1));
                prop_count = prop_count + 1;
            }
        }
    }

    if (devpath == 0) {
        return drm_err_invalid_argument("udevadm output missing P: (devpath) line");
    }

    # Build syspath = "/sys" + devpath
    var dplen = strlen(devpath);
    var syspath = alloc(dplen + 5);
    memcpy(syspath, "/sys", 4);
    memcpy(syspath + 4, devpath, dplen);
    store8(syspath + 4 + dplen, 0);

    # What the U:/T:/V:/N: lines left unset comes from the properties, first one wins.
    var i = 0;
    while (i < prop_count) {
        var key = load64(prop_keys + i * 8);
        var val = load64(prop_vals + i * 8);
        if (subsystem == 0) { if (streq(key, "SUBSYSTEM") == 1) { subsystem = val; } }
        if (devtype == 0) { if (streq(key, "DEVTYPE") == 1) { devtype = val; } }
        if (driver == 0) { if (streq(key, "DRIVER") == 1) { driver = val; } }
        if (devnode == 0) {
            if (streq(key, "DEVNAME") == 1) {
                if (agnodrm_cstr_starts_with(val, "/dev/") == 1) {
                    if (_udev_has_dotdot(val, strlen(val)) == 0) { devnode = val; }
                }
            }
        }
        i = i + 1;
    }
    if (subsystem == 0) { subsystem = ""; }

    var info = udev_devinfo_new();
    udev_devinfo_set_syspath(info, syspath);
    udev_devinfo_set_devpath(info, devpath);
    udev_devinfo_set_subsystem(info, subsystem);
    udev_devinfo_set_devtype(info, devtype);
    udev_devinfo_set_driver(info, driver);
    udev_devinfo_set_devnode(info, devnode);
    udev_devinfo_set_props(info, prop_keys, prop_vals, prop_count);

    return Ok(info);
}

# Parse a block of udevadm info output (P:/N:/U:/T:/V:/E: prefixed lines).
# text: null-terminated string of udevadm output.
# Returns Result: Ok(devinfo_ptr) or Err.
fn udev_parse_udevadm_info(text): i64 {
    if (text == 0) {
        return drm_err_invalid_argument("udevadm output is null");
    }
    return _udev_parse_block(text, strlen(text));
}

# ================================================================
# List devices via udevadm info --export-db
# ================================================================

# 1 if the block at `text` is on subsystem `filter`, by the rule _udev_parse_block
# applies: the U: line, else the first E: SUBSYSTEM=. It copies nothing, so a poller that
# wants one subsystem does not leave every other device on the heap (audit F-40).
fn _udev_block_on_subsystem(text, textlen, filter): i64 {
    var flen = strlen(filter);
    var from_e = 0 - 1;
    var pos = 0;
    while (pos < textlen) {
        var ls = pos;
        while (pos < textlen) {
            if (load8(text + pos) == 10) { break; }
            pos = pos + 1;
        }
        var end = pos;
        pos = pos + 1;
        while (ls < end) {
            var ch = load8(text + ls);
            if (ch != 32) { if (ch != 9) { break; } }
            ls = ls + 1;
        }
        var n = end - ls;
        if (n < 3) { continue; }
        if (load8(text + ls + 1) != 58) { continue; }
        if (load8(text + ls + 2) != 32) { continue; }
        var kind = load8(text + ls);
        if (kind == 85) {        # U: decides, wherever it comes
            if (n - 3 != flen) { return 0; }
            return memeq(text + ls + 3, filter, flen);
        }
        if (kind == 69) {
            if (from_e < 0) {
                if (n >= 13) {
                    if (memeq(text + ls + 3, "SUBSYSTEM=", 10) == 1) {
                        from_e = 0;
                        if (n - 13 == flen) { from_e = memeq(text + ls + 13, filter, flen); }
                    }
                }
            }
        }
    }
    return from_e == 1;
}

# Parse `textlen` bytes of --export-db output, blocks split by blank lines, into
# result_arr. Blocks that do not parse are skipped. Stops once result_arr is full.
fn _udev_parse_db(output, textlen, subsystem_filter, result_arr, max_devices): i64 {
    var count = 0;
    var block_start = 0;
    var pos = 0;
    while (pos <= textlen) {
        if (count >= max_devices) { break; }
        var at_end = 0;
        if (pos == textlen) { at_end = 1; }
        elif (load8(output + pos) == 10) {
            # Check if next char is also newline (blank line)
            if (pos + 1 < textlen) {
                if (load8(output + pos + 1) == 10) { at_end = 1; }
            }
        }
        if (at_end == 0) {
            pos = pos + 1;
            continue;
        }

        if (pos > block_start) {
            var keep = 1;
            if (subsystem_filter != 0) {
                if (strlen(subsystem_filter) > 0) {
                    keep = _udev_block_on_subsystem(output + block_start, pos - block_start, subsystem_filter);
                }
            }
            if (keep == 1) {
                var dev_res_t, dev_res_v = _udev_parse_block(output + block_start, pos - block_start);
                if (is_ok(dev_res_t) == 1) {
                    store64(result_arr + count * 8, dev_res_v);
                    count = count + 1;
                }
            }
        }
        # Skip blank lines
        while (pos < textlen) {
            if (load8(output + pos) != 10) { break; }
            pos = pos + 1;
        }
        block_start = pos;
        # Without this, pos==textlen re-enters the at_end branch forever.
        if (pos >= textlen) { break; }
    }
    return count;
}

# List all devices, optionally filtered by subsystem string.
# subsystem_filter: a null-terminated string, or 0 for no filter.
# result_arr: pre-allocated array of device pointers.
# max_devices: max capacity of result_arr. A count equal to it may mean there are more.
# Returns Result: Ok(count) or Err.
#
# The whole database is parsed or none of it: a capture that fills its buffer runs again
# with a larger one, and past UDEV_DB_MAX the call fails. A cut database would parse its
# last block with a truncated N: line, and hand the caller the wrong device node (audit
# F-37). The capture buffer is released on return; the devices are heap copies.
fn udev_list_devices(subsystem_filter, result_arr, max_devices): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);                # agnos has no udev/udevadm — no devices to enumerate
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_devices) != 1) {
        return drm_err_invalid_argument("result array is null or max_devices is negative");
    }
    # argv vec: element 0 is the ABSOLUTE command path — execve(2) does no
    # PATH lookup, so a bare "udevadm" never runs. Each arg is its own vec
    # entry; _agnodrm_capture_within runs it with no /bin/sh and no metacharacter
    # split. Mirrors netns_run_ip / journald_query.
    var args = vec_new();
    vec_push(args, "/usr/bin/udevadm");
    vec_push(args, "info");
    vec_push(args, "--export-db");
    if (_udev_tool != 0) { vec_set(args, 0, _udev_tool); }

    var cap = UDEV_DB_CHUNK;
    while (cap <= UDEV_DB_MAX) {
        var buf = _agnodrm_scratch_new(cap);
        if (buf == 0) { return drm_err_io(ENOMEM, "no memory for the udev device database"); }
        var failed = "udevadm info --export-db failed";
        var res_t, res_v = _agnodrm_capture_within(args, buf, cap, failed, AGNODRM_TOOL_DEADLINE_MS);
        if (is_err_result(res_t) == 1) {
            _agnodrm_scratch_free(buf, cap);
            return Err(res_v);
        }
        if (res_v < cap) {
            var count = _udev_parse_db(buf, res_v, subsystem_filter, result_arr, max_devices);
            _agnodrm_scratch_free(buf, cap);
            return Ok(count);
        }
        _agnodrm_scratch_free(buf, cap);
        cap = cap * 4;
    }
    return drm_err_io(0, "udev device database is too large to read whole");
    #endif
}

# ================================================================
# Get device info for a single device by sysfs path
# ================================================================

# Get one device's info. syspath: an absolute /sys/... path or devpath, the forms
# udev_devinfo hands out. A relative path, or one holding a ".." component, is refused
# before udevadm sees it.
fn udev_get_device_info(syspath): i64 {
    if (syspath == 0) {
        return drm_err_invalid_argument("syspath is null");
    }
    if (strlen(syspath) == 0) {
        return drm_err_invalid_argument("syspath cannot be empty");
    }

    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("udev device query (agnos has no udev/udevadm)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (load8(syspath) != 47) {
        return drm_err_invalid_argument("syspath must be absolute");
    }
    var slen = strlen(syspath);
    if (_udev_has_dotdot(syspath, slen) == 1) {
        return drm_err_invalid_argument("syspath must not contain '..'");
    }

    # Build --path=<syspath> argument
    var prefix = "--path=";
    var plen = strlen(prefix);
    var patharg = alloc(plen + slen + 1);
    memcpy(patharg, prefix, plen);
    memcpy(patharg + plen, syspath, slen);
    store8(patharg + plen + slen, 0);

    # argv vec: element 0 is the ABSOLUTE command path (execve does no PATH
    # lookup). Each arg is its own vec entry — no shell, no metacharacter
    # split — so `patharg` (attacker-influenced via `syspath`) reaches
    # udevadm verbatim as argv[2] and cannot escape into a shell.
    var args = vec_new();
    vec_push(args, "/usr/bin/udevadm");
    vec_push(args, "info");
    vec_push(args, patharg);
    if (_udev_tool != 0) { vec_set(args, 0, _udev_tool); }

    var cap = UDEV_INFO_MAX;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for udevadm info"); }
    var res_t, res_v = _agnodrm_capture_within(args, buf, cap, "udevadm info --path failed", AGNODRM_TOOL_DEADLINE_MS);
    if (is_err_result(res_t) == 1) {
        _agnodrm_scratch_free(buf, cap);
        return Err(res_v);
    }
    if (res_v >= cap) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_io(0, "udevadm info output is too large to read whole");
    }
    var dev_t, dev_v = _udev_parse_block(buf, res_v);
    _agnodrm_scratch_free(buf, cap);
    if (is_err_result(dev_t) == 1) { return Err(dev_v); }
    return Ok(dev_v);
    #endif
}

# ================================================================
# Udev rule validation
# ================================================================

# Check if a string starts with a given prefix.
# Thin wrapper over the shared single-pass predicate (public API stable).
fn udev_starts_with(str, prefix): i64 {
    return agnodrm_cstr_starts_with(str, prefix);
}

# 1 if `key` is the rule key `name`: the name alone, or followed by an attribute or an
# operator, so RUN{program}, RUN+= and SYSCTL{kernel.core_pattern} all count.
fn _udev_key_is(key, name): i64 {
    if (agnodrm_cstr_starts_with(key, name) != 1) { return 0; }
    var c = load8(key + strlen(name));
    if (c == 0) { return 1; }
    if (c == 123) { return 1; }   # '{'
    if (c == 43) { return 1; }    # '+'
    if (c == 45) { return 1; }    # '-'
    if (c == 58) { return 1; }    # ':'
    if (c == 61) { return 1; }    # '='
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# The key that makes `key` dangerous, as a message, or 0. A denylist of the keys that
# run a program, write a sysctl or start a unit as root; an unlisted key passes. Rule
# keys are case-sensitive, so no folding is needed.
fn _udev_key_danger(key): i64 {
    while (load8(key) == 32 || load8(key) == 9) { key = key + 1; }
    if (_udev_key_is(key, "RUN") == 1) { return "udev rule contains dangerous key: RUN"; }
    if (_udev_key_is(key, "PROGRAM") == 1) { return "udev rule contains dangerous key: PROGRAM"; }
    if (_udev_key_is(key, "SYSCTL") == 1) { return "udev rule contains dangerous key: SYSCTL"; }
    if (udev_starts_with(key, "IMPORT{program}") == 1) {
        return "udev rule contains dangerous key: IMPORT{program}";
    }
    if (udev_starts_with(key, "IMPORT{builtin}") == 1) {
        return "udev rule contains dangerous key: IMPORT{builtin}";
    }
    if (udev_starts_with(key, "ENV{SYSTEMD_WANTS}") == 1) {
        return "udev rule contains dangerous key: ENV{SYSTEMD_WANTS}";
    }
    if (udev_starts_with(key, "ENV{SYSTEMD_USER_WANTS}") == 1) {
        return "udev rule contains dangerous key: ENV{SYSTEMD_USER_WANTS}";
    }
    return 0;
}

# Validate a udev rule.
# action_keys: array of string pointers to action key names.
# action_count: number of action keys.
# Returns Result: Ok(0) if no dangerous key was found, Err if one was or an argument is
# bad. Through 1.7.1 RUN matched only exactly, so RUN{program}, the spelling real rules
# use, passed (audit F-34). Ok(0) means nothing listed matched, not that a rule is safe.
fn udev_validate_rule(action_keys, action_count): i64 {
    if (_agnodrm_out_ok(action_keys, action_count) != 1) {
        return drm_err_invalid_argument("action keys are null or the count is negative");
    }
    var i = 0;
    while (i < action_count) {
        var key = load64(action_keys + i * 8);
        if (key == 0) { return drm_err_invalid_argument("udev rule key is null"); }
        var danger = _udev_key_danger(key);
        if (danger != 0) { return drm_err_invalid_argument(danger); }
        i = i + 1;
    }
    return Ok(0);
}

# Parse a subsystem string into a constant
fn udev_parse_subsystem(s): i64 {
    if (streq(s, "block") == 1) { return SUBSYS_BLOCK; }
    if (streq(s, "net") == 1) { return SUBSYS_NET; }
    if (streq(s, "input") == 1) { return SUBSYS_INPUT; }
    if (streq(s, "usb") == 1) { return SUBSYS_USB; }
    if (streq(s, "pci") == 1) { return SUBSYS_PCI; }
    if (streq(s, "tty") == 1) { return SUBSYS_TTY; }
    if (streq(s, "drm") == 1) { return SUBSYS_GPU; }
    if (streq(s, "sound") == 1) { return SUBSYS_SOUND; }
    if (streq(s, "snd") == 1) { return SUBSYS_SOUND; }
    return SUBSYS_OTHER;
}

# --- drm.cyr ---

# drm.cyr — DRM (Direct Rendering Manager) device interface
# Ported from rust-old/src/drm.rs
#
# Enumerate GPU devices under /dev/dri/, query driver version
# and capabilities via ioctl. Every kernel call goes through the
# stdlib's per-target sys_* wrappers (sys_open / sys_getdents64 /
# sys_ioctl / sys_close), never a raw syscall number.
#
# Requires: src/error.cyr, lib/syscalls.cyr

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"

# ================================================================
# DRM ioctl constants
# ================================================================

# DRM ioctl type byte is 'd' (0x64)
# _IOWR('d', nr, size) = (3 << 30) | (size << 16) | (0x64 << 8) | nr

# DRM_IOCTL_VERSION: _IOWR('d', 0x00, 64)  [struct drm_version is 64 bytes]
# = (3 << 30) | (64 << 16) | (0x64 << 8) | 0x00
# = 0xC0406400
# Through 1.7.1 this encoded 72 bytes. drm_ioctl takes the caller's size, so real
# kernels answered anyway, but qemu and an ioctl-number allowlist refuse it (audit F-35).

# DRM_IOCTL_GET_CAP: _IOWR('d', 0x0C, 16)  [DrmGetCap is 16 bytes]
# = (3 << 30) | (16 << 16) | (0x64 << 8) | 0x0C
# = 0xC010640C

enum DrmIoctl {
    DRM_IOCTL_VERSION = 0xC0406400;
    DRM_IOCTL_GET_CAP = 0xC010640C;
}

# DRM capability IDs
enum DrmCap {
    DRM_CAP_DUMB_BUFFER = 1;
    DRM_CAP_VBLANK_HIGH_CRTC = 2;
    DRM_CAP_DUMB_PREFERRED_DEPTH = 3;
    DRM_CAP_DUMB_PREFER_SHADOW = 4;
    DRM_CAP_PRIME = 5;
    DRM_CAP_TIMESTAMP_MONOTONIC = 6;
    DRM_CAP_ASYNC_PAGE_FLIP = 7;
    DRM_CAP_CURSOR_WIDTH = 8;
    DRM_CAP_CURSOR_HEIGHT = 9;
    DRM_CAP_ADDFB2_MODIFIERS = 16;
    DRM_CAP_PAGE_FLIP_TARGET = 17;
    DRM_CAP_CRTC_IN_VBLANK_EVENT = 18;
    DRM_CAP_SYNCOBJ = 19;
    DRM_CAP_SYNCOBJ_TIMELINE = 20;
}

# Connector type constants
enum DrmConnectorType {
    DRM_CONN_UNKNOWN = 0;
    DRM_CONN_VGA = 1;
    DRM_CONN_DVII = 2;
    DRM_CONN_DVID = 3;
    DRM_CONN_DVIA = 4;
    DRM_CONN_COMPOSITE = 5;
    DRM_CONN_SVIDEO = 6;
    DRM_CONN_LVDS = 7;
    DRM_CONN_COMPONENT = 8;
    DRM_CONN_DISPLAYPORT = 10;
    DRM_CONN_HDMIA = 11;
    DRM_CONN_HDMIB = 12;
    DRM_CONN_TV = 13;
    DRM_CONN_EDP = 14;
    DRM_CONN_VIRTUAL = 15;
    DRM_CONN_DSI = 16;
    DRM_CONN_USB = 20;
}

# Connection status
enum DrmConnStatus {
    DRM_CONNECTED = 1;
    DRM_DISCONNECTED = 2;
    DRM_CONN_STATUS_UNKNOWN = 3;
}

# ioctl and getdents64 go through lib/syscalls.cyr's sys_ioctl /
# sys_getdents64, which carry each target's own syscall number.

# Linux flag, unnamed in the stdlib, the same value on x86_64 and aarch64. Opening a
# tty by mistake must not make it this process's controlling terminal.
enum DrmOpenFlags {
    DRM_O_NOCTTY = 0x100;
    DRM_IOCTL_MAX_TRIES = 64;
}

# sys_ioctl with the retry libdrm's drmIoctl does: a signal or a busy driver is not a
# failure of the request. Bounded, so a driver stuck on EAGAIN cannot hold the caller.
fn _drm_ioctl(fd, request, arg): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - ENOSYS;           # agnos has no DRM subsystem, and older stdlibs no sys_ioctl
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ret = sys_ioctl(fd, request, arg);
    var tries = 1;
    while (ret == 0 - EINTR || ret == 0 - EAGAIN) {
        if (tries >= DRM_IOCTL_MAX_TRIES) { break; }
        ret = sys_ioctl(fd, request, arg);
        tries = tries + 1;
    }
    return ret;
    #endif
}

# ================================================================
# DRM Version struct (on-wire for ioctl)
# ================================================================

# struct drm_version layout on LP64 (64 bytes):
#   +0:  version_major    (i32, 4 bytes)
#   +4:  version_minor    (i32, 4 bytes)
#   +8:  version_patchlevel (i32, 4 bytes)
#   +12: padding          (4 bytes)
#   +16: name_len         (u64)
#   +24: name_ptr         (u64)
#   +32: date_len         (u64)
#   +40: date_ptr         (u64)
#   +48: desc_len         (u64)
#   +56: desc_ptr         (u64)

enum DrmVerOff {
    DRM_VER_SIZE = 64;
    DRM_VER_MAJOR = 0;
    DRM_VER_MINOR = 4;
    DRM_VER_PATCH = 8;
    DRM_VER_NAME_LEN = 16;
    DRM_VER_NAME_PTR = 24;
    DRM_VER_DATE_LEN = 32;
    DRM_VER_DATE_PTR = 40;
    DRM_VER_DESC_LEN = 48;
    DRM_VER_DESC_PTR = 56;
}

# DrmGetCap layout (16 bytes):
#   +0: capability (u64)
#   +8: value      (u64)

# ================================================================
# Version result struct
# 6 fields (3 i64 + 3 ptr) * 8 = 48 bytes. Accessors auto-generated.
# ================================================================

#derive(accessors)
struct drm_verinfo { major; minor; patch; name; date; desc; }

fn drm_verinfo_new(major, minor, patch, name, date, desc): i64 {
    var v = alloc(48);
    drm_verinfo_set_major(v, major);
    drm_verinfo_set_minor(v, minor);
    drm_verinfo_set_patch(v, patch);
    drm_verinfo_set_name(v, name);
    drm_verinfo_set_date(v, date);
    drm_verinfo_set_desc(v, desc);
    return v;
}

# Hand-rolled JSON serializer — cstring fields; see roadmap.md V1.1.12.
fn drm_verinfo_to_json(v, sb): i64 {
    str_builder_add_cstr(sb, "{\"major\":");
    str_builder_add_int(sb, drm_verinfo_major(v));
    str_builder_add_cstr(sb, ",\"minor\":");
    str_builder_add_int(sb, drm_verinfo_minor(v));
    str_builder_add_cstr(sb, ",\"patch\":");
    str_builder_add_int(sb, drm_verinfo_patch(v));
    str_builder_add_cstr(sb, ",\"name\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_name(v));
    str_builder_add_cstr(sb, ",\"date\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_date(v));
    str_builder_add_cstr(sb, ",\"desc\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_desc(v));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Device enumeration
# ================================================================

# List DRM card device paths under /dev/dri/.
# result_arr: pre-allocated array of string pointers.
# max_cards: capacity of result_arr. A count equal to it may mean there are more.
# Returns Result: Ok(count); Err(not_supported) when there is no /dev/dri, or Err for
# a directory that exists and could not be read.
fn drm_list_devices(result_arr, max_cards): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);                # agnos has no DRM subsystem (/dev/dri) — no cards to enumerate
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_cards) != 1) {
        return drm_err_invalid_argument("result array is null or max_cards is negative");
    }
    # Open /dev/dri/ directory
    var dri_path = "/dev/dri";
    # O_RDONLY | O_DIRECTORY. Spell the per-target symbol: the old raw 0x10000 is
    # O_DIRECTORY on x86_64 but O_DIRECT on arm64, so aarch64 got EINVAL (CHANGELOG 1.6.1).
    var fd = sys_open(dri_path, O_DIRECTORY | O_CLOEXEC, 0);
    if (fd < 0) {
        if (fd == 0 - ENOENT) { return drm_err_not_supported("DRM (/dev/dri not found)"); }
        return drm_err_io(0 - fd, "failed to open /dev/dri");
    }

    # Read directory entries
    var bufsz = 4096;
    var buf = _agnodrm_scratch_new(bufsz);
    if (buf == 0) {
        sys_close(fd);
        return drm_err_io(ENOMEM, "no memory to read /dev/dri");
    }
    var count = 0;

    var nread = sys_getdents64(fd, buf, 4096);
    while (nread > 0) {
        var pos = 0;
        while (pos < nread) {
            # dirent64: d_ino(8), d_off(8), d_reclen(2), d_type(1), d_name(...)
            # d_name therefore starts at +19, so a record is at least 20 bytes.
            # Validate d_reclen before trusting it: reclen == 0 would spin this
            # loop forever, and a reclen running past nread would walk name_ptr
            # into uninitialized heap. devtmpfs makes both unreachable today —
            # this is defence-in-depth against a malformed dirent stream.
            var reclen = load16(buf + pos + 16);
            var rec_ok = 1;
            if (reclen < 20) { rec_ok = 0; }
            if (rec_ok == 1) { if (pos + reclen > nread) { rec_ok = 0; } }
            if (rec_ok == 0) { pos = nread; continue; }

            var name_ptr = buf + pos + 19;
            var name_max = reclen - 19;      # bytes available to d_name

            # Bounded NUL scan — d_name is padded, not guaranteed terminated
            # within our read window, so never hand it to strlen().
            var nlen = 0;
            var scanning = 1;
            while (scanning == 1) {
                if (nlen >= name_max) { scanning = 0; }
                if (scanning == 1) {
                    if (load8(name_ptr + nlen) == 0) { scanning = 0; }
                    if (scanning == 1) { nlen = nlen + 1; }
                }
            }

            # Check if name starts with "card"
            if (name_max >= 4) {
                if (memeq(name_ptr, "card", 4) == 1) {
                    if (count < max_cards) {
                        var path = alloc(10 + nlen);
                        memcpy(path, "/dev/dri/", 9);
                        memcpy(path + 9, name_ptr, nlen);
                        store8(path + 9 + nlen, 0);
                        store64(result_arr + count * 8, path);
                        count = count + 1;
                    }
                }
            }
            pos = pos + reclen;
        }
        nread = sys_getdents64(fd, buf, 4096);
    }
    sys_close(fd);
    _agnodrm_scratch_free(buf, bufsz);
    if (nread < 0) {
        return drm_err_io(0 - nread, "failed to read /dev/dri");
    }

    return Ok(count);
    #endif
}

# ================================================================
# Open a DRM device
# ================================================================

# 1 if `fd` is a character device that answers DRM_IOCTL_VERSION. The answer is what
# makes it DRM, on every target: no st_rdev offset is named by the stdlib, and major 226
# would say less than the driver saying so.
fn _drm_is_device(fd): i64 {
    var st = alloc(STAT_BUFSZ);
    if (sys_fstat(fd, st) != 0) { return 0; }
    if ((load32(st + STAT_MODE) & 0xF000) != 0x2000) { return 0; }  # S_IFCHR
    var ver = alloc(DRM_VER_SIZE);
    memset(ver, 0, DRM_VER_SIZE);
    if (_drm_ioctl(fd, DRM_IOCTL_VERSION, ver) < 0) { return 0; }
    return 1;
}

# Open a DRM device by path. Returns Result: Ok(fd) or Err. Anything that is not a DRM
# device is closed and refused, so a regular file, /dev/ptmx or /dev/kvm cannot come
# back as an Ok fd (audit F-38). Opening a card node takes DRM master when none is held;
# a caller that only queries should open a render node, which answers both ioctls here.
fn drm_open(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("open DRM device (no DRM subsystem)");  # agnos: display via bhumi scanout
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0) {
        return drm_err_invalid_argument("drm device path is null");
    }
    # Per-target O_* names, as drm_list_devices spells O_DIRECTORY.
    var fd = sys_open(path, O_RDWR | O_CLOEXEC | DRM_O_NOCTTY, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open DRM device");
    }
    if (_drm_is_device(fd) != 1) {
        sys_close(fd);
        return drm_err_invalid_argument("path is not a DRM device");
    }
    return Ok(fd);
    #endif
}

# Close a DRM device fd. Returns 0 or a negative errno, so a double close shows.
fn drm_close(fd): i64 {
    return sys_close(fd);
}

# ================================================================
# Query driver version
# ================================================================

# Get the DRM driver version for an open device fd.
# Returns Result: Ok(drm_verinfo_ptr) or Err.
fn drm_get_driver_version(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("DRM version ioctl (no DRM subsystem)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # First call: get string lengths
    var ver = alloc(DRM_VER_SIZE);
    memset(ver, 0, DRM_VER_SIZE);

    var ret = _drm_ioctl(fd, DRM_IOCTL_VERSION, ver);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "DRM_IOCTL_VERSION (lengths) failed");
    }

    # Read reported lengths (cap at 4096)
    var name_len = load64(ver + DRM_VER_NAME_LEN);
    var date_len = load64(ver + DRM_VER_DATE_LEN);
    var desc_len = load64(ver + DRM_VER_DESC_LEN);
    # Clamp low as well as high. These fields are __kernel_size_t (u64); read
    # back as i64 anything >= 2^63 reads negative, and `> 4096` does not catch
    # that — alloc(negative + 1) below would be handed a bogus size.
    if (name_len < 0) { name_len = 0; }
    if (date_len < 0) { date_len = 0; }
    if (desc_len < 0) { desc_len = 0; }
    if (name_len > 4096) { name_len = 4096; }
    if (date_len > 4096) { date_len = 4096; }
    if (desc_len > 4096) { desc_len = 4096; }

    # Allocate buffers
    var name_buf = alloc(name_len + 1);
    var date_buf = alloc(date_len + 1);
    var desc_buf = alloc(desc_len + 1);
    memset(name_buf, 0, name_len + 1);
    memset(date_buf, 0, date_len + 1);
    memset(desc_buf, 0, desc_len + 1);

    # Second call: fill buffers
    store64(ver + DRM_VER_NAME_LEN, name_len);
    store64(ver + DRM_VER_NAME_PTR, name_buf);
    store64(ver + DRM_VER_DATE_LEN, date_len);
    store64(ver + DRM_VER_DATE_PTR, date_buf);
    store64(ver + DRM_VER_DESC_LEN, desc_len);
    store64(ver + DRM_VER_DESC_PTR, desc_buf);

    ret = _drm_ioctl(fd, DRM_IOCTL_VERSION, ver);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "DRM_IOCTL_VERSION (fill) failed");
    }

    var major = load32(ver + DRM_VER_MAJOR);
    var minor = load32(ver + DRM_VER_MINOR);
    var patch = load32(ver + DRM_VER_PATCH);

    var info = drm_verinfo_new(major, minor, patch, name_buf, date_buf, desc_buf);
    return Ok(info);
    #endif
}

# ================================================================
# Query capability
# ================================================================

# 1 for the errnos that mean the driver has no such capability: EINVAL for one it does
# not know, EOPNOTSUPP for a KMS capability on a render-only driver.
fn _drm_cap_absent(errno): i64 {
    if (errno == EINVAL) { return 1; }
    if (errno == EOPNOTSUPP) { return 1; }
    return 0;
}

# Query a DRM capability value for an open device fd.
# cap: one of the DRM_CAP_* constants.
# Returns Result: Ok(value), Ok(0) if the driver has no such capability, or Err.
fn drm_get_capability(fd, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("DRM capability ioctl (no DRM subsystem)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # DrmGetCap struct: { capability: u64, value: u64 } = 16 bytes
    var getcap = alloc(16);
    store64(getcap, cap);
    store64(getcap + 8, 0);

    var ret = _drm_ioctl(fd, DRM_IOCTL_GET_CAP, getcap);
    if (ret < 0) {
        var errno = 0 - ret;
        if (_drm_cap_absent(errno) == 1) { return Ok(0); }
        return drm_err_syscall_failed(errno, "DRM_IOCTL_GET_CAP failed");
    }

    var value = load64(getcap + 8);
    return Ok(value);
    #endif
}

# Check if device supports dumb buffers.
# Returns Result: Ok(1) or Ok(0).
fn drm_supports_dumb_buffer(fd): i64 {
    var res_t, res_v = drm_get_capability(fd, DRM_CAP_DUMB_BUFFER);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    var val = res_v;
    if (val != 0) { return Ok(1); }
    return Ok(0);
}

# --- journald.cyr ---

# journald.cyr — systemd journal integration
# Ported from rust-old/src/journald.rs
#
# Send structured log messages to journald via AF_UNIX datagram socket,
# and query the journal via journalctl subprocess.
#
# Requires: lib/string.cyr, lib/str.cyr, lib/vec.cyr, lib/process.cyr,
#           lib/syscalls.cyr, lib/net.cyr, src/error.cyr
#
# All structs are bags of i64 fields accessed via store64/load64.
# Strings are Str (fat pointer: data + length) from lib/str.cyr.

# The journal socket is reached through the stdlib's per-target sys_socket /
# sys_sendto wrappers (lib/syscalls.cyr), which carry each target's own
# syscall number. This module used to inline the x86_64 numbers 41 / 44; on
# aarch64 44 is fstatfs, and it only worked once cyrius 6.6.5 began routing
# the x86 number (CHANGELOG 1.6.1). SOCK_DGRAM is lib/net.cyr's name;
# include-once, so includers pay nothing.
include "lib/syscalls.cyr"
include "lib/net.cyr"

# ================================================================
# Constants
# ================================================================

enum JournalConst {
    # AF_UNIX = 1 (the stdlib names AF_INET / AF_INET6 only)
    AF_UNIX = 1;
    # sockaddr_un: { family(2), path(108) } = 110 bytes
    SOCKADDR_UN_SIZE = 110;
    # A query's first capture, and the most it will hold before it refuses.
    JOURNAL_QUERY_CHUNK = 131072;
    JOURNAL_QUERY_MAX = 33554432;
    # How long journalctl may print nothing. A rare match in a large journal can be quiet
    # for a while, so this is generous. The stdlib then waits as long again before it kills.
    JOURNAL_QUERY_DEADLINE_MS = 60000;
    # The sealed-memfd path, which the stdlib does not name; see memfd_create(2), fcntl(2)
    # and cmsg(3). Both arches agree on all of them.
    JOURNAL_MFD_FLAGS = 3;          # MFD_CLOEXEC | MFD_ALLOW_SEALING
    JOURNAL_MFD_NOEXEC = 8;         # MFD_NOEXEC_SEAL, which a kernel before 6.3 refuses
    JOURNAL_F_ADD_SEALS = 1033;
    JOURNAL_SEALS = 15;             # F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE
    JOURNAL_SCM_RIGHTS = 1;
    JOURNAL_CMSG_LEN = 20;          # CMSG_LEN(sizeof(int))
    JOURNAL_CMSG_SPACE = 24;        # CMSG_SPACE(sizeof(int))
    JOURNAL_MSGHDR_SIZE = 56;
}

# Syslog priority levels
enum JournalPriority {
    JOURNAL_EMERG = 0;
    JOURNAL_ALERT = 1;
    JOURNAL_CRIT = 2;
    JOURNAL_ERR = 3;
    JOURNAL_WARNING = 4;
    JOURNAL_NOTICE = 5;
    JOURNAL_INFO = 6;
    JOURNAL_DEBUG = 7;
}

# ================================================================
# JournalEntry struct — 7 fields * 8 = 56 bytes.
# field_keys/field_vals are vec pointers; appended via the
# `add_field` helper (different name from derive's setters,
# no collision).
# ================================================================

#derive(accessors)
struct journald_entry {
    timestamp;
    unit;
    priority;
    message;
    pid;
    field_keys;
    field_vals;
}

fn journald_entry_new(timestamp, unit, priority, message, pid): i64 {
    var e = alloc(56);
    journald_entry_set_timestamp(e, timestamp);
    journald_entry_set_unit(e, unit);
    journald_entry_set_priority(e, priority);
    journald_entry_set_message(e, message);
    journald_entry_set_pid(e, pid);
    journald_entry_set_field_keys(e, vec_new());
    journald_entry_set_field_vals(e, vec_new());
    return e;
}

# Add an extra field (key-value pair) to a journal entry
fn journald_entry_add_field(e, key, val): i64 {
    vec_push(journald_entry_field_keys(e), key);
    vec_push(journald_entry_field_vals(e), val);
    return 0;
}

# ================================================================
# JournalFilter struct — 7 fields * 8 = 56 bytes.
# priority and lines use -1 as the unset sentinel.
# ================================================================

#derive(accessors)
struct journald_filter {
    unit;
    since;
    until;
    priority;
    grep;
    lines;
    boot;
}

fn journald_filter_new(): i64 {
    var f = alloc(56);
    journald_filter_set_unit(f, 0);
    journald_filter_set_since(f, 0);
    journald_filter_set_until(f, 0);
    journald_filter_set_priority(f, 0 - 1);   # unset
    journald_filter_set_grep(f, 0);
    journald_filter_set_lines(f, 0 - 1);      # unset
    journald_filter_set_boot(f, 0);
    return f;
}

# ================================================================
# Test seams, 0 outside tests/tcyr: a stub to run in place of /usr/bin/journalctl, and a
# socket to send to in place of the host's journal.
var _journald_tool = 0;
var _journald_socket = 0;

# Build journalctl argv vec
# ================================================================

# Build a vec of cstring args for an exec_vec / exec_capture invocation
# of journalctl. Each filter value lands in its OWN argv entry — no shell,
# no concatenation, no metacharacter expansion. Caller-controlled values
# (unit, grep, since, until, boot) are passed verbatim to journalctl as
# argv[i]; an attacker controlling those values cannot escape into the
# shell because there is no shell. See audit F-1 (2026-04-26).
#
# --unit, --since, --until, --priority and --grep take a required argument, so the next
# word is the value whatever it looks like. --boot takes an optional one, so it must be
# one word: as two, a value that does not parse as a boot id stays on the command line,
# where "--vacuum-time=1s" is an option and "_UID=0" a match (audit F-20). --lines is
# optional too, and only ever a formatted integer. --all keeps fields over 4096 bytes,
# which journalctl otherwise prints as null.
fn _journald_build_argv(filter): i64 {
    var args = vec_new();
    vec_push(args, "/usr/bin/journalctl");
    vec_push(args, "--output=json");
    vec_push(args, "--no-pager");
    vec_push(args, "--all");

    var unit = journald_filter_unit(filter);
    if (unit != 0) {
        vec_push(args, "--unit");
        vec_push(args, str_cstr(unit));
    }

    var since = journald_filter_since(filter);
    if (since != 0) {
        vec_push(args, "--since");
        vec_push(args, str_cstr(since));
    }

    var until = journald_filter_until(filter);
    if (until != 0) {
        vec_push(args, "--until");
        vec_push(args, str_cstr(until));
    }

    var prio = journald_filter_priority(filter);
    if (prio >= 0) {
        var pbuf = alloc(24);
        fmt_int_buf(prio, pbuf);
        vec_push(args, "--priority");
        vec_push(args, pbuf);
    }

    var grep = journald_filter_grep(filter);
    if (grep != 0) {
        vec_push(args, "--grep");
        vec_push(args, str_cstr(grep));
    }

    var lines = journald_filter_lines(filter);
    if (lines >= 0) {
        var lbuf = alloc(24);
        fmt_int_buf(lines, lbuf);
        vec_push(args, "--lines");
        vec_push(args, lbuf);
    }

    var boot = journald_filter_boot(filter);
    if (boot != 0) {
        var bsb = str_builder_new();
        str_builder_add_cstr(bsb, "--boot=");
        str_builder_add(bsb, boot);
        vec_push(args, str_cstr(str_builder_build(bsb)));
    }

    return args;
}

# ================================================================
# Send structured log message to journald via unix socket
# ================================================================

# Build a sockaddr_un pointing to /run/systemd/journal/socket.
# Returns pointer to the struct (110 bytes).
fn journald_make_sockaddr(): i64 {
    var sa = alloc(SOCKADDR_UN_SIZE);
    memset(sa, 0, SOCKADDR_UN_SIZE);
    store16(sa, AF_UNIX);  # sa_family = AF_UNIX
    # Copy socket path starting at offset 2
    var path = "/run/systemd/journal/socket";
    if (_journald_socket != 0) { path = _journald_socket; }
    var plen = strlen(path);
    if (plen > SOCKADDR_UN_SIZE - 3) { plen = SOCKADDR_UN_SIZE - 3; }
    memcpy(sa + 2, path, plen);
    return sa;
}

# The address, built once: a per-line alloc would grow the heap for as long as the
# process logs. Two threads racing here build the same bytes twice, which is harmless.
var _journald_sa = 0;

fn _journald_sockaddr(): i64 {
    if (_journald_sa == 0) { _journald_sa = journald_make_sockaddr(); }
    return _journald_sa;
}

# Copy `n` bytes to buf + pos unless `buf` is 0, which only measures. Returns the new pos.
fn _journald_put(buf, pos, data, n): i64 {
    if (buf != 0) { memcpy(buf + pos, data, n); }
    return pos + n;
}

# Append one field to a journal datagram. The native protocol is KEY=VALUE\n, so a
# value holding a newline would end its field there and the rest would parse as new
# fields: a message of "x\nPRIORITY=0\nSYSLOG_IDENTIFIER=sshd" could forge both
# (audit F-9). Such a value goes in the protocol's other form, which keeps it whole:
# KEY\n, its length as a little-endian u64, the bytes, \n. Returns the new pos.
fn _journald_put_field(buf, pos, key, value): i64 {
    var vlen = strlen(value);
    var newline = 0;
    var i = 0;
    while (i < vlen) {
        if (load8(value + i) == 10) {
            newline = 1;
            break;
        }
        i = i + 1;
    }
    pos = _journald_put(buf, pos, key, strlen(key));
    if (newline == 0) {
        pos = _journald_put(buf, pos, "=", 1);
    } else {
        pos = _journald_put(buf, pos, "\n", 1);
        if (buf != 0) { store64(buf + pos, vlen); }
        pos = pos + 8;
    }
    pos = _journald_put(buf, pos, value, vlen);
    return _journald_put(buf, pos, "\n", 1);
}

# 1 for a field name the journal accepts: 1-64 bytes of A-Z, 0-9 and _, not starting
# with a digit or with _ (those are trusted fields). journald drops anything else, and
# a name holding = or a newline would end up parsed as other fields (audit F-9). The
# base fields are refused too: a caller's extras must not restate a line's priority or
# identifier, which would log a second value beside the real one (audit F-46).
fn _journald_key_valid(key): i64 {
    if (key == 0) { return 0; }
    if (streq(key, "MESSAGE") == 1) { return 0; }
    if (streq(key, "PRIORITY") == 1) { return 0; }
    if (streq(key, "SYSLOG_IDENTIFIER") == 1) { return 0; }
    var n = strlen(key);
    if (n == 0) { return 0; }
    if (n > 64) { return 0; }
    var first = load8(key);
    if (first == 95) { return 0; }
    if (first >= 48) {
        if (first <= 57) { return 0; }
    }
    var i = 0;
    while (i < n) {
        var c = load8(key + i);
        var ok = 0;
        if (c >= 65) {
            if (c <= 90) { ok = 1; }
        }
        if (c >= 48) {
            if (c <= 57) { ok = 1; }
        }
        if (c == 95) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Lay out one datagram at `buf`: the base fields, then the extras whose names the journal
# would accept and that have a value. With `buf` 0 this only measures. Returns its length.
# fields_keys / fields_vals may be 0; a pair past the shorter vec is ignored.
fn _journald_layout(buf, message, priority, identifier, fields_keys, fields_vals): i64 {
    var pos = _journald_put(buf, 0, "PRIORITY=", 9);
    if (buf != 0) { store8(buf + pos, 48 + priority); }
    pos = _journald_put(buf, pos + 1, "\n", 1);
    pos = _journald_put_field(buf, pos, "MESSAGE", message);
    if (identifier != 0) {
        pos = _journald_put_field(buf, pos, "SYSLOG_IDENTIFIER", identifier);
    }
    if (fields_keys == 0) { return pos; }
    if (fields_vals == 0) { return pos; }
    var nfields = vec_len(fields_keys);
    if (vec_len(fields_vals) < nfields) { nfields = vec_len(fields_vals); }
    var fi = 0;
    while (fi < nfields) {
        var fkey = vec_get(fields_keys, fi);
        var fval = vec_get(fields_vals, fi);
        if (_journald_key_valid(fkey) == 1) {
            if (fval != 0) { pos = _journald_put_field(buf, pos, fkey, fval); }
        }
        fi = fi + 1;
    }
    return pos;
}

# 1 if a send failed because the entry would not fit, which is what sd_journal_sendv
# retries as a memfd. Anything else is a real failure.
fn _journald_too_big(ret): i64 {
    if (ret == (0 - EMSGSIZE)) { return 1; }
    if (ret == (0 - ENOBUFS)) { return 1; }
    return ret == (0 - EAGAIN);
}

#ifndef CYRIUS_TARGET_AGNOS
# Hand journald `len` bytes at `buf` as a sealed memfd, the protocol's form for an entry
# that does not fit a datagram: the same bytes, and a datagram holding nothing but the fd.
# All four seals, so journald can map it instead of copying it, and so nobody can change
# it under the mapping. With vm.memfd_noexec=2 a memfd has to ask for MFD_NOEXEC_SEAL, and
# a kernel before 6.3 refuses that flag, so it asks first and falls back.
# Returns 0 or above on success, or a negative errno.
fn _journald_send_memfd(sock, buf, len): i64 {
    var ctl[24];
    var msg[56];
    var mfd = sys_memfd_create("journal-data", JOURNAL_MFD_FLAGS | JOURNAL_MFD_NOEXEC);
    if (mfd == (0 - EINVAL)) { mfd = sys_memfd_create("journal-data", JOURNAL_MFD_FLAGS); }
    if (mfd < 0) { return mfd; }
    var ret = _agnodrm_write_all(mfd, buf, len);
    if (ret >= 0) { ret = sys_fcntl(mfd, JOURNAL_F_ADD_SEALS, JOURNAL_SEALS); }
    if (ret >= 0) {
        memset(&ctl, 0, JOURNAL_CMSG_SPACE);
        store64(&ctl, JOURNAL_CMSG_LEN);
        store32(&ctl + 8, SOL_SOCKET);
        store32(&ctl + 12, JOURNAL_SCM_RIGHTS);
        store32(&ctl + 16, mfd);
        memset(&msg, 0, JOURNAL_MSGHDR_SIZE);
        store64(&msg, _journald_sockaddr());
        store32(&msg + 8, SOCKADDR_UN_SIZE);
        store64(&msg + 32, &ctl);
        store64(&msg + 40, JOURNAL_CMSG_SPACE);
        ret = sys_sendmsg(sock, &msg, 0);
    }
    sys_close(mfd);
    return ret;
}
#endif

# Check, lay out and send one entry. The buffer is scratch: from alloc(), every line
# logged would stay in the heap for good, 442 MiB per million (audit F-40).
fn _journald_deliver(message, priority, identifier, fields_keys, fields_vals): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (message == 0) {
        return drm_err_invalid_argument("journal message cannot be null");
    }
    if (priority < 0) {
        return drm_err_invalid_argument("journal priority must be 0-7");
    }
    if (priority > 7) {
        return drm_err_invalid_argument("journal priority must be 0-7");
    }

    var len = _journald_layout(0, message, priority, identifier, fields_keys, fields_vals);
    var buf = _agnodrm_scratch_new(len);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for a journal datagram"); }
    _journald_layout(buf, message, priority, identifier, fields_keys, fields_vals);

    # Create AF_UNIX SOCK_DGRAM socket
    var fd = sys_socket(AF_UNIX, SOCK_DGRAM, 0);
    if (fd < 0) {
        _agnodrm_scratch_free(buf, len);
        return drm_err_syscall_failed(0 - fd, "failed to create unix socket");
    }

    # sendto(fd, buf, len, flags, dest_addr, addrlen)
    var ret = sys_sendto(fd, buf, len, 0, _journald_sockaddr(), SOCKADDR_UN_SIZE);
    if (_journald_too_big(ret) == 1) { ret = _journald_send_memfd(fd, buf, len); }
    sys_close(fd);
    _agnodrm_scratch_free(buf, len);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "send to journal socket failed");
    }

    return Ok(0);
    #endif
}

# Send a structured log message to the journald socket.
# message: C string — the log message text.
# priority: integer 0-7 (JOURNAL_EMERG through JOURNAL_DEBUG).
# identifier: C string — syslog identifier (e.g. "agnodrm").
#
# The journal native protocol uses newline-separated KEY=VALUE pairs
# sent as a single datagram to /run/systemd/journal/socket. A message too big for one
# datagram, about 212 KB, goes as a sealed memfd holding the same bytes. journald takes it
# or drops it without telling the sender: over its entry limit, Ok here means sent, not
# stored.
#
# Returns Result: Ok(0) on success, Err on failure.
fn journald_send(message, priority, identifier): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no systemd-journald AF_UNIX socket — it logs via sakshi, not
    # journald. The send path targets the Linux journal socket; not supported
    # on agnos. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _journald_deliver(message, priority, identifier, 0, 0);
    #endif
}

# Send a structured log with extra key-value fields.
# fields_keys: vec of C string pointers (field names).
# fields_vals: vec of C string pointers (field values).
# A field the journal would not accept, one restating a base field, or one with a null
# value is skipped.
# Returns Result: Ok(0) or Err.
fn journald_send_fields(message, priority, identifier, fields_keys, fields_vals): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no systemd-journald AF_UNIX socket — it logs via sakshi, not
    # journald. The send path targets the Linux journal socket; not supported
    # on agnos. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _journald_deliver(message, priority, identifier, fields_keys, fields_vals);
    #endif
}

# ================================================================
# Parse a single JSON line from journalctl --output=json
# ================================================================

# The end of the JSON string opening at `start`, the index of its closing quote, or
# `jlen` if it has none. A line ending in a lone backslash stops at jlen, not past it.
fn _journald_string_end(jd, jlen, start): i64 {
    var end = start + 1;
    while (end < jlen) {
        var c = load8(jd + end);
        if (c == 34) { return end; }
        if (c == 92) { end = end + 1; }
        end = end + 1;
    }
    return jlen;
}

# The value journalctl prints as an array, at `jd + pos`: bytes that are not valid UTF-8
# or hold a control character, as numbers, or a field the entry has more than once, as
# one element per value, of which the first is taken. Reading these as empty let a single
# ESC byte hide a line from whatever reads the log (audit F-47). Returns a Str, or 0.
fn _journald_array_value(jd, jlen, pos): i64 {
    var i = pos + 1;
    var depth = 0;
    while (i < jlen) {
        if (load8(jd + i) != 91) { break; }
        if (depth >= 1) { return 0; }
        depth = depth + 1;
        i = i + 1;
    }
    if (i >= jlen) { return 0; }
    var first = load8(jd + i);
    if (first == 34) {
        var end = _journald_string_end(jd, jlen, i);
        return _agnodrm_json_unescape(jd + i + 1, end - i - 1);
    }
    if (first < 48 || first > 57) { return 0; }
    var out = alloc(jlen - i + 1);
    var o = 0;
    var v = 0;
    while (i < jlen) {
        var c = load8(jd + i);
        i = i + 1;
        if (c >= 48 && c <= 57) {
            v = (v * 10 + (c - 48)) & 255;
            continue;
        }
        store8(out + o, v);
        o = o + 1;
        v = 0;
        if (c != 44) { break; }
    }
    store8(out + o, 0);
    return str_new(out, o);
}

# Minimal JSON field extraction: find a key in a JSON object string and return its value
# as a new Str, escapes decoded, or 0 if not found or null. This is a lightweight
# parser — handles the flat objects journalctl prints, one level of arrays included.
fn journald_json_get_str(json, key): i64 {
    # Search for "key" in the JSON
    var jlen = str_len(json);
    var jd = str_data(json);
    var klen = strlen(key);

    var pos = 0;
    while (pos < jlen - klen - 3) {
        # Look for "<key>"
        if (load8(jd + pos) == 34) {  # '"'
            if (memeq(jd + pos + 1, key, klen) == 1) {
                if (load8(jd + pos + 1 + klen) == 34) {  # closing '"'
                    # Found the key. Now find the value after ':'
                    var vpos = pos + 2 + klen;
                    # Skip whitespace and colon
                    while (vpos < jlen) {
                        var vc = load8(jd + vpos);
                        if (vc == 58) { vpos = vpos + 1; break; }  # ':'
                        if (vc == 32) { vpos = vpos + 1; continue; }
                        if (vc == 9) { vpos = vpos + 1; continue; }
                        break;
                    }
                    # Skip whitespace
                    while (vpos < jlen) {
                        var wc = load8(jd + vpos);
                        if (wc == 32) { vpos = vpos + 1; continue; }
                        if (wc == 9) { vpos = vpos + 1; continue; }
                        if (wc == 10) { vpos = vpos + 1; continue; }
                        break;
                    }
                    if (vpos < jlen) {
                        if (load8(jd + vpos) == 34) {
                            var vend = _journald_string_end(jd, jlen, vpos);
                            return _agnodrm_json_unescape(jd + vpos + 1, vend - vpos - 1);
                        }
                        if (load8(jd + vpos) == 91) {  # '['
                            return _journald_array_value(jd, jlen, vpos);
                        }
                    }
                }
            }
        }
        pos = pos + 1;
    }

    return 0;
}

# A journal PRIORITY field as a number, or JOURNAL_INFO for anything that is not 0-7:
# str_to_int reads "abc" as 0, which is an emergency.
fn _journald_priority_of(s): i64 {
    if (s == 0) { return JOURNAL_INFO; }
    if (str_len(s) != 1) { return JOURNAL_INFO; }
    var c = load8(str_data(s));
    if (c < 48 || c > 55) { return JOURNAL_INFO; }
    return c - 48;
}

# Parse a single JSON line from journalctl output into a JournalEntry.
# Returns Result: Ok(entry_ptr) or Err.
fn journald_parse_json(json_line): i64 {
    var jlen = str_len(json_line);
    if (jlen == 0) {
        return drm_err_invalid_argument("empty journal JSON line");
    }

    # Check it starts with open brace (ASCII 123)
    if (load8(str_data(json_line)) != 123) {
        return drm_err_invalid_argument("journal JSON is not an object");
    }

    # Extract known fields
    var ts_str = journald_json_get_str(json_line, "__REALTIME_TIMESTAMP");
    var timestamp = 0;
    if (ts_str != 0) {
        timestamp = str_to_int(ts_str);
    }

    var unit = journald_json_get_str(json_line, "_SYSTEMD_UNIT");
    if (unit == 0) { unit = str_from(""); }

    var priority = _journald_priority_of(journald_json_get_str(json_line, "PRIORITY"));

    var message = journald_json_get_str(json_line, "MESSAGE");
    if (message == 0) { message = str_from(""); }

    var pid_str = journald_json_get_str(json_line, "_PID");
    var pid = 0;
    if (pid_str != 0) {
        pid = str_to_int(pid_str);
    }

    var entry = journald_entry_new(timestamp, unit, priority, message, pid);
    return Ok(entry);
}

# ================================================================
# Query journal via journalctl subprocess
# ================================================================

# Parse `n` bytes of journalctl JSON lines into a vec of entries, every string a copy.
# A line that does not parse is left out.
fn _journald_parse_output(buf, n): i64 {
    var entries = vec_new();
    var pos = 0;
    while (pos < n) {
        var start = pos;
        while (pos < n) {
            if (load8(buf + pos) == 10) { break; }
            pos = pos + 1;
        }
        var len = pos - start;
        pos = pos + 1;
        if (len == 0) { continue; }
        var parse_res_t, parse_res_v = journald_parse_json(str_new(buf + start, len));
        if (is_ok(parse_res_t) == 1) {
            vec_push(entries, parse_res_v);
        }
    }
    return entries;
}

# Query the systemd journal using journalctl and parse JSON output.
# filter: JournalFilter pointer (from journald_filter_new).
# Returns Result: Ok(vec_of_entry_ptrs) or Err.
#
# Argv-based exec via lib/process.cyr: every filter value becomes its OWN argv entry. No
# shell. No metacharacter expansion. See _journald_build_argv for why --boot is one word,
# and SECURITY-NOTES.md § journald.
#
# The whole output is read or the call fails. Output that fills the buffer runs again
# with a larger one, up to JOURNAL_QUERY_MAX: a cut query kept the oldest entries and a
# last one made from half a line, and lost the newest, which is what "last N" is for
# (audit F-21). A query that big should set lines or since.
#
# A --grep pattern can run for as long as it likes, so journalctl gets a deadline. Silent for
# JOURNAL_QUERY_DEADLINE_MS, or for the process's own deadline if that is tighter, the call
# is an Err (ETIMEDOUT), even if journalctl would have finished a moment later. What it
# printed first is thrown away, like any capture that did not finish. The stdlib gives it
# as long again before killing it, so the caller waits up to twice the deadline. This
# measures silence, not total time, and restarts for each larger buffer, so output that
# trickles in is bounded by JOURNAL_QUERY_MAX instead. The process's deadline is put back.
fn journald_query(filter): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no journalctl subprocess and no systemd journal to query — the
    # journal is a Linux systemd facility; agnos records via sakshi. Not
    # supported here. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald query (no journalctl on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (filter == 0) { return drm_err_invalid_argument("journal filter is null"); }
    var args = _journald_build_argv(filter);
    if (_journald_tool != 0) { vec_set(args, 0, _journald_tool); }
    # Not agnodrm_run_capture: journalctl exits 1 when --grep matches nothing, which is
    # an empty result. Without --grep, 1 is bad input or a missing boot, so it fails, as
    # do a missing journalctl (127), a signal and an end never seen (negative). With
    # --grep, 1 cannot tell no match from a bad regex; those read as empty.
    # A full buffer proves nothing: the reader closed the pipe, so journalctl with more
    # to say dies of SIGPIPE. That capture is thrown away and run again.
    var status = alloc(16);
    var cap = JOURNAL_QUERY_CHUNK;
    while (cap <= JOURNAL_QUERY_MAX) {
        var buf = _agnodrm_scratch_new(cap);
        if (buf == 0) { return drm_err_io(ENOMEM, "no memory for journalctl output"); }
        var outer = _agnodrm_deadline_begin(JOURNAL_QUERY_DEADLINE_MS);
        var nbytes = exec_capture_status(args, buf, cap, status);
        _agnodrm_deadline_end(outer);
        if (load64(status) == (0 - 2)) {  # exec_capture_status's mark for a deadline kill
            _agnodrm_scratch_free(buf, cap);
            return drm_err_io(ETIMEDOUT, "journalctl ran past its deadline");
        }
        if (nbytes < 0) {
            _agnodrm_scratch_free(buf, cap);
            return drm_err_unknown("failed to execute journalctl");
        }
        if (nbytes < cap) {
            var code = load64(status);
            var failed = code != 0;
            if (code == 1) {
                if (journald_filter_grep(filter) != 0) { failed = 0; }
            }
            if (failed != 0) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_unknown("journalctl failed");
            }
            var entries = _journald_parse_output(buf, nbytes);
            _agnodrm_scratch_free(buf, cap);
            return Ok(entries);
        }
        _agnodrm_scratch_free(buf, cap);
        cap = cap * 4;
    }
    return drm_err_io(0, "journal query output is too large to read whole");
    #endif
}

# ================================================================
# Convenience: get last N log entries for a unit
# ================================================================

# Get the last `lines` journal entries for a specific systemd unit.
# unit_name: C string (e.g. "sshd.service").
# lines: number of entries to return.
# Returns Result: Ok(vec_of_entry_ptrs) or Err.
fn journald_get_unit_logs(unit_name, lines): i64 {
    if (unit_name == 0) {
        return drm_err_invalid_argument("unit name cannot be null");
    }
    if (strlen(unit_name) == 0) {
        return drm_err_invalid_argument("unit name cannot be empty");
    }

    var filter = journald_filter_new();
    journald_filter_set_unit(filter, str_from(unit_name));
    journald_filter_set_lines(filter, lines);

    return journald_query(filter);
}

# ================================================================
# Convenience: send info-level log
# ================================================================

# Send an info-level message to the journal.
# message: C string.
# Returns Result: Ok(0) or Err.
fn journald_info(message): i64 {
    return journald_send(message, JOURNAL_INFO, "agnodrm");
}

# Send a warning-level message to the journal.
fn journald_warning(message): i64 {
    return journald_send(message, JOURNAL_WARNING, "agnodrm");
}

# Send an error-level message to the journal.
fn journald_error(message): i64 {
    return journald_send(message, JOURNAL_ERR, "agnodrm");
}

# Send a debug-level message to the journal.
fn journald_debug(message): i64 {
    return journald_send(message, JOURNAL_DEBUG, "agnodrm");
}

# --- netns.cyr ---

# netns.cyr — per-agent network namespace management
# Ported from rust-old/src/netns.rs
#
# Creates isolated network namespaces with veth pairs for AGNOS agents.
# Shells out to `ip` (standard practice — avoids raw netlink).
# Firewall policy rendered as nftables rulesets.
#
# Requires: src/error.cyr, lib/syscalls.cyr, lib/process.cyr

# Included directly (as drm.cyr does) for the per-target O_* open flags;
# include-once, so includers pay nothing.
include "lib/syscalls.cyr"

# ================================================================
# Traffic direction / protocol / action constants
# ================================================================

enum TrafficDir {
    TRAFFIC_INBOUND = 1;
    TRAFFIC_OUTBOUND = 2;
}

enum NetProtocol {
    PROTO_TCP = 1;
    PROTO_UDP = 2;
    PROTO_ANY = 3;
}

enum FwAction {
    FW_ACCEPT = 1;
    FW_DROP = 2;
}

# ================================================================
# NetNamespaceConfig struct — 7 fields * 8 = 56 bytes.
# 3-arg `set_dns(c, dns_arr, dns_count)/3` keeps its name (different
# from derive's auto-generated `set_dns_arr/2` and `set_dns_count/2`)
# and delegates through the derive setters.
# ================================================================

#derive(accessors)
struct netns_config {
    name;
    agent_ip;
    host_ip;
    prefix_len;
    enable_nat;
    dns_arr;
    dns_count;
}

fn netns_config_new(name, agent_ip, host_ip, prefix_len, enable_nat): i64 {
    var c = alloc(56);
    netns_config_set_name(c, name);
    netns_config_set_agent_ip(c, agent_ip);
    netns_config_set_host_ip(c, host_ip);
    netns_config_set_prefix_len(c, prefix_len);
    netns_config_set_enable_nat(c, enable_nat);
    netns_config_set_dns_arr(c, 0);
    netns_config_set_dns_count(c, 0);
    return c;
}

fn netns_config_set_dns(c, dns_arr, dns_count): i64 {
    netns_config_set_dns_arr(c, dns_arr);
    netns_config_set_dns_count(c, dns_count);
    return 0;
}

# ================================================================
# NetNamespaceHandle struct — 4 fields * 8 = 32 bytes.
# ================================================================

#derive(accessors)
struct netns_handle { name; veth_host; veth_agent; netns_path; }

fn netns_handle_new(name, veth_host, veth_agent, netns_path): i64 {
    var h = alloc(32);
    netns_handle_set_name(h, name);
    netns_handle_set_veth_host(h, veth_host);
    netns_handle_set_veth_agent(h, veth_agent);
    netns_handle_set_netns_path(h, netns_path);
    return h;
}

# ================================================================
# FirewallRule struct — 6 fields * 8 = 48 bytes.
# ================================================================

#derive(accessors)
struct netns_fw_rule { direction; protocol; port; remote_addr; action; comment; }

fn netns_fw_rule_new(direction, protocol, port, remote_addr, action, comment): i64 {
    var r = alloc(48);
    netns_fw_rule_set_direction(r, direction);
    netns_fw_rule_set_protocol(r, protocol);
    netns_fw_rule_set_port(r, port);
    netns_fw_rule_set_remote_addr(r, remote_addr);
    netns_fw_rule_set_action(r, action);
    netns_fw_rule_set_comment(r, comment);
    return r;
}

# ================================================================
# FirewallPolicy struct — 4 fields * 8 = 32 bytes.
# Field names match 1.0 getters: `default_in`/`default_out` (not
# `default_inbound`/`default_outbound`). Field `rules_arr` dodges
# the 3-arg `netns_fw_policy_set_rules(p, rules_arr, count)/3`
# collision; the 1.0 `rules` getter and 3-arg setter stay as
# thin wrappers.
# ================================================================

#derive(accessors)
struct netns_fw_policy { default_in; default_out; rules_arr; rule_count; }

fn netns_fw_policy_new(default_in, default_out): i64 {
    var p = alloc(32);
    netns_fw_policy_set_default_in(p, default_in);
    netns_fw_policy_set_default_out(p, default_out);
    netns_fw_policy_set_rules_arr(p, 0);
    netns_fw_policy_set_rule_count(p, 0);
    return p;
}

# 1.0 API preservation
fn netns_fw_policy_rules(p): i64 { return netns_fw_policy_rules_arr(p); }
fn netns_fw_policy_set_rules(p, rules_arr, count): i64 {
    netns_fw_policy_set_rules_arr(p, rules_arr);
    netns_fw_policy_set_rule_count(p, count);
    return 0;
}

# ================================================================
# IP address generation from agent name hash
# ================================================================

# Simple hash function for agent name
fn netns_hash_name(name): i64 {
    var h = 5381;
    var i = 0;
    var len = strlen(name);
    while (i < len) {
        var c = load8(name + i);
        h = h * 33 + c;
        i = i + 1;
    }
    # Make positive. The most negative i64 negates to itself.
    if (h < 0) { h = 0 - h; }
    if (h < 0) { h = 0; }
    return h;
}

# "10.100.<third>.<last>" as a heap string.
fn _netns_ip4(third, last): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "10.100.");
    str_builder_add_int(sb, third);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, last);
    return str_cstr(str_builder_build(sb));
}

# Generate agent IPs. Returns a struct { host_ip, agent_ip }: the first two hosts of one
# of the 16384 /30 subnets in 10.100.0.0/16, chosen by a hash of the name. Through 1.7.1
# there were 255, and any 20 agents more likely than not shared one (audit F-45). A
# hash cannot rule that out and nothing here keeps a registry, so a caller running many
# agents must still check for a clash.
fn netns_generate_agent_ips(agent_name): i64 {
    var idx = netns_hash_name(agent_name) % 16384;
    var third = idx >> 6;
    var base = (idx & 63) * 4;
    var result = alloc(16);
    store64(result, _netns_ip4(third, base + 1));
    store64(result + 8, _netns_ip4(third, base + 2));
    return result;
}

# ================================================================
# Create convenience config for an agent
# ================================================================

fn netns_config_for_agent(name): i64 {
    var ips = netns_generate_agent_ips(name);
    var host_ip = load64(ips);
    var agent_ip = load64(ips + 8);
    return netns_config_new(name, agent_ip, host_ip, 30, 1);
}

# ================================================================
# Validate namespace config
# ================================================================

# 1 if `s` is a dotted-quad IPv4 address. A leading zero is refused: `ip` and `nft` read
# it as octal, so 010.0.0.1 is 8.0.0.1 to them, a rule on the wrong host.
fn _netns_ipv4_ok(s, n): i64 {
    var parts = 0;
    var digits = 0;
    var val = 0;
    var i = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(s + i); }
        if (c >= 48 && c <= 57) {
            if (digits > 0) {
                if (val == 0) { return 0; }
            }
            digits = digits + 1;
            if (digits > 3) { return 0; }
            val = val * 10 + (c - 48);
            if (val > 255) { return 0; }
        } else {
            if (i < n) {
                if (c != 46) { return 0; }
            }
            if (digits == 0) { return 0; }
            parts = parts + 1;
            digits = 0;
            val = 0;
        }
        i = i + 1;
    }
    return parts == 4;
}

# 1 if the `n` bytes at `s` are an IPv6 address: at most eight groups of 1-4 hex digits,
# exactly eight unless one "::" stands for the rest. Nothing else reaches ruleset text.
fn _netns_ipv6_ok(s, n): i64 {
    if (n < 2) { return 0; }
    if (n > 39) { return 0; }
    var groups = 0;
    var digits = 0;
    var compressed = 0;
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 58) {
            var had = digits;
            if (digits > 0) { groups = groups + 1; }
            digits = 0;
            var gap = 0;
            if (i + 1 < n) { gap = load8(s + i + 1) == 58; }
            if (gap == 1) {
                if (compressed == 1) { return 0; }
                compressed = 1;
                i = i + 1;
            } else {
                if (had == 0) { return 0; }        # a ':' with no group before it
                if (i + 1 >= n) { return 0; }      # a lone trailing ':'
            }
        } elif (agnodrm_is_hex_char(c) == 1) {
            digits = digits + 1;
            if (digits > 4) { return 0; }
        } else {
            return 0;
        }
        i = i + 1;
    }
    if (digits > 0) { groups = groups + 1; }
    if (compressed == 1) { return groups <= 7; }
    return groups == 8;
}

# What `addr` is: 4 for IPv4, 6 for IPv6, either with an optional /prefix; 0 for
# anything else. This is what stops a remote_addr holding nft syntax (audit F-19).
fn _netns_addr_family(addr): i64 {
    var n = strlen(addr);
    var hostlen = n;
    var i = 0;
    while (i < n) {
        if (load8(addr + i) == 47) {
            hostlen = i;
            break;
        }
        i = i + 1;
    }
    var family = 0;
    var maxprefix = 0;
    if (_netns_ipv4_ok(addr, hostlen) == 1) {
        family = 4;
        maxprefix = 32;
    } elif (_netns_ipv6_ok(addr, hostlen) == 1) {
        family = 6;
        maxprefix = 128;
    }
    if (family == 0) { return 0; }
    if (hostlen == n) { return family; }
    var plen = n - hostlen - 1;
    if (plen < 1) { return 0; }
    if (plen > 3) { return 0; }
    if (plen > 1) {
        if (load8(addr + hostlen + 1) == 48) { return 0; }  # octal to nft, as above
    }
    var val = 0;
    i = hostlen + 1;
    while (i < n) {
        var c = load8(addr + i);
        if (c < 48 || c > 57) { return 0; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    if (val > maxprefix) { return 0; }
    return family;
}

# Validate a namespace config. The name goes into `ip` arguments and an interface name,
# so it is held to letters, digits, '-' and '_', and cannot start with '-'. `ip` takes
# "%d" in an interface name as a template and picks a number, which left a link no
# cleanup could name. Both addresses must be IPv4: the /30 this module configures.
fn netns_validate_config(config): i64 {
    if (config == 0) { return drm_err_invalid_argument("namespace config is null"); }
    var name = netns_config_name(config);
    if (name == 0) { return drm_err_invalid_argument("namespace name is null"); }
    var nlen = strlen(name);
    if (nlen == 0) { return drm_err_invalid_argument("namespace name cannot be empty"); }
    if (nlen > 64) { return drm_err_invalid_argument("namespace name too long (max 64)"); }
    if (load8(name) == 45) { return drm_err_invalid_argument("namespace name cannot start with '-'"); }
    var ni = 0;
    while (ni < nlen) {
        if (agnodrm_is_name_char(load8(name + ni)) != 1) {
            return drm_err_invalid_argument("namespace name holds a character other than a-z, A-Z, 0-9, - or _");
        }
        ni = ni + 1;
    }

    var aip = netns_config_agent_ip(config);
    var hip = netns_config_host_ip(config);
    if (aip == 0) { return drm_err_invalid_argument("agent IP is null"); }
    if (hip == 0) { return drm_err_invalid_argument("host IP is null"); }
    if (strlen(aip) == 0) { return drm_err_invalid_argument("agent IP cannot be empty"); }
    if (strlen(hip) == 0) { return drm_err_invalid_argument("host IP cannot be empty"); }
    if (_netns_ipv4_ok(aip, strlen(aip)) != 1) { return drm_err_invalid_argument("agent IP is not an IPv4 address"); }
    if (_netns_ipv4_ok(hip, strlen(hip)) != 1) { return drm_err_invalid_argument("host IP is not an IPv4 address"); }

    var plen = netns_config_prefix_len(config);
    # `< 1` (not `== 0`): a negative prefix_len passed both old checks, and
    # netns_create_agent_netns formatted it into a 4-byte scratch, which a large
    # negative value overran.
    if (plen < 1) { return drm_err_invalid_argument("invalid prefix length: < 1"); }
    if (plen > 32) { return drm_err_invalid_argument("invalid prefix length: > 32"); }

    return Ok(0);
}

# ================================================================
# Truncate veth name to 15 chars (Linux max)
# ================================================================

# One end of an agent's veth pair: `veth-<name><tail>` when that fits in 15 bytes, or
# `veth-<8 hex of a hash of the name><tail>` when it does not. Truncating cut the tail
# off, so both ends of a name of 9 or more bytes were the same name and `ip link add`
# refused every one (audit F-22).
fn _netns_veth_name(name, tail): i64 {
    var plain = netns_concat3("veth-", name, tail);
    if (strlen(plain) <= 15) { return plain; }
    var h = netns_hash_name(name) & 0xFFFFFFFF;
    var hex = alloc(9);
    var i = 0;
    while (i < 8) {
        var d = (h >> ((7 - i) * 4)) & 15;
        if (d < 10) { store8(hex + i, 48 + d); }
        else { store8(hex + i, 87 + d); }
        i = i + 1;
    }
    store8(hex + 8, 0);
    return netns_concat3("veth-", hex, tail);
}

# Cut a name to fit IFNAMSIZ. The library no longer uses this: _netns_veth_name hashes a
# long name, so two that share a start stay distinct.
#deprecated("the library names veths with a hash; removed in agnodrm 2.0.0")
fn netns_truncate_veth(base): i64 {
    var len = strlen(base);
    if (len <= 15) {
        var out = alloc(len + 1);
        memcpy(out, base, len);
        store8(out + len, 0);
        return out;
    }
    var out = alloc(16);
    memcpy(out, base, 15);
    store8(out + 15, 0);
    return out;
}

# ================================================================
# Helper: run ip command
# ================================================================

# Run an `ip` command. `args` is a vec of cstr argv; element 0 is the
# absolute command path. exec_vec builds a NULL-terminated argv and
# execve's it directly. (The old run_capture/_exec3 path only supported
# cmd + 2 args and passed the whole argv array as a single argument, so
# `ip netns add <name>` never reached `ip`; execve also needs an absolute
# path, not a bare "ip".)
#
# _netns_ip_path is a test seam, 0 outside tests/tcyr: a stub to run in place of
# /usr/sbin/ip, so a test can make a chosen step fail. Nothing but a test sets it.
var _netns_ip_path = 0;
var _netns_run_dir = 0;

fn netns_run_ip(args): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("network namespaces (ip command)");  # agnos: no netns
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_netns_ip_path != 0) { vec_set(args, 0, _netns_ip_path); }
    var rc = _agnodrm_exec_within(args, AGNODRM_TOOL_DEADLINE_MS);
    if (rc == (0 - 2)) { return drm_err_io(ETIMEDOUT, "ip command ran past its deadline"); }
    if (rc != 0) { return drm_err_io(0, "ip command failed"); }
    return Ok(0);
    #endif
}

# ================================================================
# Build a string by concatenating parts
# ================================================================

fn netns_concat2(a, b): i64 {
    var alen = strlen(a);
    var blen = strlen(b);
    var out = alloc(alen + blen + 1);
    memcpy(out, a, alen);
    memcpy(out + alen, b, blen);
    store8(out + alen + blen, 0);
    return out;
}

fn netns_concat3(a, b, c): i64 {
    var ab = netns_concat2(a, b);
    return netns_concat2(ab, c);
}

# ================================================================
# Create agent network namespace
# ================================================================

# Remove what netns_create_agent_netns made: the host veth, whose peer goes with it,
# then the namespace. Best effort: this runs after a failure, whose Err is returned.
fn _netns_undo_create(veth_host, ns_name): i64 {
    var cl1 = vec_new();
    vec_push(cl1, "/usr/sbin/ip"); vec_push(cl1, "link");
    vec_push(cl1, "delete"); vec_push(cl1, veth_host);
    netns_run_ip(cl1);
    var cl2 = vec_new();
    vec_push(cl2, "/usr/sbin/ip"); vec_push(cl2, "netns");
    vec_push(cl2, "delete"); vec_push(cl2, ns_name);
    netns_run_ip(cl2);
    return 0;
}

# Run one configuration step. A step that fails undoes the create, so a caller never
# holds a handle to a namespace with no address, no route or a link left down.
fn _netns_setup_step(args, veth_host, ns_name): i64 {
    var res_t, res_v = netns_run_ip(args);
    if (is_err_result(res_t) == 1) {
        _netns_undo_create(veth_host, ns_name);
        return Err(res_v);
    }
    return Ok(0);
}

# Create a network namespace for an agent with veth pair and IP configuration.
# Returns Result: Ok(handle_ptr) or Err.
fn netns_create_agent_netns(config): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("network namespace creation");  # agnos: no netns
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var vres_t, vres_v = netns_validate_config(config);
    if (is_err_result(vres_t) == 1) { return Err(vres_v); }

    var name = netns_config_name(config);
    var ns_name = netns_concat2("agnos-agent-", name);
    var veth_host = _netns_veth_name(name, "-h");
    var veth_agent = _netns_veth_name(name, "-a");

    # 1. Create namespace: ip netns add <ns_name>
    var args1 = vec_new();
    vec_push(args1, "/usr/sbin/ip"); vec_push(args1, "netns");
    vec_push(args1, "add"); vec_push(args1, ns_name);
    var res1_t, res1_v = netns_run_ip(args1);
    if (is_err_result(res1_t) == 1) { return Err(res1_v); }

    # 2. Create veth pair: ip link add <host> type veth peer name <agent>
    var args2 = vec_new();
    vec_push(args2, "/usr/sbin/ip"); vec_push(args2, "link"); vec_push(args2, "add");
    vec_push(args2, veth_host); vec_push(args2, "type"); vec_push(args2, "veth");
    vec_push(args2, "peer"); vec_push(args2, "name"); vec_push(args2, veth_agent);
    var res2_t, res2_v = netns_run_ip(args2);
    if (is_err_result(res2_t) == 1) {
        # Cleanup namespace
        var cleanup = vec_new();
        vec_push(cleanup, "/usr/sbin/ip"); vec_push(cleanup, "netns");
        vec_push(cleanup, "delete"); vec_push(cleanup, ns_name);
        netns_run_ip(cleanup);
        return Err(res2_v);
    }

    # 3. Move agent veth into namespace: ip link set <agent> netns <ns>
    var args3 = vec_new();
    vec_push(args3, "/usr/sbin/ip"); vec_push(args3, "link"); vec_push(args3, "set");
    vec_push(args3, veth_agent); vec_push(args3, "netns"); vec_push(args3, ns_name);
    var res3_t, res3_v = netns_run_ip(args3);
    if (is_err_result(res3_t) == 1) {
        _netns_undo_create(veth_host, ns_name);
        return Err(res3_v);
    }

    # 4. Assign IPs
    var plen_str = alloc(24);  # 24, not a digit count: see agnodrm_tmp_create
    var plen_slen = fmt_int_buf(netns_config_prefix_len(config), plen_str);
    store8(plen_str + plen_slen, 0);

    var host_cidr = netns_concat3(netns_config_host_ip(config), "/", plen_str);
    var agent_cidr = netns_concat3(netns_config_agent_ip(config), "/", plen_str);

    # ip addr add <host_cidr> dev <veth_host>
    var args4 = vec_new();
    vec_push(args4, "/usr/sbin/ip"); vec_push(args4, "addr"); vec_push(args4, "add");
    vec_push(args4, host_cidr); vec_push(args4, "dev"); vec_push(args4, veth_host);
    var res4_t, res4_v = _netns_setup_step(args4, veth_host, ns_name);
    if (is_err_result(res4_t) == 1) { return Err(res4_v); }

    # ip netns exec <ns> ip addr add <agent_cidr> dev <agent>
    # The inner `ip` is absolute too: exec_vec passes an empty environment, so
    # `ip netns exec` would look it up on the libc default path alone.
    var args5 = vec_new();
    vec_push(args5, "/usr/sbin/ip"); vec_push(args5, "netns"); vec_push(args5, "exec"); vec_push(args5, ns_name);
    vec_push(args5, "/usr/sbin/ip"); vec_push(args5, "addr"); vec_push(args5, "add"); vec_push(args5, agent_cidr);
    vec_push(args5, "dev"); vec_push(args5, veth_agent);
    var res5_t, res5_v = _netns_setup_step(args5, veth_host, ns_name);
    if (is_err_result(res5_t) == 1) { return Err(res5_v); }

    # 5. Bring interfaces up
    var args6 = vec_new();
    vec_push(args6, "/usr/sbin/ip"); vec_push(args6, "link"); vec_push(args6, "set");
    vec_push(args6, veth_host); vec_push(args6, "up");
    var res6_t, res6_v = _netns_setup_step(args6, veth_host, ns_name);
    if (is_err_result(res6_t) == 1) { return Err(res6_v); }

    # Bring up agent side in namespace
    var args7 = vec_new();
    vec_push(args7, "/usr/sbin/ip"); vec_push(args7, "netns"); vec_push(args7, "exec"); vec_push(args7, ns_name);
    vec_push(args7, "/usr/sbin/ip"); vec_push(args7, "link"); vec_push(args7, "set"); vec_push(args7, veth_agent);
    vec_push(args7, "up");
    var res7_t, res7_v = _netns_setup_step(args7, veth_host, ns_name);
    if (is_err_result(res7_t) == 1) { return Err(res7_v); }

    # Bring up loopback in namespace
    var args8 = vec_new();
    vec_push(args8, "/usr/sbin/ip"); vec_push(args8, "netns"); vec_push(args8, "exec"); vec_push(args8, ns_name);
    vec_push(args8, "/usr/sbin/ip"); vec_push(args8, "link"); vec_push(args8, "set"); vec_push(args8, "lo");
    vec_push(args8, "up");
    var res8_t, res8_v = _netns_setup_step(args8, veth_host, ns_name);
    if (is_err_result(res8_t) == 1) { return Err(res8_v); }

    # Set default route inside namespace
    var args9 = vec_new();
    vec_push(args9, "/usr/sbin/ip"); vec_push(args9, "netns"); vec_push(args9, "exec"); vec_push(args9, ns_name);
    vec_push(args9, "/usr/sbin/ip"); vec_push(args9, "route"); vec_push(args9, "add"); vec_push(args9, "default");
    vec_push(args9, "via"); vec_push(args9, netns_config_host_ip(config));
    var res9_t, res9_v = _netns_setup_step(args9, veth_host, ns_name);
    if (is_err_result(res9_t) == 1) { return Err(res9_v); }

    # Build netns path
    var netns_path = netns_concat2("/var/run/netns/", ns_name);

    var handle = netns_handle_new(ns_name, veth_host, veth_agent, netns_path);
    return Ok(handle);
    #endif
}

# ================================================================
# Destroy agent network namespace
# ================================================================

fn netns_destroy_agent_netns(handle): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("network namespace destruction");  # agnos: no netns
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (handle == 0) { return drm_err_invalid_argument("namespace handle is null"); }
    var veth_host = netns_handle_veth_host(handle);
    var ns_name = netns_handle_name(handle);

    # Delete host-side veth (peer is auto-deleted)
    var args1 = vec_new();
    vec_push(args1, "/usr/sbin/ip"); vec_push(args1, "link");
    vec_push(args1, "delete"); vec_push(args1, veth_host);
    netns_run_ip(args1);

    # Delete namespace
    var args2 = vec_new();
    vec_push(args2, "/usr/sbin/ip"); vec_push(args2, "netns");
    vec_push(args2, "delete"); vec_push(args2, ns_name);
    return netns_run_ip(args2);
    #endif
}

# ================================================================
# Render nftables ruleset from FirewallPolicy
# ================================================================

# Append to a fixed 16 KiB buffer, silently dropping what does not fit. The renderer no
# longer uses this: a firewall must not lose rules to a buffer (audit F-43).
#deprecated("the renderer uses a str_builder; removed in agnodrm 2.0.0")
fn netns_nft_append(buf, pos, str): i64 {
    var len = strlen(str);
    if (pos + len >= 16384) { return pos; }
    memcpy(buf + pos, str, len);
    return pos + len;
}

fn netns_nft_action_str(action): i64 {
    if (action == FW_ACCEPT) { return "accept"; }
    return "drop";
}

fn netns_nft_proto_str(proto): i64 {
    if (proto == PROTO_TCP) { return "tcp"; }
    if (proto == PROTO_UDP) { return "udp"; }
    return 0;
}

enum NetnsNftLimits {
    NFT_COMMENT_MAX = 128;   # NFT_USERDATA_MAXLEN
}

# 1 if a rule comment can sit inside nft's double quotes: printable ASCII, no quote or
# backslash, within nft's own limit. Anything else could close the string and add rules.
fn _netns_comment_ok(comment): i64 {
    if (comment == 0) { return 1; }
    var n = strlen(comment);
    if (n > NFT_COMMENT_MAX) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(comment + i);
        if (c < 32 || c > 126 || c == 34 || c == 92) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Check one rule. Returns Result: Ok(0) or Err.
fn _netns_rule_validate(rule): i64 {
    if (rule == 0) { return drm_err_invalid_argument("firewall rule is null"); }
    var dir = netns_fw_rule_direction(rule);
    if (dir != TRAFFIC_INBOUND) {
        if (dir != TRAFFIC_OUTBOUND) { return drm_err_invalid_argument("firewall rule has no direction"); }
    }
    var action = netns_fw_rule_action(rule);
    if (action != FW_ACCEPT) {
        if (action != FW_DROP) { return drm_err_invalid_argument("firewall rule has no action"); }
    }
    var proto = netns_fw_rule_protocol(rule);
    var port = netns_fw_rule_port(rule);
    if (proto != PROTO_TCP) { if (proto != PROTO_UDP) { if (proto != PROTO_ANY) {
                return drm_err_invalid_argument("firewall rule has an unknown protocol");
            } } }
    if (port < 0 || port > 65535) {
        return drm_err_invalid_argument("firewall rule port is out of range");
    }
    if (port != 0) {
        if (proto == PROTO_ANY) { return drm_err_invalid_argument("firewall rule has a port and no protocol"); }
    }
    var raddr = netns_fw_rule_remote_addr(rule);
    if (raddr != 0) {
        if (strlen(raddr) > 0) {
            if (_netns_addr_family(raddr) == 0) {
                return drm_err_invalid_argument("firewall rule remote_addr is not an address");
            }
        }
    }
    if (_netns_comment_ok(netns_fw_rule_comment(rule)) != 1) {
        return drm_err_invalid_argument("firewall rule comment holds a quote, backslash or control byte");
    }
    return Ok(0);
}

# Check that every rule of a policy can be rendered as written, before anything acts on
# it. A rule that cannot be expressed is an error, not a line to leave out: under a
# default accept, a DROP that vanishes is a hole (audit F-18, F-19).
# Returns Result: Ok(0) or Err naming the first problem.
fn netns_fw_policy_validate(policy): i64 {
    if (policy == 0) { return drm_err_invalid_argument("firewall policy is null"); }
    var count = netns_fw_policy_rule_count(policy);
    var rules = netns_fw_policy_rules(policy);
    if (_agnodrm_out_ok(rules, count) != 1) {
        return drm_err_invalid_argument("firewall rules are null or the count is negative");
    }
    var i = 0;
    while (i < count) {
        var res_t, res_v = _netns_rule_validate(load64(rules + i * 8));
        if (is_err_result(res_t) == 1) { return Err(res_v); }
        i = i + 1;
    }
    return Ok(0);
}

# Render one rule as a single line: everything it names must match together. Through
# 1.7.1 a port and an address became two independent rules, so "ssh from the bastion"
# opened 22 to everyone and every port to the bastion (audit F-18). `dir_word` is saddr
# or daddr. A rule that names nothing matches everything.
fn _netns_render_rule(sb, rule, dir_word): i64 {
    str_builder_add_cstr(sb, "    ");
    var raddr = netns_fw_rule_remote_addr(rule);
    if (raddr != 0) {
        if (strlen(raddr) > 0) {
            if (_netns_addr_family(raddr) == 6) { str_builder_add_cstr(sb, "ip6 "); }
            else { str_builder_add_cstr(sb, "ip "); }
            str_builder_add_cstr(sb, dir_word);
            str_builder_add_cstr(sb, " ");
            str_builder_add_cstr(sb, raddr);
            str_builder_add_cstr(sb, " ");
        }
    }
    var proto = netns_nft_proto_str(netns_fw_rule_protocol(rule));
    var port = netns_fw_rule_port(rule);
    if (proto != 0) {
        if (port != 0) {
            str_builder_add_cstr(sb, proto);
            str_builder_add_cstr(sb, " dport ");
            str_builder_add_int(sb, port);
            str_builder_add_cstr(sb, " ");
        } else {
            str_builder_add_cstr(sb, "meta l4proto ");
            str_builder_add_cstr(sb, proto);
            str_builder_add_cstr(sb, " ");
        }
    }
    str_builder_add_cstr(sb, netns_nft_action_str(netns_fw_rule_action(rule)));
    var comment = netns_fw_rule_comment(rule);
    if (comment != 0) {
        if (strlen(comment) > 0) {
            str_builder_add_cstr(sb, " comment \"");
            str_builder_add_cstr(sb, comment);
            str_builder_add_cstr(sb, "\"");
        }
    }
    str_builder_add_cstr(sb, "\n");
    return 0;
}

# Render the base chain of one direction, and its rules.
fn _netns_render_chain(sb, policy, direction): i64 {
    var chain = "output";
    var default_action = netns_fw_policy_default_out(policy);
    var lo_word = "oif";
    var dir_word = "daddr";
    if (direction == TRAFFIC_INBOUND) {
        chain = "input";
        default_action = netns_fw_policy_default_in(policy);
        lo_word = "iif";
        dir_word = "saddr";
    }
    str_builder_add_cstr(sb, "  chain ");
    str_builder_add_cstr(sb, chain);
    str_builder_add_cstr(sb, " { type filter hook ");
    str_builder_add_cstr(sb, chain);
    str_builder_add_cstr(sb, " priority 0; policy ");
    str_builder_add_cstr(sb, netns_nft_action_str(default_action));
    str_builder_add_cstr(sb, ";\n");
    str_builder_add_cstr(sb, "    ct state established,related accept\n");
    str_builder_add_cstr(sb, "    ");
    str_builder_add_cstr(sb, lo_word);
    str_builder_add_cstr(sb, " lo accept\n");

    var rules = netns_fw_policy_rules(policy);
    var count = netns_fw_policy_rule_count(policy);
    var i = 0;
    while (i < count) {
        var rule = load64(rules + i * 8);
        if (netns_fw_rule_direction(rule) == direction) {
            _netns_render_rule(sb, rule, dir_word);
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "  }\n");
    return 0;
}

# Render a FirewallPolicy into an nftables ruleset string.
# Returns a heap-allocated null-terminated string, or 0 if netns_fw_policy_validate
# refuses the policy; that call says why.
#
# The ruleset replaces the table: declaring it first makes the delete safe on a first
# apply, and `nft -f` runs the file as one transaction. Without that a second apply
# merges, so a tightened policy keeps its old accepts (audit F-24).
fn netns_render_nftables_ruleset(policy): i64 {
    var chk_t, chk_v = netns_fw_policy_validate(policy);
    if (is_err_result(chk_t) == 1) { return 0; }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet kavach\n");
    str_builder_add_cstr(sb, "delete table inet kavach\n");
    str_builder_add_cstr(sb, "table inet kavach {\n");
    _netns_render_chain(sb, policy, TRAFFIC_INBOUND);
    _netns_render_chain(sb, policy, TRAFFIC_OUTBOUND);
    str_builder_add_cstr(sb, "}\n");
    return str_cstr(str_builder_build(sb));
}

# ================================================================
# Apply nftables ruleset to a namespace
# ================================================================

# Apply a pre-rendered nftables ruleset inside the namespace.
# ruleset: null-terminated nftables script string.
# Returns Result.
fn netns_apply_nftables_ruleset(handle, ruleset): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("nftables ruleset in network namespace");  # agnos: no netns/nft
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (handle == 0) { return drm_err_invalid_argument("namespace handle is null"); }
    if (ruleset == 0) { return drm_err_invalid_argument("nft ruleset is null"); }
    var ns_name = netns_handle_name(handle);

    # kybernet makes this 0755, and other services read it, so that is the mode here. A
    # directory anyone else can write to is refused, by its mode or by owning it: the
    # ruleset sits there, closed, until nft reads it. Test seam: _netns_run_dir, 0 outside
    # tests/tcyr.
    var run_dir = "/run/agnos";
    if (_netns_run_dir != 0) { run_dir = _netns_run_dir; }
    xmkdir(run_dir, 0x1ED);  # mode 0755; a failure shows at the temp below
    var run_st = alloc(STAT_BUFSZ);
    if (xstat(run_dir, run_st) == 0) {
        var run_uid = load32(run_st + STAT_UID);
        if ((load32(run_st + STAT_MODE) & 0x12) != 0) {
            return drm_err_invalid_argument("nft run directory is writable by others");
        }
        if (run_uid != 0) {
            if (run_uid != sys_geteuid()) {
                return drm_err_invalid_argument("nft run directory belongs to another user");
            }
        }
    }

    # Write ruleset to an exclusive temp; see agnodrm_tmp_create.
    var tmp_path = 0;
    var fd = agnodrm_tmp_create(netns_concat2(run_dir, "/nft"), &tmp_path);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to create nft temp file");
    }
    # A short or failed write would hand nft a truncated ruleset, silently
    # dropping rules, so it fails the call instead of being applied.
    var wrote = _agnodrm_write_all(fd, ruleset, strlen(ruleset));
    sys_close(fd);
    if (wrote < 0) {
        sys_unlink(tmp_path);
        return drm_err_io(0 - wrote, "failed to write nft temp file");
    }

    # ip netns exec <ns> nft -f <path>
    # The inner `nft` is absolute, as the inner `ip` is above.
    var nft_args = vec_new();
    vec_push(nft_args, "/usr/sbin/ip"); vec_push(nft_args, "netns"); vec_push(nft_args, "exec");
    vec_push(nft_args, ns_name); vec_push(nft_args, "/usr/sbin/nft"); vec_push(nft_args, "-f");
    vec_push(nft_args, tmp_path);

    var run_t, run_v = netns_run_ip(nft_args);
    sys_unlink(tmp_path);
    if (is_err_result(run_t) == 1) { return Err(run_v); }
    return Ok(run_v);
    #endif
}

# --- bootloader.cyr ---

# bootloader.cyr — bootloader detection and boot entry management
# Ported from rust-old/src/bootloader.rs
#
# Supports systemd-boot and GRUB2. Auto-detects which bootloader is
# installed by probing well-known paths. Parses boot entries and
# validates kernel command-line parameters.
#
# Requires: src/error.cyr, src/util.cyr, lib/syscalls.cyr, lib/process.cyr,
# lib/hashmap.cyr, lib/fs.cyr, lib/io.cyr

# Included directly (as drm.cyr does) for the per-target O_* symbols
# bootloader_detect opens with; include-once, so includers pay nothing.
include "lib/syscalls.cyr"
# The loader-entries fallback walks a directory and reads files through the
# portable stdlib helpers — dir_list / path_join / path_has_ext (lib/fs.cyr),
# file_open / file_read_all / xstat (lib/io.cyr) — never raw syscalls.
# Included here so every includer of this module links them.
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
# As drm.cyr does: the drm_err_* constructors return a Result pair, and a
# standalone `cyrius check` that cannot see them misreads every
# `return drm_err_*(...)` as a dropped tag. `cyrius distlib` strips src/
# includes, so the bundle is unaffected.

# ================================================================
# Bootloader type constants
# ================================================================

enum BootloaderType {
    BOOT_SYSTEMD_BOOT = 1;
    BOOT_GRUB2 = 2;
    BOOT_UNKNOWN = 3;
}

# What an entry boots. See bootloader_entry_boot_kind.
enum BootEntryKind {
    BOOT_ENTRY_NONE = 0;
    BOOT_ENTRY_LINUX = 1;
    BOOT_ENTRY_EFI = 2;
    BOOT_ENTRY_UKI = 3;
    BOOT_ENTRY_UKI_URL = 4;
    BOOT_ENTRY_CONFLICT = 5;
}

# ================================================================
# Well-known paths
# ================================================================

# Checked as static strings in the detect function:
# /boot/efi/EFI/systemd  -> systemd-boot
# /boot/grub/grub.cfg    -> GRUB2
# /boot/loader/loader.conf  -> systemd-boot loader config
# /boot/loader/entries/  -> systemd-boot entries dir

# ================================================================
# BootEntry struct
# 11 fields * 8 = 88 bytes. Accessors auto-generated.
# ================================================================

#derive(accessors)
struct bootloader_entry { id; title; linux; initrd; options; is_default; version; efi; uki; uki_url; extra; }

fn bootloader_entry_new(): i64 {
    var e = alloc(88);
    memset(e, 0, 88);
    return e;
}

# What an entry names to boot, by systemd-boot's rule: exactly one of linux, efi, uki and
# uki-url. Two of them, in either order, and it drops the entry, though bootctl still
# lists it. For an entry file, none means it drops that too. A kind is not a promise that
# it boots: systemd-boot also drops an entry for a missing file or another architecture.
#
# What a clean bootloader_validate_kernel_cmdline on `options` proves depends on the kind,
# and `options` is worth validating for all of them:
#   BOOT_ENTRY_LINUX    `options` is the kernel's command line.
#   BOOT_ENTRY_UKI      `options` replaces the image's own command line unless Secure Boot
#   BOOT_ENTRY_UKI_URL  is on and the image has one. Then the image's own applies, and
#                       nothing here can read that, so the check covers one of two lines.
#   BOOT_ENTRY_EFI      The program does what it likes with them.
#
# From bootloader_parse_bootctl_list, BOOT_ENTRY_NONE says only that bootctl showed no boot
# key. Automatic entries look like that, and so does a file bootctl could not load, and
# those can boot. A 0 entry is BOOT_ENTRY_NONE.
fn bootloader_entry_boot_kind(e): i64 {
    if (e == 0) { return BOOT_ENTRY_NONE; }
    var kind = BOOT_ENTRY_NONE;
    var seen = 0;
    if (bootloader_entry_linux(e) != 0) {
        kind = BOOT_ENTRY_LINUX;
        seen = seen + 1;
    }
    if (bootloader_entry_efi(e) != 0) {
        kind = BOOT_ENTRY_EFI;
        seen = seen + 1;
    }
    if (bootloader_entry_uki(e) != 0) {
        kind = BOOT_ENTRY_UKI;
        seen = seen + 1;
    }
    if (bootloader_entry_uki_url(e) != 0) {
        kind = BOOT_ENTRY_UKI_URL;
        seen = seen + 1;
    }
    if (seen > 1) { return BOOT_ENTRY_CONFLICT; }
    return kind;
}

# ================================================================
# BootConfig struct
# 5 fields * 8 = 40 bytes. Accessors auto-generated except for the
# entries pair: the 1.0 surface ships a 3-arg
# `bootloader_config_set_entries(c, arr, count)` convenience setter
# that writes both the array pointer and the count atomically; that
# would collide with derive's auto-generated 2-arg
# `bootloader_config_set_entries(c, v)`. So the array-pointer field
# is named `entries_arr` (matching the original layout doc); the
# 1.0 `entries` getter and 3-arg `set_entries` stay as thin
# wrappers that delegate through the derive accessors.
# ================================================================

#derive(accessors)
struct bootloader_config { type; timeout; default_id; entries_arr; entry_count; }

fn bootloader_config_new(): i64 {
    var c = alloc(40);
    memset(c, 0, 40);
    return c;
}

# 1.0 API preservation — `entries` getter + 3-arg `set_entries`
# delegate through the derive-generated `entries_arr` accessors.
fn bootloader_config_entries(c): i64 { return bootloader_config_entries_arr(c); }
fn bootloader_config_set_entries(c, arr, count): i64 {
    bootloader_config_set_entries_arr(c, arr);
    bootloader_config_set_entry_count(c, count);
    return 0;
}

# ================================================================
# Bootloader detection
# ================================================================

# Test seam, 0 outside tests/tcyr: the directory the fixed /boot and /efi paths resolve
# under, so a test can stand up a boot tree without touching this host's.
var _bootloader_root = 0;

fn _bootloader_path(path): i64 {
    if (_bootloader_root == 0) { return path; }
    var rootlen = strlen(_bootloader_root);
    var pathlen = strlen(path);
    var full = alloc(rootlen + pathlen + 1);
    memcpy(full, _bootloader_root, rootlen);
    memcpy(full + rootlen, path, pathlen);
    store8(full + rootlen + pathlen, 0);
    return full;
}

# 1 if `path` opens as a directory, or as a file when `want_dir` is 0.
fn _bootloader_probe(path, want_dir): i64 {
    var flags = O_RDONLY;
    # O_DIRECTORY is the per-target symbol; a raw 0x10000 is O_DIRECT on arm64.
    if (want_dir == 1) { flags = flags | O_DIRECTORY; }
    var fd = file_open(_bootloader_path(path), flags, 0);
    if (fd < 0) { return 0; }
    file_close(fd);
    return 1;
}

# Detect the installed bootloader by probing well-known paths: systemd-boot under each
# place an ESP is mounted, the roots the entry fallback reads, then either GRUB layout.
# Returns Result: Ok(BootloaderType constant).
fn bootloader_detect(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(BOOT_UNKNOWN);     # agnos boots via gnoboot, not GRUB/systemd-boot
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_bootloader_probe("/boot/efi/EFI/systemd", 1) == 1) { return Ok(BOOT_SYSTEMD_BOOT); }
    if (_bootloader_probe("/efi/EFI/systemd", 1) == 1) { return Ok(BOOT_SYSTEMD_BOOT); }
    if (_bootloader_probe("/boot/EFI/systemd", 1) == 1) { return Ok(BOOT_SYSTEMD_BOOT); }
    if (_bootloader_probe("/boot/grub/grub.cfg", 0) == 1) { return Ok(BOOT_GRUB2); }
    if (_bootloader_probe("/boot/grub2/grub.cfg", 0) == 1) { return Ok(BOOT_GRUB2); }
    return Ok(BOOT_UNKNOWN);
    #endif
}

# ================================================================
# Parse loader.conf (systemd-boot)
# ================================================================

# Helper: check if line starts with prefix (skipping leading whitespace)
fn bootloader_line_starts_with(line, linelen, prefix): i64 {
    var plen = strlen(prefix);
    # Skip leading whitespace
    var start = 0;
    while (start < linelen) {
        var ch = load8(line + start);
        if (ch != 32) { if (ch != 9) { break; } }
        start = start + 1;
    }
    if (linelen - start < plen) { return 0; }
    var i = 0;
    while (i < plen) {
        if (load8(line + start + i) != load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    return start + plen;
}

# Extract the value after a key in a line (trim whitespace).
# Returns heap string pointer.
fn bootloader_extract_value(line, linelen, key_end_pos): i64 {
    var start = key_end_pos;
    # Skip whitespace
    while (start < linelen) {
        var ch = load8(line + start);
        if (ch != 32) { if (ch != 9) { break; } }
        start = start + 1;
    }
    var vlen = linelen - start;
    if (vlen <= 0) { return 0; }
    var val = alloc(vlen + 1);
    memcpy(val, line + start, vlen);
    store8(val + vlen, 0);
    return val;
}

# 1 for "@saved" in any case, the one @ name systemd-boot takes as a default.
fn _bootloader_is_saved(v): i64 {
    var saved = "@saved";
    var i = 0;
    while (i < 6) {
        if ((load8(v + i) | 32) != (load8(saved + i) | 32)) { return 0; }
        i = i + 1;
    }
    return load8(v + 6) == 0;
}

# Parse loader.conf file contents.
# Returns { timeout, default_id } as a 16-byte struct.
fn bootloader_parse_loader_conf(text): i64 {
    var result = alloc(16);
    store64(result, 5);  # default timeout: 5 seconds
    store64(result + 8, 0);  # default_id: null

    if (text == 0) { return result; }

    var textlen = strlen(text);
    var pos = 0;

    while (pos < textlen) {
        var linestart = pos;
        while (pos < textlen) {
            var lc = load8(text + pos);
            if (lc == 10 || lc == 13) { break; }   # CR ends a line, as in an entry
            pos = pos + 1;
        }
        var linelen = pos - linestart;
        if (pos < textlen) { pos = pos + 1; }  # skip newline

        # Trailing blanks are not part of a value.
        while (linelen > 0) {
            var tail = load8(text + linestart + linelen - 1);
            if (tail != 32) { if (tail != 9) { break; } }
            linelen = linelen - 1;
        }
        if (linelen == 0) { continue; }

        # Skip comment lines
        var first = linestart;
        while (first < linestart + linelen) {
            var ch = load8(text + first);
            if (ch != 32) { if (ch != 9) { break; } }
            first = first + 1;
        }
        if (first < linestart + linelen) {
            if (load8(text + first) == 35) { continue; }  # '#'
        }

        var kp = _bootloader_entry_key(text + linestart, linelen, "timeout");
        if (kp > 0) {
            var val = _bootloader_entry_value(text + linestart, linelen, kp);
            if (val != 0) {
                # Seconds, or a word such as menu-force that has no number to give:
                # that leaves the default, rather than reading its digits, if any.
                var t = 0;
                var vi = 0;
                var vl = strlen(val);
                var isnum = vl <= 9;
                while (vi < vl) {
                    var ch = load8(val + vi);
                    if (ch < 48 || ch > 57) { isnum = 0; }
                    t = t * 10 + (ch - 48);
                    vi = vi + 1;
                }
                if (isnum == 1) { store64(result, t); }
            }
            continue;
        }

        kp = _bootloader_entry_key(text + linestart, linelen, "default");
        if (kp > 0) {
            var val = _bootloader_entry_value(text + linestart, linelen, kp);
            # A value of only quotes clears the default, as it does for systemd-boot, and a
            # line with no value at all is not one it reads. Only @saved of the @ names counts.
            if (val == 0) {
                if (bootloader_extract_value(text + linestart, linelen, kp) != 0) { store64(result + 8, 0); }
            } elif (load8(val) == 64) {
                if (_bootloader_is_saved(val) != 1) { val = 0; }
            }
            if (val != 0) {
                # Strip .conf suffix if present
                var vl = strlen(val);
                if (vl > 5) {
                    if (load8(val + vl - 5) == 46) {  # '.'
                        if (load8(val + vl - 4) == 99) {  # 'c'
                            if (load8(val + vl - 3) == 111) {  # 'o'
                                if (load8(val + vl - 2) == 110) {  # 'n'
                                    if (load8(val + vl - 1) == 102) {  # 'f'
                                        store8(val + vl - 5, 0);
                                    }
                                }
                            }
                        }
                    }
                }
                store64(result + 8, val);
            }
            continue;
        }
    }

    return result;
}

# ================================================================
# List boot entries (high-level)
# ================================================================

# Test seam, 0 outside tests/tcyr: a stub to run in place of /usr/bin/bootctl.
var _bootloader_bootctl = 0;

# Walk every readable one of /boot/loader/entries, /efi/loader/entries and
# /boot/efi/loader/entries into result_arr from `count`, merged as systemd-boot merges the
# ESP and XBOOTLDR. Two directories can each hold an id, and both are returned: hiding one
# would hide what may boot. Two paths to one directory are read once. Returns the new
# count, or a BOOTLOADER_SCAN_* refusal, BOOTLOADER_SCAN_NO_DIR when none could be read.
fn _bootloader_scan_boot_dirs(result_arr, max_entries, count): i64 {
    var dirs = vec_new();
    vec_push(dirs, "/boot/loader/entries");
    vec_push(dirs, "/efi/loader/entries");
    vec_push(dirs, "/boot/efi/loader/entries");
    var readable = 0;
    var di = 0;
    while (di < vec_len(dirs)) {
        var dir = _bootloader_path(vec_get(dirs, di));
        var seen = 0;
        var pi = 0;
        while (pi < di) {
            seen = seen | _bootloader_same_dir(dir, _bootloader_path(vec_get(dirs, pi)));
            pi = pi + 1;
        }
        di = di + 1;
        if (seen == 1) { continue; }
        var n = _bootloader_scan_entries_dir(dir, result_arr, max_entries, count);
        if (n <= BOOTLOADER_SCAN_TOO_LARGE) { return n; }
        if (n >= 0) {
            readable = 1;
            count = n;
        } elif (n != 0 - ENOENT) {
            # A directory that exists and cannot be read may hold what boots.
            if (n != 0 - ENOTDIR) { return BOOTLOADER_SCAN_DIR_FAILED; }
        }
    }
    if (readable == 0) { return BOOTLOADER_SCAN_NO_DIR; }
    return count;
}

# `a` and `b` joined with a space, or one of them if the two agree or the other is missing.
fn _bootloader_both(a, b): i64 {
    if (a == 0) { return b; }
    if (b == 0) { return a; }
    if (streq(a, b) == 1) { return a; }
    return str_data(str_builder_build(_bootloader_sb_append(_bootloader_sb_append(0, a), b)));
}

# Give a bootctl entry what its file says, since the file is what systemd-boot reads. bootctl
# drops a path it will not take, such as one holding "..", and prints what is left, so a
# later `linux` line or `initrd` line goes unseen. It joins options lines before it would
# unquote them, if it did, so `options "quiet 1"` reads as one quoted word. So the boot keys
# come from the file. `options` and `extra` hold what both say, which adds what an addon
# contributes and hides nothing: where the two agree, that is one copy. Returns 0.
fn _bootloader_take_file(e, f): i64 {
    bootloader_entry_set_linux(e, bootloader_entry_linux(f));
    bootloader_entry_set_efi(e, bootloader_entry_efi(f));
    bootloader_entry_set_uki(e, bootloader_entry_uki(f));
    bootloader_entry_set_uki_url(e, bootloader_entry_uki_url(f));
    bootloader_entry_set_initrd(e, bootloader_entry_initrd(f));
    bootloader_entry_set_options(e, _bootloader_both(bootloader_entry_options(f), bootloader_entry_options(e)));
    bootloader_entry_set_extra(e, _bootloader_both(bootloader_entry_extra(f), bootloader_entry_extra(e)));
    return 0;
}

# 1 for a name systemd-boot reads as a Type #2 entry in /EFI/Linux: an .efi in any case,
# not hidden, and not auto-*.
fn _bootloader_uki_name_ok(name): i64 {
    var n = strlen(name);
    if (n <= 4) { return 0; }
    if (load8(name) == 46) { return 0; }
    if (load8(name + n - 4) != 46) { return 0; }
    if ((load8(name + n - 3) | 32) != 101) { return 0; }
    if ((load8(name + n - 2) | 32) != 102) { return 0; }
    if ((load8(name + n - 1) | 32) != 105) { return 0; }
    if (n >= 5) {
        if ((load8(name) | 32) == 97) {
            if ((load8(name + 1) | 32) == 117) {
                if ((load8(name + 2) | 32) == 116) {
                    if ((load8(name + 3) | 32) == 111) {
                        if (load8(name + 4) == 45) { return 0; }
                    }
                }
            }
        }
    }
    return 1;
}

# Account for one /EFI/Linux directory's UKIs in result_arr. Each entry already there
# answers for one file, marked in `claimed`, so a second file of the same name on the other
# partition still shows. One with no boot key learns it is a UKI, since a blank line in
# .uname can split that key from the block in bootctl's text. Any other file is added, as a
# UKI with no options, because a validator must see it: bootctl refuses a name holding a
# space, and fails outright on a long loader.conf line, while systemd-boot boots both.
# This library does not read a UKI, so its command line stays unknown, as
# bootloader_entry_boot_kind says. bootctl names a counted UKI, or a profile of one, other
# than its file, which comes back under both and errs toward showing it. Returns the new
# count, or a BOOTLOADER_SCAN_* refusal.
fn _bootloader_add_ukis(dir, result_arr, max_entries, count, claimed): i64 {
    var dstr = str_from(dir);
    var names = vec_new();
    var listed = dir_list_checked(dstr, names);
    if (listed < 0) {
        if (listed == 0 - ENOENT) { return count; }
        if (listed == 0 - ENOTDIR) { return count; }
        return BOOTLOADER_SCAN_DIR_FAILED;
    }
    var total = count;
    var ni = 0;
    while (ni < vec_len(names)) {
        var nstr = vec_get(names, ni);
        var name = str_cstr(nstr);
        ni = ni + 1;
        if (_bootloader_uki_name_ok(name) != 1) { continue; }
        var path = str_data(path_join(dstr, nstr));
        var reg = _bootloader_is_regular(path);
        if (reg < 0) { return BOOTLOADER_SCAN_UNREADABLE; }
        if (reg == 0) { continue; }
        var ei = 0;
        var known = 0;
        while (ei < total) {
            var e = load64(result_arr + ei * 8);
            if (load8(claimed + ei) == 0) {
                if (streq(bootloader_entry_id(e), name) == 1) {
                    known = 1;
                    store8(claimed + ei, 1);
                    if (bootloader_entry_boot_kind(e) == BOOT_ENTRY_NONE) { bootloader_entry_set_uki(e, path); }
                    break;
                }
            }
            ei = ei + 1;
        }
        if (known == 1) { continue; }
        if (max_entries == 0) { continue; }
        if (total >= max_entries) { return BOOTLOADER_SCAN_TOO_MANY; }
        var u = bootloader_entry_new();
        bootloader_entry_set_id(u, name);
        bootloader_entry_set_uki(u, path);
        store64(result_arr + total * 8, u);
        store8(claimed + total, 1);
        total = total + 1;
    }
    return total;
}

# Account for the UKIs under every root an ESP or XBOOTLDR is mounted on. Returns the new
# count, or a BOOTLOADER_SCAN_* refusal.
fn _bootloader_scan_ukis(result_arr, max_entries, count): i64 {
    var bytes = max_entries + 1;
    var claimed = _agnodrm_scratch_new(bytes);
    if (claimed == 0) { return BOOTLOADER_SCAN_TOO_MANY; }
    memset(claimed, 0, bytes);
    var roots = vec_new();
    vec_push(roots, "/boot/EFI/Linux");
    vec_push(roots, "/efi/EFI/Linux");
    vec_push(roots, "/boot/efi/EFI/Linux");
    var di = 0;
    while (di < vec_len(roots)) {
        var dir = _bootloader_path(vec_get(roots, di));
        var seen = 0;
        var pi = 0;
        while (pi < di) {
            seen = seen | _bootloader_same_dir(dir, _bootloader_path(vec_get(roots, pi)));
            pi = pi + 1;
        }
        di = di + 1;
        if (seen == 1) { continue; }
        count = _bootloader_add_ukis(dir, result_arr, max_entries, count, claimed);
        if (count < 0) { break; }
    }
    _agnodrm_scratch_free(claimed, bytes);
    return count;
}

# Add to result_arr, which holds `count` entries from bootctl, every entry file bootctl did
# not report. bootctl leaves out what systemd-boot boots: a file named "a b.conf", or one
# with a line it cannot parse. Each entry from bootctl answers for one file, so a second
# file of the same id, on the other partition, is still added. A counted file reads
# "a+3.conf" here and "a.conf" there, and comes back under both, which errs toward showing
# it. Returns the new count, or a BOOTLOADER_SCAN_* refusal. No directory to read leaves the
# list as bootctl gave it.
fn _bootloader_merge_files(result_arr, max_entries, count): i64 {
    var bytes = max_entries * 8 + count + 1;
    var files = _agnodrm_scratch_new(bytes);
    if (files == 0) { return BOOTLOADER_SCAN_TOO_MANY; }
    memset(files, 0, bytes);
    var claimed = files + max_entries * 8;
    var n = _bootloader_scan_boot_dirs(files, max_entries, 0);
    var total = count;
    var fi = 0;
    while (fi < n) {
        var f = load64(files + fi * 8);
        var hit = 0;
        var bi = 0;
        while (bi < count) {
            if (load8(claimed + bi) == 0) {
                var reported = load64(result_arr + bi * 8);
                if (streq(bootloader_entry_id(reported), bootloader_entry_id(f)) == 1) {
                    store8(claimed + bi, 1);
                    _bootloader_take_file(reported, f);
                    hit = 1;
                    break;
                }
            }
            bi = bi + 1;
        }
        if (hit == 0) {
            if (total >= max_entries) {
                _agnodrm_scratch_free(files, bytes);
                return BOOTLOADER_SCAN_TOO_MANY;
            }
            store64(result_arr + total * 8, f);
            total = total + 1;
        }
        fi = fi + 1;
    }
    _agnodrm_scratch_free(files, bytes);
    if (n == BOOTLOADER_SCAN_NO_DIR) { return _bootloader_scan_ukis(result_arr, max_entries, count); }
    if (n < 0) { return n; }
    return _bootloader_scan_ukis(result_arr, max_entries, total);
}

# List boot entries: what `bootctl list` reports, and every BLS Type #1 entry file it did
# not, since the two disagree about what is an entry (see _bootloader_merge_files).
# result_arr: caller-allocated array of max_entries BootEntry pointers.
# Every UKI in /EFI/Linux is accounted for the same way. When bootctl is missing, fails, or
# prints nothing, the files are the whole list.
# is_default is set only from bootctl's JSON; see _bootloader_scan_entries_dir for why neither
# the files nor bootctl's text can say.
# Returns Result: Ok(count) — 0 when a source was read and held no entries —
# Err(not_supported) when bootctl produced nothing AND no entries directory
# could be read, so "no source" no longer reads as "no entries", or Err when the
# entries cannot all be returned: more than max_entries, or a file over the cap.
fn bootloader_list_boot_entries(result_arr, max_entries): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);               # agnos boots via gnoboot; no systemd-boot entries
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_entries) != 1) {
        return drm_err_invalid_argument("result array is null or max_entries is negative");
    }
    # Ask bootctl for JSON, and for text from one too old to know --json. argv vec: element 0
    # is the ABSOLUTE command path (execve does no PATH lookup). A bootctl that hit the
    # deadline gets no second one: it hung, and it was not the flag it choked on.
    var args = vec_new();
    vec_push(args, "/usr/bin/bootctl");
    vec_push(args, "list");
    vec_push(args, "--json=short");
    if (_bootloader_bootctl != 0) { vec_set(args, 0, _bootloader_bootctl); }

    var cap = BOOTLOADER_BOOTCTL_MAX;
    var buf = _agnodrm_scratch_new(cap + 1);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for bootctl output"); }
    var failed = "bootctl list failed";
    var res_t, res_v = _agnodrm_capture_within(args, buf, cap, failed, AGNODRM_TOOL_DEADLINE_MS);
    if (is_err_result(res_t) == 1) {
        if (drm_syserr_errno(res_v) != ETIMEDOUT) {
            vec_pop(args);
            var plain_t, plain_v = _agnodrm_capture_within(args, buf, cap, failed, AGNODRM_TOOL_DEADLINE_MS);
            res_t = plain_t;
            res_v = plain_v;
        }
    }
    if (is_ok(res_t) == 1) {
        var nbytes = res_v;
        # A full buffer means the output was cut: the last entry would lose its
        # options (a kernel parameter the caller then never sees) and later
        # entries would vanish. Refuse rather than return a truncated list.
        if (nbytes >= cap) {
            _agnodrm_scratch_free(buf, cap + 1);
            return drm_err_io(0, "bootctl list output is too large; not parsing a truncated list");
        }
        if (nbytes > 0) {
            store8(buf + nbytes, 0);
            var p_t = 0;
            var p_v = 0;
            if (load8(buf + _agnodrm_json_ws(buf, nbytes, 0)) == 91) {
                var pj_t, pj_v = bootloader_parse_bootctl_json(buf, result_arr, max_entries);
                p_t = pj_t;
                p_v = pj_v;
            } else {
                var pt_t, pt_v = bootloader_parse_bootctl_list(buf, result_arr, max_entries);
                p_t = pt_t;
                p_v = pt_v;
            }
            _agnodrm_scratch_free(buf, cap + 1);
            if (is_err_result(p_t) == 1) { return Err(p_v); }
            var merged = _bootloader_merge_files(result_arr, max_entries, p_v);
            if (merged < 0) { return _bootloader_scan_err(merged); }
            return Ok(merged);
        }
    }
    _agnodrm_scratch_free(buf, cap + 1);

    # Fallback (roadmap V1.6.x): read the loader entries directly, from all of them.
    # Through 1.7.1 the first directory won, so an empty /boot hid every entry on /efi.
    var count = _bootloader_scan_boot_dirs(result_arr, max_entries, 0);
    if (count >= 0) {
        count = _bootloader_scan_ukis(result_arr, max_entries, count);
        if (count >= 0) { return Ok(count); }
        return _bootloader_scan_err(count);
    }
    if (count == BOOTLOADER_SCAN_NO_DIR) {
        var why = "bootctl list printed nothing and no loader/entries dir under /boot, /efi or /boot/efi is readable";
        return drm_err_not_supported(why);
    }
    return _bootloader_scan_err(count);
    #endif
}

# ================================================================
# Loader-entries fallback — Boot Loader Specification Type #1
# ================================================================
#
# Everything read here is EXTERNAL INPUT, and every read is bounded. The rule for a
# file that cannot be read in full is to fail the listing, never to leave it out:
# systemd-boot reads a file of any size, so an entry skipped here is one a validator
# never sees and the machine still boots (audit F-28).
#   * a file is read with lib/io.cyr file_read_all into ONE buffer of
#     BOOTLOADER_ENTRY_FILE_MAX + 1 bytes, allocated once per directory walk.
#     A file that fills that extra byte is over the cap and fails the call: it is
#     neither truncated nor dropped. A file at the cap leaves index `cap` for the
#     terminator;
#   * a file holding a NUL byte is read up to it, where systemd-boot stops;
#   * only names that stat as regular files are opened (xstat follows
#     symlinks), so a FIFO or device node already in the directory is skipped.
#     The stat and the open are separate calls: a FIFO swapped in between them
#     could still block the read — which needs write access to the entries
#     directory, i.e. root on $BOOT;
#   * names are filtered before any open (_bootloader_entry_name_ok);
#   * repeated initrd / options lines accumulate in a str_builder (amortised
#     doubling), not by re-copying the joined string per line — that would be
#     quadratic in the line count within the cap.

enum BootloaderEntryLimits {
    BOOTLOADER_ENTRY_FILE_MAX = 65536;   # per-file read cap, bytes
    BOOTLOADER_ENTRY_NAME_MAX = 255;     # NAME_MAX; a longer name is skipped
}

# _bootloader_scan_entries_dir's refusals, below every negative errno.
var BOOTLOADER_SCAN_TOO_LARGE = 0 - 5000;
var BOOTLOADER_SCAN_TOO_MANY = 0 - 5001;
var BOOTLOADER_SCAN_UNREADABLE = 0 - 5002;
var BOOTLOADER_SCAN_NO_DIR = 0 - 5003;
var BOOTLOADER_BOOTCTL_MAX = 1048576;       # JSON runs larger than the text it replaces
var BOOTLOADER_SCAN_DIR_FAILED = 0 - 5004;

fn _bootloader_scan_err(n): i64 {
    if (n == BOOTLOADER_SCAN_TOO_MANY) {
        return drm_err_invalid_argument("more loader entries than max_entries");
    }
    if (n == BOOTLOADER_SCAN_UNREADABLE) {
        return drm_err_io(0, "a loader entry cannot be read; not parsing part of the list");
    }
    if (n == BOOTLOADER_SCAN_DIR_FAILED) {
        return drm_err_io(0, "a loader entries directory cannot be read");
    }
    return drm_err_io(0, "a loader entry is over 64 KiB; not parsing part of the list");
}

# 1 if two paths are one directory, by device and inode. st_dev is at +0 and st_ino at +8
# on x86_64 and aarch64 alike; the stdlib names neither.
fn _bootloader_same_dir(a, b): i64 {
    var sa = alloc(STAT_BUFSZ);
    var sb = alloc(STAT_BUFSZ);
    if (xstat(a, sa) != 0) { return 0; }
    if (xstat(b, sb) != 0) { return 0; }
    if (load64(sa) != load64(sb)) { return 0; }
    return load64(sa + 8) == load64(sb + 8);
}

# 1 if the `nlen` bytes at `nd` end in ".conf" in any case, as systemd-boot matches it.
fn _bootloader_has_conf_suffix(nd, nlen): i64 {
    var i = 0;
    while (i < 5) {
        var c = load8(nd + nlen - 5 + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (c != load8(".conf" + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 if a directory entry name (Str) names a loader entry file we will open:
# it ends in ".conf" in any case (systemd-boot folds it) after a
# non-empty stem, is not hidden (which also excludes "." and ".."), is at most
# BOOTLOADER_ENTRY_NAME_MAX bytes, and holds no '/' or control byte. Linux getdents
# cannot yield a '/' or an over-long name; those two checks are defence in depth for any
# other dirent source. DEL is legal on vfat and systemd-boot reads such a file, so a name
# holding one is an entry like any other.
fn _bootloader_entry_name_ok(name: Str): i64 {
    if (name == 0) { return 0; }
    var nlen = str_len(name);
    var nd = str_data(name);
    if (nlen <= 5) { return 0; }
    if (nlen > BOOTLOADER_ENTRY_NAME_MAX) { return 0; }
    if (load8(nd) == 46) { return 0; }         # '.': hidden, ".", ".."
    var i = 0;
    while (i < nlen) {
        var ch = load8(nd + i);
        if (ch == 47) { return 0; }            # '/'
        if (ch < 32) { return 0; }             # control byte (NUL included)
        i = i + 1;
    }
    return _bootloader_has_conf_suffix(nd, nlen);
}

# vec_sort_by comparator over two Str names: byte-wise unsigned order, a name
# ordering before any longer name it prefixes (strcmp order, locale-free).
fn _bootloader_name_cmp(a, b): i64 {
    var al = str_len(a);
    var bl = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    var n = al;
    if (bl < n) { n = bl; }
    var i = 0;
    while (i < n) {
        var ca = load8(ad + i);
        var cb = load8(bd + i);
        if (ca != cb) { return ca - cb; }
        i = i + 1;
    }
    return al - bl;
}

# 1 if `path` (cstring) resolves to a regular file, 0 if it does not or resolves to
# nothing (a dangling or looping link), or -1 if it cannot be told: an entry that may be a
# file and cannot be read is not one to leave out. xstat follows symlinks, so a link to a regular file counts; a FIFO,
# device node, socket or directory does not. STAT_MODE is the per-target st_mode offset
# (24 on x86_64, 16 on aarch64, 0 on agnos) — never a hardcoded offset. S_IFMT 0xF000,
# S_IFREG 0x8000.
fn _bootloader_is_regular(path): i64 {
    var st[144];
    var ret = xstat(path, &st);
    if (ret == 0 - ENOENT) { return 0; }
    if (ret == 0 - ENOTDIR) { return 0; }
    if (ret == 0 - ELOOP) { return 0; }
    if (ret != 0) { return 0 - 1; }
    var mode = load32(&st + STAT_MODE);
    if ((mode & 0xF000) == 0x8000) { return 1; }
    return 0;
}

# If the first word of `line` is exactly `key`, the offset just past it (where
# bootloader_extract_value starts); else 0. bootloader_line_starts_with alone
# is a prefix test — "linuxefi x" would match "linux" — so the byte after the
# key must be a space, a tab, or the end of the line.
fn _bootloader_entry_key(line, linelen, key): i64 {
    var kp = bootloader_line_starts_with(line, linelen, key);
    if (kp == 0) { return 0; }
    if (kp >= linelen) { return kp; }
    var ch = load8(line + kp);
    if (ch == 32) { return kp; }
    if (ch == 9) { return kp; }
    return 0;
}

# Append a value to a lazily-created str_builder, one space between values.
# Returns the builder (new or the one passed in); a 0 or empty `val` is a
# no-op, so a join never gains a doubled or leading space.
fn _bootloader_sb_append(sb, val): i64 {
    if (val == 0) { return sb; }
    if (load8(val) == 0) { return sb; }
    if (sb == 0) { sb = str_builder_new(); }
    else { str_builder_putc(sb, 32); }
    str_builder_add_cstr(sb, val);
    return sb;
}

# Strip one matching pair of quotes from a value, as systemd-boot does to every key of an
# entry file: `options 'init=/bin/sh'` boots that option. A value that is only quotes is
# empty, which is 0. `v` is a heap copy, and the result points into it.
fn _bootloader_unquote(v): i64 {
    if (v == 0) { return 0; }
    var q = load8(v);
    if (q != 34) {
        if (q != 39) { return v; }
    }
    var n = strlen(v);
    if (load8(v + n - 1) != q) { return v; }
    if (n < 3) { return 0; }
    store8(v + n - 1, 0);
    return v + 1;
}

# A value from an entry file, as systemd-boot reads it.
fn _bootloader_entry_value(line, linelen, kp): i64 {
    return _bootloader_unquote(bootloader_extract_value(line, linelen, kp));
}

# Parse one BLS Type #1 entry body — `textlen` bytes at `text`, not
# NUL-delimited — into entry `e`. Lines end at LF or CR, as systemd-boot ends them: with
# LF alone, "# x\roptions init=/bin/sh" read as a comment here and booted as an option
# (audit F-27). Trailing spaces/tabs are trimmed; blank lines and lines whose first
# non-blank byte is '#' are skipped. The key is the first word, the value the
# rest of the line after the separating whitespace, less one matching pair of quotes.
# title / version / linux / efi / uki / uki-url are single-valued (last wins); initrd,
# options and extra may repeat and are joined with one space, as the BLS concatenates
# options, so a path holding a space cannot be told from two. Any of the four boot keys
# is kept even beside another: bootloader_entry_boot_kind says what that means. extra
# hands a UKI credentials and system extensions; systemd-boot adds nothing from it to a
# command line.
# machine-id, sort-key, profile, devicetree, devicetree-overlay and architecture have no
# bootloader_entry field and are ignored, as are unknown keys and empty values. No key
# is required: a missing one leaves its field 0. Returns 0.
fn _bootloader_parse_entry_text(e, text, textlen): i64 {
    var sb_initrd = 0;
    var sb_options = 0;
    var sb_extra = 0;
    var pos = 0;
    while (pos < textlen) {
        var ls = pos;
        while (pos < textlen) {
            var lc = load8(text + pos);
            if (lc == 10 || lc == 13) { break; }
            pos = pos + 1;
        }
        var ll = pos - ls;
        if (pos < textlen) { pos = pos + 1; }   # skip the LF or CR

        # Trim trailing space / tab (padded values).
        var trim = 1;
        while (trim == 1) {
            if (ll == 0) { trim = 0; }
            else {
                var tc = load8(text + ls + ll - 1);
                if (tc == 32 || tc == 9) { ll = ll - 1; }
                else { trim = 0; }
            }
        }
        if (ll == 0) { continue; }

        # Blank (all whitespace) or comment line.
        var first = 0;
        while (first < ll) {
            var fc = load8(text + ls + first);
            if (fc != 32) { if (fc != 9) { break; } }
            first = first + 1;
        }
        if (first >= ll) { continue; }
        if (load8(text + ls + first) == 35) { continue; }   # '#'

        var line = text + ls;
        var kp = _bootloader_entry_key(line, ll, "title");
        if (kp > 0) {
            var tv = _bootloader_entry_value(line, ll, kp);
            if (tv != 0) { bootloader_entry_set_title(e, tv); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "version");
        if (kp > 0) {
            var vv = _bootloader_entry_value(line, ll, kp);
            if (vv != 0) { bootloader_entry_set_version(e, vv); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "linux");
        if (kp > 0) {
            var lv = _bootloader_entry_value(line, ll, kp);
            if (lv != 0) { bootloader_entry_set_linux(e, lv); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "initrd");
        if (kp > 0) {
            sb_initrd = _bootloader_sb_append(sb_initrd, _bootloader_entry_value(line, ll, kp));
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "options");
        if (kp > 0) {
            sb_options = _bootloader_sb_append(sb_options, _bootloader_entry_value(line, ll, kp));
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "efi");
        if (kp > 0) {
            var ev = _bootloader_entry_value(line, ll, kp);
            if (ev != 0) { bootloader_entry_set_efi(e, ev); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "uki");
        if (kp > 0) {
            var uv = _bootloader_entry_value(line, ll, kp);
            if (uv != 0) { bootloader_entry_set_uki(e, uv); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "uki-url");
        if (kp > 0) {
            var rv = _bootloader_entry_value(line, ll, kp);
            if (rv != 0) { bootloader_entry_set_uki_url(e, rv); }
            continue;
        }
        kp = _bootloader_entry_key(line, ll, "extra");
        if (kp > 0) {
            sb_extra = _bootloader_sb_append(sb_extra, _bootloader_entry_value(line, ll, kp));
            continue;
        }
    }
    if (sb_initrd != 0) { bootloader_entry_set_initrd(e, str_data(str_builder_build(sb_initrd))); }
    if (sb_options != 0) { bootloader_entry_set_options(e, str_data(str_builder_build(sb_options))); }
    if (sb_extra != 0) { bootloader_entry_set_extra(e, str_data(str_builder_build(sb_extra))); }
    return 0;
}

# Walk one entries directory (cstring `dir`) into result_arr from index `count`. Returns
# the new count (>= 0), the negative errno of a failed directory read (agnos calls fail
# with a bare -1), or a BOOTLOADER_SCAN_* refusal: a file over the cap or unreadable, or
# more entries than max_entries. max_entries 0 asks for nothing, and is no overflow.
# Callers validate arguments.
#
# Order is deterministic: candidate names are sorted byte-wise
# (_bootloader_name_cmp) first, so a listing is always in the same order.
# That is file-name order, NOT systemd-boot's menu
# order (sort-key, machine-id, version); `version` is filled in so a caller
# can reorder. is_default is left 0: the effective default is the
# LoaderEntryDefault / LoaderEntryOneShot EFI variables before loader.conf's
# `default`, which may itself be a glob, so no exact answer exists from the
# entries directory alone. (The bootctl path leaves it 0 as well: see
# bootloader_parse_bootctl_list.)
fn _bootloader_scan_entries_dir(dir, result_arr, max_entries, count): i64 {
    var dstr = str_from(dir);
    var names = vec_new();
    # dir_list would read a directory that fails part way as a short one.
    var listed = dir_list_checked(dstr, names);
    if (listed < 0) { return listed; }
    var cand = vec_new();
    var ni = 0;
    var nn = vec_len(names);
    while (ni < nn) {
        var nm = vec_get(names, ni);
        if (_bootloader_entry_name_ok(nm) == 1) { vec_push(cand, nm); }
        ni = ni + 1;
    }
    vec_sort_by(cand, &_bootloader_name_cmp);

    var cap = BOOTLOADER_ENTRY_FILE_MAX;
    var buf = _agnodrm_scratch_new(cap + 1);
    if (buf == 0) { return 0 - ENOMEM; }
    var ret = 0;
    var ci = 0;
    var cn = vec_len(cand);
    while (ci < cn) {
        if (max_entries == 0) { break; }
        var cname = vec_get(cand, ci);
        ci = ci + 1;
        var full = str_data(path_join(dstr, cname));
        var kind = _bootloader_is_regular(full);
        if (kind < 0) {
            ret = BOOTLOADER_SCAN_UNREADABLE;
            break;
        }
        if (kind == 0) { continue; }
        # Read up to cap + 1 bytes into the cap + 1 buffer: a full read means
        # the file is over the cap. Otherwise got <= cap and buf[got] is in bounds.
        var got = file_read_all(full, buf, cap + 1);
        if (got < 0) {
            if (got == 0 - ENOENT) { continue; }  # removed since the listing
            ret = BOOTLOADER_SCAN_UNREADABLE;
            break;
        }
        if (got > cap) {
            ret = BOOTLOADER_SCAN_TOO_LARGE;
            break;
        }
        var nul = memchr(buf, 0, got);
        if (nul >= 0) { got = nul; }
        store8(buf + got, 0);

        # The id is the whole file name, ".conf" included — systemd-boot's entry
        # id, and what the bootctl path reports for a .conf entry. The paths
        # still differ elsewhere: bootctl also lists UKIs and automatic entries,
        # and returns its display text (see bootloader_parse_bootctl_list).
        var idlen = str_len(cname);
        var id = alloc(idlen + 1);
        memcpy(id, str_data(cname), idlen);
        store8(id + idlen, 0);
        if (count >= max_entries) {
            ret = BOOTLOADER_SCAN_TOO_MANY;
            break;
        }
        var e = bootloader_entry_new();
        bootloader_entry_set_id(e, id);
        _bootloader_parse_entry_text(e, buf, got);
        store64(result_arr + count * 8, e);
        count = count + 1;
    }
    _agnodrm_scratch_free(buf, cap + 1);
    if (ret < 0) { return ret; }
    return count;
}

# List Boot Loader Specification Type #1 entries from one directory, e.g.
# "/boot/loader/entries". Every "<id>.conf" regular file, the suffix in any case, is
# parsed, in byte-wise file-name order, into a bootloader_entry (id = the file name,
# ".conf" included, as systemd-boot and the bootctl path report it; repeated
# initrd / options joined with a space; is_default 0), into the caller-allocated
# result_arr. Hidden names and non-regular files are skipped, as systemd-boot skips them.
# Returns Result: Ok(count) — 0 for a readable directory with no entries — or
# Err when `dir` is not a readable directory, an argument is invalid, or the entries
# cannot all be returned: a file over 64 KiB (BOOTLOADER_ENTRY_FILE_MAX) or unreadable,
# or more entries than max_entries. The bootloader would boot what a short list leaves out.
fn bootloader_list_loader_entries(dir, result_arr, max_entries): i64 {
    if (dir == 0) { return drm_err_invalid_argument("loader entries dir is null"); }
    if (_agnodrm_out_ok(result_arr, max_entries) != 1) {
        return drm_err_invalid_argument("result array is null or max_entries is negative");
    }
    var n = _bootloader_scan_entries_dir(dir, result_arr, max_entries, 0);
    if (n <= BOOTLOADER_SCAN_TOO_LARGE) { return _bootloader_scan_err(n); }
    if (n < 0) {
        return drm_err_io(0 - n, "loader entries directory is not a readable directory");
    }
    return Ok(n);
}

# Count of leading blanks; `linelen` for an empty or whitespace-only line.
fn _bootloader_indent(line, linelen): i64 {
    var i = 0;
    while (i < linelen) {
        var ch = load8(line + i);
        if (ch != 32) { if (ch != 9) { break; } }
        i = i + 1;
    }
    return i;
}

# Index of the ':' ending the line's first word, or -1 if it does not end in one.
fn _bootloader_label_colon(line, linelen, indent): i64 {
    var j = indent;
    while (j < linelen) {
        var cj = load8(line + j);
        if (cj == 32) { break; }
        if (cj == 9) { break; }
        j = j + 1;
    }
    if (j == indent) { return 0 - 1; }
    if (load8(line + j - 1) == 58) { return j - 1; }
    return 0 - 1;
}

# 1 for a bootctl continuation line. bootctl right-aligns its labels, so a real
# label starts left of the block's colon column (`colon`, 0 until one is seen),
# and its continuations are indented past it: a line at or past the column is a
# continuation whatever its first word looks like. Before any label, an indented
# line whose first word is not "key:" is one.
fn _bootloader_is_continuation(line, linelen, indent, colon): i64 {
    if (colon > 0) {
        if (indent >= colon) { return 1; }
    }
    if (indent == 0) { return 0; }
    if (_bootloader_label_colon(line, linelen, indent) >= 0) { return 0; }
    return 1;
}

# Finish a bootctl block: set the joined initrd / options, then store the entry
# if the block carried an id. Returns the new count, or -1 if result_arr is full, which
# fails the parse: an entry a caller cannot see is one it cannot validate. max_entries
# 0 asks for nothing and is no overflow.
fn _bootloader_bootctl_flush(e, sb_initrd, sb_options, result_arr, max_entries, count): i64 {
    if (e == 0) { return count; }
    if (sb_initrd != 0) { bootloader_entry_set_initrd(e, str_data(str_builder_build(sb_initrd))); }
    if (sb_options != 0) { bootloader_entry_set_options(e, str_data(str_builder_build(sb_options))); }
    if (bootloader_entry_id(e) == 0) { return count; }
    if (max_entries == 0) { return count; }
    if (count >= max_entries) { return 0 - 1; }
    store64(result_arr + count * 8, e);
    return count + 1;
}

# Length of the tree glyph bootctl puts before an addon's command line: "└─" where the
# locale is UTF-8, as it is under exec's empty env, else "`-". 0 if there is none.
fn _bootloader_tree_glyph(v): i64 {
    if (v == 0) { return 0; }
    var n = strlen(v);
    if (n >= 2) {
        if (memeq(v, "`-", 2) == 1) { return 2; }
    }
    if (n < 6) { return 0; }
    if (memeq(v, "\xe2\x94\x94\xe2\x94\x80", 6) == 1) { return 6; }
    return 0;
}

# An "options:" value as it boots: no glyph, and one pair of quotes off, which systemd-boot
# does to a Type #1 file's lines. A Type #2 entry's line is the UKI's own, and nothing
# unquotes that.
fn _bootloader_bootctl_option(line, linelen, kp, type2): i64 {
    var v = bootloader_extract_value(line, linelen, kp);
    if (v == 0) { return 0; }
    var text = v + _bootloader_tree_glyph(v);
    if (type2 == 1) { return text; }
    return _bootloader_unquote(text);
}

# What a block can only be sure of once it ends: its extras, and that a Type #2 entry's
# "linux:" was a UKI. Returns 0.
fn _bootloader_bootctl_finish(e, sb_extra, type2): i64 {
    if (e == 0) { return 0; }
    if (sb_extra != 0) { bootloader_entry_set_extra(e, str_data(str_builder_build(sb_extra))); }
    if (type2 != 1) { return 0; }
    if (bootloader_entry_linux(e) == 0) { return 0; }
    bootloader_entry_set_uki(e, bootloader_entry_linux(e));
    bootloader_entry_set_linux(e, 0);
    return 0;
}

# Parse `bootctl list` text, for a bootctl too old to print JSON. Prefer
# bootloader_parse_bootctl_json. Each entry is a block of right-aligned
# "key: value" lines, blocks separated by a blank line:
#
#         type: Boot Loader Specification Type #1 (.conf)
#        title: Arch Linux (linux) (default) (selected)
#           id: 2026-05-24_21-49-02_linux.conf
#       source: /boot//loader/entries/2026-05-24_21-49-02_linux.conf ...
#        linux: /boot//vmlinuz-linux
#       initrd: /boot//intel-ucode.img
#               /boot//initramfs-linux.img
#      options: root=PARTUUID=... rw
#
# The entry is the whole block, so a field's position in it does not matter.
# (1.6.1 and earlier opened a new entry on "id:"; bootctl prints "title:"
# first, so every entry got the NEXT entry's title and the last got none.)
# A block without an "id:" line is not an entry and is dropped.
#
# bootctl prints a second and later initrd — and a multi-line options value,
# e.g. a UKI cmdline containing a newline — as unlabelled continuation lines.
# Both are joined into the field with one space: dropping an options line
# would drop a kernel parameter (say init=/bin/sh) from what a caller checks
# with bootloader_validate_kernel_cmdline. Continuation lines under any other
# key (devicetree-overlay, ...) are ignored. Three more differ from an entry file. bootctl
# prints a Type #2 UKI under "linux:", so the block's "type:" moves it to uki. It prints an
# addon's command line as an "options:" line after "extra:", behind a tree glyph, which is
# taken off so the text reaches the validator. And it never unquotes, so an options line
# is unquoted here as systemd-boot would. extra lists what bootctl kept, which is not
# what the file says. See bootloader_entry_boot_kind on what it can and cannot show. What
# makes a line a continuation is
# its indent, never its text: an options line is free to read "x: init=/bin/sh"
# or "id: other.conf", and it stays options. A line of blanks past the colon
# column is an empty continuation, not the end of the block; only a line short of
# that column ends it.
#
# The values are bootctl's DISPLAY text, kept as printed: a title can carry
# bootctl's marks — " (default)", " (selected)", " (not reported/new)",
# " (reported/absent)" — and linux / initrd carry its "<root>//" prefix and,
# for a missing file, a " (No such file or directory)" note. is_default is not
# inferred: the marks are display text an entry's own title can imitate. For
# the entry files' own values use bootloader_list_loader_entries.
fn bootloader_parse_bootctl_list(text, result_arr, max_entries): i64 {
    if (text == 0) { return drm_err_invalid_argument("bootctl text is null"); }
    if (_agnodrm_out_ok(result_arr, max_entries) != 1) {
        return drm_err_invalid_argument("result array is null or max_entries is negative");
    }
    var count = 0;
    var current = 0;
    var sb_initrd = 0;
    var sb_options = 0;
    var sb_extra = 0;
    var type2 = 0;           # this block's "type:" says Type #2
    var cont = 0;            # field continuation lines extend: 0 none, 1 initrd, 2 options
    var colon = 0;           # this block's label colon column, 0 until one is seen
    var textlen = strlen(text);
    var pos = 0;

    while (pos < textlen) {
        var linestart = pos;
        while (pos < textlen) {
            if (load8(text + pos) == 10) { break; }
            pos = pos + 1;
        }
        var linelen = pos - linestart;
        if (pos < textlen) { pos = pos + 1; }
        var line = text + linestart;

        var indent = _bootloader_indent(line, linelen);
        if (indent == linelen) {
            if (colon > 0) {
                if (indent >= colon) { continue; }
            }
            _bootloader_bootctl_finish(current, sb_extra, type2);
            count = _bootloader_bootctl_flush(current, sb_initrd, sb_options, result_arr, max_entries, count);
            if (count < 0) { return drm_err_invalid_argument("more boot entries than max_entries"); }
            current = 0;
            sb_initrd = 0;
            sb_options = 0;
            sb_extra = 0;
            type2 = 0;
            cont = 0;
            colon = 0;
            continue;
        }
        if (current == 0) { current = bootloader_entry_new(); }

        if (_bootloader_is_continuation(line, linelen, indent, colon) == 1) {
            var more = bootloader_extract_value(line, linelen, 0);
            if (cont == 1) { sb_initrd = _bootloader_sb_append(sb_initrd, more); }
            if (cont == 2) { sb_options = _bootloader_sb_append(sb_options, more); }
            continue;
        }
        cont = 0;
        if (colon == 0) {
            var labelled = _bootloader_label_colon(line, linelen, indent);
            if (labelled > 0) { colon = labelled; }
        }

        var kp = bootloader_line_starts_with(line, linelen, "id:");
        if (kp > 0) {
            bootloader_entry_set_id(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "title:");
        if (kp > 0) {
            bootloader_entry_set_title(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "linux:");
        if (kp > 0) {
            bootloader_entry_set_linux(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "initrd:");
        if (kp > 0) {
            sb_initrd = _bootloader_sb_append(sb_initrd, bootloader_extract_value(line, linelen, kp));
            cont = 1;
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "options:");
        if (kp > 0) {
            sb_options = _bootloader_sb_append(sb_options, _bootloader_bootctl_option(line, linelen, kp, type2));
            cont = 2;
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "type:");
        if (kp > 0) {
            var ty = bootloader_extract_value(line, linelen, kp);
            if (ty != 0) {
                if (strstr(ty, "Type #2") >= 0) { type2 = 1; }
            }
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "version:");
        if (kp > 0) {
            bootloader_entry_set_version(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "efi:");
        if (kp > 0) {
            bootloader_entry_set_efi(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "uki:");
        if (kp > 0) {
            bootloader_entry_set_uki(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "uki-url:");
        if (kp > 0) {
            bootloader_entry_set_uki_url(current, bootloader_extract_value(line, linelen, kp));
            continue;
        }
        kp = bootloader_line_starts_with(line, linelen, "extra:");
        if (kp > 0) {
            sb_extra = _bootloader_sb_append(sb_extra, bootloader_extract_value(line, linelen, kp));
            continue;
        }
    }
    _bootloader_bootctl_finish(current, sb_extra, type2);
    count = _bootloader_bootctl_flush(current, sb_initrd, sb_options, result_arr, max_entries, count);
    if (count < 0) { return drm_err_invalid_argument("more boot entries than max_entries"); }

    return Ok(count);
}

# The strings of the JSON array at `i`, joined with one space, or 0 for anything else, which
# for "addons" is usually a null.
fn _bootloader_json_join(obj, n, i): i64 {
    if (i < 0) { return 0; }
    if (load8(obj + i) != 91) { return 0; }
    var end = _agnodrm_json_skip_value(obj, n, i);
    if (end < 0) { return 0; }
    var sb = 0;
    var j = _agnodrm_json_ws(obj, n, i + 1);
    while (j < end - 1) {
        sb = _bootloader_sb_append(sb, _agnodrm_json_cstr(obj, n, j));
        j = _agnodrm_json_skip_value(obj, n, j);
        if (j < 0) { break; }
        j = _agnodrm_json_ws(obj, n, j);
        if (j >= end - 1) { break; }
        if (load8(obj + j) != 44) { break; }
        j = _agnodrm_json_ws(obj, n, j + 1);
    }
    if (sb == 0) { return 0; }
    return str_data(str_builder_build(sb));
}

# 1 if the object holds an escaped NUL. No C string from bootctl can, and a field that held
# one would read as absent, so `cmdline` would fall back to `options` and hide what follows.
fn _bootloader_json_has_nul(obj, n): i64 {
    var i = 0;
    while (i + 5 < n) {
        if (load8(obj + i) == 92) {
            if (memeq(obj + i + 1, "u0000", 5) == 1) { return 1; }
            i = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# A UKI's command line as sd-stub hands it on: control characters and blanks are spaces, and
# none at either end. `v` is changed in place. Returns `v`, or 0 if nothing is left.
fn _bootloader_mangle_cmdline(v): i64 {
    if (v == 0) { return 0; }
    var n = strlen(v);
    var i = 0;
    while (i < n) {
        var c = load8(v + i);
        if (c < 32 || c == 127) { store8(v + i, 32); }
        i = i + 1;
    }
    while (n > 0) {
        if (load8(v + n - 1) != 32) { break; }
        n = n - 1;
    }
    store8(v + n, 0);
    i = 0;
    while (i < n) {
        if (load8(v + i) != 32) { break; }
        i = i + 1;
    }
    if (i == n) { return 0; }
    return v + i;
}

# The string value of `key` in the object, or 0.
fn _bootloader_json_str(obj, n, key): i64 {
    return _agnodrm_json_cstr(obj, n, _agnodrm_json_field(obj, n, key));
}

# One entry from the JSON object at `obj`, or 0 if it is not an object, has no id, or holds
# an escaped NUL.
#
# `cmdline` is `options` plus what addons add, so it is what the kernel is handed, and it wins
# when present. For a Type #1 entry it carries the quotes systemd-boot takes off a file's
# value, so they come off here too, as far as a joined line allows: the file itself is read
# as well, see _bootloader_take_file. A Type #2 entry's line is the UKI's own, which sd-stub
# mangles and nothing unquotes, and its path comes as "linux", which moves to uki, as in the
# text form. `extras` lists an entry's extras by path, and `addons` the addons among them as
# objects. isDefault is bootctl's own answer, where the text form has only a mark a title
# can imitate.
fn _bootloader_json_entry(obj, n): i64 {
    if (_bootloader_json_has_nul(obj, n) == 1) { return 0; }
    var id = _bootloader_json_str(obj, n, "id");
    if (id == 0) { return 0; }
    var e = bootloader_entry_new();
    bootloader_entry_set_id(e, id);
    bootloader_entry_set_title(e, _bootloader_json_str(obj, n, "title"));
    if (bootloader_entry_title(e) == 0) {
        bootloader_entry_set_title(e, _bootloader_json_str(obj, n, "showTitle"));
    }
    bootloader_entry_set_version(e, _bootloader_json_str(obj, n, "version"));
    bootloader_entry_set_linux(e, _bootloader_json_str(obj, n, "linux"));
    bootloader_entry_set_efi(e, _bootloader_json_str(obj, n, "efi"));
    bootloader_entry_set_uki(e, _bootloader_json_str(obj, n, "uki"));
    bootloader_entry_set_uki_url(e, _bootloader_json_str(obj, n, "ukiUrl"));
    bootloader_entry_set_initrd(e, _bootloader_json_join(obj, n, _agnodrm_json_field(obj, n, "initrd")));
    bootloader_entry_set_extra(e, _bootloader_json_join(obj, n, _agnodrm_json_field(obj, n, "extras")));
    var line = _bootloader_json_str(obj, n, "cmdline");
    if (line == 0) { line = _bootloader_json_str(obj, n, "options"); }
    var ty = _bootloader_json_str(obj, n, "type");
    var uki = 0;
    if (ty != 0) { uki = streq(ty, "type2"); }
    if (uki == 1) {
        bootloader_entry_set_options(e, _bootloader_mangle_cmdline(line));
        _bootloader_bootctl_finish(e, 0, 1);
    } else {
        bootloader_entry_set_options(e, _bootloader_unquote(line));
    }
    var dflt = _agnodrm_json_field(obj, n, "isDefault");
    if (dflt >= 0) {
        if (_agnodrm_json_is(obj, n, dflt, "true") == 1) { bootloader_entry_set_is_default(e, 1); }
    }
    return e;
}

# Parse `bootctl list --json=short` output: an array of objects, one per entry. Prefer this to
# bootloader_parse_bootctl_list, whose input is display text a value can reshape. A blank line
# in a UKI's .uname, or a newline in an addon's command line, is one escaped character here.
# Fields are the entry's own, so linux has no "<root>//" prefix and no display marks, and
# Automatic entries come back too, with an id, a title and no boot key.
#
# Returns Result: Ok(count), or Err if the text is not one whole array of objects each with
# an id, or there are more entries than max_entries: an entry a caller cannot see is one it
# cannot validate. max_entries 0 asks for nothing and is no overflow.
fn bootloader_parse_bootctl_json(text, result_arr, max_entries): i64 {
    if (text == 0) { return drm_err_invalid_argument("bootctl json is null"); }
    if (_agnodrm_out_ok(result_arr, max_entries) != 1) {
        return drm_err_invalid_argument("result array is null or max_entries is negative");
    }
    var n = strlen(text);
    var i = _agnodrm_json_ws(text, n, 0);
    if (i >= n) { return drm_err_invalid_argument("bootctl json is empty"); }
    if (load8(text + i) != 91) { return drm_err_invalid_argument("bootctl json is not an array"); }
    var end = _agnodrm_json_skip_value(text, n, i);
    if (end < 0) { return drm_err_invalid_argument("bootctl json is not one whole array"); }
    if (_agnodrm_json_ws(text, n, end) != n) {
        return drm_err_invalid_argument("bootctl json is not one whole array");
    }
    var count = 0;
    i = _agnodrm_json_ws(text, n, i + 1);
    while (i < end - 1) {
        var after = _agnodrm_json_skip_value(text, n, i);
        if (after < 0) { return drm_err_invalid_argument("bootctl json entry is cut short"); }
        var e = _bootloader_json_entry(text + i, after - i);
        if (e == 0) { return drm_err_invalid_argument("bootctl json entry cannot be read"); }
        if (max_entries != 0) {
            if (count >= max_entries) { return drm_err_invalid_argument("more boot entries than max_entries"); }
            store64(result_arr + count * 8, e);
            count = count + 1;
        }
        i = _agnodrm_json_ws(text, n, after);
        if (i >= end - 1) { break; }
        if (load8(text + i) != 44) { return drm_err_invalid_argument("bootctl json has no comma between entries"); }
        i = _agnodrm_json_ws(text, n, i + 1);
        if (i >= end - 1) { return drm_err_invalid_argument("bootctl json ends in a comma"); }
    }
    return Ok(count);
}

# ================================================================
# Kernel command line validation
# ================================================================

# DEPRECATED since 1.6.2, removed in 2.0.0 (roadmap V2.0). Case-insensitive
# SUBSTRING search for `token` in text[0..textlen); returns 1 or 0. It is
# looser than bootloader_validate_kernel_cmdline, which matches exact
# space-delimited tokens. Migration: use bootloader_validate_kernel_cmdline.
#deprecated("use bootloader_validate_kernel_cmdline (exact-token match); removed in agnodrm 2.0.0")
fn bootloader_is_dangerous_token(text, textlen, token): i64 {
    var tlen = strlen(token);
    if (tlen > textlen) { return 0; }
    var i = 0;
    var limit = textlen - tlen;
    while (i <= limit) {
        var found = 1;
        var j = 0;
        while (j < tlen) {
            var c1 = load8(text + i + j);
            var c2 = load8(token + j);
            # Lowercase c1 if uppercase
            if (c1 >= 65) { if (c1 <= 90) { c1 = c1 + 32; } }
            if (c1 != c2) { found = 0; break; }
            j = j + 1;
        }
        if (found == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# What a danger-map key means: the whole token matches; the key part names a switch
# whose value turns a protection off; the key part is dangerous with any value; the token
# matches only standing alone, for a word as common as "1".
enum BootloaderDanger {
    BL_DANGER_TOKEN = 1;
    BL_DANGER_IF_OFF = 2;
    BL_DANGER_ANY_VALUE = 4;
    BL_DANGER_BARE = 8;
}

var _bootloader_danger_map = 0;

fn bootloader_danger_reset(): i64 { _bootloader_danger_map = 0; return 0; }

# Copy `n` bytes at `src` to `out` the way the kernel reads a parameter: quotes go
# (next_arg strips them), and before the first '=' a '-' is a '_' (parameq folds them,
# as systemd does for its own). Lowercased, because this check is case-insensitive.
# Returns the new length. Without this, init="/bin/sh" and init-on-alloc=0 passed.
fn _bootloader_norm_token(src, n, out): i64 {
    var len = 0;
    var inkey = 1;
    var i = 0;
    while (i < n) {
        var c = load8(src + i);
        i = i + 1;
        if (c == 34) { continue; }
        if (c == 39) { continue; }   # bootctl shows a quote systemd-boot takes off
        if (c == 61) { inkey = 0; }
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (inkey == 1) {
            if (c == 45) { c = 95; }
        }
        store8(out + len, c);
        len = len + 1;
    }
    store8(out + len, 0);
    return len;
}

# Add `key` in its normal form, so an entry is spelled here as people spell it.
fn _bootloader_danger_add(key, kind): i64 {
    var n = strlen(key);
    var norm = alloc(n + 1);
    _bootloader_norm_token(key, n, norm);
    map_set(_bootloader_danger_map, norm, map_get(_bootloader_danger_map, norm) | kind);
    return 0;
}

fn _bootloader_danger_init(): i64 {
    if (_bootloader_danger_map != 0) { return 0; }
    _bootloader_danger_map = map_new();
    var m = BL_DANGER_TOKEN;
    # Single-user / shell-escape patterns. An init= shell is matched by file name in any
    # directory; see _bootloader_init_is_shell.
    _bootloader_danger_add("single", m);
    _bootloader_danger_add("emergency", m);
    _bootloader_danger_add("rd.break", m);
    _bootloader_danger_add("rd.shell", m);
    _bootloader_danger_add("rd.shell=1", m);
    _bootloader_danger_add("debug_shell", m);
    _bootloader_danger_add("systemd.debug-shell", m);
    # Rescue / emergency targets — the systemd spelling of `single`.
    _bootloader_danger_add("rescue", m);
    _bootloader_danger_add("rd.rescue", m);
    _bootloader_danger_add("systemd.unit=rescue.target", m);
    _bootloader_danger_add("systemd.unit=emergency.target", m);
    _bootloader_danger_add("rd.systemd.unit=rescue.target", m);
    _bootloader_danger_add("rd.systemd.unit=emergency.target", m);
    _bootloader_danger_add("systemd.unit=rescue", m);
    _bootloader_danger_add("systemd.unit=emergency", m);
    # F-8 (1.1.14): kernel-lockdown / module-signing downgrades
    _bootloader_danger_add("lockdown=none", m);
    _bootloader_danger_add("lockdown=integrity", m);
    # LSM disable / downgrade spellings the off-values below do not cover.
    _bootloader_danger_add("security=none", m);
    _bootloader_danger_add("selinux=permissive", m);
    # F-8: EFI / DMA-protection escape
    _bootloader_danger_add("efi=disable_early_pci_dma", m);
    _bootloader_danger_add("efi=no_disable_early_pci_dma", m);
    # CPU-mitigation and KASLR / NX downgrades with no value to read.
    _bootloader_danger_add("nopti", m);
    _bootloader_danger_add("nospectre_v1", m);
    _bootloader_danger_add("nospectre_v2", m);
    _bootloader_danger_add("nospec_store_bypass_disable", m);
    _bootloader_danger_add("nosmep", m);
    _bootloader_danger_add("nosmap", m);
    _bootloader_danger_add("nokaslr", m);

    # The SysV spellings of `single`. Inside a quoted value these are ordinary words: a
    # dm-verity table holds a 1.
    m = BL_DANGER_BARE;
    _bootloader_danger_add("s", m);
    _bootloader_danger_add("-s", m);
    _bootloader_danger_add("1", m);

    # Switches whose every "off" spelling (0, off, n, no, false) is the downgrade.
    m = BL_DANGER_IF_OFF;
    _bootloader_danger_add("selinux", m);
    _bootloader_danger_add("apparmor", m);
    _bootloader_danger_add("enforcing", m);
    _bootloader_danger_add("audit", m);
    _bootloader_danger_add("module.sig_enforce", m);
    _bootloader_danger_add("loadpin.enforce", m);
    _bootloader_danger_add("init_on_alloc", m);
    _bootloader_danger_add("init_on_free", m);
    _bootloader_danger_add("slab_nomerge", m);
    _bootloader_danger_add("kaslr", m);
    _bootloader_danger_add("noexec", m);
    _bootloader_danger_add("mitigations", m);
    _bootloader_danger_add("pti", m);
    _bootloader_danger_add("spectre_v2", m);
    _bootloader_danger_add("spectre_v2_user", m);
    _bootloader_danger_add("spec_store_bypass_disable", m);
    _bootloader_danger_add("l1tf", m);
    _bootloader_danger_add("mds", m);
    _bootloader_danger_add("tsx_async_abort", m);
    _bootloader_danger_add("retbleed", m);
    _bootloader_danger_add("iommu", m);
    _bootloader_danger_add("intel_iommu", m);
    _bootloader_danger_add("amd_iommu", m);

    # Any value: `rdinit=` overrides the initramfs init, the escape `init=` gives, and
    # never appears in an ordinary cmdline; rd.break= names where to drop to a shell;
    # systemd.run= runs its value.
    m = BL_DANGER_ANY_VALUE;
    _bootloader_danger_add("rdinit", m);
    _bootloader_danger_add("rd.break", m);
    _bootloader_danger_add("systemd.run", m);
    return 0;
}

# 1 if `val` (`n` bytes) is one of the spellings a kernel switch reads as off.
fn _bootloader_value_is_off(val, n): i64 {
    if (n == 1) {
        if (load8(val) == 48) { return 1; }             # 0
        return load8(val) == 110;                       # n
    }
    if (n == 2) { return memeq(val, "no", 2); }
    if (n == 3) { return memeq(val, "off", 3); }
    if (n == 5) { return memeq(val, "false", 5); }
    return 0;
}

# 1 if the init= value `val` ends in the name of an interpreter or rescue tool, in any
# directory: /bin/sh, /usr/bin/bash, /tmp/x/sh. Listing directories missed the /usr
# spelling of every shell on a merged system.
fn _bootloader_init_is_shell(val, n): i64 {
    var base = 0;
    var i = 0;
    while (i < n) {
        if (load8(val + i) == 47) { base = i + 1; }
        i = i + 1;
    }
    var name = val + base;
    var len = n - base;
    if (len < 2) { return 0; }
    if (streq(name, "sh") == 1) { return 1; }
    if (streq(name, "ash") == 1) { return 1; }
    if (streq(name, "bash") == 1) { return 1; }
    if (streq(name, "rbash") == 1) { return 1; }
    if (streq(name, "dash") == 1) { return 1; }
    if (streq(name, "zsh") == 1) { return 1; }
    if (streq(name, "ksh") == 1) { return 1; }
    if (streq(name, "csh") == 1) { return 1; }
    if (streq(name, "tcsh") == 1) { return 1; }
    if (streq(name, "fish") == 1) { return 1; }
    if (streq(name, "busybox") == 1) { return 1; }
    if (streq(name, "sulogin") == 1) { return 1; }
    return 0;
}

# 1 if the normalised, NUL-terminated token at `tok` is dangerous. `bare` is 1 unless the
# word sat inside a quoted value.
fn _bootloader_token_danger(tok, tlen, bare): i64 {
    var whole = map_get(_bootloader_danger_map, tok);
    if ((whole & BL_DANGER_TOKEN) != 0) { return 1; }
    if ((whole & BL_DANGER_BARE) != 0) { return bare; }
    var eq = 0;
    while (eq < tlen) {
        if (load8(tok + eq) == 61) { break; }
        eq = eq + 1;
    }
    if (eq == 0) { return 0; }
    if (eq == tlen) { return 0; }
    var val = tok + eq + 1;
    var vlen = tlen - eq - 1;
    if (eq == 4) {
        if (memeq(tok, "init", 4) == 1) { return _bootloader_init_is_shell(val, vlen); }
    }
    store8(tok + eq, 0);
    var kind = map_get(_bootloader_danger_map, tok);
    store8(tok + eq, 61);
    if ((kind & BL_DANGER_ANY_VALUE) != 0) { return 1; }
    if ((kind & BL_DANGER_IF_OFF) != 0) { return _bootloader_value_is_off(val, vlen); }
    return 0;
}

# Denylist check for a kernel cmdline: Ok(0) means no listed footgun matched,
# NOT that the cmdline is safe.
#
# Returns Result: Ok(0) if no known-dangerous parameter was found, Err if one
# was, or if the cmdline is malformed (non-printable, non-ASCII, > 4096 chars).
#
# NOTE: Ok(0) means "nothing on the denylist matched" — NOT "this cmdline is
# safe". Every space-separated word is checked, inside quotes too: the kernel holds a
# quoted value together, but an initramfs may not, and dracut-style parsers split words
# their own way, so foo="x rd.break y" is refused. Only a word as common as "1" is
# exempt inside quotes, so dm-mod.create="... verity 1 ..." passes. Each word is read as
# the kernel reads a parameter (quotes stripped, '-' and '_' folded in the name, either
# case), then matched exactly, by an off-value of a known switch, or by an init= shell's
# file name. An unlisted interpreter, an equivalent spelling, or a novel kernel
# parameter passes. Treat this as a hygiene check that catches known footguns, not as an
# authorisation boundary. An allowlist-based API is roadmap V2.0.
fn bootloader_validate_kernel_cmdline(options): i64 {
    if (options == 0) {
        return drm_err_invalid_argument("kernel cmdline is null");
    }

    var optlen = strlen(options);
    if (optlen > 4096) {
        return drm_err_invalid_argument("kernel command line exceeds 4096-character limit");
    }

    # Single pass: validate chars + extract space-delimited tokens + check dangerous list.
    _bootloader_danger_init();

    var i = 0;
    var tok_start = 0;
    var quoted = 0;
    var word_quoted = 0;
    while (i <= optlen) {
        var c = 0;
        if (i < optlen) { c = load8(options + i); }
        if (c == 34) { quoted = 1 - quoted; }

        # Check printable ASCII (space=32..tilde=126)
        if (i < optlen) {
            if (c < 32) {
                return drm_err_invalid_argument("kernel cmdline contains non-printable characters");
            }
            if (c > 126) {
                return drm_err_invalid_argument("kernel cmdline contains non-ASCII characters");
            }
        }

        # On a space or end-of-string, check the word. It stands alone if it neither
        # started nor ended inside quotes.
        if (c == 32 || i == optlen) {
            var bare = 1 - quoted;
            if (word_quoted == 1) { bare = 0; }
            word_quoted = quoted;
            var tlen = i - tok_start;
            if (tlen > 0) {
                # Extract the token to a NUL-terminated buffer. Scratch for a long one: cut
                # short, init=/<128 bytes>/sh lost the name that makes it a shell.
                var tok[128];
                var tokp = &tok;
                var big = 0;
                if (tlen > 127) {
                    big = _agnodrm_scratch_new(tlen + 1);
                    if (big == 0) { return drm_err_io(ENOMEM, "no memory for a cmdline token"); }
                    tokp = big;
                }
                var nlen = _bootloader_norm_token(options + tok_start, tlen, tokp);
                var hit = _bootloader_token_danger(tokp, nlen, bare);
                if (big != 0) { _agnodrm_scratch_free(big, tlen + 1); }
                if (hit == 1) {
                    return drm_err_invalid_argument("kernel cmdline contains dangerous parameter");
                }
            }
            tok_start = i + 1;
        }
        i = i + 1;
    }

    return Ok(0);
}

# Bootloader type to string.
fn bootloader_type_str(bt): i64 {
    if (bt == BOOT_SYSTEMD_BOOT) { return "systemd-boot"; }
    if (bt == BOOT_GRUB2) { return "GRUB2"; }
    return "unknown";
}

# --- update.cyr ---

# update.cyr — atomic updates, version comparison, update manifest
# Ported from rust-old/src/update.rs
#
# Provides atomic file operations (write, copy, swap), CalVer version
# comparison (YYYY.M.D), and update manifest validation.
#
# Requires: src/error.cyr, lib/syscalls.cyr

# Included directly (as drm.cyr does) for the per-target O_* open flags;
# include-once, so includers pay nothing.
include "lib/syscalls.cyr"

# ================================================================
# Update slot constants
# ================================================================

enum UpdateSlot {
    SLOT_A = 1;
    SLOT_B = 2;
}

# ================================================================
# Update phase constants
# ================================================================

enum UpdatePhase {
    PHASE_DOWNLOADING = 1;
    PHASE_VERIFYING = 2;
    PHASE_APPLYING = 3;
    PHASE_FINALIZING = 4;
    PHASE_ROLLING_BACK = 5;
    PHASE_COMPLETE = 6;
    PHASE_FAILED = 7;
}

# ================================================================
# Version comparison result constants
# ================================================================

# Version comparison results (can't use negative in enum)
var VER_LESS = 0 - 1;
var VER_EQUAL = 0;
var VER_GREATER = 1;

enum UpdateLimits {
    UPDATE_JSON_MAX = 1048576;       # the state file and a manifest, bytes
    UPDATE_STATE_FIELD_MAX = 1024;   # one saved version string, bytes
    UPDATE_CMDLINE_MAX = 8192;       # past this /proc/cmdline cannot be read whole
    UPDATE_COPY_CHUNK = 1048576;
    UPDATE_BOOTS_MAX = 1000000000000000000;  # 18 digits, what the reader takes
    UPDATE_VER_FIELD_DIGITS = 6;     # 20 bits; three of them fit a positive i64
    # sha256sum prints nothing until it has read the whole image, and dd prints nothing at
    # all, so these are long: a slot is gigabytes, and a slow disk is not a hung one.
    UPDATE_HASH_DEADLINE_MS = 1800000;
    UPDATE_WRITE_DEADLINE_MS = 3600000;
    UPDATE_VER_FIELD_BITS = 20;
    UPDATE_VER_FIELD_MASK = 0xFFFFF;
}

# ================================================================
# Atomic file write
# ================================================================

# Under AGNODRM_POWERCUT every durable write of the A/B flows calls _update_cut: the state
# and the marker here, the firmware and the slot at their calls. Only
# tests/tcyr/test_powercut.tcyr sets that and defines it, so no shipped build and no bundle
# holds a way to stop mid-update. A new durable write anywhere else needs its own call.
# Publish a finished temp over `dst`: set `mode` (negative leaves the temp's), flush,
# close, rename, then flush the directory, so the rename is on disk before whatever the
# caller does next. Consumes `fd`. Before the rename any failure removes the temp and
# leaves `dst` alone. Returns Result: Ok(0) or Err.
fn _update_commit_tmp(fd, tmppath, dst, mode): i64 {
    var ret = 0;
    if (mode >= 0) { ret = sys_fchmod(fd, mode); }
    if (ret >= 0) { ret = agnodrm_fsync(fd); }
    file_close(fd);
    if (ret < 0) {
        xunlink(tmppath);
        return drm_err_io(0 - ret, "atomic update: chmod or fsync failed");
    }
    ret = agnodrm_rename(tmppath, dst);
    if (ret < 0) {
        xunlink(tmppath);
        return drm_err_io(0 - ret, "atomic update: rename failed");
    }
    ret = _agnodrm_fsync_parent(dst);
    if (ret < 0) {
        return drm_err_io(0 - ret, "atomic update: directory fsync failed");
    }
    #ifdef AGNODRM_POWERCUT
    _update_cut();
    #endif
    return Ok(0);
}

# Atomically write data to a file path. Writes to a temp file first,
# then renames to the target path. A target that exists keeps its permission bits, and
# the temp is born with them, so a 0600 file's new bytes are never readable by more
# than the old ones were (audit F-32). A new file is 0644 before umask.
# path: destination file path (null-terminated).
# data: pointer to data buffer.
# data_len: number of bytes to write.
# Returns Result: Ok(0) or Err.
fn update_atomic_write(path, data, data_len): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("atomic file write (temp-file + Linux fsync/rename)");  # agnos: no A/B update
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0) {
        return drm_err_invalid_argument("atomic_write path is null");
    }
    if (data_len < 0) {
        return drm_err_invalid_argument("atomic_write data_len is negative");
    }

    # Write to an exclusive temp beside the target; see agnodrm_tmp_create.
    var mode = _agnodrm_file_mode(path);
    var born = 0x1A4;  # mode 0644
    if (mode >= 0) { born = mode; }
    var tmppath = 0;
    var fd = _agnodrm_tmp_open(path, &tmppath, born);
    if (fd < 0) {
        return drm_err_io(0 - fd, "atomic_write: failed to create temp file");
    }

    var ret = _agnodrm_write_all(fd, data, data_len);
    if (ret < 0) {
        file_close(fd);
        xunlink(tmppath);
        return drm_err_io(0 - ret, "atomic_write: write failed");
    }

    var res_t, res_v = _update_commit_tmp(fd, tmppath, path, mode);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(0);
    #endif
}

# ================================================================
# Atomic file copy
# ================================================================

# Copy all of `src_fd` to `dst_fd`. Returns the byte count, or a negative errno.
fn _update_copy_fd(src_fd, dst_fd): i64 {
    var cap = UPDATE_COPY_CHUNK;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) { return 0 - ENOMEM; }
    var total = 0;
    while (1) {
        var n = _agnodrm_read_all(src_fd, buf, cap);
        if (n < 0) {
            total = n;
            break;
        }
        if (n == 0) { break; }
        var w = _agnodrm_write_all(dst_fd, buf, n);
        if (w < 0) {
            total = w;
            break;
        }
        total = total + n;
    }
    _agnodrm_scratch_free(buf, cap);
    return total;
}

# Atomically copy src to dst (via temp + rename). As with cp, an existing dst keeps its
# permission bits and a new one takes src's, so a 0600 key stays 0600 and a tool stays
# executable (audit F-32).
# Returns Result: Ok(bytes_copied) or Err.
fn update_atomic_copy(src, dst): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("atomic file copy (temp-file + Linux fsync/rename)");  # agnos: no A/B update
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (src == 0) { return drm_err_invalid_argument("atomic_copy src is null"); }
    if (dst == 0) { return drm_err_invalid_argument("atomic_copy dst is null"); }

    # Open source
    var src_fd = sys_open(src, O_RDONLY | O_CLOEXEC, 0);
    if (src_fd < 0) {
        return drm_err_io(0 - src_fd, "atomic_copy: failed to open source");
    }

    var mode = _agnodrm_file_mode(dst);
    var born = mode;
    if (mode < 0) {
        var st = alloc(STAT_BUFSZ);
        born = 0x1A4;  # mode 0644
        if (sys_fstat(src_fd, st) == 0) {
            mode = load32(st + STAT_MODE) & 0x1FF;
            born = mode;
        }
    }

    # Exclusive temp beside the destination; see agnodrm_tmp_create.
    var tmppath = 0;
    var dst_fd = _agnodrm_tmp_open(dst, &tmppath, born);
    if (dst_fd < 0) {
        file_close(src_fd);
        return drm_err_io(0 - dst_fd, "atomic_copy: failed to create temp dest");
    }

    var total = _update_copy_fd(src_fd, dst_fd);
    file_close(src_fd);
    if (total < 0) {
        file_close(dst_fd);
        xunlink(tmppath);
        return drm_err_io(0 - total, "atomic_copy: copy failed");
    }

    var res_t, res_v = _update_commit_tmp(dst_fd, tmppath, dst, mode);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(total);
    #endif
}

# ================================================================
# Version validation (CalVer YYYY.M.D)
# ================================================================

# Pack "Y.M.D" into one positive integer that orders as the version does, or -1 if it
# is not exactly three runs of 1 to UPDATE_VER_FIELD_DIGITS digits. The digit cap is what
# stops the wrap: unbounded, 18446744073709553642.1.1 parsed as 2026.1.1 and passed
# validation (audit F-52). No heap: update_compare_versions is called per candidate.
fn _update_version_key(version): i64 {
    if (version == 0) { return 0 - 1; }
    var key = 0;
    var field = 0;
    var digits = 0;
    var parts = 0;
    var i = 0;
    while (1) {
        var c = load8(version + i);
        i = i + 1;
        if (c >= 48 && c <= 57) {
            digits = digits + 1;
            if (digits > UPDATE_VER_FIELD_DIGITS) { return 0 - 1; }
            field = field * 10 + (c - 48);
            continue;
        }
        if (c != 46) {
            if (c != 0) { return 0 - 1; }
        }
        if (digits == 0) { return 0 - 1; }
        key = (key << UPDATE_VER_FIELD_BITS) | field;
        parts = parts + 1;
        if (c == 0) { break; }
        if (parts == 3) { return 0 - 1; }
        field = 0;
        digits = 0;
    }
    if (parts != 3) { return 0 - 1; }
    return key;
}

# Parse a version string into { year, month, day }.
# Returns pointer to 24-byte struct, or 0 on parse failure.
fn update_parse_version(version): i64 {
    var key = _update_version_key(version);
    if (key < 0) { return 0; }
    var v = alloc(24);
    store64(v, key >> (UPDATE_VER_FIELD_BITS * 2));
    store64(v + 8, (key >> UPDATE_VER_FIELD_BITS) & UPDATE_VER_FIELD_MASK);
    store64(v + 16, key & UPDATE_VER_FIELD_MASK);
    return v;
}

fn _update_month_days(year, month): i64 {
    if (month == 2) {
        if (year % 4 != 0) { return 28; }
        if (year % 100 == 0) {
            if (year % 400 != 0) { return 28; }
        }
        return 29;
    }
    if (month == 4) { return 30; }
    if (month == 6) { return 30; }
    if (month == 9) { return 30; }
    if (month == 11) { return 30; }
    return 31;
}

# Validate a CalVer version string (YYYY.M.D): a real date in 2024-2100.
# Returns Result: Ok(0) or Err.
fn update_validate_version(version): i64 {
    var key = _update_version_key(version);
    if (key < 0) {
        return drm_err_invalid_argument("version must have exactly 3 parts (YYYY.M.D)");
    }
    var year = key >> (UPDATE_VER_FIELD_BITS * 2);
    var month = (key >> UPDATE_VER_FIELD_BITS) & UPDATE_VER_FIELD_MASK;
    var day = key & UPDATE_VER_FIELD_MASK;

    if (year < 2024) {
        return drm_err_invalid_argument("version year out of range (2024-2100)");
    }
    if (year > 2100) {
        return drm_err_invalid_argument("version year out of range (2024-2100)");
    }
    if (month < 1) {
        return drm_err_invalid_argument("version month out of range (1-12)");
    }
    if (month > 12) {
        return drm_err_invalid_argument("version month out of range (1-12)");
    }
    if (day < 1) {
        return drm_err_invalid_argument("version day out of range");
    }
    if (day > _update_month_days(year, month)) {
        return drm_err_invalid_argument("version day out of range");
    }
    return Ok(0);
}

# ================================================================
# Version comparison
# ================================================================

# Byte-wise order of two C strings, a null reading as empty.
fn _update_compare_text(a, b): i64 {
    if (a == 0) { a = ""; }
    if (b == 0) { b = ""; }
    var i = 0;
    while (1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca < cb) { return VER_LESS; }
        if (ca > cb) { return VER_GREATER; }
        if (ca == 0) { return VER_EQUAL; }
        i = i + 1;
    }
    return VER_EQUAL;
}

# Compare two CalVer version strings.
# Returns VER_LESS (-1), VER_EQUAL (0), or VER_GREATER (1).
# Anything malformed orders below any version, and two malformed strings compare
# byte by byte.
fn update_compare_versions(a, b): i64 {
    var ka = _update_version_key(a);
    var kb = _update_version_key(b);
    if (ka < 0) {
        if (kb < 0) { return _update_compare_text(a, b); }
        return VER_LESS;
    }
    if (kb < 0) { return VER_GREATER; }
    if (ka < kb) { return VER_LESS; }
    if (ka > kb) { return VER_GREATER; }
    return VER_EQUAL;
}

# ================================================================
# Update slot helpers
# ================================================================

fn update_other_slot(slot): i64 {
    if (slot == SLOT_A) { return SLOT_B; }
    return SLOT_A;
}

fn update_slot_suffix(slot): i64 {
    if (slot == SLOT_A) { return "a"; }
    return "b";
}

fn update_slot_str(slot): i64 {
    if (slot == SLOT_A) { return "A"; }
    return "B";
}

fn update_phase_str(phase): i64 {
    if (phase == PHASE_DOWNLOADING) { return "Downloading"; }
    if (phase == PHASE_VERIFYING) { return "Verifying"; }
    if (phase == PHASE_APPLYING) { return "Applying"; }
    if (phase == PHASE_FINALIZING) { return "Finalizing"; }
    if (phase == PHASE_ROLLING_BACK) { return "Rolling back"; }
    if (phase == PHASE_COMPLETE) { return "Complete"; }
    if (phase == PHASE_FAILED) { return "Failed"; }
    return "Unknown";
}

# ================================================================
# Update channel constants
# ================================================================

enum UpdateChannel {
    CHAN_STABLE = 1;
    CHAN_BETA = 2;
    CHAN_NIGHTLY = 3;
    CHAN_CUSTOM = 4;
}

fn update_channel_str(channel): i64 {
    if (channel == CHAN_STABLE) { return "stable"; }
    if (channel == CHAN_BETA) { return "beta"; }
    if (channel == CHAN_NIGHTLY) { return "nightly"; }
    return "custom";
}

# ================================================================
# UpdateState struct — 6 fields * 8 = 48 bytes.
# Field names match 1.0 getters (`slot`/`version`/`pending`/
# `rollback_available`/`boot_count`), not the doc-comment names
# (`current_slot`/`current_version`/`pending_update`/
# `boot_count_since_update`). The 1.0 `set_rollback/2` setter
# (asymmetric — getter is `rollback_available`) stays as a thin
# wrapper. `previous` is the version on the slot left behind, known
# once an image is confirmed over it, or 0.
# ================================================================

#derive(accessors)
struct update_state { slot; version; pending; rollback_available; boot_count; previous; }

fn update_state_new(slot, version): i64 {
    var s = alloc(48);
    update_state_set_slot(s, slot);
    update_state_set_version(s, version);
    update_state_set_pending(s, 0);
    update_state_set_rollback_available(s, 0);
    update_state_set_boot_count(s, 0);
    update_state_set_previous(s, 0);
    return s;
}

# 1.0 API preservation — `set_rollback` (asymmetric) delegates
# through `set_rollback_available`.
fn update_state_set_rollback(s, val): i64 { return update_state_set_rollback_available(s, val); }

# Hand-rolled JSON serializer — cstring fields; see roadmap.md V1.1.12.
fn update_state_to_json(s, sb): i64 {
    str_builder_add_cstr(sb, "{\"slot\":");
    str_builder_add_int(sb, update_state_slot(s));
    str_builder_add_cstr(sb, ",\"version\":");
    agnodrm_json_emit_cstr_or_null(sb, update_state_version(s));
    # `pending` holds a cstring (the pending version, or 0), like `version`.
    # Through 1.6.1 it went through str_builder_add_int, so a pending update
    # serialized as the heap address of its version string.
    str_builder_add_cstr(sb, ",\"pending\":");
    agnodrm_json_emit_cstr_or_null(sb, update_state_pending(s));
    str_builder_add_cstr(sb, ",\"rollback_available\":");
    str_builder_add_int(sb, update_state_rollback_available(s));
    str_builder_add_cstr(sb, ",\"boot_count\":");
    str_builder_add_int(sb, update_state_boot_count(s));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# UpdateConfig struct — 7 fields * 8 = 56 bytes.
# Field names match 1.0 getters: `url`/`slot_a`/`slot_b` (not the
# doc names `update_url`/`slot_a_device`/`slot_b_device`). `verify`,
# on by default, compares the image's sha256 to the manifest's before
# update_apply writes it. `max_retries` and `backup_dir` are carried
# and nothing reads them (roadmap.md).
# ================================================================

#derive(accessors)
struct update_config {
    url;
    slot_a;
    slot_b;
    state_file;
    backup_dir;
    max_retries;
    verify;
}

fn update_config_new(): i64 {
    var c = alloc(56);
    update_config_set_url(c, "https://updates.agnos.org");
    update_config_set_slot_a(c, "/dev/disk/by-partlabel/rootfs_a");
    update_config_set_slot_b(c, "/dev/disk/by-partlabel/rootfs_b");
    update_config_set_state_file(c, "/var/lib/agnos/update-state.json");
    update_config_set_backup_dir(c, "/var/lib/agnos/backups");
    update_config_set_max_retries(c, 3);
    update_config_set_verify(c, 1);
    return c;
}

fn update_config_device_for_slot(c, slot): i64 {
    if (slot == SLOT_A) { return update_config_slot_a(c); }
    return update_config_slot_b(c);
}

# ================================================================
# UpdateManifest struct — 6 fields * 8 = 48 bytes.
# Field name `files` matches 1.0 getter (not doc-comment `files_vec`).
# The manifest is not signed; see update_verify_manifest and update_apply. min_version
# is carried and not enforced (roadmap.md).
# ================================================================

#derive(accessors)
struct update_manifest { version; channel; files; release_date; min_version; changelog; }

fn update_manifest_new(version, channel, release_date): i64 {
    var m = alloc(48);
    update_manifest_set_version(m, version);
    update_manifest_set_channel(m, channel);
    update_manifest_set_files(m, vec_new());
    update_manifest_set_release_date(m, release_date);
    update_manifest_set_min_version(m, 0);
    update_manifest_set_changelog(m, 0);
    return m;
}

# ================================================================
# UpdateFile struct — 5 fields * 8 = 40 bytes.
# Field `size` matches 1.0 getter (not the doc/constructor name
# `size_bytes`).
# ================================================================

#derive(accessors)
struct update_file { path; sha256; size; delta_from; compressed; }

fn update_file_new(path, sha256, size_bytes): i64 {
    var f = alloc(40);
    update_file_set_path(f, path);
    update_file_set_sha256(f, sha256);
    update_file_set_size(f, size_bytes);
    update_file_set_delta_from(f, 0);
    update_file_set_compressed(f, 0);
    return f;
}

# ================================================================
# Slot detection
# ================================================================

# Test seam, 0 outside tests/tcyr: the directory the fixed host paths below resolve
# under, so a test can drive the slot paths without touching this host's state or
# running its efibootmgr and argonaut. Nothing but a test sets it.
var _update_root = 0;

fn _update_path(path): i64 {
    if (_update_root == 0) { return path; }
    var rootlen = strlen(_update_root);
    var pathlen = strlen(path);
    var full = alloc(rootlen + pathlen + 1);
    memcpy(full, _update_root, rootlen);
    memcpy(full + rootlen, path, pathlen);
    store8(full + rootlen + pathlen, 0);
    return full;
}

# Find agnos.slot= in `n` bytes of kernel cmdline. Whole tokens only: "xagnos.slot=b" is
# not the key and "agnos.slot=banana" is not slot B. Tokens split as the kernel splits
# them: blanks inside double quotes do not end one, so foo="bar agnos.slot=a" is one
# parameter of foo, and "--" ends the kernel's own parameters, so anything after it is
# init's. Two tokens that disagree are an Err, because update_apply overwrites by this
# answer. Returns Result: Ok(SLOT_A or SLOT_B), Ok(0) if there is none, or Err.
fn _update_scan_cmdline(p, n): i64 {
    var found = 0;
    var pos = 0;
    while (pos < n) {
        var c = load8(p + pos);
        if (c == 32) { pos = pos + 1; continue; }
        if (c == 9) { pos = pos + 1; continue; }
        if (c == 10) { pos = pos + 1; continue; }
        var start = pos;
        var quoted = 0;
        while (pos < n) {
            c = load8(p + pos);
            if (c == 34) { quoted = 1 - quoted; }
            if (quoted == 0) {
                if (c == 32) { break; }
                if (c == 9) { break; }
                if (c == 10) { break; }
            }
            pos = pos + 1;
        }
        var toklen = pos - start;
        if (toklen == 2) {
            if (memeq(p + start, "--", 2) == 1) { break; }
        }
        if (toklen < 11) { continue; }
        if (memeq(p + start, "agnos.slot=", 11) != 1) { continue; }
        var slot = 0;
        if (toklen == 12) {
            var val = load8(p + start + 11);
            if (val == 97) { slot = SLOT_A; }
            if (val == 65) { slot = SLOT_A; }
            if (val == 98) { slot = SLOT_B; }
            if (val == 66) { slot = SLOT_B; }
        }
        if (slot == 0) { return drm_err_invalid_argument("Unknown slot in cmdline"); }
        if (found != 0) {
            if (found != slot) { return drm_err_invalid_argument("Conflicting slots in cmdline"); }
        }
        found = slot;
    }
    return Ok(found);
}

# The slot the kernel cmdline says this boot came from: Ok(SLOT_A or SLOT_B), Ok(0) if
# it has no agnos.slot= token, or Err for one that cannot be read as a slot. A cmdline
# too long to read whole is an Err, since a conflicting token could be past the cut.
fn _update_cmdline_slot(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);            # agnos has no /proc/cmdline
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open(_update_path("/proc/cmdline"), O_RDONLY | O_CLOEXEC, 0);
    if (fd < 0) { return Ok(0); }
    var cap = UPDATE_CMDLINE_MAX + 1;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) {
        sys_close(fd);
        return drm_err_io(ENOMEM, "no memory to read the kernel cmdline");
    }
    var n = _agnodrm_read_all(fd, buf, cap);
    sys_close(fd);
    if (n < 0) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_io(0 - n, "failed to read the kernel cmdline");
    }
    if (n >= cap) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_invalid_argument("kernel cmdline is too long to read whole");
    }
    var res_t, res_v = _update_scan_cmdline(buf, n);
    _agnodrm_scratch_free(buf, cap);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
    #endif
}

# Detect current boot slot by reading /proc/cmdline for "agnos.slot=".
# Falls back to reading the state file, then defaults to slot A.
# Returns Result: Ok(slot) or Err.
#
# The fallbacks are a best guess, for display. The state file records where the next
# boot goes, not where this one came from, so it is wrong between a switch and the
# reboot and after a firmware fallback. update_apply does not use them.
fn update_get_current_slot(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("current boot slot (/proc/cmdline agnos.slot=)");  # agnos: no /proc/cmdline
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cmd_t, cmd_v = _update_cmdline_slot();
    if (is_err_result(cmd_t) == 1) { return Err(cmd_v); }
    if (cmd_v != 0) { return Ok(cmd_v); }

    var st_t, st_v = update_load_state(_update_path("/var/lib/agnos/update-state.json"));
    if (is_ok(st_t) == 1) { return Ok(update_state_slot(st_v)); }

    # Default to slot A
    return Ok(SLOT_A);
    #endif
}

# ================================================================
# State persistence
# ================================================================

# A small reader for the two JSON documents this module takes from disk. It walks the
# tokens, so text inside a string is never read as a key: a version holding
# "rollback_available":true stays a version (audit F-31). Bare substring scans read
# "current_slot":0 as slot 2 and "rollback_available":null as true (audit F-53).

# A heap copy of the string value at `i`, or 0 if there is no string there. One holding
# an escape counts as none: nothing here writes one, and a version never needs one.
fn _update_json_str(p, n, i): i64 {
    if (i >= n) { return 0; }
    if (load8(p + i) != 34) { return 0; }
    var end = _agnodrm_json_skip_str(p, n, i);
    if (end < 0) { return 0; }
    var len = end - i - 2;
    var out = alloc(len + 1);
    memcpy(out, p + i + 1, len);
    store8(out + len, 0);
    if (memchr(out, 92, len) >= 0) { return 0; }
    return out;
}

# 1 if a version string can be saved: bounded, and nothing that JSON would need escaped.
fn _update_state_text_ok(s): i64 {
    if (s == 0) { return 1; }
    var n = strlen(s);
    if (n > UPDATE_STATE_FIELD_MAX) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 32 || c > 126 || c == 34 || c == 92) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Save update state to a JSON file.
# Returns Result: Ok(0) or Err. A slot that is neither A nor B, a negative boot count, or
# a version string JSON would have to escape is refused: nothing is written that
# update_load_state would not read back unchanged (audit F-31, F-53).
fn update_save_state(state, path): i64 {
    if (state == 0) { return drm_err_invalid_argument("state is null"); }
    if (path == 0) { return drm_err_invalid_argument("path is null"); }

    var slot = update_state_slot(state);
    if (slot != SLOT_A) {
        if (slot != SLOT_B) { return drm_err_invalid_argument("state slot is neither A nor B"); }
    }
    var ver = update_state_version(state);
    var pending = update_state_pending(state);
    if (_update_state_text_ok(ver) != 1) {
        return drm_err_invalid_argument("state version is too long or holds a character JSON escapes");
    }
    if (_update_state_text_ok(pending) != 1) {
        return drm_err_invalid_argument("pending version is too long or holds a character JSON escapes");
    }
    var previous = update_state_previous(state);
    if (_update_state_text_ok(previous) != 1) {
        return drm_err_invalid_argument("previous version is too long or holds a character JSON escapes");
    }
    var boots = update_state_boot_count(state);
    if (boots < 0) { return drm_err_invalid_argument("boot count is negative"); }
    if (boots >= UPDATE_BOOTS_MAX) { return drm_err_invalid_argument("boot count is out of range"); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"current_slot\":");
    str_builder_add_int(sb, slot);
    str_builder_add_cstr(sb, ",\"current_version\":\"");
    if (ver != 0) { str_builder_add_cstr(sb, ver); }
    str_builder_add_cstr(sb, "\",\"pending_update\":");
    if (pending == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, pending);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"rollback_available\":");
    if (update_state_rollback_available(state) == 1) {
        str_builder_add_cstr(sb, "true");
    } else {
        str_builder_add_cstr(sb, "false");
    }
    str_builder_add_cstr(sb, ",\"boot_count\":");
    str_builder_add_int(sb, boots);
    if (previous != 0) {
        str_builder_add_cstr(sb, ",\"previous_version\":\"");
        str_builder_add_cstr(sb, previous);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}\n");
    var text = str_builder_build(sb);

    return update_atomic_write(path, str_data(text), str_len(text));
}

# Parse a state document. current_slot is required and must be 1 or 2; the other fields
# may be absent, and each must hold its own type. Returns Result: Ok(state_ptr) or Err.
fn _update_parse_state(buf, n): i64 {
    var why = "update state file is corrupt";
    var si = _agnodrm_json_field(buf, n, "current_slot");
    if (si < 0) { return drm_err_invalid_argument(why); }
    var slot = 0;
    if (_agnodrm_json_is(buf, n, si, "1") == 1) { slot = SLOT_A; }
    if (_agnodrm_json_is(buf, n, si, "2") == 1) { slot = SLOT_B; }
    if (slot == 0) { return drm_err_invalid_argument(why); }

    var version = "";
    var vi = _agnodrm_json_field(buf, n, "current_version");
    if (vi >= 0) {
        version = _update_json_str(buf, n, vi);
        if (version == 0) { return drm_err_invalid_argument(why); }
    }
    var state = update_state_new(slot, version);

    var pi = _agnodrm_json_field(buf, n, "pending_update");
    if (pi >= 0) {
        if (_agnodrm_json_is(buf, n, pi, "null") != 1) {
            var pv = _update_json_str(buf, n, pi);
            if (pv == 0) { return drm_err_invalid_argument(why); }
            if (load8(pv) != 0) { update_state_set_pending(state, pv); }
        }
    }

    var oi = _agnodrm_json_field(buf, n, "previous_version");
    if (oi >= 0) {
        var ov = _update_json_str(buf, n, oi);
        if (ov == 0) { return drm_err_invalid_argument(why); }
        update_state_set_previous(state, ov);
    }

    var ri = _agnodrm_json_field(buf, n, "rollback_available");
    if (ri >= 0) {
        if (_agnodrm_json_is(buf, n, ri, "true") == 1) {
            update_state_set_rollback(state, 1);
        } elif (_agnodrm_json_is(buf, n, ri, "false") != 1) {
            return drm_err_invalid_argument(why);
        }
    }

    var bi = _agnodrm_json_field(buf, n, "boot_count");
    if (bi >= 0) {
        var bend = _agnodrm_json_skip_value(buf, n, bi);
        if (bend - bi > 18) { return drm_err_invalid_argument(why); }
        var bc = 0;
        while (bi < bend) {
            var c = load8(buf + bi);
            if (c < 48 || c > 57) { return drm_err_invalid_argument(why); }
            bc = bc * 10 + (c - 48);
            bi = bi + 1;
        }
        update_state_set_boot_count(state, bc);
    }

    return Ok(state);
}

# Load update state from a JSON file.
# Returns Result: Ok(state_ptr) or Err. A failed open keeps its errno, which is how
# _update_load_or_new tells a missing file from an unreadable one.
fn update_load_state(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("load update state (/var/lib/agnos A/B state file)");  # agnos: no A/B update subsystem
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0) { return drm_err_invalid_argument("state path is null"); }

    var fd = sys_open(path, O_RDONLY | O_CLOEXEC, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open update state file");
    }

    var cap = UPDATE_JSON_MAX + 1;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) {
        sys_close(fd);
        return drm_err_io(ENOMEM, "no memory to read update state");
    }
    var n = _agnodrm_read_all(fd, buf, cap);
    sys_close(fd);
    if (n < 0) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_io(0 - n, "failed to read update state file");
    }
    if (n >= cap) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_invalid_argument("update state file is too large");
    }
    var res_t, res_v = _update_parse_state(buf, n);
    _agnodrm_scratch_free(buf, cap);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
    #endif
}

# Load the state, or a fresh one on `slot` if the file does not exist yet. Only a missing
# file is fresh: one that cannot be read or parsed still holds the rollback record, and
# overwriting it would erase that (audit F-30).
fn _update_load_or_new(path, slot): i64 {
    var res_t, res_v = update_load_state(path);
    if (is_ok(res_t) == 1) { return Ok(res_v); }
    if (drm_syserr_errno(res_v) == ENOENT) { return Ok(update_state_new(slot, "")); }
    return Err(res_v);
}

# ================================================================
# Manifest validation
# ================================================================

# What an image needs from its manifest: a valid version, and at least one file, each
# with a well-formed sha256. Returns Result: Ok(0) or Err.
fn _update_check_manifest_files(manifest): i64 {
    var ver = update_manifest_version(manifest);
    if (ver == 0 || strlen(ver) == 0) {
        return drm_err_invalid_argument("manifest version must not be empty");
    }

    var files = update_manifest_files(manifest);
    if (files == 0 || vec_len(files) == 0) {
        return drm_err_invalid_argument("manifest must contain at least one file");
    }

    # Validate version format
    var vres_t, vres_v = update_validate_version(ver);
    if (is_err_result(vres_t) == 1) { return Err(vres_v); }

    # Validate each file has a valid sha256 (64 hex chars)
    var fi = 0;
    while (fi < vec_len(files)) {
        var f = vec_get(files, fi);
        if (f == 0) { return drm_err_invalid_argument("manifest holds a null file"); }
        var hash = update_file_sha256(f);
        if (hash == 0 || strlen(hash) != 64) {
            return drm_err_invalid_argument("file has invalid sha256 (expected 64 hex chars)");
        }
        # Verify all chars are hex
        var hi = 0;
        while (hi < 64) {
            var c = load8(hash + hi);
            if (agnodrm_is_hex_char(c) == 0) {
                return drm_err_invalid_argument("file sha256 contains non-hex character");
            }
            hi = hi + 1;
        }
        fi = fi + 1;
    }

    return Ok(0);
}

# Validate structural integrity of an update manifest.
# Returns Result: Ok(0) or Err.
# Structural checks only: the digest itself is compared by update_apply, against the
# image on disk, and nothing here says who wrote the manifest.
fn update_verify_manifest(manifest): i64 {
    if (manifest == 0) { return drm_err_invalid_argument("manifest is null"); }

    var rd = update_manifest_release_date(manifest);
    if (rd == 0 || strlen(rd) == 0) {
        return drm_err_invalid_argument("manifest release_date must not be empty");
    }

    return _update_check_manifest_files(manifest);
}

# ================================================================
# Update check
# ================================================================

# Check for available update by reading a local manifest file.
# url_or_path: path to manifest JSON file (file:// prefix stripped).
# current_version: installed version string.
# Returns Result: Ok(manifest_ptr) if update available, Ok(0) if up-to-date, or Err.
#
# Note: Network fetch (curl) not yet implemented (roadmap.md V1.5.x).
# Supports local file paths and file:// URLs only.
# Future: Mac/Windows will need platform-specific fetch (NSURLSession, WinHTTP).
fn update_check(config, current_version): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("update check (Linux manifest file read)");  # agnos: no A/B update subsystem
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (config == 0) { return drm_err_invalid_argument("config is null"); }
    if (current_version == 0) { return drm_err_invalid_argument("current_version is null"); }

    var url = update_config_url(config);
    if (url == 0) { return drm_err_invalid_argument("update url is null"); }
    var path = url;

    # Strip file:// prefix if present
    if (strlen(url) > 7 && memeq(url, "file://", 7) == 1) {
        path = url + 7;
    }

    # Only support local file paths for now (roadmap.md V1.5.x)
    if (load8(path) != 47) {  # '/'
        return drm_err_not_supported("network update check not yet implemented");   #skip-lint
    }

    # Read manifest file
    var fd = sys_open(path, O_RDONLY | O_CLOEXEC, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open manifest file");
    }
    var cap = UPDATE_JSON_MAX + 1;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) {
        sys_close(fd);
        return drm_err_io(ENOMEM, "no memory to read the manifest");
    }
    var total = _agnodrm_read_all(fd, buf, cap);
    sys_close(fd);
    if (total < 0) {
        _agnodrm_scratch_free(buf, cap);
        return drm_err_io(0 - total, "failed to read manifest file");
    }

    # The top-level "version", read from the whole document or not at all. A cut file
    # is not one whole object, and a key or value elsewhere named "version" is not it.
    var manifest_version = 0;
    var vidx = 0 - 2;
    if (total < cap) { vidx = _agnodrm_json_field(buf, total, "version"); }
    if (vidx >= 0) { manifest_version = _update_json_str(buf, total, vidx); }
    _agnodrm_scratch_free(buf, cap);
    if (vidx == 0 - 2) {
        return drm_err_invalid_argument("manifest is not one whole JSON object");
    }
    if (manifest_version == 0) {
        return drm_err_invalid_argument("manifest missing version field");
    }
    # An unvalidated version is not an update: 9999.99.99 outranks anything.
    var vchk_t, vchk_v = update_validate_version(manifest_version);
    if (is_err_result(vchk_t) == 1) { return Err(vchk_v); }

    # Compare versions
    var cmp = update_compare_versions(manifest_version, current_version);
    if (cmp == VER_GREATER) {
        # Newer version available — build minimal manifest
        var manifest = update_manifest_new(manifest_version, CHAN_STABLE, "");
        return Ok(manifest);
    }

    # Up to date
    return Ok(0);
    #endif
}

# ================================================================
# Apply update to inactive slot
# ================================================================

# Run sha256sum over the image and compare with the manifest's digest, as hex in either
# case. A missing tool fails: `verify` is a promise, and skipping it would break it
# silently. Returns Result: Ok(0) or Err.
fn _update_verify_image(image, expected): i64 {
    var args = vec_new();
    vec_push(args, _update_path("/usr/bin/sha256sum"));
    vec_push(args, image);
    var cap = 128;
    var buf = alloc(cap);
    var failed = "sha256sum of the update image failed";
    var res_t, res_v = _agnodrm_capture_within(args, buf, cap, failed, UPDATE_HASH_DEADLINE_MS);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    if (res_v < 64) { return drm_err_unknown("sha256sum printed no digest"); }
    var i = 0;
    while (i < 64) {
        var got = load8(buf + i);
        var want = load8(expected + i);
        if (got >= 65 && got <= 90) { got = got + 32; }
        if (want >= 65 && want <= 90) { want = want + 32; }
        if (got != want) {
            return drm_err_invalid_argument("update image does not match the manifest's sha256");
        }
        i = i + 1;
    }
    return Ok(0);
}

# Refuse an image file that is not a regular file of the size the manifest gives. A size
# of 0 means the manifest gave none. Returns Result: Ok(0) or Err.
fn _update_check_image_file(image, size): i64 {
    var st = alloc(STAT_BUFSZ);
    if (xstat(image, st) != 0) {
        return drm_err_invalid_argument("update image cannot be read");
    }
    if ((load32(st + STAT_MODE) & 0xF000) != 0x8000) {   # S_IFREG
        return drm_err_invalid_argument("update image is not a regular file");
    }
    if (size != 0) {
        if (load64(st + STAT_SIZE) != size) {
            return drm_err_invalid_argument("update image is not the size the manifest gives");
        }
    }
    return Ok(0);
}

# Make the marker name `slot`. It is written unless it provably says so already, so one
# that is missing or cannot be read comes out right, or the write fails.
# Returns Result: Ok(0) or Err.
fn _update_aim_marker(slot): i64 {
    var marker = _update_path("/var/lib/agnos/next-slot");
    var suffix = update_slot_suffix(slot);
    var old = alloc(16);
    var old_len = file_read_all(marker, old, 16);
    if (old_len == strlen(suffix)) {
        if (memeq(old, suffix, old_len) == 1) { return Ok(0); }
    }
    var res_t, res_v = update_atomic_write(marker, suffix, strlen(suffix));
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(0);
}

# Make the next boot certain to stay on `slot`, the marker and then the firmware, before
# the other slot is written. BootNext outranks the marker, so a firmware that cannot
# answer on an EFI host is a refusal, even with everything here agreeing: a best-effort
# switch can have left a BootNext behind that nothing on disk records.
# Returns Result: Ok(0), or Err if the next boot cannot be shown to stay.
fn _update_hold_boot(slot): i64 {
    var mk_t, mk_v = _update_aim_marker(slot);
    if (is_err_result(mk_t) == 1) { return Err(mk_v); }
    return _update_set_bootnext(slot, 1, 1);
}

# Write update image to the inactive slot's block device.
# Returns Result: Ok(0) or Err.
#
# The manifest must describe one whole raw image with a valid version and digest: this
# does not decompress, apply a delta, or write a second file, and `dd` would put any of
# those on the slot as it stands (audit F-29). With the config's `verify` on, the image
# must match the manifest's sha256 before a byte is written. That catches a corrupt
# image, not a forged one: the manifest is not signed.
#
# The target slot may hold the only known-good image, and the write destroys it. So
# this runs in an order a power cut can stop anywhere: first the next boot is proven to
# stay on the running slot, then the rollback record is cleared and saved, and only then
# does `dd` start. In the other order a cut boots the slot about to be written with its
# record gone, and a write that dies leaves a rollback that boots half an image (audit
# F-16). An image on trial refuses outright: the target would be the one good slot left.
# Afterwards the image is pending, and rollback_available stays clear until
# update_switch_slot leaves a good slot behind.
fn update_apply(config, manifest): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("apply update to inactive slot (dd to block device)");  # agnos: no A/B slots
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (config == 0) { return drm_err_invalid_argument("config is null"); }
    if (manifest == 0) { return drm_err_invalid_argument("manifest is null"); }

    var vm_t, vm_v = _update_check_manifest_files(manifest);
    if (is_err_result(vm_t) == 1) { return Err(vm_v); }

    var files = update_manifest_files(manifest);
    if (vec_len(files) != 1) {
        return drm_err_not_supported("update_apply writes one image; the manifest lists several");
    }
    var file = vec_get(files, 0);
    if (update_file_compressed(file) != 0) {
        return drm_err_not_supported("update_apply writes a raw image, not a compressed one");
    }
    if (update_file_delta_from(file) != 0) {
        return drm_err_not_supported("update_apply writes a whole image, not a delta");
    }

    # Only the boot itself can say which slot is running, and a wrong answer overwrites
    # the running root. Not update_get_current_slot: its state-file fallback is wrong
    # between a switch and the reboot and after a firmware fallback, and its default is
    # a guess (audit F-4). With no agnos.slot= on the cmdline this refuses.
    var current_res_t, current_res_v = _update_cmdline_slot();
    if (is_err_result(current_res_t) == 1) { return Err(current_res_v); }
    var current = current_res_v;
    if (current == 0) {
        return drm_err_invalid_argument("cannot tell the running slot: no agnos.slot= on the kernel cmdline");
    }

    var target_slot = update_other_slot(current);
    var target_dev = update_config_device_for_slot(config, target_slot);
    if (target_dev == 0 || strlen(target_dev) == 0) {
        return drm_err_invalid_argument("target slot has no device");
    }
    # dd would create a missing one as a plain file, and report success.
    var devst = alloc(STAT_BUFSZ);
    if (xstat(target_dev, devst) != 0) {
        return drm_err_invalid_argument("target slot device does not exist");
    }

    var image = update_file_path(file);
    if (image == 0 || strlen(image) == 0) {
        return drm_err_invalid_argument("update image path is empty");
    }

    # Validate image path: must be absolute, no traversal
    if (load8(image) != 47) {
        return drm_err_invalid_argument("update image path must be absolute");
    }
    if (strstr(image, "..") >= 0) {
        return drm_err_invalid_argument("update image path must not contain '..'");
    }

    # Validate within staging directory
    var staging = _update_path("/var/lib/agnos/updates/");
    if (memeq(image, staging, strlen(staging)) != 1) {
        return drm_err_invalid_argument("update image must be within /var/lib/agnos/updates/");
    }

    var state_file = update_config_state_file(config);
    var load_t, load_v = _update_load_or_new(state_file, current);
    if (is_err_result(load_t) == 1) { return Err(load_v); }
    var state = load_v;
    if (update_state_pending(state) != 0) {
        if (update_state_rollback_available(state) == 1) {
            if (update_state_slot(state) == current) {
                return drm_err_invalid_argument("an update is on trial: confirm it or roll back first");
            }
        }
    }

    var ck_t, ck_v = _update_check_image_file(image, update_file_size(file));
    if (is_err_result(ck_t) == 1) { return Err(ck_v); }
    if (update_config_verify(config) != 0) {
        var hash_t, hash_v = _update_verify_image(image, update_file_sha256(file));
        if (is_err_result(hash_t) == 1) { return Err(hash_v); }
    }

    # From here the target slot holds nothing anyone may boot.
    var hold_t, hold_v = _update_hold_boot(current);
    if (is_err_result(hold_t) == 1) { return Err(hold_v); }
    update_state_set_slot(state, current);
    update_state_set_pending(state, 0);
    update_state_set_rollback(state, 0);
    update_state_set_boot_count(state, 0);
    update_state_set_previous(state, 0);
    var pre_t, pre_v = update_save_state(state, state_file);
    if (is_err_result(pre_t) == 1) { return Err(pre_v); }

    # Write via dd. Element 0 is the ABSOLUTE path — execve does no PATH
    # lookup. _agnodrm_checked_within checks dd's exit code, and a deadline kill reads the
    # same: the record was cleared first, so a slot left half-written is known to be one.
    var args = vec_new();
    vec_push(args, "/usr/bin/dd");

    # Build if=<image>
    var if_arg = alloc(strlen(image) + 4);
    memcpy(if_arg, "if=", 3);
    memcpy(if_arg + 3, image, strlen(image) + 1);
    vec_push(args, if_arg);

    # Build of=<device>
    var of_arg = alloc(strlen(target_dev) + 4);
    memcpy(of_arg, "of=", 3);
    memcpy(of_arg + 3, target_dev, strlen(target_dev) + 1);
    vec_push(args, of_arg);

    vec_push(args, "bs=4M");
    vec_push(args, "conv=fsync");

    var dd_res_t, dd_res_v = _agnodrm_checked_within(args, "dd image write failed", UPDATE_WRITE_DEADLINE_MS);
    if (is_err_result(dd_res_t) == 1) { return Err(dd_res_v); }
    #ifdef AGNODRM_POWERCUT
    _update_cut();
    #endif

    # A caller must not switch to the image with no pending record on disk.
    update_state_set_pending(state, update_manifest_version(manifest));
    var save_t, save_v = update_save_state(state, state_file);
    if (is_err_result(save_t) == 1) { return Err(save_v); }

    return Ok(0);
    #endif
}

# ================================================================
# Switch active slot
# ================================================================

# The BootNNNN number of the entry labelled exactly `label` in `efibootmgr` output,
# as a 4-character C string, or 0 if there is none. A line reads
#   Boot0003* AGNOS-A<TAB>HD(1,GPT,...)
# with no `*` on an inactive entry; newer efibootmgr prints the device path after a
# tab on every line, and older ones print the label alone.
fn _update_efi_bootnum(text, label): i64 {
    var textlen = strlen(text);
    var lablen = strlen(label);
    var pos = 0;
    while (pos < textlen) {
        var line = text + pos;
        var end = pos;
        while (end < textlen) {
            if (load8(text + end) == 10) { break; }
            end = end + 1;
        }
        var linelen = end - pos;
        pos = end + 1;

        if (linelen < 9 + lablen) { continue; }
        if (memeq(line, "Boot", 4) != 1) { continue; }
        var hexok = 1;
        var hi = 4;
        while (hi < 8) {
            if (agnodrm_is_hex_char(load8(line + hi)) != 1) { hexok = 0; }
            hi = hi + 1;
        }
        if (hexok != 1) { continue; }

        var i = 8;
        if (load8(line + i) == 42) { i = i + 1; }  # '*': the entry is active
        if (load8(line + i) != 32) { continue; }
        while (i < linelen) {
            if (load8(line + i) != 32) { break; }
            i = i + 1;
        }
        if (i + lablen > linelen) { continue; }
        if (memeq(line + i, label, lablen) != 1) { continue; }
        if (i + lablen < linelen) {
            if (load8(line + i + lablen) != 9) { continue; }  # "AGNOS-A rescue" is not AGNOS-A
        }

        var num = alloc(5);
        memcpy(num, line + 4, 4);
        store8(num + 4, 0);
        return num;
    }
    return 0;
}

# The 4-character number after a "BootNext:" line in `efibootmgr` output, or 0.
fn _update_efi_bootnext(text): i64 {
    var textlen = strlen(text);
    var pos = 0;
    while (pos + 13 < textlen) {
        if (memeq(text + pos, "BootNext: ", 10) == 1) {
            var num = alloc(5);
            memcpy(num, text + pos + 10, 4);
            store8(num + 4, 0);
            return num;
        }
        while (pos < textlen) {
            if (load8(text + pos) == 10) { break; }
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    return 0;
}

# "AGNOS-A" or "AGNOS-B", the label an entry carries.
fn _update_efi_label(slot): i64 {
    var label = alloc(8);
    memcpy(label, "AGNOS-", 6);
    if (slot == SLOT_A) { store8(label + 6, 65); }  # 'A'
    else { store8(label + 6, 66); }                   # 'B'
    store8(label + 7, 0);
    return label;
}

# Point the firmware's next boot at `slot`. `hold` 1 touches firmware only if a BootNext
# is aimed at the other slot, so an update writes no NVRAM for nothing and leaves alone a
# BootNext someone set for their own entry. `strict` 1 is an Err if a BootNext there cannot
# be ruled out, which matters because BootNext outranks the marker. Otherwise this is best
# effort: the marker is what commits a switch, and a host may have no EFI, no efibootmgr or
# no such entry. With no EFI or no efibootmgr there is no BootNext this library could set.
# `--bootnext` takes a hex boot number, not a label, so the number comes from the
# entry list. (Through 1.7.0 this passed "AGNOS-A", which efibootmgr always refused.)
# Returns Result: Ok(0) or Err.
fn _update_set_bootnext(slot, hold, strict): i64 {
    var efibootmgr = _update_path("/usr/bin/efibootmgr");
    var list_args = vec_new();
    vec_push(list_args, efibootmgr);
    var cap = 65536;
    var buf = _agnodrm_scratch_new(cap + 1);
    if (buf == 0) {
        if (strict == 1) { return drm_err_io(ENOMEM, "no memory for the EFI boot list"); }
        return Ok(0);
    }
    var list_t, list_v = _agnodrm_capture_within(list_args, buf, cap, "efibootmgr failed", AGNODRM_TOOL_DEADLINE_MS);
    if (is_ok(list_t) == 1) {
        # A cut list can lose the entry a hold compares BootNext against.
        if (list_v >= cap) {
            _agnodrm_scratch_free(buf, cap + 1);
            if (strict != 1) { return Ok(0); }
            return drm_err_io(0, "efibootmgr output exceeds 64 KiB; cannot tell where the firmware boots next");
        }
    }
    if (is_err_result(list_t) == 1) {
        _agnodrm_scratch_free(buf, cap + 1);
        if (strict != 1) { return Ok(0); }
        if (sys_access(_update_path("/sys/firmware/efi"), 0) != 0) { return Ok(0); }
        if (sys_access(efibootmgr, 0) != 0) { return Ok(0); }
        return drm_err_unknown("cannot tell where the firmware boots next");
    }
    store8(buf + list_v, 0);

    var num = _update_efi_bootnum(buf, _update_efi_label(slot));
    var away = _update_efi_bootnum(buf, _update_efi_label(update_other_slot(slot)));
    var next = _update_efi_bootnext(buf);
    _agnodrm_scratch_free(buf, cap + 1);

    if (hold == 1) {
        if (next == 0) { return Ok(0); }
        if (away == 0) { return Ok(0); }
        if (memeq(next, away, 4) != 1) { return Ok(0); }
    }

    if (num != 0) {
        var args = vec_new();
        vec_push(args, efibootmgr);
        vec_push(args, "--bootnext");
        vec_push(args, num);
        if (_agnodrm_exec_within(args, AGNODRM_TOOL_DEADLINE_MS) == 0) {  # execve needs the abs path above
            #ifdef AGNODRM_POWERCUT
            _update_cut();
            #endif
            return Ok(0);
        }
    }

    # BootNext cannot point at this slot. One left by an earlier switch would send the
    # next boot to the wrong slot, so clear it: the firmware then follows BootOrder.
    if (next != 0) {
        var clear_args = vec_new();
        vec_push(clear_args, efibootmgr);
        vec_push(clear_args, "--delete-bootnext");
        if (_agnodrm_exec_within(clear_args, AGNODRM_TOOL_DEADLINE_MS) != 0) {
            if (strict == 1) { return drm_err_unknown("cannot clear the firmware's BootNext"); }
        }
        #ifdef AGNODRM_POWERCUT
        _update_cut();
        #endif
    }
    return Ok(0);
}

# Swap the version with the one recorded for the other slot, if there is one: a move
# between two confirmed images.
fn _update_swap_versions(state): i64 {
    var previous = update_state_previous(state);
    if (previous == 0) { return 0; }
    update_state_set_previous(state, update_state_version(state));
    update_state_set_version(state, previous);
    return 0;
}

# Move forward onto `slot`: the state, then the marker, then the firmware, each flushed
# before the next. The state goes first because the marker is what commits the move: a
# power cut between them boots the old slot, with a state that reads as a fallback and
# that update_rollback squares. Marker first would boot an image the state knows nothing
# about. Leaving a running slot leaves a good slot behind, which is what
# rollback_available records, and so does moving onto a pending image, even one booted by
# hand first: it stays on trial until confirmed. `running` is the booted slot, 0 if
# unknown. Only a real move resets the boot count, so repeating a switch cannot disarm a
# trial.
#
# An Err from the state write can come after its rename, if only the directory flush
# failed. An Err from the marker puts the state back, best effort. The firmware is left
# alone either way.
fn _update_switch_forward(config, state, slot, running): i64 {
    var state_file = update_config_state_file(config);
    var old_slot = update_state_slot(state);
    var old_rollback = update_state_rollback_available(state);
    var old_boots = update_state_boot_count(state);
    var old_version = update_state_version(state);
    var old_previous = update_state_previous(state);

    update_state_set_slot(state, slot);
    if (old_slot != slot) {
        update_state_set_boot_count(state, 0);
        var leaves_slot = running != slot;
        if (update_state_pending(state) != 0) { leaves_slot = 1; }
        if (leaves_slot == 1) { update_state_set_rollback(state, 1); }
        if (update_state_pending(state) == 0) { _update_swap_versions(state); }
    }
    var save_t, save_v = update_save_state(state, state_file);
    if (is_err_result(save_t) == 1) { return Err(save_v); }

    var marker = _update_path("/var/lib/agnos/next-slot");
    var suffix = update_slot_suffix(slot);
    var res_t, res_v = update_atomic_write(marker, suffix, strlen(suffix));
    if (is_err_result(res_t) == 1) {
        update_state_set_slot(state, old_slot);
        update_state_set_rollback(state, old_rollback);
        update_state_set_boot_count(state, old_boots);
        update_state_set_version(state, old_version);
        update_state_set_previous(state, old_previous);
        update_save_state(state, state_file);
        return Err(res_v);
    }

    var fw_t, fw_v = _update_set_bootnext(slot, 0, 0);
    return Ok(0);
}

# Move back to the slot a switch left behind: the marker, then the firmware, then the
# state, the reverse of going forward. Clearing the record is what makes the good slot
# unreachable, so it goes last, once the next boot is shown to be there: with the state
# first, a power cut booted the bad slot with no record left to roll back with (audit
# F-15). Stopping anywhere leaves a state that reads as a trial or a fallback, and running
# this again finishes the job.
#
# On an EFI host a failing efibootmgr refuses this, because a BootNext left on the bad
# slot would outrank the marker. Nothing is lost by that: the marker has moved, the
# record stays, and running this again once the firmware answers finishes the job.
# Neither running the target nor a counted boot shows a BootNext is spent, since a switch
# made this boot leaves it armed; see docs/architecture/001-slot-write-order.md.
# `keep_pending` leaves an image that never booted as it was after update_apply, written
# and ready to switch to.
fn _update_roll_back(config, state, keep_pending): i64 {
    var previous = update_other_slot(update_state_slot(state));
    var mk_t, mk_v = _update_aim_marker(previous);
    if (is_err_result(mk_t) == 1) { return Err(mk_v); }

    var fw_t, fw_v = _update_set_bootnext(previous, 0, 1);
    if (is_err_result(fw_t) == 1) { return Err(fw_v); }

    if (keep_pending != 1) {
        if (update_state_pending(state) == 0) {
            _update_swap_versions(state);
            update_state_set_previous(state, 0);
        }
        update_state_set_pending(state, 0);
    }
    update_state_set_slot(state, previous);
    update_state_set_boot_count(state, 0);
    update_state_set_rollback(state, 0);
    return update_save_state(state, update_config_state_file(config));
}

# Mark a slot as active for the next boot.
# Writes slot marker for argonaut and optionally sets EFI boot entry.
# Returns Result: Ok(0) or Err.
#
# Moving to the other slot needs a reason to think it boots: an image on it, or a record
# that it was left in working order. After a write that died, or a finished rollback, it
# has neither, and this refuses (audit F-16). With no state file yet nothing is known
# against it, and a cmdline saying the host runs that slot is proof it boots. Leaving an
# image on trial for the good slot is a rollback, whichever call asks for it: going
# forward would keep the trial armed against the good slot. If the image never booted and
# the host still runs the good slot, it stays pending and can be switched to again.
fn update_switch_slot(config, slot): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("switch active slot (efibootmgr --bootnext)");  # agnos: no efibootmgr
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (config == 0) { return drm_err_invalid_argument("config is null"); }
    if (slot != SLOT_A) {
        if (slot != SLOT_B) { return drm_err_invalid_argument("slot is neither A nor B"); }
    }

    var running = 0;
    var run_t, run_v = _update_cmdline_slot();
    if (is_ok(run_t) == 1) { running = run_v; }

    var state_file = update_config_state_file(config);
    var load_t, load_v = update_load_state(state_file);
    if (is_err_result(load_t) == 1) {
        if (drm_syserr_errno(load_v) != ENOENT) { return Err(load_v); }
        var fresh = update_state_new(update_other_slot(slot), "");
        return _update_switch_forward(config, fresh, slot, running);
    }
    var state = load_v;
    if (slot != update_state_slot(state)) {
        var pending = update_state_pending(state);
        var behind = update_state_rollback_available(state);
        if (pending != 0) {
            if (behind == 1) {
                var unbooted = 0;
                if (running == slot) { unbooted = update_state_boot_count(state) == 0; }
                return _update_roll_back(config, state, unbooted);
            }
        } elif (behind == 0) {
            if (running != slot) {
                return drm_err_invalid_argument("the other slot holds nothing known to boot");
            }
        }
    }
    return _update_switch_forward(config, state, slot, running);
    #endif
}

# ================================================================
# Rollback
# ================================================================

# Roll back to the previous slot, or abandon an image nothing has switched to.
# Returns Result: Ok(0) or Err.
#
# rollback_available says a switch left a good slot behind. With it clear and an update
# pending, update_apply wrote an image and no switch followed: the running slot is the
# good one, so the pending record goes and the next boot stays where it is. Through
# 1.7.1 this took "not state.slot" as the slot to return to, which there is the image
# just written (audit F-15).
fn update_rollback(config): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("rollback to previous slot (argonaut + efibootmgr)");  # agnos: no A/B slots
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (config == 0) { return drm_err_invalid_argument("config is null"); }

    var state_file = update_config_state_file(config);
    var load_res_t, load_res_v = update_load_state(state_file);
    if (is_err_result(load_res_t) == 1) { return Err(load_res_v); }
    var state = load_res_v;

    if (update_state_rollback_available(state) == 0) {
        if (update_state_pending(state) == 0) {
            return drm_err_invalid_argument("no rollback image available");
        }
        update_state_set_pending(state, 0);
        return update_save_state(state, state_file);
    }

    var back_t, back_v = _update_roll_back(config, state, 0);
    if (is_err_result(back_t) == 1) { return Err(back_v); }

    # Stop services only once the rollback stands, so a failed one leaves them running.
    var stop_args = vec_new();
    vec_push(stop_args, _update_path("/usr/bin/argonaut"));
    vec_push(stop_args, "stop");
    vec_push(stop_args, "daimon");
    _agnodrm_exec_within(stop_args, AGNODRM_TOOL_DEADLINE_MS);  # best effort (execve needs the abs path above)

    return Ok(0);
    #endif
}

# ================================================================
# Boot confirmation
# ================================================================

# The saved state, or 0 if there is no state file: nothing has been updated, so a boot has
# nothing to record. Returns Result: Ok(state_ptr or 0) or Err.
fn _update_load_if_any(state_file): i64 {
    var res_t, res_v = update_load_state(state_file);
    if (is_ok(res_t) == 1) { return Ok(res_v); }
    if (drm_syserr_errno(res_v) == ENOENT) { return Ok(0); }
    return Err(res_v);
}

# 1 if the state records an image on trial: pending, with a good slot behind it. An
# image no switch has reached is pending too, and not on trial.
fn _update_on_trial(state): i64 {
    if (update_state_pending(state) == 0) { return 0; }
    return update_state_rollback_available(state) == 1;
}

# Count this boot against an image on trial. Call it once, early in every boot, then ask
# update_needs_rollback. Only a boot that update_mark_boot_successful never reaches
# leaves the count standing, which is what makes this a count of failed boots; nothing
# else in the library counted them, so update_needs_rollback could never fire (audit
# F-17). Writes only while an image is on trial.
# Returns Result: Ok(boot_count) or Err.
fn update_mark_boot_attempt(config): i64 {
    if (config == 0) { return drm_err_invalid_argument("config is null"); }

    var state_file = update_config_state_file(config);
    var load_res_t, load_res_v = _update_load_if_any(state_file);
    if (is_err_result(load_res_t) == 1) { return Err(load_res_v); }
    var state = load_res_v;
    if (state == 0) { return Ok(0); }

    var boots = update_state_boot_count(state);
    if (_update_on_trial(state) != 1) { return Ok(boots); }

    boots = boots + 1;
    update_state_set_boot_count(state, boots);
    var save_t, save_v = update_save_state(state, state_file);
    if (is_err_result(save_t) == 1) { return Err(save_v); }
    return Ok(boots);
}

# Mark the current boot as successful: an image on trial becomes the current version, and
# the trial ends. With no trial there is nothing to confirm, and this writes nothing: in
# particular a pending image no switch has reached was not what just booted.
# Returns Result: Ok(0) or Err.
#
# Confirming needs proof that the image is what booted. A cmdline naming another slot
# means the firmware fell back, or the switch never took, and one naming no slot says
# nothing: both refuse and keep the pending record, and update_rollback squares the
# state with where the host is (audit F-25).
fn update_mark_boot_successful(config): i64 {
    if (config == 0) { return drm_err_invalid_argument("config is null"); }

    var state_file = update_config_state_file(config);
    var load_res_t, load_res_v = _update_load_if_any(state_file);
    if (is_err_result(load_res_t) == 1) { return Err(load_res_v); }
    var state = load_res_v;
    if (state == 0) { return Ok(0); }
    if (_update_on_trial(state) != 1) { return Ok(0); }

    var run_t, run_v = _update_cmdline_slot();
    if (is_err_result(run_t) == 1) { return Err(run_v); }
    if (run_v != update_state_slot(state)) {
        return drm_err_invalid_argument("cannot show the image on trial is what booted");
    }

    # A rollback cut short after its marker can boot the image anyway. Confirmed, it is
    # where the host stays, so the marker comes back with it.
    var mk_t, mk_v = _update_aim_marker(run_v);
    if (is_err_result(mk_t) == 1) { return Err(mk_v); }

    update_state_set_previous(state, update_state_version(state));
    update_state_set_version(state, update_state_pending(state));
    update_state_set_pending(state, 0);
    update_state_set_boot_count(state, 0);
    return update_save_state(state, state_file);
}

# Pure function: returns 1 once `max_boot_attempts` boots of an image on trial have gone
# unconfirmed, so call it after update_mark_boot_attempt. An image no switch has reached
# is not on trial, however often the running slot has booted.
fn update_needs_rollback(state, max_boot_attempts): i64 {
    if (state == 0) { return 0; }
    if (_update_on_trial(state) != 1) { return 0; }
    return update_state_boot_count(state) >= max_boot_attempts;
}

# --- fuse.cyr ---

# fuse.cyr — FUSE filesystem mount management
# New module (no Rust source)
#
# Parses /proc/mounts for FUSE mounts, provides mount/unmount
# via fusermount subprocess.
#
# Requires: src/error.cyr, lib/syscalls.cyr, lib/process.cyr

# Included directly (as drm.cyr does) for the per-target O_* open flags and
# the per-arch struct stat offsets; include-once, so includers pay nothing.
include "lib/syscalls.cyr"

# ================================================================
# FuseMount struct
# 4 ptr fields * 8 = 32 bytes. Accessors auto-generated.
# ================================================================

#derive(accessors)
struct fuse_mount { device; mountpoint; fstype; options; }

fn fuse_mount_new(device, mountpoint, fstype, options): i64 {
    var m = alloc(32);
    fuse_mount_set_device(m, device);
    fuse_mount_set_mountpoint(m, mountpoint);
    fuse_mount_set_fstype(m, fstype);
    fuse_mount_set_options(m, options);
    return m;
}

# ================================================================
# Parse /proc/mounts
enum FuseMountTable {
    FUSE_MOUNTS_CHUNK = 65536;
    FUSE_MOUNTS_MAX_BYTES = 16777216;
}

# 1 for a filesystem type that is a FUSE mount: fuse or fuseblk, alone or with a
# .<subtype>. Not fusectl, the control filesystem at /sys/fs/fuse/connections, which is
# no FUSE mount and read as one to a prefix match (audit F-48).
fn _fuse_type_ok(fstype): i64 {
    if (streq(fstype, "fuse") == 1) { return 1; }
    if (streq(fstype, "fuseblk") == 1) { return 1; }
    if (agnodrm_cstr_starts_with(fstype, "fuse.") == 1) { return 1; }
    return agnodrm_cstr_starts_with(fstype, "fuseblk.");
}

# Parse `total_read` bytes of mount table at `buf` into a vec of fuse_mount records,
# fuse entries only when `fuse_only` is 1. Every field is a heap copy.
# Format: device mountpoint fstype options dump pass
fn _fuse_parse_mounts(buf, total_read, fuse_only): i64 {
    var mounts = vec_new();
    var pos = 0;

    while (pos < total_read) {
        var linestart = pos;
        while (pos < total_read) {
            if (load8(buf + pos) == 10) { break; }
            pos = pos + 1;
        }
        var linelen = pos - linestart;
        if (pos < total_read) { pos = pos + 1; }
        if (linelen == 0) { continue; }

        # Extract fstype (field 2)
        var fstype = fuse_extract_field(buf + linestart, linelen, 2);
        if (fstype == 0) { continue; }

        var include = 1;
        if (fuse_only == 1) {
            if (_fuse_type_ok(fstype) != 1) {
                include = 0;
            }
        }

        if (include == 1) {
            var device = fuse_extract_field(buf + linestart, linelen, 0);
            var mpoint = fuse_extract_field(buf + linestart, linelen, 1);
            var opts = fuse_extract_field(buf + linestart, linelen, 3);
            vec_push(mounts, fuse_mount_new(device, mpoint, fstype, opts));
        }
    }

    return mounts;
}

# Parse a whole mount table from `fd` into a vec of fuse_mount records, fuse
# entries only when `fuse_only` is 1. Returns Ok(vec) or Err.
#
# The table is read to EOF into a buffer that grows. A fixed buffer cut it silently
# at 8 KiB, about 90 mounts, so a FUSE mount past the cut read as not mounted (audit
# F-7). Past FUSE_MOUNTS_MAX_BYTES this fails rather than parse part of a table. The
# buffer is scratch, given back on return.
fn _fuse_collect_mounts(fd, fuse_only): i64 {
    var cap = FUSE_MOUNTS_CHUNK;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for the mount table"); }
    var total_read = 0;
    while (1) {
        if (total_read == cap) {
            if (cap >= FUSE_MOUNTS_MAX_BYTES) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_io(0, "mount table is too large");
            }
            var bigger = _agnodrm_scratch_new(cap * 2);
            if (bigger == 0) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_io(ENOMEM, "mount table is too large");
            }
            memcpy(bigger, buf, total_read);
            _agnodrm_scratch_free(buf, cap);
            buf = bigger;
            cap = cap * 2;
        }
        var nread = file_read(fd, buf + total_read, cap - total_read);
        if (nread == 0 - EINTR) { continue; }
        if (nread < 0) {
            _agnodrm_scratch_free(buf, cap);
            return drm_err_io(0 - nread, "failed to read mount table");
        }
        if (nread == 0) { break; }
        total_read = total_read + nread;
    }

    var mounts = _fuse_parse_mounts(buf, total_read, fuse_only);
    _agnodrm_scratch_free(buf, cap);
    return Ok(mounts);
}

# Read this host's mounts. Returns Result: Ok(vec of fuse_mount) or Err.
fn _fuse_read_mounts(fuse_only): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(vec_new());    # agnos has no /proc/mounts and no FUSE — zero mounts
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open("/proc/mounts", O_RDONLY, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open /proc/mounts");
    }
    var res_t, res_v = _fuse_collect_mounts(fd, fuse_only);
    sys_close(fd);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
    #endif
}

# ================================================================

# Check if a string starts with a prefix.
# Thin wrapper over the shared single-pass predicate (public API stable).
fn fuse_starts_with(str, prefix): i64 {
    return agnodrm_cstr_starts_with(str, prefix);
}

# Extract a whitespace-delimited field from a line.
# field_idx: 0-based field index.
# Returns heap-allocated string or 0.
fn fuse_extract_field(line, linelen, field_idx): i64 {
    var pos = 0;
    var field = 0;

    while (field < field_idx) {
        # Skip to next whitespace
        while (pos < linelen) {
            var c = load8(line + pos);
            if (c == 32) { break; }
            if (c == 9) { break; }
            pos = pos + 1;
        }
        # Skip whitespace
        while (pos < linelen) {
            var c = load8(line + pos);
            if (c != 32) { if (c != 9) { break; } }
            pos = pos + 1;
        }
        field = field + 1;
    }

    if (pos >= linelen) { return 0; }

    var start = pos;
    while (pos < linelen) {
        var c = load8(line + pos);
        if (c == 32) { break; }
        if (c == 9) { break; }
        pos = pos + 1;
    }

    var flen = pos - start;
    if (flen == 0) { return 0; }

    # F-7 (1.1.14): /proc/mounts encodes embedded whitespace and control
    # chars as 3-digit octal escapes (`\040` space, `\011` tab, `\012` LF,
    # `\134` backslash) per fstab(5). The field-split loop above reads raw
    # space/tab as separators, so unescaped values are already split into
    # multiple fields by the kernel — but a quoted-style mount source can
    # legitimately contain `\040` and similar that we want to render
    # back as the literal byte in the heap-copied output.
    var out = alloc(flen + 1);
    var src_i = 0;
    var dst_i = 0;
    while (src_i < flen) {
        var c0 = load8(line + start + src_i);
        if (c0 == 92) {
            if (src_i + 3 < flen) {
                var d1 = load8(line + start + src_i + 1);
                var d2 = load8(line + start + src_i + 2);
                var d3 = load8(line + start + src_i + 3);
                if (d1 >= 48) {
                    if (d1 <= 55) {
                        if (d2 >= 48) {
                            if (d2 <= 55) {
                                if (d3 >= 48) {
                                    if (d3 <= 55) {
                                        var v = (d1 - 48) * 64 + (d2 - 48) * 8 + (d3 - 48);
                                        store8(out + dst_i, v);
                                        dst_i = dst_i + 1;
                                        src_i = src_i + 4;
                                        continue;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        store8(out + dst_i, c0);
        dst_i = dst_i + 1;
        src_i = src_i + 1;
    }
    store8(out + dst_i, 0);
    return out;
}

# Parse /proc/mounts and return FUSE mounts.
# result_arr: pre-allocated array of FuseMount pointers.
# max_mounts: capacity.
# fuse_only: 1 to return only FUSE mounts (fuse, fuseblk, fuse.*), 0 for all.
# A count equal to max_mounts may mean there are more.
# Returns Result: Ok(count) or Err.
fn fuse_parse_proc_mounts(result_arr, max_mounts, fuse_only): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);            # agnos has no /proc/mounts and no FUSE — zero mounts
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_mounts) != 1) {
        return drm_err_invalid_argument("result array is null or max_mounts is negative");
    }
    var res_t, res_v = _fuse_read_mounts(fuse_only);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    var total = vec_len(res_v);
    var count = 0;
    while (count < total) {
        if (count >= max_mounts) { break; }
        store64(result_arr + count * 8, vec_get(res_v, count));
        count = count + 1;
    }
    return Ok(count);
    #endif
}

# ================================================================
# Mount FUSE filesystem
# ================================================================

# Mount a FUSE filesystem.
# device: the FUSE filesystem source (e.g., user@host:path).
# mountpoint: target directory, which must pass fuse_validate_mountpoint.
# fuse_type: the absolute path of the helper (e.g., "/usr/bin/sshfs"). execve does no PATH
# lookup, and a relative path runs from the working directory.
# extra_opts: additional mount options string, or 0 for none.
# Returns Result: Ok(0) or Err.
#
# Each argument reaches the helper in its own argv entry, with no shell. A device or
# mountpoint starting with '-' is refused, since a helper would read it as an option,
# and sshfs's -o ssh_command= runs a program (audit F-23). extra_opts is the caller's to
# trust: it is options by definition.
fn fuse_mount(device, mountpoint, fuse_type, extra_opts): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse mount");   # agnos has no FUSE / fusermount
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (device == 0) { return drm_err_invalid_argument("fuse device is null"); }
    if (mountpoint == 0) { return drm_err_invalid_argument("fuse mountpoint is null"); }
    if (fuse_type == 0) { return drm_err_invalid_argument("fuse type is null"); }

    if (strlen(device) == 0) { return drm_err_invalid_argument("fuse device is empty"); }
    if (strlen(mountpoint) == 0) { return drm_err_invalid_argument("fuse mountpoint is empty"); }
    if (load8(fuse_type) != 47) { return drm_err_invalid_argument("fuse helper must be an absolute path"); }
    if (load8(device) == 45) { return drm_err_invalid_argument("fuse device cannot start with '-'"); }
    if (load8(mountpoint) == 45) { return drm_err_invalid_argument("fuse mountpoint cannot start with '-'"); }

    var chk_t, chk_v = fuse_validate_mountpoint(mountpoint);
    if (is_err_result(chk_t) == 1) { return Err(chk_v); }

    var args = vec_new();
    vec_push(args, fuse_type);
    vec_push(args, device);
    vec_push(args, mountpoint);

    if (extra_opts != 0) {
        if (strlen(extra_opts) > 0) {
            vec_push(args, "-o");
            vec_push(args, extra_opts);
        }
    }

    # No deadline: one puts the child in its own session, away from the terminal, and sshfs
    # may need that for a password, or stay in the foreground on purpose. A process deadline
    # the caller set still applies.
    return _agnodrm_checked_within(args, "fuse mount command failed", 0);
    #endif
}

# ================================================================
# Unmount FUSE filesystem
# ================================================================

# Test seam, 0 outside tests/tcyr: a stub to run in place of fusermount.
var _fuse_fusermount = 0;

# fusermount3 where it exists, the only name a fuse3-only host has, else fusermount.
fn _fuse_unmount_tool(): i64 {
    if (_fuse_fusermount != 0) { return _fuse_fusermount; }
    if (sys_access("/usr/bin/fusermount3", 0) == 0) { return "/usr/bin/fusermount3"; }
    return "/usr/bin/fusermount";
}

# Run `fusermount <flag> -- <mountpoint>`. The "--" keeps a mountpoint starting with '-'
# from reading as an option.
fn _fuse_run_unmount(mountpoint, flag, errmsg): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse unmount");   # agnos has no FUSE / fusermount
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (mountpoint == 0) { return drm_err_invalid_argument("unmount mountpoint is null"); }
    if (strlen(mountpoint) == 0) { return drm_err_invalid_argument("unmount mountpoint is empty"); }

    var args = vec_new();
    vec_push(args, _fuse_unmount_tool());
    vec_push(args, flag);
    vec_push(args, "--");
    vec_push(args, mountpoint);

    return _agnodrm_checked_within(args, errmsg, AGNODRM_TOOL_DEADLINE_MS);
    #endif
}

# Unmount a FUSE filesystem at the given mountpoint.
# Returns Result: Ok(0) or Err.
fn fuse_unmount(mountpoint): i64 {
    return _fuse_run_unmount(mountpoint, "-u", "fusermount -u failed");
}

# ================================================================
# Lazy unmount (fallback)
# ================================================================

# Lazy unmount via fusermount -uz (for busy mounts).
fn fuse_unmount_lazy(mountpoint): i64 {
    return _fuse_run_unmount(mountpoint, "-uz", "fusermount -uz failed");
}

# ================================================================
# FUSE availability check
# ================================================================

# Check whether FUSE is available on this system (/dev/fuse exists).
# Returns 1 if available, 0 otherwise.
fn fuse_is_available(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;               # agnos has no /dev/fuse — FUSE unavailable
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_access("/dev/fuse", 0) == 0;   # mode 0 = F_OK; the stdlib names no access modes
    #endif
}

# ================================================================
# Mountpoint validation
# ================================================================

# Validate that a path is suitable as a FUSE mountpoint.
# Checks: not null, exists, is a directory, is not the root directory by any spelling.
# Returns Result: Ok(0) or Err.
fn fuse_validate_mountpoint(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse mountpoint validation");   # agnos has no FUSE
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0 || strlen(path) == 0) {
        return drm_err_invalid_argument("mountpoint path is empty");
    }

    # Check path exists and is a directory. struct stat is per-arch: st_mode
    # sits at +24 on x86_64 but +16 on aarch64, where a raw +24 reads st_uid
    # and rejected every directory. Size and offset come from the stdlib's
    # per-target Stat enum.
    var statbuf = alloc(STAT_BUFSZ);
    var ret = sys_stat(path, statbuf);
    if (ret < 0) {
        return drm_err_invalid_argument("mountpoint does not exist");
    }

    var mode = load32(statbuf + STAT_MODE);
    # S_IFDIR = 0x4000 = 16384
    if ((mode & 0xF000) != 0x4000) {
        return drm_err_invalid_argument("mountpoint is not a directory");
    }

    # Root by identity, so "//", "/." and "/tmp/.." are caught too. st_dev is at +0 and
    # st_ino at +8 on x86_64 and aarch64 alike; the stdlib names neither.
    var rootbuf = alloc(STAT_BUFSZ);
    if (sys_stat("/", rootbuf) == 0) {
        if (load64(statbuf) == load64(rootbuf)) {
            if (load64(statbuf + 8) == load64(rootbuf + 8)) {
                return drm_err_invalid_argument("cannot use filesystem root as mountpoint");
            }
        }
    }

    return Ok(0);
    #endif
}

# ================================================================
# List FUSE mounts (convenience wrapper)
# ================================================================

# List all currently mounted FUSE filesystems.
# Returns Result: Ok(vec_of_mounts) or Err.
fn fuse_list_mounts(): i64 {
    var res_t, res_v = _fuse_read_mounts(1);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
}

# ================================================================
# FUSE mount status
# ================================================================

# FuseStatus constants
enum FuseStatus {
    FUSE_MOUNTED = 1;
    FUSE_NOT_MOUNTED = 2;
    FUSE_ERROR = 3;
}

# 1 if `mountpoint`, trailing slashes aside, is in `mounts`, a vec of fuse_mount.
fn _fuse_mounted_in(mounts, mountpoint): i64 {
    var mplen = strlen(mountpoint);
    while (mplen > 1) {
        if (load8(mountpoint + mplen - 1) != 47) { break; }
        mplen = mplen - 1;
    }
    var i = 0;
    while (i < vec_len(mounts)) {
        var m = vec_get(mounts, i);
        var mp = fuse_mount_mountpoint(m);
        if (mp != 0 && strlen(mp) == mplen && memeq(mp, mountpoint, mplen) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Get the status of a FUSE mount at the given mountpoint, trailing slashes aside.
# Returns Result: Ok(FuseStatus) or Err.
fn fuse_get_status(mountpoint): i64 {
    if (mountpoint == 0 || strlen(mountpoint) == 0) {
        return drm_err_invalid_argument("mountpoint is empty");
    }

    var res_t, res_v = _fuse_read_mounts(1);
    if (is_err_result(res_t) == 1) { return Ok(FUSE_ERROR); }

    if (_fuse_mounted_in(res_v, mountpoint) == 1) { return Ok(FUSE_MOUNTED); }
    return Ok(FUSE_NOT_MOUNTED);
}
