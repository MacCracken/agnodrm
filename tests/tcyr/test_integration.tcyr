    alloc_init();
    println("================================================================");
    println("  agnodrm integration tests — device model + deferred modules");   #skip-lint
    println("================================================================");
    test_error();
    test_update();
    test_bootloader();
    bootloader_danger_reset();
    test_bootloader_entries();
    test_bootctl_parse();
    test_fd_hygiene();
    test_fuse();
    test_udev();
    test_drm();
    test_netns();
    test_journald();
    println("");
    var f = assert_summary();
    if (f > 0) { return 1; }
    return 0;
}
var r = main();
sys_exit(r);
