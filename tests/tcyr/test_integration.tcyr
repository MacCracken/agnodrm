include "src/update.cyr"
include "src/fuse.cyr"

# ================================================================
# error (27 assertions)
# ================================================================

fn test_error() {
    println("-- error --");
    assert_eq(drm_syserr_kind(drm_syserr_pack(DRM_ERR_SYSCALL_FAILED, EPERM)), DRM_ERR_SYSCALL_FAILED, "pack_k");
    assert_eq(drm_syserr_errno(drm_syserr_pack(DRM_ERR_SYSCALL_FAILED, EPERM)), EPERM, "pack_e");
    assert_eq(drm_syserr_kind(drm_syserr_pack(DRM_ERR_IO, EIO)), DRM_ERR_IO, "pack_io_k");
    assert_eq(drm_syserr_errno(drm_syserr_pack(DRM_ERR_IO, EIO)), EIO, "pack_io_e");
    var pd = drm_syserr_pack(DRM_ERR_PERMISSION_DENIED, EACCES);
    assert_eq(drm_syserr_kind(pd), DRM_ERR_PERMISSION_DENIED, "pack_pd");
    var h = drm_syserr_new(DRM_ERR_IO, EIO, "test");
    assert_eq(drm_syserr_kind(h), DRM_ERR_IO, "heap_k");
    assert_eq(drm_syserr_errno(h), EIO, "heap_e");
    assert(drm_syserr_message(h) != 0, "heap_m");
    assert_eq(is_syscall_err(0 - 1), 1, "err_neg");
    assert_eq(is_syscall_err(0 - 999), 1, "err_neg2");
    assert_eq(is_syscall_err(0), 0, "err_zero");
    assert_eq(is_syscall_err(1), 0, "err_pos");
    var ws_t, ws_v = wrap_syscall(42);
    assert(is_ok(ws_t) == 1, "wrap_ok");
    assert_eq(ws_v, 42, "wrap_v");
    assert(is_err_result(wrap_syscall(0 - 1)) == 1, "wrap_e");
    assert(is_ok(wrap_syscall(0)) == 1, "wrap_0");
    assert(is_err_result(drm_err_from_errno(EPERM)) == 1, "errno_perm");
    assert(is_err_result(drm_err_from_errno(EACCES)) == 1, "errno_acces");
    assert(is_err_result(drm_err_from_errno(EINVAL)) == 1, "errno_inval");
    assert(is_err_result(drm_err_from_errno(ENOSYS)) == 1, "errno_nosys");
    assert(is_err_result(drm_err_invalid_argument("x")) == 1, "eia");
    assert(is_err_result(drm_err_permission_denied("x")) == 1, "epd");
    assert(is_err_result(drm_err_not_supported("x")) == 1, "ens");
    assert(is_err_result(drm_err_unknown("x")) == 1, "euk");
    assert(is_err_result(drm_err_io(EIO, "x")) == 1, "eio");
    assert(is_err_result(drm_err_module_not_loaded("x")) == 1, "eml");
    return 0;
}

# ================================================================
# update (15 assertions)
# ================================================================

fn test_update() {
    println("-- update --");
    assert(is_ok(update_validate_version("2025.3.1")) == 1, "v_good");
    assert(is_err_result(update_validate_version("")) == 1, "v_empty");
    assert(is_err_result(update_validate_version("bad")) == 1, "v_bad");
    assert_eq(update_compare_versions("2025.1.0", "2025.2.0"), VER_LESS, "less");
    assert_eq(update_compare_versions("2025.3.0", "2025.3.0"), VER_EQUAL, "equal");
    assert_eq(update_compare_versions("2025.3.1", "2025.3.0"), VER_GREATER, "greater");
    assert_eq(update_other_slot(SLOT_A), SLOT_B, "sl_a");
    assert_eq(update_other_slot(SLOT_B), SLOT_A, "sl_b");
    assert(streq(update_slot_str(SLOT_A), "A") == 1, "sl_sa");
    assert(streq(update_slot_str(SLOT_B), "B") == 1, "sl_sb");
    assert(streq(update_phase_str(PHASE_DOWNLOADING), "Downloading") == 1, "ph_dl");
    assert(streq(update_phase_str(PHASE_COMPLETE), "Complete") == 1, "ph_ok");
    var us = update_state_new(SLOT_A, "2026.5.1");
    update_state_set_boot_count(us, 7);
    var sb = str_builder_new();
    update_state_to_json(us, sb);
    var json = str_builder_build(sb);
    var sb_exp = str_builder_new();
    str_builder_add_cstr(sb_exp, "{\"slot\":1,\"version\":\"2026.5.1\",\"pending\":null,");
    str_builder_add_cstr(sb_exp, "\"rollback_available\":0,\"boot_count\":7}");
    assert(str_eq(json, str_builder_build(sb_exp)) == 1, "us_json");
    # Regression (1.6.2): a pending update is a cstring and must serialize as a
    # quoted string — it used to print the string's heap address as an integer.
    update_state_set_pending(us, "2026.9.1");
    var sbp = str_builder_new();
    update_state_to_json(us, sbp);
    var sb_expp = str_builder_new();
    str_builder_add_cstr(sb_expp, "{\"slot\":1,\"version\":\"2026.5.1\",\"pending\":\"2026.9.1\",");
    str_builder_add_cstr(sb_expp, "\"rollback_available\":0,\"boot_count\":7}");
    assert(str_eq(str_builder_build(sbp), str_builder_build(sb_expp)) == 1, "us_json_pending");

    # Regression (1.3.0): update_check on a manifest larger than the
    # 16384-byte read buffer must not overflow. The old read loop let
    # `total` reach 16384, so the trailing `store8(buf+total,0)` wrote
    # one byte past a full buffer. Manifest is >16383 bytes with the
    # version field near the front so it still parses after truncation.
    var mpath = "/tmp/agnos-update-bigmanifest.json";
    var mbuf = alloc(20000);
    var mhdr = "{\"version\":\"9999.1.0\",\"pad\":\"";
    var mp = strlen(mhdr);
    memcpy(mbuf, mhdr, mp);
    memset(mbuf + mp, 65, 18000);  # 'A' padding past the 16KB buffer
    mp = mp + 18000;
    memcpy(mbuf + mp, "\"}", 2);
    mp = mp + 2;
    assert(file_write_all(mpath, mbuf, mp) == mp, "big_write");
    var bcfg = update_config_new();
    update_config_set_url(bcfg, "file:///tmp/agnos-update-bigmanifest.json");
    var bres_t, bres_v = update_check(bcfg, "2026.1.0");
    assert(is_ok(bres_t) == 1, "big_check_ok");
    assert(bres_v != 0, "big_check_newer");
    xunlink(mpath);
    return 0;
}

# ================================================================
# bootloader (10 assertions)
# ================================================================

fn test_bootloader() {
    println("-- bootloader --");
    assert(is_ok(bootloader_validate_kernel_cmdline("root=/dev/sda1 ro")) == 1, "cmd_ok");
    assert(is_err_result(bootloader_validate_kernel_cmdline("root=/dev/sda1 init=/bin/sh")) == 1, "cmd_bad");
    assert(is_ok(bootloader_validate_kernel_cmdline("quiet splash")) == 1, "cmd_qs");
    assert(streq(bootloader_type_str(BOOT_SYSTEMD_BOOT), "systemd-boot") == 1, "bt_sd");
    assert(streq(bootloader_type_str(BOOT_GRUB2), "GRUB2") == 1, "bt_gr");
    var be = bootloader_entry_new();
    bootloader_entry_set_id(be, "arch");
    bootloader_entry_set_title(be, "Arch Linux");
    bootloader_entry_set_is_default(be, 1);
    assert(streq(bootloader_entry_id(be), "arch") == 1, "be_id");
    assert(streq(bootloader_entry_title(be), "Arch Linux") == 1, "be_t");
    assert_eq(bootloader_entry_is_default(be), 1, "be_d");
    var bc = bootloader_config_new();
    bootloader_config_set_type(bc, BOOT_SYSTEMD_BOOT);
    bootloader_config_set_timeout(bc, 5);
    assert_eq(bootloader_config_type(bc), BOOT_SYSTEMD_BOOT, "bc_t");
    assert_eq(bootloader_config_timeout(bc), 5, "bc_to");

    # F-1 (1.5.3): the danger denylist enumerated only three init= shells and
    # had no entry at all for rdinit=, rescue targets, or mitigation/KASLR
    # downgrades. Each of these passed validation before this release.
    assert(is_err_result(bootloader_validate_kernel_cmdline("root=/dev/sda1 rdinit=/bin/sh")) == 1, "cmd_rdinit");
    assert(is_err_result(bootloader_validate_kernel_cmdline("rdinit=/sbin/anything")) == 1, "cmd_rdinit_any");
    assert(is_err_result(bootloader_validate_kernel_cmdline("ro init=/bin/zsh")) == 1, "cmd_zsh");
    assert(is_err_result(bootloader_validate_kernel_cmdline("ro init=/bin/busybox")) == 1, "cmd_busybox");
    assert(is_err_result(bootloader_validate_kernel_cmdline("quiet mitigations=off")) == 1, "cmd_mitig");
    assert(is_err_result(bootloader_validate_kernel_cmdline("quiet nokaslr")) == 1, "cmd_nokaslr");
    assert(is_err_result(bootloader_validate_kernel_cmdline("systemd.unit=rescue.target")) == 1, "cmd_rescue");
    assert(is_err_result(bootloader_validate_kernel_cmdline("ro security=none")) == 1, "cmd_secnone");
    # Case-insensitive: tokens are lowercased before lookup.
    assert(is_err_result(bootloader_validate_kernel_cmdline("ro RDINIT=/bin/sh")) == 1, "cmd_rdinit_case");
    # `rdinit` is matched as the prefix `rdinit=`, so a token that merely
    # starts with those letters must NOT trip it.
    assert(is_ok(bootloader_validate_kernel_cmdline("ro rdinitfoo=1")) == 1, "cmd_rdinit_noprefix");
    return 0;
}

# ================================================================
# bootloader loader-entries fallback (V1.6.x) — BLS Type #1 fixtures
# ================================================================

# Fixture helpers. Everything lives under a per-pid directory in /tmp and is
# removed at the end; every path goes through the portable io.cyr / fs.cyr
# helpers, the same ones the parser uses.
fn _blfx_path(dir, name) {
    return str_data(path_join(str_from(dir), str_from(name)));
}

fn _blfx_write(dir, name, text, files) {
    vec_push(files, name);
    return file_write_all(_blfx_path(dir, name), text, strlen(text));
}

# Write `len` bytes of `ch` (LF every 64 bytes) behind a "title" line, so the
# file parses as an entry when it is within the cap.
fn _blfx_write_sized(dir, name, len, files) {
    var b = alloc(len + 1);
    memset(b, 97, len);
    var i = 63;
    while (i < len) { store8(b + i, 10); i = i + 64; }
    memcpy(b, "title Big\n", 10);
    vec_push(files, name);
    return file_write_all(_blfx_path(dir, name), b, len);
}

fn _blfx_find(arr, n, id) {
    var i = 0;
    while (i < n) {
        var e = load64(arr + i * 8);
        if (streq(bootloader_entry_id(e), id) == 1) { return e; }
        i = i + 1;
    }
    return 0;
}

fn test_bootloader_entries() {
    println("-- bootloader loader entries --");
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-bls-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    var dir = _blfx_path(root, "entries");
    var empty = _blfx_path(root, "empty");
    xmkdir(root, 0x1C0);
    assert_eq(xmkdir(dir, 0x1C0), 0, "bls_fx_mkdir");
    xmkdir(empty, 0x1C0);
    var files = vec_new();

    # Written out of order; listing must come back byte-wise by file name.
    _blfx_write(dir, "c-third.conf", "title Third\nlinux /vmlinuz-c\n", files);
    # Repeated initrd / options, plus valid BLS keys with no struct field.
    var sa = str_builder_new();
    str_builder_add_cstr(sa, "title  Arch Linux\nversion 6.9.1-arch1\nlinux /vmlinuz-linux\n");
    str_builder_add_cstr(sa, "initrd /intel-ucode.img\ninitrd /initramfs-linux.img\n");
    str_builder_add_cstr(sa, "options root=UUID=abc rw\noptions quiet\n");
    str_builder_add_cstr(sa, "machine-id 0123456789abcdef\nsort-key arch\nefi /ignored.efi\n");
    _blfx_write(dir, "a-first.conf", str_data(str_builder_build(sa)), files);
    # CRLF, tabs, trailing blanks, indented and trailing comments, blank lines.
    var sc = str_builder_new();
    str_builder_add_cstr(sc, "# leading comment\r\n\r\n  title\tWin Dows  \r\n");
    str_builder_add_cstr(sc, "\tlinux\t\t/vmlinuz-b\r\n   # indented comment\r\noptions\tro \t\r\n\r\n");
    _blfx_write(dir, "b-crlf.conf", str_data(str_builder_build(sc)), files);
    # Missing title and linux; a key that merely starts with a known key; an
    # empty value; no trailing newline.
    _blfx_write(dir, "d-partial.conf", "linuxefi /not-linux\ntitlefoo bar\nlinux   \noptions quiet splash", files);
    # Not entries: hidden, wrong/extra suffix, bare ".conf", no suffix, a
    # suffix of the wrong case.
    _blfx_write(dir, ".hidden.conf", "title Hidden\n", files);
    _blfx_write(dir, "README", "title Readme\n", files);
    _blfx_write(dir, "x.conf.bak", "title Backup\n", files);
    _blfx_write(dir, ".conf", "title Dotconf\n", files);
    _blfx_write(dir, "upper.CONF", "title Upper\n", files);
    # A NUL byte: not a text entry.
    var nulname = "e-nul.conf";
    var nulbuf = alloc(32);
    memcpy(nulbuf, "title Nul\n", 10);
    store8(nulbuf + 10, 0);
    memcpy(nulbuf + 11, "linux /x\n", 9);
    vec_push(files, nulname);
    file_write_all(_blfx_path(dir, nulname), nulbuf, 20);
    # Exactly at the cap parses (the terminator lands at buf[cap], inside the
    # cap + 1 buffer); one byte over is skipped, not truncated.
    _blfx_write_sized(dir, "f-atcap.conf", BOOTLOADER_ENTRY_FILE_MAX, files);
    _blfx_write_sized(dir, "g-overcap.conf", BOOTLOADER_ENTRY_FILE_MAX + 1, files);
    # A directory named like an entry: not a regular file, skipped.
    var subdir = _blfx_path(dir, "h-dir.conf");
    xmkdir(subdir, 0x1C0);

    var arr = alloc(8 * 16);
    var r_t, r_v = bootloader_list_loader_entries(dir, arr, 16);
    assert(is_ok(r_t) == 1, "bls_ok");
    assert_eq(r_v, 5, "bls_count");
    assert(streq(bootloader_entry_id(load64(arr)), "a-first.conf") == 1, "bls_order_0");
    assert(streq(bootloader_entry_id(load64(arr + 8)), "b-crlf.conf") == 1, "bls_order_1");
    assert(streq(bootloader_entry_id(load64(arr + 16)), "c-third.conf") == 1, "bls_order_2");
    assert(streq(bootloader_entry_id(load64(arr + 24)), "d-partial.conf") == 1, "bls_order_3");
    assert(streq(bootloader_entry_id(load64(arr + 32)), "f-atcap.conf") == 1, "bls_order_4");

    var a = _blfx_find(arr, r_v, "a-first.conf");
    assert(streq(bootloader_entry_title(a), "Arch Linux") == 1, "bls_title");
    assert(streq(bootloader_entry_version(a), "6.9.1-arch1") == 1, "bls_version");
    assert(streq(bootloader_entry_linux(a), "/vmlinuz-linux") == 1, "bls_linux");
    assert(streq(bootloader_entry_initrd(a), "/intel-ucode.img /initramfs-linux.img") == 1, "bls_initrd_joined");
    assert(streq(bootloader_entry_options(a), "root=UUID=abc rw quiet") == 1, "bls_options_joined");
    assert_eq(bootloader_entry_is_default(a), 0, "bls_is_default_0");

    var b = _blfx_find(arr, r_v, "b-crlf.conf");
    assert(streq(bootloader_entry_title(b), "Win Dows") == 1, "bls_crlf_title");
    assert(streq(bootloader_entry_linux(b), "/vmlinuz-b") == 1, "bls_crlf_linux");
    assert(streq(bootloader_entry_options(b), "ro") == 1, "bls_crlf_options");
    assert_eq(bootloader_entry_initrd(b), 0, "bls_crlf_no_initrd");

    var d = _blfx_find(arr, r_v, "d-partial.conf");
    assert_eq(bootloader_entry_title(d), 0, "bls_missing_title");
    assert_eq(bootloader_entry_linux(d), 0, "bls_missing_linux");
    assert(streq(bootloader_entry_options(d), "quiet splash") == 1, "bls_no_trailing_nl");

    var f = _blfx_find(arr, r_v, "f-atcap.conf");
    assert(streq(bootloader_entry_title(f), "Big") == 1, "bls_at_cap");
    assert_eq(_blfx_find(arr, r_v, "g-overcap.conf"), 0, "bls_over_cap_skipped");
    assert_eq(_blfx_find(arr, r_v, "e-nul.conf"), 0, "bls_nul_skipped");

    # max_entries truncates AFTER sorting, so it is always the same prefix.
    var arr2 = alloc(8 * 2);
    var t_t, t_v = bootloader_list_loader_entries(dir, arr2, 2);
    assert(is_ok(t_t) == 1, "bls_trunc_ok");
    assert_eq(t_v, 2, "bls_trunc_count");
    assert(streq(bootloader_entry_id(load64(arr2 + 8)), "b-crlf.conf") == 1, "bls_trunc_prefix");
    var z_t, z_v = bootloader_list_loader_entries(dir, 0, 0);
    assert(is_ok(z_t) == 1, "bls_max0_ok");
    assert_eq(z_v, 0, "bls_max0_count");

    # Empty directory → Ok(0); missing directory and a regular file → Err.
    var e_t, e_v = bootloader_list_loader_entries(empty, arr, 16);
    assert(is_ok(e_t) == 1, "bls_empty_ok");
    assert_eq(e_v, 0, "bls_empty_zero");
    assert(is_err_result(bootloader_list_loader_entries(_blfx_path(root, "missing"), arr, 16)) == 1, "bls_missing_err");
    var regular = _blfx_path(dir, "c-third.conf");
    assert(is_err_result(bootloader_list_loader_entries(regular, arr, 16)) == 1, "bls_file_err");
    assert(is_err_result(bootloader_list_loader_entries(0, arr, 16)) == 1, "bls_null_dir_err");
    assert(is_err_result(bootloader_list_loader_entries(dir, arr, 0 - 1)) == 1, "bls_neg_max_err");
    assert(is_err_result(bootloader_list_loader_entries(dir, 0, 4)) == 1, "bls_null_arr_err");

    # Name filter, called directly: a '/' or an over-long name cannot come out
    # of a Linux directory listing, so the walk above cannot reach them; a
    # control byte can. All three are refused before any open.
    var longname = alloc(320);
    memset(longname, 97, 300);
    memcpy(longname + 295, ".conf", 5);
    assert_eq(_bootloader_entry_name_ok(str_new(longname, 300)), 0, "bls_name_long");
    assert_eq(_bootloader_entry_name_ok(str_from("a/b.conf")), 0, "bls_name_slash");
    assert_eq(_bootloader_entry_name_ok(str_from("a\tb.conf")), 0, "bls_name_ctrl");
    assert_eq(_bootloader_entry_name_ok(str_from("ok-1.conf")), 1, "bls_name_ok");

    # Cleanup.
    var fi = 0;
    while (fi < vec_len(files)) {
        xunlink(_blfx_path(dir, vec_get(files, fi)));
        fi = fi + 1;
    }
    xrmdir(subdir);
    xrmdir(dir);
    xrmdir(empty);
    assert_eq(xrmdir(root), 0, "bls_fx_cleanup");
    return 0;
}

# ================================================================
# fuse (4 assertions)
# ================================================================

fn test_fuse() {
    println("-- fuse --");
    assert_eq(fuse_starts_with("fuse.sshfs", "fuse"), 1, "f_h");
    assert_eq(fuse_starts_with("ext4", "fuse"), 0, "f_m");
    var m = fuse_mount_new("/dev/fuse", "/mnt/data", "fuse.sshfs", "rw");
    assert(streq(fuse_mount_device(m), "/dev/fuse") == 1, "fm_d");
    assert(streq(fuse_mount_mountpoint(m), "/mnt/data") == 1, "fm_m");
    # F-7 (1.1.14): /proc/mounts octal-escape unescape (\040 → space, etc.)
    var line1 = "device /mnt/with\\040space type rw 0 0";
    var f1 = fuse_extract_field(line1, strlen(line1), 1);
    assert(streq(f1, "/mnt/with space") == 1, "esc_space");
    var line2 = "src /mnt/path\\134escape ext4 rw 0 0";
    var f2 = fuse_extract_field(line2, strlen(line2), 1);
    assert(streq(f2, "/mnt/path\\escape") == 1, "esc_backslash");
    var line3 = "src /no/escape ext4 rw 0 0";
    var f3 = fuse_extract_field(line3, strlen(line3), 1);
    assert(streq(f3, "/no/escape") == 1, "esc_none");
    # The real read+parse path against the live /proc/mounts. See also
    # test_fuse_mount_table for tables past the first buffer.
    var marr = alloc(8 * 128);
    var mres_t, mres_v = fuse_parse_proc_mounts(marr, 128, 0);
    assert(is_ok(mres_t) == 1, "fpm_ok");
    assert(mres_v >= 0, "fpm_count");
    return 0;
}

# ================================================================
# udev (7 assertions)
# ================================================================

fn test_udev() {
    println("-- udev --");
    assert_eq(udev_parse_subsystem("block"), SUBSYS_BLOCK, "u_blk");
    assert_eq(udev_parse_subsystem("net"), SUBSYS_NET, "u_net");
    assert_eq(udev_parse_subsystem("input"), SUBSYS_INPUT, "u_inp");
    assert_eq(udev_parse_subsystem("usb"), SUBSYS_USB, "u_usb");
    assert_eq(udev_parse_subsystem("xxx"), SUBSYS_OTHER, "u_oth");
    var d = udev_devinfo_new();
    udev_devinfo_set_syspath(d, "/sys/devices/pci0");
    assert(streq(udev_devinfo_syspath(d), "/sys/devices/pci0") == 1, "ud_sp");
    udev_devinfo_set_driver(d, "e1000e");
    assert(streq(udev_devinfo_driver(d), "e1000e") == 1, "ud_dr");
    return 0;
}

# ================================================================
# drm (7 assertions)
# ================================================================

fn test_drm() {
    println("-- drm --");
    assert_eq(DRM_CAP_DUMB_BUFFER, 1, "drm_db");
    assert_eq(DRM_CAP_PRIME, 5, "drm_pr");
    var v = drm_verinfo_new(1, 2, 3, "amdgpu", "20230101", "AMD GPU");
    assert_eq(drm_verinfo_major(v), 1, "dv_ma");
    assert_eq(drm_verinfo_minor(v), 2, "dv_mi");
    assert_eq(drm_verinfo_patch(v), 3, "dv_pa");
    assert(streq(drm_verinfo_name(v), "amdgpu") == 1, "dv_n");
    assert(streq(drm_verinfo_desc(v), "AMD GPU") == 1, "dv_de");
    var sb = str_builder_new();
    drm_verinfo_to_json(v, sb);
    var json = str_builder_build(sb);
    var sb_exp = str_builder_new();
    str_builder_add_cstr(sb_exp, "{\"major\":1,\"minor\":2,\"patch\":3,");
    str_builder_add_cstr(sb_exp, "\"name\":\"amdgpu\",\"date\":\"20230101\",\"desc\":\"AMD GPU\"}");
    assert(str_eq(json, str_builder_build(sb_exp)) == 1, "dv_json");
    return 0;
}

# ================================================================
# netns (14 assertions)
# ================================================================

fn test_netns() {
    println("-- netns --");
    var c = netns_config_new("agent-1", "10.0.0.2", "10.0.0.1", 24, 1);
    assert(streq(netns_config_name(c), "agent-1") == 1, "nc_n");
    assert(streq(netns_config_agent_ip(c), "10.0.0.2") == 1, "nc_ai");
    assert_eq(netns_config_prefix_len(c), 24, "nc_pl");
    assert_eq(netns_config_enable_nat(c), 1, "nc_nat");
    var h = netns_handle_new("ns1", "veth-h", "veth-a", "/var/run/netns/ns1");
    assert(streq(netns_handle_name(h), "ns1") == 1, "nh_n");
    assert(streq(netns_handle_veth_host(h), "veth-h") == 1, "nh_vh");
    var fr = netns_fw_rule_new(TRAFFIC_INBOUND, PROTO_TCP, 443, "0.0.0.0", FW_ACCEPT, "https");
    assert_eq(netns_fw_rule_direction(fr), TRAFFIC_INBOUND, "fr_d");
    assert_eq(netns_fw_rule_protocol(fr), PROTO_TCP, "fr_p");
    assert_eq(netns_fw_rule_port(fr), 443, "fr_pt");
    assert_eq(netns_fw_rule_action(fr), FW_ACCEPT, "fr_a");
    var fp = netns_fw_policy_new(FW_DROP, FW_ACCEPT);
    assert_eq(netns_fw_policy_default_in(fp), FW_DROP, "fp_i");
    assert_eq(netns_fw_policy_default_out(fp), FW_ACCEPT, "fp_o");

    # F-7 (1.5.3): prefix_len was checked with `== 0` and `> 32`, so a
    # negative value passed both and then overflowed the alloc(4) scratch
    # that fmt_int_buf renders it into.
    var cneg = netns_config_new("agent-neg", "10.0.0.2", "10.0.0.1", 0 - 999999, 1);
    assert(is_err_result(netns_validate_config(cneg)) == 1, "nc_plen_neg");
    var czero = netns_config_new("agent-z", "10.0.0.2", "10.0.0.1", 0, 1);
    assert(is_err_result(netns_validate_config(czero)) == 1, "nc_plen_zero");
    var cbig = netns_config_new("agent-b", "10.0.0.2", "10.0.0.1", 33, 1);
    assert(is_err_result(netns_validate_config(cbig)) == 1, "nc_plen_33");
    var cok = netns_config_new("agent-ok", "10.0.0.2", "10.0.0.1", 24, 1);
    assert(is_ok(netns_validate_config(cok)) == 1, "nc_plen_24");

    # F-6 (1.5.3): rule ports were never range-checked and were rendered with
    # fmt_int_buf into an alloc(8) scratch — an 8+ digit port wrote past it.
    # In-range ports still render; out-of-range ones are skipped rather than
    # emitted as an unloadable nft rule.
    var rules = alloc(8 * 2);
    var rok = netns_fw_rule_new(TRAFFIC_INBOUND, PROTO_TCP, 443, "0.0.0.0", FW_ACCEPT, "https");
    var rbad = netns_fw_rule_new(TRAFFIC_INBOUND, PROTO_TCP, 999999999, "0.0.0.0", FW_ACCEPT, "oob");
    store64(rules, rok);
    store64(rules + 8, rbad);
    var pol = netns_fw_policy_new(FW_DROP, FW_ACCEPT);
    netns_fw_policy_set_rules(pol, rules, 2);
    var rs = netns_render_nftables_ruleset(pol);
    assert(strstr(rs, "dport 443") >= 0, "nft_port_inrange");
    assert(strstr(rs, "999999999") < 0, "nft_port_oob_skipped");

    # Regression (1.3.0): netns command exec was broken — the argv array was
    # passed as a single argument to run_capture/_exec3 (cmd + 2 args max),
    # so multi-arg `ip netns add ...` never reached the binary. netns now
    # builds a cstr vec and runs it via exec_vec, which NULL-terminates a
    # real argv and execve's an absolute path. The privileged `ip` path
    # needs CAP_NET_ADMIN, so guard the mechanism netns depends on with a
    # rootless absolute-path command carrying two args past argv[0].
    var ed = "/tmp/agnos-netns-exec-test/sub";
    var margs = vec_new();
    vec_push(margs, "/usr/bin/mkdir");
    vec_push(margs, "-p");
    vec_push(margs, ed);
    exec_vec(margs);
    assert(is_dir(str_from(ed)) == 1, "exec_vec_multiarg");
    xrmdir("/tmp/agnos-netns-exec-test/sub");
    xrmdir("/tmp/agnos-netns-exec-test");
    return 0;
}

# ================================================================
# journald (6 assertions)
# ================================================================

fn test_journald() {
    println("-- journald --");
    var e = journald_entry_new(170000, str_from("svc"), JOURNAL_INFO, str_from("hello"), 1234);
    assert_eq(journald_entry_timestamp(e), 170000, "je_ts");
    assert_eq(journald_entry_priority(e), JOURNAL_INFO, "je_pri");
    assert_eq(journald_entry_pid(e), 1234, "je_pid");
    var f = journald_filter_new();
    journald_filter_set_unit(f, "sshd.service");
    journald_filter_set_priority(f, JOURNAL_ERR);
    journald_filter_set_lines(f, 50);
    assert(streq(journald_filter_unit(f), "sshd.service") == 1, "jf_u");
    assert_eq(journald_filter_priority(f), JOURNAL_ERR, "jf_p");
    assert_eq(journald_filter_lines(f), 50, "jf_l");
    return 0;
}

# ================================================================
# bootloader: bootctl list parser (regression, 1.6.2)
# ================================================================

fn test_bootctl_parse() {
    println("-- bootloader bootctl list --");
    # The real `bootctl list` shape (systemd 261): title BEFORE id, display
    # marks on the title, continuation lines under initrd AND options (a UKI
    # cmdline with a newline), a continuation under a key that is not joined,
    # an Automatic entry. Through 1.6.1 each entry got the NEXT one's title.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "         type: Boot Loader Specification Type #2 (UKI, .efi)\n");
    str_builder_add_cstr(sb, "        title: Test OS (default) (not reported/new)\n");
    str_builder_add_cstr(sb, "           id: test.efi\n");
    str_builder_add_cstr(sb, "        linux: /boot//EFI/Linux/test.efi\n");
    str_builder_add_cstr(sb, "      options: root=/dev/sda1 rw\n");
    str_builder_add_cstr(sb, "              init=/bin/sh\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "         type: Boot Loader Specification Type #1 (.conf)\n");
    str_builder_add_cstr(sb, "        title: Arch Linux (linux)\n");
    str_builder_add_cstr(sb, "           id: arch.conf\n");
    str_builder_add_cstr(sb, "        linux: /boot//vmlinuz-linux\n");
    str_builder_add_cstr(sb, "       initrd: /boot//intel-ucode.img\n");
    str_builder_add_cstr(sb, "               /boot//initramfs-linux.img\n");
    str_builder_add_cstr(sb, "      options: root=PARTUUID=abc rw\n");
    str_builder_add_cstr(sb, "devicetree-overlay: /boot//o1.dtbo\n");
    str_builder_add_cstr(sb, "               /boot//o2.dtbo\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "         type: Automatic\n");
    str_builder_add_cstr(sb, "        title: Reboot Into Firmware Interface\n");
    str_builder_add_cstr(sb, "           id: auto-reboot-to-firmware-setup\n");
    var text = str_data(str_builder_build(sb));
    var arr = alloc(8 * 8);
    var r_t, r_v = bootloader_parse_bootctl_list(text, arr, 8);
    assert(is_ok(r_t) == 1, "bctl_ok");
    assert_eq(r_v, 3, "bctl_count");
    var e0 = load64(arr);
    assert(streq(bootloader_entry_id(e0), "test.efi") == 1, "bctl_e0_id");
    assert(streq(bootloader_entry_title(e0), "Test OS (default) (not reported/new)") == 1, "bctl_e0_title_as_printed");
    assert_eq(bootloader_entry_is_default(e0), 0, "bctl_no_default_guess");
    # the security-relevant one: a continued options line must not be dropped
    assert(streq(bootloader_entry_options(e0), "root=/dev/sda1 rw init=/bin/sh") == 1, "bctl_e0_options_continued");
    var e1 = load64(arr + 8);
    assert(streq(bootloader_entry_title(e1), "Arch Linux (linux)") == 1, "bctl_e1_own_title");
    var e1_initrd = "/boot//intel-ucode.img /boot//initramfs-linux.img";
    assert(streq(bootloader_entry_initrd(e1), e1_initrd) == 1, "bctl_e1_initrd_joined");
    assert(streq(bootloader_entry_options(e1), "root=PARTUUID=abc rw") == 1, "bctl_e1_overlay_not_joined");
    var e2 = load64(arr + 16);
    assert(streq(bootloader_entry_id(e2), "auto-reboot-to-firmware-setup") == 1, "bctl_e2_id");
    assert(streq(bootloader_entry_title(e2), "Reboot Into Firmware Interface") == 1, "bctl_e2_own_title");
    assert_eq(bootloader_entry_linux(e2), 0, "bctl_e2_no_kernel");

    # id before title still works, and a block with no id (a header) is dropped.
    # F-6: what makes a continuation is its indent, not its text. A line that reads
    # like a label stays options, so the cmdline validator sees what it hides.
    var bh = "        title: A\n           id: a.conf\n      options: root=/dev/sda\n";
    var ct1 = netns_concat2(bh, "              x: init=/bin/sh\n              rd.break\n");
    var c1_t, c1_v = bootloader_parse_bootctl_list(ct1, arr, 8);
    assert_eq(c1_v, 1, "bctl_cont_label_entries");
    var c1 = load64(arr);
    var c1o = bootloader_entry_options(c1);
    assert(streq(c1o, "root=/dev/sda x: init=/bin/sh rd.break") == 1, "bctl_cont_label_joined");
    assert(is_err_result(bootloader_validate_kernel_cmdline(c1o)) == 1, "bctl_cont_label_rejected");
    var ct2 = netns_concat2(bh, "              id: b.conf init=/bin/sh\n");
    var c2_t, c2_v = bootloader_parse_bootctl_list(ct2, arr, 8);
    var c2 = load64(arr);
    assert(streq(bootloader_entry_id(c2), "a.conf") == 1, "bctl_cont_id_kept");
    var c2o = bootloader_entry_options(c2);
    assert(is_err_result(bootloader_validate_kernel_cmdline(c2o)) == 1, "bctl_cont_id_rejected");
    # A line of blanks inside the value does not end the block.
    var ct3 = netns_concat2(bh, "              \n              init=/bin/sh\n\n");
    ct3 = netns_concat2(ct3, "        title: B\n           id: b.conf\n");
    var c3_t, c3_v = bootloader_parse_bootctl_list(ct3, arr, 8);
    assert_eq(c3_v, 2, "bctl_cont_blank_entries");
    var c3o = bootloader_entry_options(load64(arr));
    assert(is_err_result(bootloader_validate_kernel_cmdline(c3o)) == 1, "bctl_cont_blank_rejected");
    assert(streq(bootloader_entry_id(load64(arr + 8)), "b.conf") == 1, "bctl_cont_blank_next_block");
    # The colon column resets per block, and a short blank line still ends one.
    var ct4 = "   id: a.conf\n   \n     title: B\n        id: b.conf\n";
    var c4_t, c4_v = bootloader_parse_bootctl_list(ct4, arr, 8);
    assert_eq(c4_v, 2, "bctl_cont_short_blank");
    assert(streq(bootloader_entry_title(load64(arr + 8)), "B") == 1, "bctl_cont_column_resets");

    var h_t, h_v = bootloader_parse_bootctl_list("Boot Loader Entries:\n\n  id: x.conf\n  title: X\n", arr, 8);
    assert(is_ok(h_t) == 1, "bctl_hdr_ok");
    assert_eq(h_v, 1, "bctl_header_dropped");
    assert(streq(bootloader_entry_title(load64(arr)), "X") == 1, "bctl_id_first_title");

    # max_entries still caps the result; bad arguments are errors, not crashes.
    var m_t, m_v = bootloader_parse_bootctl_list(text, arr, 1);
    assert(is_ok(m_t) == 1, "bctl_max_ok");
    assert_eq(m_v, 1, "bctl_max_entries");
    var n_t, n_v = bootloader_parse_bootctl_list(0, arr, 8);
    assert(is_err_result(n_t) == 1, "bctl_null_text_err");
    var a_t, a_v = bootloader_parse_bootctl_list(text, 0, 8);
    assert(is_err_result(a_t) == 1, "bctl_null_arr_err");
    return 0;
}

# ================================================================
# fd hygiene (regression, 1.6.2)
# ================================================================

# Open descriptors, counted from /proc/self/fd. Counting (not the lowest free
# fd) sees a leak of ANY descriptor: a leaked fd opened while a lower one was
# still held leaves the lowest free fd unchanged once the lower one closes.
fn _open_fd_count() {
    return vec_len(dir_list(str_from("/proc/self/fd")));
}

# "file://" + path as a NUL-terminated cstring. (str_cat does not terminate,
# so its data is not a C string.)
fn _file_url(path) {
    var sbu = str_builder_new();
    str_builder_add_cstr(sbu, "file://");
    str_builder_add_cstr(sbu, path);
    return str_data(str_builder_build(sbu));
}

fn test_fd_hygiene() {
    println("-- fd hygiene --");
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-fd-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    assert_eq(xmkdir(root, 0x1C0), 0, "fd_fx_mkdir");
    var a = _blfx_path(root, "a.bin");
    var b = _blfx_path(root, "b.bin");
    var gone = _blfx_path(root, "no/such/file");
    var st = _blfx_path(root, "state.json");
    var empty = _blfx_path(root, "empty.json");
    var man = _blfx_path(root, "manifest.json");
    var nover = _blfx_path(root, "noversion.json");
    file_write_all(empty, "", 0);
    file_write_all(man, "{\"version\":\"9999.1.0\"}", 22);
    file_write_all(nover, "{\"channel\":\"stable\"}", 20);
    var arr = alloc(64 * 8);

    var before = _open_fd_count();
    var i = 0;
    while (i < 3) {
        # success paths
        var w_t, w_v = update_atomic_write(a, "payload", 7);
        assert(is_ok(w_t) == 1, "fd_write_ok");
        var c_t, c_v = update_atomic_copy(a, b);
        assert(is_ok(c_t) == 1, "fd_copy_ok");
        var s_t, s_v = update_save_state(update_state_new(SLOT_B, "2026.9.1"), st);
        assert(is_ok(s_t) == 1, "fd_save_ok");
        var l_t, l_v = update_load_state(st);
        assert(is_ok(l_t) == 1, "fd_load_ok");
        var cfg = update_config_new();
        update_config_set_url(cfg, _file_url(man));
        var k_t, k_v = update_check(cfg, "2026.1.0");
        assert(is_ok(k_t) == 1, "fd_check_ok");
        var m_t, m_v = fuse_parse_proc_mounts(arr, 64, 0);
        assert(is_ok(m_t) == 1, "fd_mounts_ok");
        var d_t, d_v = drm_list_devices(arr, 8);
        # error paths taken after a descriptor is already open
        var ce_t, ce_v = update_atomic_copy(a, gone);
        assert(is_err_result(ce_t) == 1, "fd_copy_dst_err");
        var le_t, le_v = update_load_state(empty);
        assert(is_err_result(le_t) == 1, "fd_load_empty_err");
        var cfg2 = update_config_new();
        update_config_set_url(cfg2, _file_url(nover));
        var ke_t, ke_v = update_check(cfg2, "2026.1.0");
        assert(is_err_result(ke_t) == 1, "fd_check_nover_err");
        i = i + 1;
    }
    assert_eq(_open_fd_count(), before, "fd_no_leak");

    xunlink(a);
    xunlink(b);
    xunlink(st);
    xunlink(empty);
    xunlink(man);
    xunlink(nover);
    assert_eq(xrmdir(root), 0, "fd_fx_cleanup");
    return 0;
}

# ================================================================
# Main
# ================================================================

fn _tmpx_holds(path, text) {
    var buf = alloc(64);
    var n = file_read_all(path, buf, 63);
    if (n != strlen(text)) { return 0; }
    store8(buf + n, 0);
    return streq(buf, text);
}

# ================================================================
# fuse: a whole mount table, however long (audit F-7)
# ================================================================

fn test_fuse_mount_table() {
    println("-- fuse mount table (audit F-7) --");
    var sbp = str_builder_new();
    str_builder_add_cstr(sbp, "/tmp/agnodrm-mounts-");
    str_builder_add_int(sbp, sys_getpid());
    var path = str_data(str_builder_build(sbp));
    # Well past both old limits: 8 KiB of table, and 128 FUSE mounts.
    var sb = str_builder_new();
    var i = 0;
    while (i < 3000) {
        str_builder_add_cstr(sb, "tmpfs /run/mnt");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, " tmpfs rw,nosuid 0 0\n");
        i = i + 1;
    }
    i = 0;
    while (i < 200) {
        str_builder_add_cstr(sb, "sshfs#u@h:/ /mnt/f");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, " fuse.sshfs rw 0 0\n");
        i = i + 1;
    }
    var data = str_builder_build(sb);
    assert(str_len(data) > 65536, "mnt_fx_past_first_chunk");
    assert_eq(file_write_all(path, str_data(data), str_len(data)), str_len(data), "mnt_fx_write");

    var fd = sys_open(path, O_RDONLY, 0);
    var a_t, a_v = _fuse_collect_mounts(fd, 1);
    sys_close(fd);
    assert(is_ok(a_t) == 1, "mnt_fuse_only_ok");
    assert_eq(vec_len(a_v), 200, "mnt_fuse_only_all");
    assert(streq(fuse_mount_mountpoint(vec_get(a_v, 199)), "/mnt/f199") == 1, "mnt_last_entry");

    fd = sys_open(path, O_RDONLY, 0);
    var b_t, b_v = _fuse_collect_mounts(fd, 0);
    sys_close(fd);
    assert_eq(vec_len(b_v), 3200, "mnt_all_entries");

    # The public reader stops at the caller's array, whatever the table holds.
    var one = alloc(16);
    store64(one + 8, 0x5A5A);
    var o_t, o_v = fuse_parse_proc_mounts(one, 1, 0);
    assert(is_ok(o_t) == 1, "mnt_bounded_ok");
    assert(o_v <= 1, "mnt_bounded_count");
    assert_eq(load64(one + 8), 0x5A5A, "mnt_bounded_canary");

    # A table past the cap fails rather than parse part of itself.
    fd = sys_open("/dev/zero", O_RDONLY, 0);
    var z_t, z_v = _fuse_collect_mounts(fd, 0);
    sys_close(fd);
    assert(is_err_result(z_t) == 1, "mnt_too_large_err");

    # A read failure is an Err, not an empty table.
    var e_t, e_v = _fuse_collect_mounts(0 - 1, 0);
    assert(is_err_result(e_t) == 1, "mnt_read_error_err");

    xunlink(path);
    return 0;
}

# ================================================================
# update slot paths (audit F-3, F-4, F-5, F-13), under a scratch root
# ================================================================

fn _updfx_write(root, rel, text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, root);
    str_builder_add_cstr(sb, rel);
    var path = str_data(str_builder_build(sb));
    xunlink(path);
    return file_write_all(path, text, strlen(text));
}

# An executable stub. It runs under /bin/sh, never the host's tool.
fn _updfx_tool(root, rel, text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, root);
    str_builder_add_cstr(sb, rel);
    var path = str_data(str_builder_build(sb));
    xunlink(path);
    var fd = file_create_exclusive(path, 0x1ED);  # mode 0755
    sys_write(fd, text, strlen(text));
    sys_close(fd);
    return 0;
}

fn _updfx_holds(root, rel, text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, root);
    str_builder_add_cstr(sb, rel);
    return _tmpx_holds(str_data(str_builder_build(sb)), text);
}

fn _updfx_rm(root, rel) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, root);
    str_builder_add_cstr(sb, rel);
    return xunlink(str_data(str_builder_build(sb)));
}

# What _update_cmdline_slot makes of `text`: the slot, 0 for none, -1 for an Err.
fn _updfx_cmdline_slot(root, text) {
    _updfx_write(root, "/proc/cmdline", text);
    var t, v = _update_cmdline_slot();
    if (is_err_result(t) == 1) { return 0 - 1; }
    return v;
}

fn test_update_slots() {
    println("-- update slot paths (audit F-3, F-4, F-5, F-13) --");
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-upd-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    assert_eq(xmkdir(root, 0x1C0), 0, "upd_fx_mkdir");
    var dirs = vec_new();
    vec_push(dirs, "/proc");
    vec_push(dirs, "/var");
    vec_push(dirs, "/var/lib");
    vec_push(dirs, "/var/lib/agnos");
    vec_push(dirs, "/var/lib/agnos/updates");
    vec_push(dirs, "/usr");
    vec_push(dirs, "/usr/bin");
    var di = 0;
    while (di < vec_len(dirs)) {
        var dsb = str_builder_new();
        str_builder_add_cstr(dsb, root);
        str_builder_add_cstr(dsb, vec_get(dirs, di));
        assert_eq(xmkdir(str_data(str_builder_build(dsb)), 0x1C0), 0, "upd_fx_subdir");
        di = di + 1;
    }
    _update_root = root;

    var sf = _update_path("/var/lib/agnos/update-state.json");
    var image = _update_path("/var/lib/agnos/updates/image.img");
    var slot_a = _blfx_path(root, "rootfs_a");
    var slot_b = _blfx_path(root, "rootfs_b");
    _updfx_tool(root, "/usr/bin/argonaut", "#!/bin/sh\nexit 0\n");
    var efi_tail = "\n  exit 0\nfi\necho \"$*\" > \"$0.log\"\n";
    var efi_head = "#!/bin/sh\nif [ $# -eq 0 ]; then\n  ";
    var efi_list = "printf 'BootCurrent: 0003\\nBoot0003* AGNOS-B\\tHD(1)\\nBoot0004* AGNOS-A\\tHD(2)\\n'";
    _updfx_tool(root, "/usr/bin/efibootmgr", netns_concat3(efi_head, efi_list, efi_tail));
    file_write_all(image, "NEWIMAGE", 8);
    file_write_all(slot_a, "OLD-A", 5);
    file_write_all(slot_b, "OLD-B", 5);
    var cfg = update_config_new();
    update_config_set_state_file(cfg, sf);
    update_config_set_slot_a(cfg, slot_a);
    update_config_set_slot_b(cfg, slot_b);
    var man = update_manifest_new("2026.2.1", CHAN_STABLE, "2026-02-01");
    vec_push(update_manifest_files(man), update_file_new(image, "00", 8));

    # F-3: a rollback from B must leave the state saying A, with no cmdline slot
    # for update_get_current_slot to prefer.
    _updfx_write(root, "/proc/cmdline", "ro quiet\n");
    var s = update_state_new(SLOT_B, "2026.1.1");
    update_state_set_pending(s, "2026.1.1");
    update_state_set_rollback(s, 1);
    update_state_set_boot_count(s, 3);
    var sv_t, sv_v = update_save_state(s, sf);
    assert(is_ok(sv_t) == 1, "upd_fx_state");
    var rb_t, rb_v = update_rollback(cfg);
    assert(is_ok(rb_t) == 1, "upd_rollback_ok");
    assert(_updfx_holds(root, "/var/lib/agnos/next-slot", "a") == 1, "upd_rollback_marker");
    var l_t, l_v = update_load_state(sf);
    assert(is_ok(l_t) == 1, "upd_rollback_load");
    assert_eq(update_state_slot(l_v), SLOT_A, "upd_rollback_state_slot");
    assert_eq(update_state_boot_count(l_v), 0, "upd_rollback_boot_count");
    assert_eq(update_state_rollback_available(l_v), 0, "upd_rollback_cleared");
    assert_eq(update_state_pending(l_v), 0, "upd_rollback_pending_cleared");
    assert(streq(update_state_version(l_v), "2026.1.1") == 1, "upd_rollback_version_kept");

    # F-13: --bootnext got the entry's hex number, not its label.
    assert(_updfx_holds(root, "/usr/bin/efibootmgr.log", "--bootnext 0004\n") == 1, "upd_bootnext_number");

    # The host has not rebooted, so it still runs B while the state says A. With no
    # agnos.slot= nothing can tell, so nothing is written: the state's answer would
    # overwrite B, the running slot.
    var np_t, np_v = update_apply(cfg, man);
    assert(is_err_result(np_t) == 1, "upd_apply_no_cmdline_refused");
    assert(_tmpx_holds(slot_a, "OLD-A") == 1, "upd_apply_no_cmdline_a_intact");
    assert(_tmpx_holds(slot_b, "OLD-B") == 1, "upd_apply_no_cmdline_b_intact");

    # Rebooted into A: the update goes to B, not to the slot the host runs from.
    _updfx_write(root, "/proc/cmdline", "ro agnos.slot=a quiet\n");
    var a_t, a_v = update_apply(cfg, man);
    assert(is_ok(a_t) == 1, "upd_apply_ok");
    assert(_tmpx_holds(slot_a, "OLD-A") == 1, "upd_apply_running_slot_intact");
    assert(_tmpx_holds(slot_b, "NEWIMAGE") == 1, "upd_apply_other_slot_written");
    file_write_all(slot_b, "OLD-B", 5);

    # And from B, A: the cmdline decides, whatever the state says.
    _updfx_write(root, "/proc/cmdline", "ro agnos.slot=b quiet\n");
    var ab_cl_t, ab_cl_v = update_apply(cfg, man);
    assert(is_ok(ab_cl_t) == 1, "upd_apply_from_b_ok");
    assert(_tmpx_holds(slot_b, "OLD-B") == 1, "upd_apply_from_b_running_intact");
    assert(_tmpx_holds(slot_a, "NEWIMAGE") == 1, "upd_apply_from_b_other_written");
    file_write_all(slot_a, "OLD-A", 5);

    # The state-file fallback: the slot it says, not the default.
    var fb = update_state_new(SLOT_B, "2026.1.1");
    var fb_t, fb_v = update_save_state(fb, sf);
    assert(is_ok(fb_t) == 1, "upd_fb_save");
    _updfx_write(root, "/proc/cmdline", "ro quiet\n");
    var g_t, g_v = update_get_current_slot();
    assert(is_ok(g_t) == 1, "upd_fallback_ok");
    assert_eq(g_v, SLOT_B, "upd_fallback_state_slot");

    # F-4: a slot that cannot be read is refused, not guessed.
    _updfx_write(root, "/proc/cmdline", "ro agnos.slot=x\n");
    var x_t, x_v = update_apply(cfg, man);
    assert(is_err_result(x_t) == 1, "upd_apply_bad_slot_refused");
    assert(_tmpx_holds(slot_a, "OLD-A") == 1, "upd_apply_bad_slot_a_intact");
    assert(_tmpx_holds(slot_b, "OLD-B") == 1, "upd_apply_bad_slot_b_intact");

    # Only a whole agnos.slot= token counts.
    assert_eq(_updfx_cmdline_slot(root, "ro agnos.slot=b quiet\n"), SLOT_B, "upd_cl_b");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=A"), SLOT_A, "upd_cl_upper_no_newline");
    assert_eq(_updfx_cmdline_slot(root, "\tagnos.slot=a\n"), SLOT_A, "upd_cl_tab");
    assert_eq(_updfx_cmdline_slot(root, "xagnos.slot=b quiet\n"), 0, "upd_cl_not_the_key");
    assert_eq(_updfx_cmdline_slot(root, "ro quiet\n"), 0, "upd_cl_absent");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=banana\n"), 0 - 1, "upd_cl_long_value");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=\n"), 0 - 1, "upd_cl_empty_value");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=a agnos.slot=b\n"), 0 - 1, "upd_cl_conflict");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=b agnos.slot=b\n"), SLOT_B, "upd_cl_repeated");
    # Tokens split as the kernel splits them.
    assert_eq(_updfx_cmdline_slot(root, "foo=\"bar agnos.slot=a baz\" ro\n"), 0, "upd_cl_quoted_inside");
    assert_eq(_updfx_cmdline_slot(root, "foo=\"a b\" agnos.slot=b\n"), SLOT_B, "upd_cl_after_quoted");
    assert_eq(_updfx_cmdline_slot(root, "foo=\"open agnos.slot=a\n"), 0, "upd_cl_unterminated_quote");
    assert_eq(_updfx_cmdline_slot(root, "ro -- agnos.slot=a\n"), 0, "upd_cl_after_dashes");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=b -- agnos.slot=a\n"), SLOT_B, "upd_cl_before_dashes");
    assert_eq(_updfx_cmdline_slot(root, "agnos.slot=\"b\"\n"), 0 - 1, "upd_cl_quoted_value");
    # Past the 1023 bytes the old read stopped at.
    var lsb = str_builder_new();
    var li = 0;
    while (li < 300) {
        str_builder_add_cstr(lsb, "param=value ");
        li = li + 1;
    }
    str_builder_add_cstr(lsb, "agnos.slot=b\n");
    assert_eq(_updfx_cmdline_slot(root, str_data(str_builder_build(lsb))), SLOT_B, "upd_cl_long_line");

    _updfx_write(root, "/proc/cmdline", "ro agnos.slot=a\n");

    # An image outside the staging directory is refused before anything runs.
    # The file exists, so only that check can stop dd.
    var elsewhere = _blfx_path(root, "elsewhere.img");
    assert_eq(file_write_all(elsewhere, "ELSEWHERE", 9), 9, "upd_fx_elsewhere");
    var outside = update_manifest_new("2026.2.1", CHAN_STABLE, "2026-02-01");
    vec_push(update_manifest_files(outside), update_file_new(elsewhere, "00", 9));
    var st_t, st_v = update_apply(cfg, outside);
    assert(is_err_result(st_t) == 1, "upd_apply_outside_staging_refused");
    assert(_tmpx_holds(slot_b, "OLD-B") == 1, "upd_apply_outside_staging_intact");
    xunlink(elsewhere);

    # F-5: an unsaved state is an Err, and a switch that failed leaves no marker.
    var bad = update_config_new();
    update_config_set_state_file(bad, _blfx_path(root, "no/such/state.json"));
    update_config_set_slot_a(bad, slot_a);
    update_config_set_slot_b(bad, slot_b);
    _updfx_rm(root, "/var/lib/agnos/next-slot");
    _updfx_rm(root, "/usr/bin/efibootmgr.log");
    var w_t, w_v = update_switch_slot(bad, SLOT_B);
    assert(is_err_result(w_t) == 1, "upd_switch_save_fail_err");
    assert_eq(file_exists(_update_path("/var/lib/agnos/next-slot")), 0, "upd_switch_no_marker");
    assert_eq(file_exists(_update_path("/usr/bin/efibootmgr.log")), 0, "upd_switch_no_bootnext");
    var ab_t, ab_v = update_apply(bad, man);
    assert(is_err_result(ab_t) == 1, "upd_apply_save_fail_err");

    # A failed switch leaves an earlier one standing, marker included.
    var gs_t, gs_v = update_switch_slot(cfg, SLOT_B);
    assert(is_ok(gs_t) == 1, "upd_good_switch");
    var bs_t, bs_v = update_switch_slot(bad, SLOT_A);
    assert(is_err_result(bs_t) == 1, "upd_failed_switch_err");
    assert(_updfx_holds(root, "/var/lib/agnos/next-slot", "b") == 1, "upd_failed_switch_marker_kept");
    assert(_updfx_holds(root, "/usr/bin/efibootmgr.log", "--bootnext 0003\n") == 1, "upd_failed_switch_firmware_kept");

    # A plain switch keeps the rollback record.
    var ks = update_state_new(SLOT_A, "2026.1.1");
    update_state_set_rollback(ks, 1);
    var ksv_t, ksv_v = update_save_state(ks, sf);
    var p_t, p_v = update_switch_slot(cfg, SLOT_B);
    assert(is_ok(p_t) == 1, "upd_switch_ok");
    assert(_updfx_holds(root, "/var/lib/agnos/next-slot", "b") == 1, "upd_switch_marker");
    assert(_updfx_holds(root, "/usr/bin/efibootmgr.log", "--bootnext 0003\n") == 1, "upd_switch_bootnext");
    var k_t, k_v = update_load_state(sf);
    assert_eq(update_state_slot(k_v), SLOT_B, "upd_switch_state_slot");
    assert_eq(update_state_rollback_available(k_v), 1, "upd_switch_keeps_rollback");

    # No entry for the slot: the switch stands, and --bootnext is not called.
    _updfx_rm(root, "/usr/bin/efibootmgr.log");
    _updfx_tool(root, "/usr/bin/efibootmgr", netns_concat3(efi_head, "echo 'BootCurrent: 0003'", efi_tail));
    var ne_t, ne_v = update_switch_slot(cfg, SLOT_A);
    assert(is_ok(ne_t) == 1, "upd_no_entry_ok");
    assert_eq(file_exists(_update_path("/usr/bin/efibootmgr.log")), 0, "upd_no_entry_no_call");

    # A BootNext that cannot follow the switch is cleared, not left pointing back.
    var clr_list = "printf 'BootNext: 0003\\nBoot0003* AGNOS-B\\tHD(1)\\n'";
    _updfx_rm(root, "/usr/bin/efibootmgr.log");
    _updfx_tool(root, "/usr/bin/efibootmgr", netns_concat3(efi_head, clr_list, efi_tail));
    var cl_t, cl_v = update_switch_slot(cfg, SLOT_A);
    assert(is_ok(cl_t) == 1, "upd_clear_bootnext_ok");
    assert(_updfx_holds(root, "/usr/bin/efibootmgr.log", "--delete-bootnext\n") == 1, "upd_clear_bootnext");
    # The same when --bootnext itself fails.
    var fail_tail = "\n  exit 0\nfi\necho \"$*\" >> \"$0.log\"\n[ \"$1\" = --bootnext ] && exit 1\nexit 0\n";
    _updfx_rm(root, "/usr/bin/efibootmgr.log");
    _updfx_tool(root, "/usr/bin/efibootmgr", netns_concat3(efi_head, clr_list, fail_tail));
    var fl_t, fl_v = update_switch_slot(cfg, SLOT_B);
    assert(is_ok(fl_t) == 1, "upd_failed_bootnext_ok");
    var both = "--bootnext 0003\n--delete-bootnext\n";
    assert(_updfx_holds(root, "/usr/bin/efibootmgr.log", both) == 1, "upd_failed_bootnext_cleared");

    # efibootmgr failing, as on a host with no EFI, costs nothing either.
    _updfx_tool(root, "/usr/bin/efibootmgr", "#!/bin/sh\nexit 2\n");
    var nf_t, nf_v = update_switch_slot(cfg, SLOT_B);
    assert(is_ok(nf_t) == 1, "upd_no_efi_ok");

    # The entry-list parser.
    var el = "BootCurrent: 0003\nBootNext: 0009\nBootOrder: 0003,0004\nBoot0001  Plain\n";
    el = netns_concat2(el, "Boot00AF* AGNOS-A rescue\tHD(9)\nBoot00B0* AGNOS-AB\tHD(8)\n");
    el = netns_concat2(el, "Boot00C1* AGNOS-A\tHD(1)\nBoot00C2  AGNOS-B\n");
    assert(streq(_update_efi_bootnum(el, "AGNOS-A"), "00C1") == 1, "upd_efi_exact_label");
    assert(streq(_update_efi_bootnum(el, "AGNOS-B"), "00C2") == 1, "upd_efi_inactive_no_tab");
    assert(streq(_update_efi_bootnum(el, "Plain"), "0001") == 1, "upd_efi_plain");
    assert_eq(_update_efi_bootnum(el, "AGNOS-C"), 0, "upd_efi_missing");
    assert_eq(_update_efi_bootnum("", "AGNOS-A"), 0, "upd_efi_empty");
    assert_eq(_update_efi_bootnum("BootXYZW* AGNOS-A\n", "AGNOS-A"), 0, "upd_efi_not_hex");
    assert_eq(_update_efi_bootnum("Boot0003*AGNOS-A\n", "AGNOS-A"), 0, "upd_efi_no_space");

    _update_root = 0;
    _updfx_rm(root, "/proc/cmdline");
    _updfx_rm(root, "/var/lib/agnos/update-state.json");
    _updfx_rm(root, "/var/lib/agnos/next-slot");
    _updfx_rm(root, "/var/lib/agnos/updates/image.img");
    _updfx_rm(root, "/usr/bin/argonaut");
    _updfx_rm(root, "/usr/bin/efibootmgr");
    _updfx_rm(root, "/usr/bin/efibootmgr.log");
    xunlink(slot_a);
    xunlink(slot_b);
    while (di > 0) {
        di = di - 1;
        var usb = str_builder_new();
        str_builder_add_cstr(usb, root);
        str_builder_add_cstr(usb, vec_get(dirs, di));
        assert_eq(xrmdir(str_data(str_builder_build(usb))), 0, "upd_fx_rmdir");
    }
    assert_eq(xrmdir(root), 0, "upd_fx_cleanup");
    return 0;
}

# ================================================================
# netns: every setup step is checked and undone (audit F-10)
# ================================================================

fn _nsfx_log_has(log, text) {
    var buf = alloc(4096);
    var n = file_read_all(log, buf, 4095);
    if (n < 0) { return 0; }
    store8(buf + n, 0);
    return strstr(buf, text) >= 0;
}

fn test_netns_setup() {
    println("-- netns setup steps (audit F-10) --");
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-ip-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    assert_eq(xmkdir(root, 0x1C0), 0, "ns_fx_mkdir");
    var stub = _blfx_path(root, "ip");
    var log = _blfx_path(root, "ip.log");
    _netns_ip_path = stub;
    var cfg = netns_config_new("agent-1", "10.0.0.2", "10.0.0.1", 24, 1);

    # Fail each configuration step in turn: no handle, and the create is undone.
    var steps = vec_new();
    vec_push(steps, "\"addr add 10.0.0.1/24 dev \"*");
    vec_push(steps, "*\"ip addr add 10.0.0.2/24 dev \"*");
    vec_push(steps, "\"link set veth-agent-1-h up\"");
    vec_push(steps, "*\"ip link set veth-agent-1-a up\"");
    vec_push(steps, "*\"ip link set lo up\"");
    vec_push(steps, "*\"ip route add default via \"*");
    var i = 0;
    while (i < vec_len(steps)) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "#!/bin/sh\necho \"$*\" >> \"$0.log\"\ncase \"$*\" in\n");
        str_builder_add_cstr(sb, vec_get(steps, i));
        str_builder_add_cstr(sb, ") exit 1;;\nesac\nexit 0\n");
        _updfx_tool(root, "/ip", str_data(str_builder_build(sb)));
        xunlink(log);
        var f_t, f_v = netns_create_agent_netns(cfg);
        assert(is_err_result(f_t) == 1, "ns_step_err");
        # Reached only past step 3, so this is the step under test failing.
        assert(_nsfx_log_has(log, "link delete") == 1, "ns_step_veth_undone");
        assert(_nsfx_log_has(log, "netns delete") == 1, "ns_step_ns_undone");
        i = i + 1;
    }

    # All steps pass: a handle, and nothing undone.
    _updfx_tool(root, "/ip", "#!/bin/sh\necho \"$*\" >> \"$0.log\"\nexit 0\n");
    xunlink(log);
    var o_t, o_v = netns_create_agent_netns(cfg);
    assert(is_ok(o_t) == 1, "ns_ok");
    assert(_nsfx_log_has(log, "route add default via 10.0.0.1") == 1, "ns_ok_reached_route");
    assert_eq(_nsfx_log_has(log, "delete"), 0, "ns_ok_nothing_undone");

    _netns_ip_path = 0;
    xunlink(stub);
    xunlink(log);
    assert_eq(xrmdir(root), 0, "ns_fx_cleanup");
    return 0;
}

# ================================================================
# run_capture reports how the tool ended (audit F-11)
# ================================================================

fn _capfx(script) {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, script);
    return args;
}

fn test_run_capture_status() {
    println("-- run_capture exit status (audit F-11) --");
    var buf = alloc(64);
    var a_t, a_v = agnodrm_run_capture(_capfx("printf hi"), buf, 63, "failed");
    assert(is_ok(a_t) == 1, "cap_ok");
    assert_eq(a_v, 2, "cap_bytes");
    assert(memeq(buf, "hi", 2) == 1, "cap_output");
    var b_t, b_v = agnodrm_run_capture(_capfx("printf partial; exit 1"), buf, 63, "failed");
    assert(is_err_result(b_t) == 1, "cap_nonzero_err");
    var c_t, c_v = agnodrm_run_capture(_capfx("kill -9 $$"), buf, 63, "failed");
    assert(is_err_result(c_t) == 1, "cap_signal_err");
    var missing = vec_new();
    vec_push(missing, "/no/such/tool");
    var d_t, d_v = agnodrm_run_capture(missing, buf, 63, "failed");
    assert(is_err_result(d_t) == 1, "cap_missing_tool_err");

    # A full buffer closes the pipe, and the tool dies of SIGPIPE: that is truncation,
    # which the caller checks by bytes_read, not a tool failure.
    var e_t, e_v = agnodrm_run_capture(_capfx("exec yes x"), buf, 63, "failed");
    assert(is_ok(e_t) == 1, "cap_full_buffer_ok");
    assert_eq(e_v, 63, "cap_full_buffer_bytes");
    # With no buffer at all there is no truncation to report, so a failure still shows.
    var z_t, z_v = agnodrm_run_capture(_capfx("exit 1"), buf, 0, "failed");
    assert(is_err_result(z_t) == 1, "cap_zero_buffer_err");

    # bootctl output that does not fit is refused, never parsed cut or swapped for
    # the entries directories.
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-cap-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    assert_eq(xmkdir(root, 0x1C0), 0, "cap_fx_mkdir");
    var stub = _blfx_path(root, "tool");
    _bootloader_bootctl = stub;
    var arr = alloc(16 * 8);
    _updfx_tool(root, "/tool", "#!/bin/sh\nexec yes '      options: root=/dev/sda'\n");
    var f_t, f_v = bootloader_list_boot_entries(arr, 16);
    assert(is_err_result(f_t) == 1, "cap_bootctl_overflow_refused");
    # bootctl failing, with a partial listing, is not parsed either.
    _updfx_tool(root, "/tool", "#!/bin/sh\necho '  id: partial.conf'\nexit 1\n");
    var g_t, g_v = bootloader_list_boot_entries(arr, 16);
    var seen = 0;
    if (is_ok(g_t) == 1) {
        var gi = 0;
        while (gi < g_v) {
            if (streq(bootloader_entry_id(load64(arr + gi * 8)), "partial.conf") == 1) { seen = 1; }
            gi = gi + 1;
        }
    }
    assert_eq(seen, 0, "cap_bootctl_failed_not_parsed");
    _bootloader_bootctl = 0;

    # journald_query keeps what fits when journalctl has more to say.
    _journald_tool = stub;
    var f = journald_filter_new();
    _updfx_tool(root, "/tool", "#!/bin/sh\nexec yes '{\"MESSAGE\":\"hi\",\"PRIORITY\":\"6\"}'\n");
    var j1_t, j1_v = journald_query(f);
    assert(is_ok(j1_t) == 1, "jq_full_buffer_ok");
    assert(vec_len(j1_v) > 0, "jq_full_buffer_entries");
    # Exit 1 is bad input without --grep, and no match with it.
    _updfx_tool(root, "/tool", "#!/bin/sh\nexit 1\n");
    var j2_t, j2_v = journald_query(f);
    assert(is_err_result(j2_t) == 1, "jq_exit1_err");
    var fg = journald_filter_new();
    journald_filter_set_grep(fg, str_from("nomatch"));
    var j3_t, j3_v = journald_query(fg);
    assert(is_ok(j3_t) == 1, "jq_grep_no_match_ok");
    assert_eq(vec_len(j3_v), 0, "jq_grep_no_match_empty");
    _updfx_tool(root, "/tool", "#!/bin/sh\nexit 2\n");
    var j4_t, j4_v = journald_query(fg);
    assert(is_err_result(j4_t) == 1, "jq_grep_exit2_err");
    _updfx_tool(root, "/tool", "#!/bin/sh\nkill -9 $$\n");
    var j5_t, j5_v = journald_query(f);
    assert(is_err_result(j5_t) == 1, "jq_signal_err");
    _journald_tool = "/no/such/journalctl";
    var j6_t, j6_v = journald_query(f);
    assert(is_err_result(j6_t) == 1, "jq_missing_tool_err");
    _journald_tool = 0;

    xunlink(stub);
    assert_eq(xrmdir(root), 0, "cap_fx_cleanup");
    return 0;
}

# ================================================================
# journal datagrams: a newline cannot forge a field (audit F-9)
# ================================================================

# The field names in a datagram, by the protocol's rules, or -1 if it is malformed.
fn _jfx_keys(payload) {
    var p = str_data(payload);
    var n = str_len(payload);
    var keys = vec_new();
    var pos = 0;
    while (pos < n) {
        var ks = pos;
        while (pos < n) {
            var c = load8(p + pos);
            if (c == 10) { break; }
            if (c == 61) { break; }
            pos = pos + 1;
        }
        if (pos >= n) { return 0 - 1; }
        var klen = pos - ks;
        var name = alloc(klen + 1);
        memcpy(name, p + ks, klen);
        store8(name + klen, 0);
        vec_push(keys, name);
        if (load8(p + pos) == 61) {
            while (pos < n) {
                if (load8(p + pos) == 10) { break; }
                pos = pos + 1;
            }
            pos = pos + 1;
        } else {
            pos = pos + 1;
            if (pos + 8 > n) { return 0 - 1; }
            var vlen = load64(p + pos);
            pos = pos + 8 + vlen;
            if (pos >= n) { return 0 - 1; }
            if (load8(p + pos) != 10) { return 0 - 1; }
            pos = pos + 1;
        }
    }
    return keys;
}

fn test_journald_payload() {
    println("-- journal datagrams (audit F-9) --");
    var sb = str_builder_new();
    _journald_add_base_fields(sb, "hello", 6, "agnodrm");
    var plain = str_builder_build(sb);
    assert(streq(str_data(plain), "PRIORITY=6\nMESSAGE=hello\nSYSLOG_IDENTIFIER=agnodrm\n") == 1, "jp_plain");

    # A forged field stays inside MESSAGE, and the protocol reads three fields.
    var sb2 = str_builder_new();
    _journald_add_base_fields(sb2, "x\nPRIORITY=0\nSYSLOG_IDENTIFIER=sshd", 6, "agnodrm");
    var forged = str_builder_build(sb2);
    var keys = _jfx_keys(forged);
    assert(keys != 0 - 1, "jp_forged_wellformed");
    assert_eq(vec_len(keys), 3, "jp_forged_three_fields");
    assert(streq(vec_get(keys, 0), "PRIORITY") == 1, "jp_forged_k0");
    assert(streq(vec_get(keys, 1), "MESSAGE") == 1, "jp_forged_k1");
    assert(streq(vec_get(keys, 2), "SYSLOG_IDENTIFIER") == 1, "jp_forged_k2");

    # The binary form's bytes: KEY\n, a little-endian u64, the value, \n.
    var sb3 = str_builder_new();
    _journald_add_field(sb3, "K", "a\nb");
    var bin = str_builder_build(sb3);
    assert_eq(str_len(bin), 2 + 8 + 3 + 1, "jp_bin_len");
    assert_eq(load8(str_data(bin) + 1), 10, "jp_bin_key_end");
    assert_eq(load64(str_data(bin) + 2), 3, "jp_bin_size");
    assert(memeq(str_data(bin) + 10, "a\nb\n", 4) == 1, "jp_bin_value");

    # Field names the journal accepts, and no others.
    assert_eq(_journald_key_valid("CODE_FILE"), 1, "jk_ok");
    assert_eq(_journald_key_valid("A1_2"), 1, "jk_digits");
    assert_eq(_journald_key_valid("CODE=X"), 0, "jk_equals");
    assert_eq(_journald_key_valid(""), 0, "jk_empty");
    assert_eq(_journald_key_valid(0), 0, "jk_null");
    assert_eq(_journald_key_valid("A\nB"), 0, "jk_newline");
    assert_eq(_journald_key_valid("lower"), 0, "jk_lower");
    assert_eq(_journald_key_valid("_PID"), 0, "jk_trusted");
    assert_eq(_journald_key_valid("9X"), 0, "jk_digit_first");
    var klong = alloc(66);
    memset(klong, 65, 65);
    store8(klong + 65, 0);
    assert_eq(_journald_key_valid(klong), 0, "jk_too_long");
    store8(klong + 64, 0);
    assert_eq(_journald_key_valid(klong), 1, "jk_max_len");

    # journald_send_fields drops a name the journal would not accept, with its value.
    var fkeys = vec_new();
    var fvals = vec_new();
    vec_push(fkeys, "GOOD_KEY");
    vec_push(fvals, "kept");
    vec_push(fkeys, "CODE=X");
    vec_push(fvals, "a\nPRIORITY=0");
    vec_push(fkeys, "");
    vec_push(fvals, "PRIORITY=0\nB");
    vec_push(fkeys, "NULL_VALUE");
    vec_push(fvals, 0);
    var sbf = str_builder_new();
    _journald_add_base_fields(sbf, "m", 6, "agnodrm");
    _journald_add_extra_fields(sbf, fkeys, fvals);
    var fkv = _jfx_keys(str_builder_build(sbf));
    assert(fkv != 0 - 1, "jp_fields_wellformed");
    assert_eq(vec_len(fkv), 4, "jp_fields_count");
    assert(streq(vec_get(fkv, 3), "GOOD_KEY") == 1, "jp_fields_kept");

    # The identifier and extra-field values take the same path.
    var sb4 = str_builder_new();
    _journald_add_base_fields(sb4, "m", 6, "id\nPRIORITY=0");
    _journald_add_field(sb4, "EXTRA", "v\nMESSAGE=forged");
    var keys2 = _jfx_keys(str_builder_build(sb4));
    assert_eq(vec_len(keys2), 4, "jp_other_fields");
    return 0;
}

# ================================================================
# temp files refuse a planted name (audit F-1)
# ================================================================

# The name agnodrm_tmp_create will try `ahead` attempts from now.
fn _tmpx_name(base, ahead) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, ".tmp.");
    str_builder_add_int(sb, sys_getpid());
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, _agnodrm_tmp_ctr + ahead);
    return str_data(str_builder_build(sb));
}

fn test_tmp_exclusive() {
    println("-- temp files refuse a planted name (audit F-1) --");
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "/tmp/agnodrm-tmpx-");
    str_builder_add_int(sbd, sys_getpid());
    var root = str_data(str_builder_build(sbd));
    assert_eq(xmkdir(root, 0x1C0), 0, "tmpx_fx_mkdir");
    var target = _blfx_path(root, "state.json");
    var copied = _blfx_path(root, "copied.bin");
    var victim = _blfx_path(root, "victim");
    var source = _blfx_path(root, "source.bin");
    var dangling = _blfx_path(root, "no-such-target");
    var missing = _blfx_path(root, "no/such/file");
    assert_eq(file_write_all(victim, "PRECIOUS", 8), 8, "tmpx_fx_victim");
    assert_eq(file_write_all(source, "COPYDATA", 8), 8, "tmpx_fx_source");

    # Two creates get two files, and each path comes back through path_out.
    var a_path = 0;
    var b_path = 0;
    var a_fd = agnodrm_tmp_create(target, &a_path);
    var b_fd = agnodrm_tmp_create(target, &b_path);
    assert(a_fd >= 0, "tmpx_create_a");
    assert(b_fd >= 0, "tmpx_create_b");
    assert(streq(a_path, b_path) == 0, "tmpx_names_differ");
    assert_eq(file_exists(a_path), 1, "tmpx_a_exists");
    assert_eq(file_exists(b_path), 1, "tmpx_b_exists");
    sys_close(a_fd);
    sys_close(b_fd);
    xunlink(a_path);
    xunlink(b_path);

    # update_atomic_write: a link planted at the very next name is left alone.
    var w_link = _tmpx_name(target, 0);
    assert_eq(xsymlink(victim, w_link), 0, "tmpx_w_plant");
    var w_t, w_v = update_atomic_write(target, "NEW-STATE", 9);
    assert(is_ok(w_t) == 1, "tmpx_w_ok");
    assert(_tmpx_holds(victim, "PRECIOUS") == 1, "tmpx_w_victim_intact");
    assert(_tmpx_holds(target, "NEW-STATE") == 1, "tmpx_w_target_written");
    assert_eq(is_symlink(str_from(target)), 0, "tmpx_w_target_regular");
    assert_eq(is_symlink(str_from(w_link)), 1, "tmpx_w_link_untouched");
    xunlink(w_link);

    # update_atomic_copy: the same, with a dangling link, which O_TRUNC would create.
    var c_link = _tmpx_name(copied, 0);
    assert_eq(xsymlink(dangling, c_link), 0, "tmpx_c_plant");
    var c_t, c_v = update_atomic_copy(source, copied);
    assert(is_ok(c_t) == 1, "tmpx_c_ok");
    assert_eq(c_v, 8, "tmpx_c_bytes");
    assert_eq(file_exists(dangling), 0, "tmpx_c_dangling_not_created");
    assert(_tmpx_holds(copied, "COPYDATA") == 1, "tmpx_c_target_written");
    assert_eq(is_symlink(str_from(copied)), 0, "tmpx_c_target_regular");
    xunlink(c_link);

    # Every candidate taken: refused, with nothing written anywhere.
    var links = vec_new();
    var i = 0;
    while (i < AGNODRM_TMP_MAX_TRIES) {
        var l = _tmpx_name(target, i);
        assert_eq(xsymlink(victim, l), 0, "tmpx_x_plant");
        vec_push(links, l);
        i = i + 1;
    }
    var x_t, x_v = update_atomic_write(target, "OVERWRITTEN", 11);
    assert(is_err_result(x_t) == 1, "tmpx_x_refused");
    assert(_tmpx_holds(target, "NEW-STATE") == 1, "tmpx_x_target_intact");
    assert(_tmpx_holds(victim, "PRECIOUS") == 1, "tmpx_x_victim_intact");
    i = 0;
    while (i < vec_len(links)) {
        xunlink(vec_get(links, i));
        i = i + 1;
    }

    # Null arguments are refused before anything is created.
    var null_path = 0;
    assert_eq(agnodrm_tmp_create(0, &null_path), 0 - EINVAL, "tmpx_null_base");
    assert_eq(agnodrm_tmp_create(target, 0), 0 - EINVAL, "tmpx_null_out");

    # A restarted process starts somewhere new, not at the same names (a fixed
    # pid would otherwise walk them again after every crash). 1 in 2^32 flake.
    var s_path = 0;
    _agnodrm_tmp_ctr = 0;
    var s_fd = agnodrm_tmp_create(target, &s_path);
    assert(s_fd >= 0, "tmpx_seed_create_a");
    var seed_a = _agnodrm_tmp_ctr;
    sys_close(s_fd);
    xunlink(s_path);
    _agnodrm_tmp_ctr = 0;
    s_fd = agnodrm_tmp_create(target, &s_path);
    assert(s_fd >= 0, "tmpx_seed_create_b");
    assert(seed_a != _agnodrm_tmp_ctr, "tmpx_seed_differs");
    sys_close(s_fd);
    xunlink(s_path);

    # A failure other than a taken name is returned at once, not retried.
    var before = _agnodrm_tmp_ctr;
    var m_path = 0;
    assert_eq(agnodrm_tmp_create(missing, &m_path), 0 - ENOENT, "tmpx_m_enoent");
    assert_eq(_agnodrm_tmp_ctr, before + 1, "tmpx_m_no_retry");
    assert_eq(m_path, 0, "tmpx_m_path_out_untouched");

    xunlink(target);
    xunlink(copied);
    xunlink(victim);
    xunlink(source);
    # rmdir fails if any path above left a temp file behind.
    assert_eq(xrmdir(root), 0, "tmpx_fx_cleanup");
    return 0;
}

fn main() {
    alloc_init();
    println("================================================================");
    println("  agnodrm integration tests — device model + deferred modules");   #skip-lint
    println("================================================================");
    test_error();
    test_update();
    test_bootloader();
    bootloader_danger_reset();
    test_bootloader_entries();
    test_bootctl_parse();
    test_fd_hygiene();
    test_tmp_exclusive();
    test_update_slots();
    test_fuse_mount_table();
    test_netns_setup();
    test_run_capture_status();
    test_journald_payload();
    test_fuse();
    test_udev();
    test_drm();
    test_netns();
    test_journald();
    println("");
    var f = assert_summary();
    if (f > 0) { return 1; }
    return 0;
}
var r = main();
sys_exit(r);
