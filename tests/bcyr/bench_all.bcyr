# bench_all.bcyr — batch-amortized benchmarks
# 23 benchmarks in 7 groups (error, bootloader, update, udev, fuse, string, parsers).
# Every row times BA_WINDOWS windows of BA_OPS inline ops each, through the
# stdlib's bench_batch_start / bench_batch_stop, so the book (raw total,
# iterations, windows, and the per-op min/max in picoseconds that 6.6.5 added)
# is kept by lib/bench.cyr rather than by offsets written here.
#
# Build: cyrius build tests/bcyr/bench_all.bcyr build/bench_all
# Run:   ./build/bench_all
#
# The row NAMES are the keys of bench-history.csv — renaming one breaks the
# cross-version record for that row.

#define LINUX

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/process.cyr"
include "lib/fs.cyr"
include "lib/bench.cyr"

include "src/error.cyr"
include "src/util.cyr"
include "src/bootloader.cyr"
include "src/update.cyr"
include "src/fuse.cyr"
include "src/udev.cyr"
include "src/journald.cyr"
include "src/netns.cyr"

# Batch shape: 10K ops per timed window x 100 windows (1M ops per row).
enum BenchShape {
    BA_OPS = 10000;
    BA_WINDOWS = 100;
    # Rows whose op allocates: alloc() never frees, so 1M of them would measure paging.
    BA_HEAVY_OPS = 500;
    BA_HEAVY_WINDOWS = 20;
}

fn do_bench(name) { return bench_new(name); }

# Copy a NUL-terminated bench input into a fresh 8-byte-aligned heap buffer.
#
# Why every string input goes through here, once, before its timed loop:
# stdlib `strlen` walks BYTES until the pointer is 8-aligned and only then
# reads a word at a time, and `streq`, the bootloader / update validators and
# hashmap keys all start with a `strlen`. A string literal lands wherever the
# toolchain packs the binary's data, so its alignment — and with it the cost of
# every row that reads it — moves whenever ANY literal in the binary moves:
# at 1.6.1 `strlen_16ch` went 11 -> 21 ns with no code change, because
# 6.6.5's lib/bench.cyr added literals ahead of "hello_world_test".
#
# The copy is zero-padded to a whole number of words, so a word-at-a-time
# reader never reads past the allocation. Literals the LIBRARY compares against
# internally (udev's subsystem names, bootloader's danger map) are not inputs
# and are not copied; they are part of what the row measures.
fn ba_aligned_cstr(s) {
    var n = strlen(s);
    var words = (n + 8) & (0 - 8);
    var p = alloc(words + 8);
    var a = (p + 7) & (0 - 8);
    memset(a, 0, words);
    memcpy(a, s, n);
    return a;
}

# ================================================================
# 2. error
# ================================================================

fn bench_errors() {
    println("-- error --");
    var b = do_bench("drm_syserr_pack");
    var ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { drm_syserr_pack(DRM_ERR_SYSCALL_FAILED, EPERM); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("from_errno_eperm");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { drm_err_from_errno(EPERM); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("ok_create");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { Ok(42); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("wrap_syscall_ok");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        # A constant, so this times the wrapper. Through 1.7.1 it called sys_getpid()
        # here, and 279 of the row's 280 ns were the kernel's.
        while (k < BA_OPS) { wrap_syscall(1234); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

# ================================================================
# 5. bootloader
# ================================================================

fn bench_bootloader() {
    println("-- bootloader --");
    var safe = ba_aligned_cstr("root=/dev/sda1 ro quiet splash");
    var bad = ba_aligned_cstr("root=/dev/sda1 init=/bin/sh");
    var tok_hit = ba_aligned_cstr("init=/bin/sh");
    var tok_miss = ba_aligned_cstr("emergency");
    var textlen = strlen(safe);
    var badlen = strlen(bad);

    var b = do_bench("validate_cmdline_safe");
    var ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { bootloader_validate_kernel_cmdline(safe); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("is_dangerous_token_hit");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { bootloader_is_dangerous_token(bad, badlen, tok_hit); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("is_dangerous_token_miss");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { bootloader_is_dangerous_token(safe, textlen, tok_miss); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

# ================================================================
# 6. update
# ================================================================

fn bench_updates() {
    println("-- update --");
    var ver_good = ba_aligned_cstr("2025.3.1");
    var ver_a = ba_aligned_cstr("2025.1.0");
    var ver_b = ba_aligned_cstr("2025.2.0");

    var b = do_bench("validate_ver_good");
    var ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { update_validate_version(ver_good); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("compare_versions");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { update_compare_versions(ver_a, ver_b); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("slot_other");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { update_other_slot(SLOT_A); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

