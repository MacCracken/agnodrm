# ================================================================
# 10. fuse
# ================================================================

fn bench_fuse() {
    println("-- fuse --");
    var fs_hit = ba_aligned_cstr("fuse.sshfs");
    var fs_miss = ba_aligned_cstr("ext4");
    var prefix = ba_aligned_cstr("fuse");

    var b = do_bench("starts_with_hit");
    var ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { fuse_starts_with(fs_hit, prefix); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("starts_with_miss");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { fuse_starts_with(fs_miss, prefix); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

# ================================================================
# 11. string / stdlib
# ================================================================

fn bench_strings() {
    println("-- string --");
    # ONE copy passed as both arguments: cyrius interns identical literals, so
    # streq("hello_world_test", "hello_world_test") always compared a pointer
    # with itself — keep that, so only the alignment changes.
    var hw = ba_aligned_cstr("hello_world_test");

    var b = do_bench("streq_16ch");
    var ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { streq(hw, hw); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("strlen_16ch");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { strlen(hw); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("memeq_16");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { memeq(hw, hw, 16); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    # Same interning rule: the hit lookup used the very pointer that was
    # stored, so the stored key and the looked-up key stay one buffer.
    var key_hit = ba_aligned_cstr("key1");
    var key_miss = ba_aligned_cstr("nonexistent");
    var m = map_new();
    map_set(m, key_hit, 42);

    b = do_bench("map_get_hit");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { map_get(m, key_hit); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    b = do_bench("map_get_miss");
    ri = 0;
    while (ri < BA_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_OPS) { map_get(m, key_miss); k = k + 1; }
        bench_batch_stop(b, BA_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

# ================================================================
# parsers: the external-input paths
# ================================================================

fn bench_parsers() {
    println("-- parsers --");
    var usb = str_builder_new();
    str_builder_add_cstr(usb, "P: /devices/pci0000:00/0000:00:1f.2/ata1/host0/target0:0:0/0:0:0:0/block/sda\n");
    str_builder_add_cstr(usb, "U: block\nT: disk\nN: sda\nE: DEVNAME=/dev/sda\nE: SUBSYSTEM=block\n");
    str_builder_add_cstr(usb, "E: ID_MODEL=Samsung\nE: ID_SERIAL=S1234\n");
    var udev_text = ba_aligned_cstr(str_data(str_builder_build(usb)));
    var udev_len = strlen(udev_text);
    var b = do_bench("udev_parse_block");
    var ri = 0;
    while (ri < BA_HEAVY_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_HEAVY_OPS) { _udev_parse_block(udev_text, udev_len); k = k + 1; }
        bench_batch_stop(b, BA_HEAVY_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    var lsb = str_builder_new();
    str_builder_add_cstr(lsb, "{\"__REALTIME_TIMESTAMP\":\"1700000000000000\",\"_SYSTEMD_UNIT\":\"sshd.service\",");
    str_builder_add_cstr(lsb, "\"PRIORITY\":\"6\",\"_PID\":\"1234\",\"MESSAGE\":\"Accepted publickey for root\"}");
    var line = str_from(ba_aligned_cstr(str_data(str_builder_build(lsb))));
    b = do_bench("journald_parse_json");
    ri = 0;
    while (ri < BA_HEAVY_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_HEAVY_OPS) { journald_parse_json(line); k = k + 1; }
        bench_batch_stop(b, BA_HEAVY_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    var esb = str_builder_new();
    str_builder_add_cstr(esb, "title Arch Linux\nversion 6.9.1-arch1\nlinux /vmlinuz-linux\n");
    str_builder_add_cstr(esb, "initrd /intel-ucode.img\ninitrd /initramfs-linux.img\n");
    str_builder_add_cstr(esb, "options root=PARTUUID=0a1b2c3d rw quiet\n");
    var entry_text = ba_aligned_cstr(str_data(str_builder_build(esb)));
    var entry_len = strlen(entry_text);
    var entry_out = bootloader_entry_new();
    b = do_bench("parse_bls_entry");
    ri = 0;
    while (ri < BA_HEAVY_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_HEAVY_OPS) { _bootloader_parse_entry_text(entry_out, entry_text, entry_len); k = k + 1; }
        bench_batch_stop(b, BA_HEAVY_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    var ssb = str_builder_new();
    str_builder_add_cstr(ssb, "{\"current_slot\":2,\"current_version\":\"2026.11.5\",");
    str_builder_add_cstr(ssb, "\"pending_update\":\"2026.12.1\",\"rollback_available\":true,\"boot_count\":3}\n");
    var state = ba_aligned_cstr(str_data(str_builder_build(ssb)));
    var state_len = strlen(state);
    b = do_bench("update_parse_state");
    ri = 0;
    while (ri < BA_HEAVY_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_HEAVY_OPS) { _update_parse_state(state, state_len); k = k + 1; }
        bench_batch_stop(b, BA_HEAVY_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    var rules = alloc(8 * 4);
    store64(rules, netns_fw_rule_new(TRAFFIC_INBOUND, PROTO_TCP, 22, "10.0.0.5", FW_ACCEPT, "ssh"));
    store64(rules + 8, netns_fw_rule_new(TRAFFIC_INBOUND, PROTO_UDP, 53, 0, FW_DROP, "dns"));
    store64(rules + 16, netns_fw_rule_new(TRAFFIC_OUTBOUND, PROTO_TCP, 443, "192.168.1.0/24", FW_ACCEPT, 0));
    store64(rules + 24, netns_fw_rule_new(TRAFFIC_OUTBOUND, PROTO_ANY, 0, 0, FW_DROP, "rest"));
    var policy = netns_fw_policy_new(FW_DROP, FW_ACCEPT);
    netns_fw_policy_set_rules(policy, rules, 4);
    b = do_bench("nft_render_policy");
    ri = 0;
    while (ri < BA_HEAVY_WINDOWS) {
        bench_batch_start(b);
        var k = 0;
        while (k < BA_HEAVY_OPS) { netns_render_nftables_ruleset(policy); k = k + 1; }
        bench_batch_stop(b, BA_HEAVY_OPS);
        ri = ri + 1;
    }
    bench_report(b);

    return 0;
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();
    # A fixed hash seed. The stdlib draws one per process, and with the danger map 43 keys
    # in 64 slots, validate_cmdline_safe swung 474-2974 ns across seeds and map_get_miss
    # 40-76 ns: rows that move that far between runs cannot show a regression.
    _hm_seed = 0x9E3779B97F4A7C15;
    println("================================================================");
    println("  agnodrm bench — device model + deferred, batch-amortized (10K x 100)");   #skip-lint
    println("================================================================");

    bench_errors();

    bench_bootloader();

    bench_updates();

    bench_udev();

    bench_fuse();

    bench_strings();

    bench_parsers();

    println("");
    println("================================================================");
    println("  done — 7 groups");
    println("================================================================");
    return 0;
}

var r = main();
sys_exit(r);
