# agnodrm — shared cross-module utilities
#
# Small helpers that several modules need identically. Kept here (rather
# than copied per-module) so a single definition is audited and tested
# once. Public `agnodrm_*` prefix per the project's prefix discipline.
#
# Placed in [lib.core] so the device-model bundle resolves these. (Several
# of these were shared with the trust/security modules that moved out in
# the agnosys → agnodrm decomposition; udev/drm + the deferred group (roadmap.md Scope) still
# use them.)

include "src/error.cyr"

# Emit a JSON value for a possibly-null C string into a str_builder:
# `null` when the pointer is 0, otherwise a JSON-quoted/escaped string.
# Replaces the per-module `_<mod>_emit_cstr_or_null` shims (mac, dmverity,
# drm, certpin, update) that were byte-identical.
fn agnodrm_json_emit_cstr_or_null(sb, c): i64 {
    if (c == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_json_str(sb, str_from(c));
    }
    return 0;
}

# Is `ch` an ASCII hex digit (0-9, a-f, A-F)? Single definition shared by
# the hash/digest validators in ima, dmverity, tpm, update.
fn agnodrm_is_hex_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 70) { return 1; }   # A-F
    if (ch >= 97 && ch <= 102) { return 1; }  # a-f
    return 0;
}

# Is `ch` valid in a device-mapper / volume name (alphanumeric, `-`, `_`)?
# Single source for the dm-name allowlist shared by dmverity and luks.
fn agnodrm_is_name_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 90) { return 1; }   # A-Z
    if (ch >= 97 && ch <= 122) { return 1; }  # a-z
    if (ch == 45) { return 1; }               # -
    if (ch == 95) { return 1; }               # _
    return 0;
}

# Does C string `str` start with C string `prefix`? Single-pass: walks
# `prefix` and compares, stopping at the first mismatch, the prefix
# terminator, or the str terminator — no up-front strlen of either side
# (the previous per-module copies scanned both strings fully first).
fn agnodrm_cstr_starts_with(str, prefix): i64 {
    var i = 0;
    var pc = load8(prefix);
    while (pc != 0) {
        var sc = load8(str + i);
        if (sc == 0) { return 0; }
        if (sc != pc) { return 0; }
        i = i + 1;
        pc = load8(prefix + i);
    }
    return 1;
}

# Run a subprocess (cstr argv vec) and capture stdout into a caller buffer.
# Returns Ok(bytes_read), or Err(errmsg) unless the tool ran and exited 0: a failed
# tool must not read as a tool that said nothing, and output from one that failed
# may be partial. `errmsg` is the per-tool diagnostic. status[0] is the exit code,
# 127 if execve failed, or negative if the end was never observed; exec_capture_status
# is why the consumer floor is 6.6.7.
#
# A full buffer is the exception. The reader stops there and closes the pipe, so a
# tool with more to say dies of SIGPIPE, which says nothing about the tool. That comes
# back as Ok(buflen), and bytes_read >= buflen is how a caller sees truncation: the
# bootctl path refuses a cut list on it, and an Err here would skip that check.
fn agnodrm_run_capture(args, buf, buflen, errmsg): i64 {
    var status = alloc(16);
    var n = exec_capture_status(args, buf, buflen, status);
    if (n < 0) {
        return drm_err_unknown(errmsg);
    }
    if (buflen > 0) {
        if (n >= buflen) { return Ok(n); }
    }
    if (load64(status) != 0) {
        return drm_err_unknown(errmsg);
    }
    return Ok(n);
}

# Run a subprocess (cstr argv vec) and check for a zero exit code.
# Returns Ok(0) or Err(errmsg) on non-zero exit / exec failure. Shared by
# dmverity/luks/tpm `*_run_checked`.
fn agnodrm_run_checked(args, errmsg): i64 {
    var rc = exec_vec(args);
    if (rc != 0) {
        return drm_err_unknown(errmsg);
    }
    return Ok(0);
}

# Read up to `cap` bytes from `fd` into a fresh heap buffer, NUL-terminate,
# and return it as a Str (also valid as a cstr). Drains short reads. The
# buffer is `cap + 1` bytes so the terminator never writes past the end
# even at a full read (the per-module copies alloc'd exactly `cap`, a
# latent 1-byte overflow when the file filled the buffer). Shared by the
# pam config / passwd readers.
fn agnodrm_read_fd_to_str(fd, cap): i64 {
    var buf = alloc(cap + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n <= 0) {
            rgo = 0;
        } else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    store8(buf + total, 0);
    return str_new(buf, total);
}

# Durability pair for update.cyr's atomic write (write tmp -> fsync ->
# rename), formerly raw syscall(74) / syscall(82) with the x86_64 numbers
# inlined. They now delegate to lib/io.cyr's portable helpers, which reach
# the per-target sys_* wrappers, so this file names no syscall number. The
# raw pair was latent on agnos, where 74 is shm_free and 82 is gpu_dispatch.
# lib/io.cyr is in both profiles' .deps, so the bundles already carry it.
#
# Return convention is the syscall's: 0 on success, negative on failure
# (-errno on Linux; agnos returns -1).

# Flush `fd` to stable storage. Linux: fsync(2) via sys_fsync. agnos has no
# per-fd fsync, so xfsync issues agnos's sys_sync, a whole-filesystem flush
# that also covers `fd` (coarser, and it does not validate `fd`).
fn agnodrm_fsync(fd): i64 {
    return xfsync(fd);
}

# Rename `oldpath` to `newpath` (C strings). Linux: sys_rename (rename(2) on
# x86_64, renameat(AT_FDCWD, ...) on aarch64). agnos: its length-carrying
# 4-arg sys_rename, with file_rename computing both lengths.
fn agnodrm_rename(oldpath, newpath): i64 {
    return file_rename(oldpath, newpath);
}

enum AgnodrmTmp {
    AGNODRM_TMP_MAX_TRIES = 64;
}

# Next candidate suffix; 0 until the first call seeds it. It need not be atomic
# or secret: the exclusive create below is what arbitrates, so a lost update or
# a guessed name only costs a retry.
var _agnodrm_tmp_ctr = 0;

# Start the counter somewhere random, so a process that always has the same pid
# (PID 1, a container) does not walk the same names after each restart: at a
# fixed start, AGNODRM_TMP_MAX_TRIES crashed runs would leave every candidate
# taken and refuse all later writes. Linux flags, unnamed in the stdlib: this can
# run at early boot, so GRND_INSECURE (4) never blocks on the entropy pool, with
# GRND_NONBLOCK (1) for kernels before 5.6. The value only has to differ between
# runs. On failure the counter stays 0, which only gives up that protection.
fn _agnodrm_tmp_seed(): i64 {
    var seed = 0;
    #ifdef CYRIUS_TARGET_LINUX
    if (sys_getrandom(&seed, 4, 4) == 0 - EINVAL) { sys_getrandom(&seed, 4, 1); }
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    sys_getrandom(&seed, 4, 0);
    #endif
    _agnodrm_tmp_ctr = seed;
    return 0;
}

# Create a new file named `<base>.tmp.<pid>.<ctr>`, mode 0644 before umask.
# Returns the write fd and stores the path through `path_out`, or returns a
# negative errno and leaves `path_out` alone.
#
# The name must be treated as predictable, so it is never opened with O_TRUNC:
# file_create_exclusive refuses a name that exists as anything, including a
# dangling symlink, so a link planted at the name is never written through
# (audit F-1). A taken name moves on to the next counter, and after
# AGNODRM_TMP_MAX_TRIES the call fails with -EEXIST rather than touch one.
# On agnos before cyrius 6.6.9 that create is a non-atomic pre-check that follows
# links; agnodrm's own callers return not_supported on agnos before reaching it.
#
# A crash between this and the caller's rename or unlink leaves the temp behind.
# It is not reused or cleaned up. The suffix takes up to about 23 bytes of the
# file name, so a `base` file name over about 232 bytes fails with -ENAMETOOLONG.
fn agnodrm_tmp_create(base, path_out): i64 {
    if (base == 0 || path_out == 0) { return 0 - EINVAL; }
    if (_agnodrm_tmp_ctr == 0) { _agnodrm_tmp_seed(); }
    var baselen = strlen(base);
    # 24 bytes at each fmt_int_buf position, not a digit count: before cyrius
    # 6.6.18 it wrote 24 bytes whatever the number's length.
    var path = alloc(baselen + 64);
    if (path == 0) { return 0 - ENOMEM; }
    memcpy(path, base, baselen);
    memcpy(path + baselen, ".tmp.", 5);
    var pos = baselen + 5;
    pos = pos + fmt_int_buf(sys_getpid(), path + pos);
    store8(path + pos, 46);  # '.'
    pos = pos + 1;

    var tries = 0;
    while (tries < AGNODRM_TMP_MAX_TRIES) {
        var end = pos + fmt_int_buf(_agnodrm_tmp_ctr, path + pos);
        store8(path + end, 0);
        _agnodrm_tmp_ctr = _agnodrm_tmp_ctr + 1;
        var fd = file_create_exclusive(path, 0x1A4);  # mode 0644
        if (fd >= 0) {
            store64(path_out, path);
            return fd;
        }
        if (fd != 0 - EEXIST) { return fd; }
        tries = tries + 1;
    }
    return 0 - EEXIST;
}
