# journald.cyr — systemd journal integration
# Ported from rust-old/src/journald.rs
#
# Send structured log messages to journald via AF_UNIX datagram socket,
# and query the journal via journalctl subprocess.
#
# Requires: lib/string.cyr, lib/str.cyr, lib/vec.cyr, lib/process.cyr,
#           lib/syscalls.cyr, lib/net.cyr, src/error.cyr
#
# All structs are bags of i64 fields accessed via store64/load64.
# Strings are Str (fat pointer: data + length) from lib/str.cyr.

# The journal socket is reached through the stdlib's per-target sys_socket /
# sys_sendto wrappers (lib/syscalls.cyr), which carry each target's own
# syscall number. This module used to inline the x86_64 numbers 41 / 44; on
# aarch64 44 is fstatfs, and it only worked once cyrius 6.6.5 began routing
# the x86 number (CHANGELOG 1.6.1). SOCK_DGRAM is lib/net.cyr's name;
# include-once, so includers pay nothing.
include "lib/syscalls.cyr"
include "lib/net.cyr"
include "src/error.cyr"
include "src/util.cyr"

# ================================================================
# Constants
# ================================================================

enum JournalConst {
    # AF_UNIX = 1 (the stdlib names AF_INET / AF_INET6 only)
    AF_UNIX = 1;
    # sockaddr_un: { family(2), path(108) } = 110 bytes
    SOCKADDR_UN_SIZE = 110;
    # A query's first capture, and the most it will hold before it refuses.
    JOURNAL_QUERY_CHUNK = 131072;
    JOURNAL_QUERY_MAX = 33554432;
    # How long journalctl may print nothing. A rare match in a large journal can be quiet
    # for a while, so this is generous. The stdlib then waits as long again before it kills.
    JOURNAL_QUERY_DEADLINE_MS = 60000;
    # The sealed-memfd path, which the stdlib does not name; see memfd_create(2), fcntl(2)
    # and cmsg(3). Both arches agree on all of them.
    JOURNAL_MFD_FLAGS = 3;          # MFD_CLOEXEC | MFD_ALLOW_SEALING
    JOURNAL_MFD_NOEXEC = 8;         # MFD_NOEXEC_SEAL, which a kernel before 6.3 refuses
    JOURNAL_F_ADD_SEALS = 1033;
    JOURNAL_SEALS = 15;             # F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE
    JOURNAL_SCM_RIGHTS = 1;
    JOURNAL_CMSG_LEN = 20;          # CMSG_LEN(sizeof(int))
    JOURNAL_CMSG_SPACE = 24;        # CMSG_SPACE(sizeof(int))
    JOURNAL_MSGHDR_SIZE = 56;
}

# Syslog priority levels
enum JournalPriority {
    JOURNAL_EMERG = 0;
    JOURNAL_ALERT = 1;
    JOURNAL_CRIT = 2;
    JOURNAL_ERR = 3;
    JOURNAL_WARNING = 4;
    JOURNAL_NOTICE = 5;
    JOURNAL_INFO = 6;
    JOURNAL_DEBUG = 7;
}

# ================================================================
# JournalEntry struct — 7 fields * 8 = 56 bytes.
# field_keys/field_vals are vec pointers; appended via the
# `add_field` helper (different name from derive's setters,
# no collision).
# ================================================================

#derive(accessors)
struct journald_entry {
    timestamp;
    unit;
    priority;
    message;
    pid;
    field_keys;
    field_vals;
}

fn journald_entry_new(timestamp, unit, priority, message, pid): i64 {
    var e = alloc(56);
    journald_entry_set_timestamp(e, timestamp);
    journald_entry_set_unit(e, unit);
    journald_entry_set_priority(e, priority);
    journald_entry_set_message(e, message);
    journald_entry_set_pid(e, pid);
    journald_entry_set_field_keys(e, vec_new());
    journald_entry_set_field_vals(e, vec_new());
    return e;
}

# Add an extra field (key-value pair) to a journal entry
fn journald_entry_add_field(e, key, val): i64 {
    vec_push(journald_entry_field_keys(e), key);
    vec_push(journald_entry_field_vals(e), val);
    return 0;
}

# ================================================================
# JournalFilter struct — 7 fields * 8 = 56 bytes.
# priority and lines use -1 as the unset sentinel.
# ================================================================

#derive(accessors)
struct journald_filter {
    unit;
    since;
    until;
    priority;
    grep;
    lines;
    boot;
}

fn journald_filter_new(): i64 {
    var f = alloc(56);
    journald_filter_set_unit(f, 0);
    journald_filter_set_since(f, 0);
    journald_filter_set_until(f, 0);
    journald_filter_set_priority(f, 0 - 1);   # unset
    journald_filter_set_grep(f, 0);
    journald_filter_set_lines(f, 0 - 1);      # unset
    journald_filter_set_boot(f, 0);
    return f;
}

# ================================================================
# Test seams, 0 outside tests/tcyr: a stub to run in place of /usr/bin/journalctl, and a
# socket to send to in place of the host's journal.
var _journald_tool = 0;
var _journald_socket = 0;

# Build journalctl argv vec
# ================================================================

# Build a vec of cstring args for an exec_vec / exec_capture invocation
# of journalctl. Each filter value lands in its OWN argv entry — no shell,
# no concatenation, no metacharacter expansion. Caller-controlled values
# (unit, grep, since, until, boot) are passed verbatim to journalctl as
# argv[i]; an attacker controlling those values cannot escape into the
# shell because there is no shell. See audit F-1 (2026-04-26).
#
# --unit, --since, --until, --priority and --grep take a required argument, so the next
# word is the value whatever it looks like. --boot takes an optional one, so it must be
# one word: as two, a value that does not parse as a boot id stays on the command line,
# where "--vacuum-time=1s" is an option and "_UID=0" a match (audit F-20). --lines is
# optional too, and only ever a formatted integer. --all keeps fields over 4096 bytes,
# which journalctl otherwise prints as null.
fn _journald_build_argv(filter): i64 {
    var args = vec_new();
    vec_push(args, "/usr/bin/journalctl");
    vec_push(args, "--output=json");
    vec_push(args, "--no-pager");
    vec_push(args, "--all");

    var unit = journald_filter_unit(filter);
    if (unit != 0) {
        vec_push(args, "--unit");
        vec_push(args, str_cstr(unit));
    }

    var since = journald_filter_since(filter);
    if (since != 0) {
        vec_push(args, "--since");
        vec_push(args, str_cstr(since));
    }

    var until = journald_filter_until(filter);
    if (until != 0) {
        vec_push(args, "--until");
        vec_push(args, str_cstr(until));
    }

    var prio = journald_filter_priority(filter);
    if (prio >= 0) {
        var pbuf = alloc(24);
        fmt_int_buf(prio, pbuf);
        vec_push(args, "--priority");
        vec_push(args, pbuf);
    }

    var grep = journald_filter_grep(filter);
    if (grep != 0) {
        vec_push(args, "--grep");
        vec_push(args, str_cstr(grep));
    }

    var lines = journald_filter_lines(filter);
    if (lines >= 0) {
        var lbuf = alloc(24);
        fmt_int_buf(lines, lbuf);
        vec_push(args, "--lines");
        vec_push(args, lbuf);
    }

    var boot = journald_filter_boot(filter);
    if (boot != 0) {
        var bsb = str_builder_new();
        str_builder_add_cstr(bsb, "--boot=");
        str_builder_add(bsb, boot);
        vec_push(args, str_cstr(str_builder_build(bsb)));
    }

    return args;
}

# ================================================================
# Send structured log message to journald via unix socket
# ================================================================

# Build a sockaddr_un pointing to /run/systemd/journal/socket.
# Returns pointer to the struct (110 bytes).
fn journald_make_sockaddr(): i64 {
    var sa = alloc(SOCKADDR_UN_SIZE);
    memset(sa, 0, SOCKADDR_UN_SIZE);
    store16(sa, AF_UNIX);  # sa_family = AF_UNIX
    # Copy socket path starting at offset 2
    var path = "/run/systemd/journal/socket";
    if (_journald_socket != 0) { path = _journald_socket; }
    var plen = strlen(path);
    if (plen > SOCKADDR_UN_SIZE - 3) { plen = SOCKADDR_UN_SIZE - 3; }
    memcpy(sa + 2, path, plen);
    return sa;
}

# The address, built once: a per-line alloc would grow the heap for as long as the
# process logs. Two threads racing here build the same bytes twice, which is harmless.
var _journald_sa = 0;

fn _journald_sockaddr(): i64 {
    if (_journald_sa == 0) { _journald_sa = journald_make_sockaddr(); }
    return _journald_sa;
}

# Copy `n` bytes to buf + pos unless `buf` is 0, which only measures. Returns the new pos.
fn _journald_put(buf, pos, data, n): i64 {
    if (buf != 0) { memcpy(buf + pos, data, n); }
    return pos + n;
}

# Append one field to a journal datagram. The native protocol is KEY=VALUE\n, so a
# value holding a newline would end its field there and the rest would parse as new
# fields: a message of "x\nPRIORITY=0\nSYSLOG_IDENTIFIER=sshd" could forge both
# (audit F-9). Such a value goes in the protocol's other form, which keeps it whole:
# KEY\n, its length as a little-endian u64, the bytes, \n. Returns the new pos.
fn _journald_put_field(buf, pos, key, value): i64 {
    var vlen = strlen(value);
    var newline = 0;
    var i = 0;
    while (i < vlen) {
        if (load8(value + i) == 10) {
            newline = 1;
            break;
        }
        i = i + 1;
    }
    pos = _journald_put(buf, pos, key, strlen(key));
    if (newline == 0) {
        pos = _journald_put(buf, pos, "=", 1);
    } else {
        pos = _journald_put(buf, pos, "\n", 1);
        if (buf != 0) { store64(buf + pos, vlen); }
        pos = pos + 8;
    }
    pos = _journald_put(buf, pos, value, vlen);
    return _journald_put(buf, pos, "\n", 1);
}

# 1 for a field name the journal accepts: 1-64 bytes of A-Z, 0-9 and _, not starting
# with a digit or with _ (those are trusted fields). journald drops anything else, and
# a name holding = or a newline would end up parsed as other fields (audit F-9). The
# base fields are refused too: a caller's extras must not restate a line's priority or
# identifier, which would log a second value beside the real one (audit F-46).
fn _journald_key_valid(key): i64 {
    if (key == 0) { return 0; }
    if (streq(key, "MESSAGE") == 1) { return 0; }
    if (streq(key, "PRIORITY") == 1) { return 0; }
    if (streq(key, "SYSLOG_IDENTIFIER") == 1) { return 0; }
    var n = strlen(key);
    if (n == 0) { return 0; }
    if (n > 64) { return 0; }
    var first = load8(key);
    if (first == 95) { return 0; }
    if (first >= 48) {
        if (first <= 57) { return 0; }
    }
    var i = 0;
    while (i < n) {
        var c = load8(key + i);
        var ok = 0;
        if (c >= 65) {
            if (c <= 90) { ok = 1; }
        }
        if (c >= 48) {
            if (c <= 57) { ok = 1; }
        }
        if (c == 95) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Lay out one datagram at `buf`: the base fields, then the extras whose names the journal
# would accept and that have a value. With `buf` 0 this only measures. Returns its length.
# fields_keys / fields_vals may be 0; a pair past the shorter vec is ignored.
fn _journald_layout(buf, message, priority, identifier, fields_keys, fields_vals): i64 {
    var pos = _journald_put(buf, 0, "PRIORITY=", 9);
    if (buf != 0) { store8(buf + pos, 48 + priority); }
    pos = _journald_put(buf, pos + 1, "\n", 1);
    pos = _journald_put_field(buf, pos, "MESSAGE", message);
    if (identifier != 0) {
        pos = _journald_put_field(buf, pos, "SYSLOG_IDENTIFIER", identifier);
    }
    if (fields_keys == 0) { return pos; }
    if (fields_vals == 0) { return pos; }
    var nfields = vec_len(fields_keys);
    if (vec_len(fields_vals) < nfields) { nfields = vec_len(fields_vals); }
    var fi = 0;
    while (fi < nfields) {
        var fkey = vec_get(fields_keys, fi);
        var fval = vec_get(fields_vals, fi);
        if (_journald_key_valid(fkey) == 1) {
            if (fval != 0) { pos = _journald_put_field(buf, pos, fkey, fval); }
        }
        fi = fi + 1;
    }
    return pos;
}

# 1 if a send failed because the entry would not fit, which is what sd_journal_sendv
# retries as a memfd. Anything else is a real failure.
fn _journald_too_big(ret): i64 {
    if (ret == (0 - EMSGSIZE)) { return 1; }
    if (ret == (0 - ENOBUFS)) { return 1; }
    return ret == (0 - EAGAIN);
}

#ifndef CYRIUS_TARGET_AGNOS
# Hand journald `len` bytes at `buf` as a sealed memfd, the protocol's form for an entry
# that does not fit a datagram: the same bytes, and a datagram holding nothing but the fd.
# All four seals, so journald can map it instead of copying it, and so nobody can change
# it under the mapping. With vm.memfd_noexec=2 a memfd has to ask for MFD_NOEXEC_SEAL, and
# a kernel before 6.3 refuses that flag, so it asks first and falls back.
# Returns 0 or above on success, or a negative errno.
fn _journald_send_memfd(sock, buf, len): i64 {
    var ctl[24];
    var msg[56];
    var mfd = sys_memfd_create("journal-data", JOURNAL_MFD_FLAGS | JOURNAL_MFD_NOEXEC);
    if (mfd == (0 - EINVAL)) { mfd = sys_memfd_create("journal-data", JOURNAL_MFD_FLAGS); }
    if (mfd < 0) { return mfd; }
    var ret = _agnodrm_write_all(mfd, buf, len);
    if (ret >= 0) { ret = sys_fcntl(mfd, JOURNAL_F_ADD_SEALS, JOURNAL_SEALS); }
    if (ret >= 0) {
        memset(&ctl, 0, JOURNAL_CMSG_SPACE);
        store64(&ctl, JOURNAL_CMSG_LEN);
        store32(&ctl + 8, SOL_SOCKET);
        store32(&ctl + 12, JOURNAL_SCM_RIGHTS);
        store32(&ctl + 16, mfd);
        memset(&msg, 0, JOURNAL_MSGHDR_SIZE);
        store64(&msg, _journald_sockaddr());
        store32(&msg + 8, SOCKADDR_UN_SIZE);
        store64(&msg + 32, &ctl);
        store64(&msg + 40, JOURNAL_CMSG_SPACE);
        ret = sys_sendmsg(sock, &msg, 0);
    }
    sys_close(mfd);
    return ret;
}
#endif

# Check, lay out and send one entry. The buffer is scratch: from alloc(), every line
# logged would stay in the heap for good, 442 MiB per million (audit F-40).
fn _journald_deliver(message, priority, identifier, fields_keys, fields_vals): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (message == 0) {
        return drm_err_invalid_argument("journal message cannot be null");
    }
    if (priority < 0) {
        return drm_err_invalid_argument("journal priority must be 0-7");
    }
    if (priority > 7) {
        return drm_err_invalid_argument("journal priority must be 0-7");
    }

    var len = _journald_layout(0, message, priority, identifier, fields_keys, fields_vals);
    var buf = _agnodrm_scratch_new(len);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for a journal datagram"); }
    _journald_layout(buf, message, priority, identifier, fields_keys, fields_vals);

    # Create AF_UNIX SOCK_DGRAM socket
    var fd = sys_socket(AF_UNIX, SOCK_DGRAM, 0);
    if (fd < 0) {
        _agnodrm_scratch_free(buf, len);
        return drm_err_syscall_failed(0 - fd, "failed to create unix socket");
    }

    # sendto(fd, buf, len, flags, dest_addr, addrlen)
    var ret = sys_sendto(fd, buf, len, 0, _journald_sockaddr(), SOCKADDR_UN_SIZE);
    if (_journald_too_big(ret) == 1) { ret = _journald_send_memfd(fd, buf, len); }
    sys_close(fd);
    _agnodrm_scratch_free(buf, len);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "send to journal socket failed");
    }

    return Ok(0);
    #endif
}

# Send a structured log message to the journald socket.
# message: C string — the log message text.
# priority: integer 0-7 (JOURNAL_EMERG through JOURNAL_DEBUG).
# identifier: C string — syslog identifier (e.g. "agnodrm").
#
# The journal native protocol uses newline-separated KEY=VALUE pairs
# sent as a single datagram to /run/systemd/journal/socket. A message too big for one
# datagram, about 212 KB, goes as a sealed memfd holding the same bytes. journald takes it
# or drops it without telling the sender: over its entry limit, Ok here means sent, not
# stored.
#
# Returns Result: Ok(0) on success, Err on failure.
fn journald_send(message, priority, identifier): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no systemd-journald AF_UNIX socket — it logs via sakshi, not
    # journald. The send path targets the Linux journal socket; not supported
    # on agnos. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _journald_deliver(message, priority, identifier, 0, 0);
    #endif
}

# Send a structured log with extra key-value fields.
# fields_keys: vec of C string pointers (field names).
# fields_vals: vec of C string pointers (field values).
# A field the journal would not accept, one restating a base field, or one with a null
# value is skipped.
# Returns Result: Ok(0) or Err.
fn journald_send_fields(message, priority, identifier, fields_keys, fields_vals): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no systemd-journald AF_UNIX socket — it logs via sakshi, not
    # journald. The send path targets the Linux journal socket; not supported
    # on agnos. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald send (use sakshi on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return _journald_deliver(message, priority, identifier, fields_keys, fields_vals);
    #endif
}

# ================================================================
# Parse a single JSON line from journalctl --output=json
# ================================================================

# The end of the JSON string opening at `start`, the index of its closing quote, or
# `jlen` if it has none. A line ending in a lone backslash stops at jlen, not past it.
fn _journald_string_end(jd, jlen, start): i64 {
    var end = start + 1;
    while (end < jlen) {
        var c = load8(jd + end);
        if (c == 34) { return end; }
        if (c == 92) { end = end + 1; }
        end = end + 1;
    }
    return jlen;
}

# The value journalctl prints as an array, at `jd + pos`: bytes that are not valid UTF-8
# or hold a control character, as numbers, or a field the entry has more than once, as
# one element per value, of which the first is taken. Reading these as empty let a single
# ESC byte hide a line from whatever reads the log (audit F-47). Returns a Str, or 0.
fn _journald_array_value(jd, jlen, pos): i64 {
    var i = pos + 1;
    var depth = 0;
    while (i < jlen) {
        if (load8(jd + i) != 91) { break; }
        if (depth >= 1) { return 0; }
        depth = depth + 1;
        i = i + 1;
    }
    if (i >= jlen) { return 0; }
    var first = load8(jd + i);
    if (first == 34) {
        var end = _journald_string_end(jd, jlen, i);
        return _agnodrm_json_unescape(jd + i + 1, end - i - 1);
    }
    if (first < 48 || first > 57) { return 0; }
    var out = alloc(jlen - i + 1);
    var o = 0;
    var v = 0;
    while (i < jlen) {
        var c = load8(jd + i);
        i = i + 1;
        if (c >= 48 && c <= 57) {
            v = (v * 10 + (c - 48)) & 255;
            continue;
        }
        store8(out + o, v);
        o = o + 1;
        v = 0;
        if (c != 44) { break; }
    }
    store8(out + o, 0);
    return str_new(out, o);
}

# Minimal JSON field extraction: find a key in a JSON object string and return its value
# as a new Str, escapes decoded, or 0 if not found or null. This is a lightweight
# parser — handles the flat objects journalctl prints, one level of arrays included.
fn journald_json_get_str(json, key): i64 {
    # Search for "key" in the JSON
    var jlen = str_len(json);
    var jd = str_data(json);
    var klen = strlen(key);

    var pos = 0;
    while (pos < jlen - klen - 3) {
        # Look for "<key>"
        if (load8(jd + pos) == 34) {  # '"'
            if (memeq(jd + pos + 1, key, klen) == 1) {
                if (load8(jd + pos + 1 + klen) == 34) {  # closing '"'
                    # Found the key. Now find the value after ':'
                    var vpos = pos + 2 + klen;
                    # Skip whitespace and colon
                    while (vpos < jlen) {
                        var vc = load8(jd + vpos);
                        if (vc == 58) { vpos = vpos + 1; break; }  # ':'
                        if (vc == 32) { vpos = vpos + 1; continue; }
                        if (vc == 9) { vpos = vpos + 1; continue; }
                        break;
                    }
                    # Skip whitespace
                    while (vpos < jlen) {
                        var wc = load8(jd + vpos);
                        if (wc == 32) { vpos = vpos + 1; continue; }
                        if (wc == 9) { vpos = vpos + 1; continue; }
                        if (wc == 10) { vpos = vpos + 1; continue; }
                        break;
                    }
                    if (vpos < jlen) {
                        if (load8(jd + vpos) == 34) {
                            var vend = _journald_string_end(jd, jlen, vpos);
                            return _agnodrm_json_unescape(jd + vpos + 1, vend - vpos - 1);
                        }
                        if (load8(jd + vpos) == 91) {  # '['
                            return _journald_array_value(jd, jlen, vpos);
                        }
                    }
                }
            }
        }
        pos = pos + 1;
    }

    return 0;
}

# A journal PRIORITY field as a number, or JOURNAL_INFO for anything that is not 0-7:
# str_to_int reads "abc" as 0, which is an emergency.
fn _journald_priority_of(s): i64 {
    if (s == 0) { return JOURNAL_INFO; }
    if (str_len(s) != 1) { return JOURNAL_INFO; }
    var c = load8(str_data(s));
    if (c < 48 || c > 55) { return JOURNAL_INFO; }
    return c - 48;
}

# Parse a single JSON line from journalctl output into a JournalEntry.
# Returns Result: Ok(entry_ptr) or Err.
fn journald_parse_json(json_line): i64 {
    var jlen = str_len(json_line);
    if (jlen == 0) {
        return drm_err_invalid_argument("empty journal JSON line");
    }

    # Check it starts with open brace (ASCII 123)
    if (load8(str_data(json_line)) != 123) {
        return drm_err_invalid_argument("journal JSON is not an object");
    }

    # Extract known fields
    var ts_str = journald_json_get_str(json_line, "__REALTIME_TIMESTAMP");
    var timestamp = 0;
    if (ts_str != 0) {
        timestamp = str_to_int(ts_str);
    }

    var unit = journald_json_get_str(json_line, "_SYSTEMD_UNIT");
    if (unit == 0) { unit = str_from(""); }

    var priority = _journald_priority_of(journald_json_get_str(json_line, "PRIORITY"));

    var message = journald_json_get_str(json_line, "MESSAGE");
    if (message == 0) { message = str_from(""); }

    var pid_str = journald_json_get_str(json_line, "_PID");
    var pid = 0;
    if (pid_str != 0) {
        pid = str_to_int(pid_str);
    }

    var entry = journald_entry_new(timestamp, unit, priority, message, pid);
    return Ok(entry);
}

# ================================================================
# Query journal via journalctl subprocess
# ================================================================

# Parse `n` bytes of journalctl JSON lines into a vec of entries, every string a copy.
# A line that does not parse is left out.
fn _journald_parse_output(buf, n): i64 {
    var entries = vec_new();
    var pos = 0;
    while (pos < n) {
        var start = pos;
        while (pos < n) {
            if (load8(buf + pos) == 10) { break; }
            pos = pos + 1;
        }
        var len = pos - start;
        pos = pos + 1;
        if (len == 0) { continue; }
        var parse_res_t, parse_res_v = journald_parse_json(str_new(buf + start, len));
        if (is_ok(parse_res_t) == 1) {
            vec_push(entries, parse_res_v);
        }
    }
    return entries;
}

# Query the systemd journal using journalctl and parse JSON output.
# filter: JournalFilter pointer (from journald_filter_new).
# Returns Result: Ok(vec_of_entry_ptrs) or Err.
#
# Argv-based exec via lib/process.cyr: every filter value becomes its OWN argv entry. No
# shell. No metacharacter expansion. See _journald_build_argv for why --boot is one word,
# and SECURITY-NOTES.md § journald.
#
# The whole output is read or the call fails. Output that fills the buffer runs again
# with a larger one, up to JOURNAL_QUERY_MAX: a cut query kept the oldest entries and a
# last one made from half a line, and lost the newest, which is what "last N" is for
# (audit F-21). A query that big should set lines or since.
#
# A --grep pattern can run for as long as it likes, so journalctl gets a deadline. Silent for
# JOURNAL_QUERY_DEADLINE_MS, or for the process's own deadline if that is tighter, the call
# is an Err (ETIMEDOUT), even if journalctl would have finished a moment later. What it
# printed first is thrown away, like any capture that did not finish. The stdlib gives it
# as long again before killing it, so the caller waits up to twice the deadline. This
# measures silence, not total time, and restarts for each larger buffer, so output that
# trickles in is bounded by JOURNAL_QUERY_MAX instead. The process's deadline is put back.
fn journald_query(filter): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no journalctl subprocess and no systemd journal to query — the
    # journal is a Linux systemd facility; agnos records via sakshi. Not
    # supported here. (See the journald Linux-eccentric deferral.)
    return drm_err_not_supported("journald query (no journalctl on agnos)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (filter == 0) { return drm_err_invalid_argument("journal filter is null"); }
    var args = _journald_build_argv(filter);
    if (_journald_tool != 0) { vec_set(args, 0, _journald_tool); }
    # Not agnodrm_run_capture: journalctl exits 1 when --grep matches nothing, which is
    # an empty result. Without --grep, 1 is bad input or a missing boot, so it fails, as
    # do a missing journalctl (127), a signal and an end never seen (negative). With
    # --grep, 1 cannot tell no match from a bad regex; those read as empty.
    # A full buffer proves nothing: the reader closed the pipe, so journalctl with more
    # to say dies of SIGPIPE. That capture is thrown away and run again.
    var status = alloc(16);
    var cap = JOURNAL_QUERY_CHUNK;
    while (cap <= JOURNAL_QUERY_MAX) {
        var buf = _agnodrm_scratch_new(cap);
        if (buf == 0) { return drm_err_io(ENOMEM, "no memory for journalctl output"); }
        var outer = _agnodrm_deadline_begin(JOURNAL_QUERY_DEADLINE_MS);
        var nbytes = exec_capture_status(args, buf, cap, status);
        _agnodrm_deadline_end(outer);
        if (load64(status) == (0 - 2)) {  # exec_capture_status's mark for a deadline kill
            _agnodrm_scratch_free(buf, cap);
            return drm_err_io(ETIMEDOUT, "journalctl ran past its deadline");
        }
        if (nbytes < 0) {
            _agnodrm_scratch_free(buf, cap);
            return drm_err_unknown("failed to execute journalctl");
        }
        if (nbytes < cap) {
            var code = load64(status);
            var failed = code != 0;
            if (code == 1) {
                if (journald_filter_grep(filter) != 0) { failed = 0; }
            }
            if (failed != 0) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_unknown("journalctl failed");
            }
            var entries = _journald_parse_output(buf, nbytes);
            _agnodrm_scratch_free(buf, cap);
            return Ok(entries);
        }
        _agnodrm_scratch_free(buf, cap);
        cap = cap * 4;
    }
    return drm_err_io(0, "journal query output is too large to read whole");
    #endif
}

# ================================================================
# Convenience: get last N log entries for a unit
# ================================================================

# Get the last `lines` journal entries for a specific systemd unit.
# unit_name: C string (e.g. "sshd.service").
# lines: number of entries to return.
# Returns Result: Ok(vec_of_entry_ptrs) or Err.
fn journald_get_unit_logs(unit_name, lines): i64 {
    if (unit_name == 0) {
        return drm_err_invalid_argument("unit name cannot be null");
    }
    if (strlen(unit_name) == 0) {
        return drm_err_invalid_argument("unit name cannot be empty");
    }

    var filter = journald_filter_new();
    journald_filter_set_unit(filter, str_from(unit_name));
    journald_filter_set_lines(filter, lines);

    return journald_query(filter);
}

# ================================================================
# Convenience: send info-level log
# ================================================================

# Send an info-level message to the journal.
# message: C string.
# Returns Result: Ok(0) or Err.
fn journald_info(message): i64 {
    return journald_send(message, JOURNAL_INFO, "agnodrm");
}

# Send a warning-level message to the journal.
fn journald_warning(message): i64 {
    return journald_send(message, JOURNAL_WARNING, "agnodrm");
}

# Send an error-level message to the journal.
fn journald_error(message): i64 {
    return journald_send(message, JOURNAL_ERR, "agnodrm");
}

# Send a debug-level message to the journal.
fn journald_debug(message): i64 {
    return journald_send(message, JOURNAL_DEBUG, "agnodrm");
}
