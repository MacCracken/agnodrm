# drm.cyr — DRM (Direct Rendering Manager) device interface
# Ported from rust-old/src/drm.rs
#
# Enumerate GPU devices under /dev/dri/, query driver version
# and capabilities via ioctl. Every kernel call goes through the
# stdlib's per-target sys_* wrappers (sys_open / sys_getdents64 /
# sys_ioctl / sys_close), never a raw syscall number.
#
# Requires: src/error.cyr, lib/syscalls.cyr

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "src/error.cyr"
include "src/util.cyr"

# ================================================================
# DRM ioctl constants
# ================================================================

# DRM ioctl type byte is 'd' (0x64)
# _IOWR('d', nr, size) = (3 << 30) | (size << 16) | (0x64 << 8) | nr

# DRM_IOCTL_VERSION: _IOWR('d', 0x00, 64)  [struct drm_version is 64 bytes]
# = (3 << 30) | (64 << 16) | (0x64 << 8) | 0x00
# = 0xC0406400
# Through 1.7.1 this encoded 72 bytes. drm_ioctl takes the caller's size, so real
# kernels answered anyway, but qemu and an ioctl-number allowlist refuse it (audit F-35).

# DRM_IOCTL_GET_CAP: _IOWR('d', 0x0C, 16)  [DrmGetCap is 16 bytes]
# = (3 << 30) | (16 << 16) | (0x64 << 8) | 0x0C
# = 0xC010640C

enum DrmIoctl {
    DRM_IOCTL_VERSION = 0xC0406400;
    DRM_IOCTL_GET_CAP = 0xC010640C;
}

# DRM capability IDs
enum DrmCap {
    DRM_CAP_DUMB_BUFFER = 1;
    DRM_CAP_VBLANK_HIGH_CRTC = 2;
    DRM_CAP_DUMB_PREFERRED_DEPTH = 3;
    DRM_CAP_DUMB_PREFER_SHADOW = 4;
    DRM_CAP_PRIME = 5;
    DRM_CAP_TIMESTAMP_MONOTONIC = 6;
    DRM_CAP_ASYNC_PAGE_FLIP = 7;
    DRM_CAP_CURSOR_WIDTH = 8;
    DRM_CAP_CURSOR_HEIGHT = 9;
    DRM_CAP_ADDFB2_MODIFIERS = 16;
    DRM_CAP_PAGE_FLIP_TARGET = 17;
    DRM_CAP_CRTC_IN_VBLANK_EVENT = 18;
    DRM_CAP_SYNCOBJ = 19;
    DRM_CAP_SYNCOBJ_TIMELINE = 20;
}

# Connector type constants
enum DrmConnectorType {
    DRM_CONN_UNKNOWN = 0;
    DRM_CONN_VGA = 1;
    DRM_CONN_DVII = 2;
    DRM_CONN_DVID = 3;
    DRM_CONN_DVIA = 4;
    DRM_CONN_COMPOSITE = 5;
    DRM_CONN_SVIDEO = 6;
    DRM_CONN_LVDS = 7;
    DRM_CONN_COMPONENT = 8;
    DRM_CONN_DISPLAYPORT = 10;
    DRM_CONN_HDMIA = 11;
    DRM_CONN_HDMIB = 12;
    DRM_CONN_TV = 13;
    DRM_CONN_EDP = 14;
    DRM_CONN_VIRTUAL = 15;
    DRM_CONN_DSI = 16;
    DRM_CONN_USB = 20;
}

# Connection status
enum DrmConnStatus {
    DRM_CONNECTED = 1;
    DRM_DISCONNECTED = 2;
    DRM_CONN_STATUS_UNKNOWN = 3;
}

# ioctl and getdents64 go through lib/syscalls.cyr's sys_ioctl /
# sys_getdents64, which carry each target's own syscall number.

# Linux flag, unnamed in the stdlib, the same value on x86_64 and aarch64. Opening a
# tty by mistake must not make it this process's controlling terminal.
enum DrmOpenFlags {
    DRM_O_NOCTTY = 0x100;
    DRM_IOCTL_MAX_TRIES = 64;
}

# sys_ioctl with the retry libdrm's drmIoctl does: a signal or a busy driver is not a
# failure of the request. Bounded, so a driver stuck on EAGAIN cannot hold the caller.
fn _drm_ioctl(fd, request, arg): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - ENOSYS;           # agnos has no DRM subsystem, and older stdlibs no sys_ioctl
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ret = sys_ioctl(fd, request, arg);
    var tries = 1;
    while (ret == 0 - EINTR || ret == 0 - EAGAIN) {
        if (tries >= DRM_IOCTL_MAX_TRIES) { break; }
        ret = sys_ioctl(fd, request, arg);
        tries = tries + 1;
    }
    return ret;
    #endif
}

# ================================================================
# DRM Version struct (on-wire for ioctl)
# ================================================================

# struct drm_version layout on LP64 (64 bytes):
#   +0:  version_major    (i32, 4 bytes)
#   +4:  version_minor    (i32, 4 bytes)
#   +8:  version_patchlevel (i32, 4 bytes)
#   +12: padding          (4 bytes)
#   +16: name_len         (u64)
#   +24: name_ptr         (u64)
#   +32: date_len         (u64)
#   +40: date_ptr         (u64)
#   +48: desc_len         (u64)
#   +56: desc_ptr         (u64)

enum DrmVerOff {
    DRM_VER_SIZE = 64;
    DRM_VER_MAJOR = 0;
    DRM_VER_MINOR = 4;
    DRM_VER_PATCH = 8;
    DRM_VER_NAME_LEN = 16;
    DRM_VER_NAME_PTR = 24;
    DRM_VER_DATE_LEN = 32;
    DRM_VER_DATE_PTR = 40;
    DRM_VER_DESC_LEN = 48;
    DRM_VER_DESC_PTR = 56;
}

# DrmGetCap layout (16 bytes):
#   +0: capability (u64)
#   +8: value      (u64)

# ================================================================
# Version result struct
# 6 fields (3 i64 + 3 ptr) * 8 = 48 bytes. Accessors auto-generated.
# ================================================================

#derive(accessors)
struct drm_verinfo { major; minor; patch; name; date; desc; }

fn drm_verinfo_new(major, minor, patch, name, date, desc): i64 {
    var v = alloc(48);
    drm_verinfo_set_major(v, major);
    drm_verinfo_set_minor(v, minor);
    drm_verinfo_set_patch(v, patch);
    drm_verinfo_set_name(v, name);
    drm_verinfo_set_date(v, date);
    drm_verinfo_set_desc(v, desc);
    return v;
}

# Hand-rolled JSON serializer — cstring fields; see roadmap.md V1.1.12.
fn drm_verinfo_to_json(v, sb): i64 {
    str_builder_add_cstr(sb, "{\"major\":");
    str_builder_add_int(sb, drm_verinfo_major(v));
    str_builder_add_cstr(sb, ",\"minor\":");
    str_builder_add_int(sb, drm_verinfo_minor(v));
    str_builder_add_cstr(sb, ",\"patch\":");
    str_builder_add_int(sb, drm_verinfo_patch(v));
    str_builder_add_cstr(sb, ",\"name\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_name(v));
    str_builder_add_cstr(sb, ",\"date\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_date(v));
    str_builder_add_cstr(sb, ",\"desc\":");
    agnodrm_json_emit_cstr_or_null(sb, drm_verinfo_desc(v));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Device enumeration
# ================================================================

# List DRM card device paths under /dev/dri/.
# result_arr: pre-allocated array of string pointers.
# max_cards: capacity of result_arr. A count equal to it may mean there are more.
# Returns Result: Ok(count); Err(not_supported) when there is no /dev/dri, or Err for
# a directory that exists and could not be read.
fn drm_list_devices(result_arr, max_cards): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);                # agnos has no DRM subsystem (/dev/dri) — no cards to enumerate
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_cards) != 1) {
        return drm_err_invalid_argument("result array is null or max_cards is negative");
    }
    # Open /dev/dri/ directory
    var dri_path = "/dev/dri";
    # O_RDONLY | O_DIRECTORY. Spell the per-target symbol: the old raw 0x10000 is
    # O_DIRECTORY on x86_64 but O_DIRECT on arm64, so aarch64 got EINVAL (CHANGELOG 1.6.1).
    var fd = sys_open(dri_path, O_DIRECTORY | O_CLOEXEC, 0);
    if (fd < 0) {
        if (fd == 0 - ENOENT) { return drm_err_not_supported("DRM (/dev/dri not found)"); }
        return drm_err_io(0 - fd, "failed to open /dev/dri");
    }

    # Read directory entries
    var bufsz = 4096;
    var buf = _agnodrm_scratch_new(bufsz);
    if (buf == 0) {
        sys_close(fd);
        return drm_err_io(ENOMEM, "no memory to read /dev/dri");
    }
    var count = 0;

    var nread = sys_getdents64(fd, buf, 4096);
    while (nread > 0) {
        var pos = 0;
        while (pos < nread) {
            # dirent64: d_ino(8), d_off(8), d_reclen(2), d_type(1), d_name(...)
            # d_name therefore starts at +19, so a record is at least 20 bytes.
            # Validate d_reclen before trusting it: reclen == 0 would spin this
            # loop forever, and a reclen running past nread would walk name_ptr
            # into uninitialized heap. devtmpfs makes both unreachable today —
            # this is defence-in-depth against a malformed dirent stream.
            var reclen = load16(buf + pos + 16);
            var rec_ok = 1;
            if (reclen < 20) { rec_ok = 0; }
            if (rec_ok == 1) { if (pos + reclen > nread) { rec_ok = 0; } }
            if (rec_ok == 0) { pos = nread; continue; }

            var name_ptr = buf + pos + 19;
            var name_max = reclen - 19;      # bytes available to d_name

            # Bounded NUL scan — d_name is padded, not guaranteed terminated
            # within our read window, so never hand it to strlen().
            var nlen = 0;
            var scanning = 1;
            while (scanning == 1) {
                if (nlen >= name_max) { scanning = 0; }
                if (scanning == 1) {
                    if (load8(name_ptr + nlen) == 0) { scanning = 0; }
                    if (scanning == 1) { nlen = nlen + 1; }
                }
            }

            # Check if name starts with "card"
            if (name_max >= 4) {
                if (memeq(name_ptr, "card", 4) == 1) {
                    if (count < max_cards) {
                        var path = alloc(10 + nlen);
                        memcpy(path, "/dev/dri/", 9);
                        memcpy(path + 9, name_ptr, nlen);
                        store8(path + 9 + nlen, 0);
                        store64(result_arr + count * 8, path);
                        count = count + 1;
                    }
                }
            }
            pos = pos + reclen;
        }
        nread = sys_getdents64(fd, buf, 4096);
    }
    sys_close(fd);
    _agnodrm_scratch_free(buf, bufsz);
    if (nread < 0) {
        return drm_err_io(0 - nread, "failed to read /dev/dri");
    }

    return Ok(count);
    #endif
}

# ================================================================
# Open a DRM device
# ================================================================

# 1 if `fd` is a character device that answers DRM_IOCTL_VERSION. The answer is what
# makes it DRM, on every target: no st_rdev offset is named by the stdlib, and major 226
# would say less than the driver saying so.
fn _drm_is_device(fd): i64 {
    var st = alloc(STAT_BUFSZ);
    if (sys_fstat(fd, st) != 0) { return 0; }
    if ((load32(st + STAT_MODE) & 0xF000) != 0x2000) { return 0; }  # S_IFCHR
    var ver = alloc(DRM_VER_SIZE);
    memset(ver, 0, DRM_VER_SIZE);
    if (_drm_ioctl(fd, DRM_IOCTL_VERSION, ver) < 0) { return 0; }
    return 1;
}

# Open a DRM device by path. Returns Result: Ok(fd) or Err. Anything that is not a DRM
# device is closed and refused, so a regular file, /dev/ptmx or /dev/kvm cannot come
# back as an Ok fd (audit F-38). Opening a card node takes DRM master when none is held;
# a caller that only queries should open a render node, which answers both ioctls here.
fn drm_open(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("open DRM device (no DRM subsystem)");  # agnos: display via bhumi scanout
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0) {
        return drm_err_invalid_argument("drm device path is null");
    }
    # Per-target O_* names, as drm_list_devices spells O_DIRECTORY.
    var fd = sys_open(path, O_RDWR | O_CLOEXEC | DRM_O_NOCTTY, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open DRM device");
    }
    if (_drm_is_device(fd) != 1) {
        sys_close(fd);
        return drm_err_invalid_argument("path is not a DRM device");
    }
    return Ok(fd);
    #endif
}

# Close a DRM device fd. Returns 0 or a negative errno, so a double close shows.
fn drm_close(fd): i64 {
    return sys_close(fd);
}

# ================================================================
# Query driver version
# ================================================================

# Get the DRM driver version for an open device fd.
# Returns Result: Ok(drm_verinfo_ptr) or Err.
fn drm_get_driver_version(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("DRM version ioctl (no DRM subsystem)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # First call: get string lengths
    var ver = alloc(DRM_VER_SIZE);
    memset(ver, 0, DRM_VER_SIZE);

    var ret = _drm_ioctl(fd, DRM_IOCTL_VERSION, ver);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "DRM_IOCTL_VERSION (lengths) failed");
    }

    # Read reported lengths (cap at 4096)
    var name_len = load64(ver + DRM_VER_NAME_LEN);
    var date_len = load64(ver + DRM_VER_DATE_LEN);
    var desc_len = load64(ver + DRM_VER_DESC_LEN);
    # Clamp low as well as high. These fields are __kernel_size_t (u64); read
    # back as i64 anything >= 2^63 reads negative, and `> 4096` does not catch
    # that — alloc(negative + 1) below would be handed a bogus size.
    if (name_len < 0) { name_len = 0; }
    if (date_len < 0) { date_len = 0; }
    if (desc_len < 0) { desc_len = 0; }
    if (name_len > 4096) { name_len = 4096; }
    if (date_len > 4096) { date_len = 4096; }
    if (desc_len > 4096) { desc_len = 4096; }

    # Allocate buffers
    var name_buf = alloc(name_len + 1);
    var date_buf = alloc(date_len + 1);
    var desc_buf = alloc(desc_len + 1);
    memset(name_buf, 0, name_len + 1);
    memset(date_buf, 0, date_len + 1);
    memset(desc_buf, 0, desc_len + 1);

    # Second call: fill buffers
    store64(ver + DRM_VER_NAME_LEN, name_len);
    store64(ver + DRM_VER_NAME_PTR, name_buf);
    store64(ver + DRM_VER_DATE_LEN, date_len);
    store64(ver + DRM_VER_DATE_PTR, date_buf);
    store64(ver + DRM_VER_DESC_LEN, desc_len);
    store64(ver + DRM_VER_DESC_PTR, desc_buf);

    ret = _drm_ioctl(fd, DRM_IOCTL_VERSION, ver);
    if (ret < 0) {
        return drm_err_syscall_failed(0 - ret, "DRM_IOCTL_VERSION (fill) failed");
    }

    var major = load32(ver + DRM_VER_MAJOR);
    var minor = load32(ver + DRM_VER_MINOR);
    var patch = load32(ver + DRM_VER_PATCH);

    var info = drm_verinfo_new(major, minor, patch, name_buf, date_buf, desc_buf);
    return Ok(info);
    #endif
}

# ================================================================
# Query capability
# ================================================================

# 1 for the errnos that mean the driver has no such capability: EINVAL for one it does
# not know, EOPNOTSUPP for a KMS capability on a render-only driver.
fn _drm_cap_absent(errno): i64 {
    if (errno == EINVAL) { return 1; }
    if (errno == EOPNOTSUPP) { return 1; }
    return 0;
}

# Query a DRM capability value for an open device fd.
# cap: one of the DRM_CAP_* constants.
# Returns Result: Ok(value), Ok(0) if the driver has no such capability, or Err.
fn drm_get_capability(fd, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("DRM capability ioctl (no DRM subsystem)");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # DrmGetCap struct: { capability: u64, value: u64 } = 16 bytes
    var getcap = alloc(16);
    store64(getcap, cap);
    store64(getcap + 8, 0);

    var ret = _drm_ioctl(fd, DRM_IOCTL_GET_CAP, getcap);
    if (ret < 0) {
        var errno = 0 - ret;
        if (_drm_cap_absent(errno) == 1) { return Ok(0); }
        return drm_err_syscall_failed(errno, "DRM_IOCTL_GET_CAP failed");
    }

    var value = load64(getcap + 8);
    return Ok(value);
    #endif
}

# Check if device supports dumb buffers.
# Returns Result: Ok(1) or Ok(0).
fn drm_supports_dumb_buffer(fd): i64 {
    var res_t, res_v = drm_get_capability(fd, DRM_CAP_DUMB_BUFFER);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    var val = res_v;
    if (val != 0) { return Ok(1); }
    return Ok(0);
}
