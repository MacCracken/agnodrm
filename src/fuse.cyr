# fuse.cyr — FUSE filesystem mount management
# New module (no Rust source)
#
# Parses /proc/mounts for FUSE mounts, provides mount/unmount
# via fusermount subprocess.
#
# Requires: src/error.cyr, lib/syscalls.cyr, lib/process.cyr

# Included directly (as drm.cyr does) for the per-target O_* open flags and
# the per-arch struct stat offsets; include-once, so includers pay nothing.
include "lib/syscalls.cyr"
include "src/error.cyr"
include "src/util.cyr"

# ================================================================
# FuseMount struct
# 4 ptr fields * 8 = 32 bytes. Accessors auto-generated.
# ================================================================

#derive(accessors)
struct fuse_mount { device; mountpoint; fstype; options; }

fn fuse_mount_new(device, mountpoint, fstype, options): i64 {
    var m = alloc(32);
    fuse_mount_set_device(m, device);
    fuse_mount_set_mountpoint(m, mountpoint);
    fuse_mount_set_fstype(m, fstype);
    fuse_mount_set_options(m, options);
    return m;
}

# ================================================================
# Parse /proc/mounts
enum FuseMountTable {
    FUSE_MOUNTS_CHUNK = 65536;
    FUSE_MOUNTS_MAX_BYTES = 16777216;
}

# 1 for a filesystem type that is a FUSE mount: fuse or fuseblk, alone or with a
# .<subtype>. Not fusectl, the control filesystem at /sys/fs/fuse/connections, which is
# no FUSE mount and read as one to a prefix match (audit F-48).
fn _fuse_type_ok(fstype): i64 {
    if (streq(fstype, "fuse") == 1) { return 1; }
    if (streq(fstype, "fuseblk") == 1) { return 1; }
    if (agnodrm_cstr_starts_with(fstype, "fuse.") == 1) { return 1; }
    return agnodrm_cstr_starts_with(fstype, "fuseblk.");
}

# Parse `total_read` bytes of mount table at `buf` into a vec of fuse_mount records,
# fuse entries only when `fuse_only` is 1. Every field is a heap copy.
# Format: device mountpoint fstype options dump pass
fn _fuse_parse_mounts(buf, total_read, fuse_only): i64 {
    var mounts = vec_new();
    var pos = 0;

    while (pos < total_read) {
        var linestart = pos;
        while (pos < total_read) {
            if (load8(buf + pos) == 10) { break; }
            pos = pos + 1;
        }
        var linelen = pos - linestart;
        if (pos < total_read) { pos = pos + 1; }
        if (linelen == 0) { continue; }

        # Extract fstype (field 2)
        var fstype = fuse_extract_field(buf + linestart, linelen, 2);
        if (fstype == 0) { continue; }

        var include = 1;
        if (fuse_only == 1) {
            if (_fuse_type_ok(fstype) != 1) {
                include = 0;
            }
        }

        if (include == 1) {
            var device = fuse_extract_field(buf + linestart, linelen, 0);
            var mpoint = fuse_extract_field(buf + linestart, linelen, 1);
            var opts = fuse_extract_field(buf + linestart, linelen, 3);
            vec_push(mounts, fuse_mount_new(device, mpoint, fstype, opts));
        }
    }

    return mounts;
}

# Parse a whole mount table from `fd` into a vec of fuse_mount records, fuse
# entries only when `fuse_only` is 1. Returns Ok(vec) or Err.
#
# The table is read to EOF into a buffer that grows. A fixed buffer cut it silently
# at 8 KiB, about 90 mounts, so a FUSE mount past the cut read as not mounted (audit
# F-7). Past FUSE_MOUNTS_MAX_BYTES this fails rather than parse part of a table. The
# buffer is scratch, given back on return.
fn _fuse_collect_mounts(fd, fuse_only): i64 {
    var cap = FUSE_MOUNTS_CHUNK;
    var buf = _agnodrm_scratch_new(cap);
    if (buf == 0) { return drm_err_io(ENOMEM, "no memory for the mount table"); }
    var total_read = 0;
    while (1) {
        if (total_read == cap) {
            if (cap >= FUSE_MOUNTS_MAX_BYTES) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_io(0, "mount table is too large");
            }
            var bigger = _agnodrm_scratch_new(cap * 2);
            if (bigger == 0) {
                _agnodrm_scratch_free(buf, cap);
                return drm_err_io(ENOMEM, "mount table is too large");
            }
            memcpy(bigger, buf, total_read);
            _agnodrm_scratch_free(buf, cap);
            buf = bigger;
            cap = cap * 2;
        }
        var nread = file_read(fd, buf + total_read, cap - total_read);
        if (nread == 0 - EINTR) { continue; }
        if (nread < 0) {
            _agnodrm_scratch_free(buf, cap);
            return drm_err_io(0 - nread, "failed to read mount table");
        }
        if (nread == 0) { break; }
        total_read = total_read + nread;
    }

    var mounts = _fuse_parse_mounts(buf, total_read, fuse_only);
    _agnodrm_scratch_free(buf, cap);
    return Ok(mounts);
}

# Read this host's mounts. Returns Result: Ok(vec of fuse_mount) or Err.
fn _fuse_read_mounts(fuse_only): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(vec_new());    # agnos has no /proc/mounts and no FUSE — zero mounts
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_open("/proc/mounts", O_RDONLY, 0);
    if (fd < 0) {
        return drm_err_io(0 - fd, "failed to open /proc/mounts");
    }
    var res_t, res_v = _fuse_collect_mounts(fd, fuse_only);
    sys_close(fd);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
    #endif
}

# ================================================================

# Check if a string starts with a prefix.
# Thin wrapper over the shared single-pass predicate (public API stable).
fn fuse_starts_with(str, prefix): i64 {
    return agnodrm_cstr_starts_with(str, prefix);
}

# Extract a whitespace-delimited field from a line.
# field_idx: 0-based field index.
# Returns heap-allocated string or 0.
fn fuse_extract_field(line, linelen, field_idx): i64 {
    var pos = 0;
    var field = 0;

    while (field < field_idx) {
        # Skip to next whitespace
        while (pos < linelen) {
            var c = load8(line + pos);
            if (c == 32) { break; }
            if (c == 9) { break; }
            pos = pos + 1;
        }
        # Skip whitespace
        while (pos < linelen) {
            var c = load8(line + pos);
            if (c != 32) { if (c != 9) { break; } }
            pos = pos + 1;
        }
        field = field + 1;
    }

    if (pos >= linelen) { return 0; }

    var start = pos;
    while (pos < linelen) {
        var c = load8(line + pos);
        if (c == 32) { break; }
        if (c == 9) { break; }
        pos = pos + 1;
    }

    var flen = pos - start;
    if (flen == 0) { return 0; }

    # F-7 (1.1.14): /proc/mounts encodes embedded whitespace and control
    # chars as 3-digit octal escapes (`\040` space, `\011` tab, `\012` LF,
    # `\134` backslash) per fstab(5). The field-split loop above reads raw
    # space/tab as separators, so unescaped values are already split into
    # multiple fields by the kernel — but a quoted-style mount source can
    # legitimately contain `\040` and similar that we want to render
    # back as the literal byte in the heap-copied output.
    var out = alloc(flen + 1);
    var src_i = 0;
    var dst_i = 0;
    while (src_i < flen) {
        var c0 = load8(line + start + src_i);
        if (c0 == 92) {
            if (src_i + 3 < flen) {
                var d1 = load8(line + start + src_i + 1);
                var d2 = load8(line + start + src_i + 2);
                var d3 = load8(line + start + src_i + 3);
                if (d1 >= 48) {
                    if (d1 <= 55) {
                        if (d2 >= 48) {
                            if (d2 <= 55) {
                                if (d3 >= 48) {
                                    if (d3 <= 55) {
                                        var v = (d1 - 48) * 64 + (d2 - 48) * 8 + (d3 - 48);
                                        store8(out + dst_i, v);
                                        dst_i = dst_i + 1;
                                        src_i = src_i + 4;
                                        continue;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        store8(out + dst_i, c0);
        dst_i = dst_i + 1;
        src_i = src_i + 1;
    }
    store8(out + dst_i, 0);
    return out;
}

# Parse /proc/mounts and return FUSE mounts.
# result_arr: pre-allocated array of FuseMount pointers.
# max_mounts: capacity.
# fuse_only: 1 to return only FUSE mounts (fuse, fuseblk, fuse.*), 0 for all.
# A count equal to max_mounts may mean there are more.
# Returns Result: Ok(count) or Err.
fn fuse_parse_proc_mounts(result_arr, max_mounts, fuse_only): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return Ok(0);            # agnos has no /proc/mounts and no FUSE — zero mounts
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_agnodrm_out_ok(result_arr, max_mounts) != 1) {
        return drm_err_invalid_argument("result array is null or max_mounts is negative");
    }
    var res_t, res_v = _fuse_read_mounts(fuse_only);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    var total = vec_len(res_v);
    var count = 0;
    while (count < total) {
        if (count >= max_mounts) { break; }
        store64(result_arr + count * 8, vec_get(res_v, count));
        count = count + 1;
    }
    return Ok(count);
    #endif
}

# ================================================================
# Mount FUSE filesystem
# ================================================================

# Mount a FUSE filesystem.
# device: the FUSE filesystem source (e.g., user@host:path).
# mountpoint: target directory, which must pass fuse_validate_mountpoint.
# fuse_type: the absolute path of the helper (e.g., "/usr/bin/sshfs"). execve does no PATH
# lookup, and a relative path runs from the working directory.
# extra_opts: additional mount options string, or 0 for none.
# Returns Result: Ok(0) or Err.
#
# Each argument reaches the helper in its own argv entry, with no shell. A device or
# mountpoint starting with '-' is refused, since a helper would read it as an option,
# and sshfs's -o ssh_command= runs a program (audit F-23). extra_opts is the caller's to
# trust: it is options by definition.
fn fuse_mount(device, mountpoint, fuse_type, extra_opts): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse mount");   # agnos has no FUSE / fusermount
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (device == 0) { return drm_err_invalid_argument("fuse device is null"); }
    if (mountpoint == 0) { return drm_err_invalid_argument("fuse mountpoint is null"); }
    if (fuse_type == 0) { return drm_err_invalid_argument("fuse type is null"); }

    if (strlen(device) == 0) { return drm_err_invalid_argument("fuse device is empty"); }
    if (strlen(mountpoint) == 0) { return drm_err_invalid_argument("fuse mountpoint is empty"); }
    if (load8(fuse_type) != 47) { return drm_err_invalid_argument("fuse helper must be an absolute path"); }
    if (load8(device) == 45) { return drm_err_invalid_argument("fuse device cannot start with '-'"); }
    if (load8(mountpoint) == 45) { return drm_err_invalid_argument("fuse mountpoint cannot start with '-'"); }

    var chk_t, chk_v = fuse_validate_mountpoint(mountpoint);
    if (is_err_result(chk_t) == 1) { return Err(chk_v); }

    var args = vec_new();
    vec_push(args, fuse_type);
    vec_push(args, device);
    vec_push(args, mountpoint);

    if (extra_opts != 0) {
        if (strlen(extra_opts) > 0) {
            vec_push(args, "-o");
            vec_push(args, extra_opts);
        }
    }

    return agnodrm_run_checked(args, "fuse mount command failed");
    #endif
}

# ================================================================
# Unmount FUSE filesystem
# ================================================================

# Test seam, 0 outside tests/tcyr: a stub to run in place of fusermount.
var _fuse_fusermount = 0;

# fusermount3 where it exists, the only name a fuse3-only host has, else fusermount.
fn _fuse_unmount_tool(): i64 {
    if (_fuse_fusermount != 0) { return _fuse_fusermount; }
    if (sys_access("/usr/bin/fusermount3", 0) == 0) { return "/usr/bin/fusermount3"; }
    return "/usr/bin/fusermount";
}

# Run `fusermount <flag> -- <mountpoint>`. The "--" keeps a mountpoint starting with '-'
# from reading as an option.
fn _fuse_run_unmount(mountpoint, flag, errmsg): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse unmount");   # agnos has no FUSE / fusermount
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (mountpoint == 0) { return drm_err_invalid_argument("unmount mountpoint is null"); }
    if (strlen(mountpoint) == 0) { return drm_err_invalid_argument("unmount mountpoint is empty"); }

    var args = vec_new();
    vec_push(args, _fuse_unmount_tool());
    vec_push(args, flag);
    vec_push(args, "--");
    vec_push(args, mountpoint);

    return agnodrm_run_checked(args, errmsg);
    #endif
}

# Unmount a FUSE filesystem at the given mountpoint.
# Returns Result: Ok(0) or Err.
fn fuse_unmount(mountpoint): i64 {
    return _fuse_run_unmount(mountpoint, "-u", "fusermount -u failed");
}

# ================================================================
# Lazy unmount (fallback)
# ================================================================

# Lazy unmount via fusermount -uz (for busy mounts).
fn fuse_unmount_lazy(mountpoint): i64 {
    return _fuse_run_unmount(mountpoint, "-uz", "fusermount -uz failed");
}

# ================================================================
# FUSE availability check
# ================================================================

# Check whether FUSE is available on this system (/dev/fuse exists).
# Returns 1 if available, 0 otherwise.
fn fuse_is_available(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;               # agnos has no /dev/fuse — FUSE unavailable
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_access("/dev/fuse", 0) == 0;   # mode 0 = F_OK; the stdlib names no access modes
    #endif
}

# ================================================================
# Mountpoint validation
# ================================================================

# Validate that a path is suitable as a FUSE mountpoint.
# Checks: not null, exists, is a directory, is not the root directory by any spelling.
# Returns Result: Ok(0) or Err.
fn fuse_validate_mountpoint(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return drm_err_not_supported("fuse mountpoint validation");   # agnos has no FUSE
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0 || strlen(path) == 0) {
        return drm_err_invalid_argument("mountpoint path is empty");
    }

    # Check path exists and is a directory. struct stat is per-arch: st_mode
    # sits at +24 on x86_64 but +16 on aarch64, where a raw +24 reads st_uid
    # and rejected every directory. Size and offset come from the stdlib's
    # per-target Stat enum.
    var statbuf = alloc(STAT_BUFSZ);
    var ret = sys_stat(path, statbuf);
    if (ret < 0) {
        return drm_err_invalid_argument("mountpoint does not exist");
    }

    var mode = load32(statbuf + STAT_MODE);
    # S_IFDIR = 0x4000 = 16384
    if ((mode & 0xF000) != 0x4000) {
        return drm_err_invalid_argument("mountpoint is not a directory");
    }

    # Root by identity, so "//", "/." and "/tmp/.." are caught too. st_dev is at +0 and
    # st_ino at +8 on x86_64 and aarch64 alike; the stdlib names neither.
    var rootbuf = alloc(STAT_BUFSZ);
    if (sys_stat("/", rootbuf) == 0) {
        if (load64(statbuf) == load64(rootbuf)) {
            if (load64(statbuf + 8) == load64(rootbuf + 8)) {
                return drm_err_invalid_argument("cannot use filesystem root as mountpoint");
            }
        }
    }

    return Ok(0);
    #endif
}

# ================================================================
# List FUSE mounts (convenience wrapper)
# ================================================================

# List all currently mounted FUSE filesystems.
# Returns Result: Ok(vec_of_mounts) or Err.
fn fuse_list_mounts(): i64 {
    var res_t, res_v = _fuse_read_mounts(1);
    if (is_err_result(res_t) == 1) { return Err(res_v); }
    return Ok(res_v);
}

# ================================================================
# FUSE mount status
# ================================================================

# FuseStatus constants
enum FuseStatus {
    FUSE_MOUNTED = 1;
    FUSE_NOT_MOUNTED = 2;
    FUSE_ERROR = 3;
}

# 1 if `mountpoint`, trailing slashes aside, is in `mounts`, a vec of fuse_mount.
fn _fuse_mounted_in(mounts, mountpoint): i64 {
    var mplen = strlen(mountpoint);
    while (mplen > 1) {
        if (load8(mountpoint + mplen - 1) != 47) { break; }
        mplen = mplen - 1;
    }
    var i = 0;
    while (i < vec_len(mounts)) {
        var m = vec_get(mounts, i);
        var mp = fuse_mount_mountpoint(m);
        if (mp != 0 && strlen(mp) == mplen && memeq(mp, mountpoint, mplen) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Get the status of a FUSE mount at the given mountpoint, trailing slashes aside.
# Returns Result: Ok(FuseStatus) or Err.
fn fuse_get_status(mountpoint): i64 {
    if (mountpoint == 0 || strlen(mountpoint) == 0) {
        return drm_err_invalid_argument("mountpoint is empty");
    }

    var res_t, res_v = _fuse_read_mounts(1);
    if (is_err_result(res_t) == 1) { return Ok(FUSE_ERROR); }

    if (_fuse_mounted_in(res_v, mountpoint) == 1) { return Ok(FUSE_MOUNTED); }
    return Ok(FUSE_NOT_MOUNTED);
}
