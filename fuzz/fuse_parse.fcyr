# Fuzz: fuse_extract_field — /proc/mounts line parser.
# Must not crash on empty lines, malformed escapes, truncated fields,
# embedded null bytes, huge inputs. Tests F-7 (1.1.14) octal-escape unescape.

#define LINUX

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/process.cyr"
include "src/error.cyr"
# src/fuse.cyr calls agnodrm_run_checked / agnodrm_cstr_starts_with, so it
# needs src/util.cyr (and util's own stdlib deps, lib/io.cyr among them).
# Without it the build only WARNED "undefined function" — DCE proves the
# call sites unreachable from this harness — plus three dropped-tag warnings
# on fuse_mount / fuse_unmount / fuse_unmount_lazy, because an undefined
# callee's `: stack` Result shape is unknown. audit.sh gate 11 and the CI
# Fuzz step now fail on both classes.
include "src/util.cyr"
include "src/fuse.cyr"

alloc_init();

# --- well-formed lines ---
var l1 = "src /mnt fuse.x rw 0 0";
var f1a = fuse_extract_field(l1, strlen(l1), 0);
if (streq(f1a, "src") != 1) { sys_exit(10); }
var f1b = fuse_extract_field(l1, strlen(l1), 2);
if (streq(f1b, "fuse.x") != 1) { sys_exit(11); }

# --- octal escape: \040 → space ---
var l2 = "dev /mnt/with\\040space ext4 rw 0 0";
var f2 = fuse_extract_field(l2, strlen(l2), 1);
if (streq(f2, "/mnt/with space") != 1) { sys_exit(20); }

# --- octal escape: \011 → tab ---
var l3 = "dev /mnt\\011tab ext4 rw 0 0";
var f3 = fuse_extract_field(l3, strlen(l3), 1);
if (streq(f3, "/mnt\ttab") != 1) { sys_exit(21); }

# --- octal escape: \012 → LF (zero-truncates as cstring) ---
# Output cstring would terminate at the embedded \n; test that the unescape
# happened (extract returns non-zero).
var l4 = "dev /mnt\\012lf ext4 rw 0 0";
var f4 = fuse_extract_field(l4, strlen(l4), 1);
if (f4 == 0) { sys_exit(22); }

# --- octal escape: \134 → backslash ---
var l5 = "dev /mnt\\134path ext4 rw 0 0";
var f5 = fuse_extract_field(l5, strlen(l5), 1);
if (streq(f5, "/mnt\\path") != 1) { sys_exit(23); }

# --- non-escape: lone backslash before non-octal ---
var l6 = "dev /mnt\\xyz ext4 rw 0 0";
var f6 = fuse_extract_field(l6, strlen(l6), 1);
# Should preserve the backslash + xyz literally (no octal match).
if (streq(f6, "/mnt\\xyz") != 1) { sys_exit(24); }

# --- octal at end of field: incomplete escape ---
var l7 = "dev /mnt/\\04 ext4 rw 0 0";
var f7 = fuse_extract_field(l7, strlen(l7), 1);
# Should preserve \04 literally (only 2 chars, not 3).
if (streq(f7, "/mnt/\\04") != 1) { sys_exit(25); }

# --- empty line ---
var l8 = "";
var f8 = fuse_extract_field(l8, 0, 0);
if (f8 != 0) { sys_exit(30); }

# --- one-field line (request idx 0 OK, idx 1 returns 0) ---
var l9 = "alone";
var f9a = fuse_extract_field(l9, strlen(l9), 0);
if (streq(f9a, "alone") != 1) { sys_exit(40); }
var f9b = fuse_extract_field(l9, strlen(l9), 1);
if (f9b != 0) { sys_exit(41); }

# --- multi-whitespace separators ---
var l10 = "a    b\t\tc";
var f10 = fuse_extract_field(l10, strlen(l10), 1);
if (streq(f10, "b") != 1) { sys_exit(50); }

# --- request beyond available fields ---
var l11 = "one two three";
var f11 = fuse_extract_field(l11, strlen(l11), 10);
if (f11 != 0) { sys_exit(60); }

# --- huge synthetic line (must not crash) ---
var big = alloc(8192);
var bi = 0;
while (bi < 8191) {
    var c = 32 + (bi * 37) % 90;
    if ((bi % 50) == 49) { c = 32; }
    store8(big + bi, c);
    bi = bi + 1;
}
store8(big + 8191, 0);
var fbig = fuse_extract_field(big, 8191, 5);
# must not crash; result may or may not be 0 depending on fields

# --- adversarial backslash density ---
var adv = alloc(513);
var ai = 0;
while (ai < 512) {
    if ((ai % 4) == 0) { store8(adv + ai, 92); }     # \
    if ((ai % 4) == 1) { store8(adv + ai, 48); }     # 0
    if ((ai % 4) == 2) { store8(adv + ai, 52); }     # 4
    if ((ai % 4) == 3) { store8(adv + ai, 48); }     # 0
    ai = ai + 1;
}
store8(adv + 512, 0);
var fadv = fuse_extract_field(adv, 512, 0);
# must not crash

# --- iteration stress ---
var x = 0;
while (x < 500) {
    var fs = fuse_extract_field(l2, strlen(l2), 1);
    if (streq(fs, "/mnt/with space") != 1) { sys_exit(70); }
    x = x + 1;
}

# --- _fuse_type_ok against a model of the names the kernel gives a FUSE mount ---
fn fz_type_model(t): i64 {
    if (streq(t, "fuse") == 1) { return 1; }
    if (streq(t, "fuseblk") == 1) { return 1; }
    if (strstr(t, "fuse.") == 0) { return 1; }
    return strstr(t, "fuseblk.") == 0;
}

var types = vec_new();
vec_push(types, "");
vec_push(types, "fuse");
vec_push(types, "fuseblk");
vec_push(types, "fuse.");
vec_push(types, "fuse.sshfs");
vec_push(types, "fuseblk.ntfs");
vec_push(types, "fusectl");
vec_push(types, "ext4");
vec_push(types, "xfuse");
vec_push(types, "fuseblkx");
var ti = 0;
while (ti < vec_len(types)) {
    var ty = vec_get(types, ti);
    if (_fuse_type_ok(ty) != fz_type_model(ty)) { sys_exit(80); }
    ti = ti + 1;
}

# --- _fuse_parse_mounts on mutated tables that end against unmapped memory ---
var fz_seed = 0x2545F4914F6CDD1D;
fn fz_rand(): i64 {
    var x = fz_seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x1FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    fz_seed = x;
    return x & 0x7FFFFFFF;
}

var guard_map = _agnodrm_scratch_new(16384);
_agnodrm_scratch_free(guard_map + 12288, 4096);
var guard = guard_map + 12288;

# Every record is a real line's fields: nothing with a raw line end in it, and a filter that only
# ever narrows the list to mounts whose type passes.
fn fz_check_table(text, len): i64 {
    var all = _fuse_parse_mounts(text, len, 0);
    var only = _fuse_parse_mounts(text, len, 1);
    if (vec_len(only) > vec_len(all)) { sys_exit(81); }
    var lines = 1;
    var i = 0;
    while (i < len) {
        if (load8(text + i) == 10) { lines = lines + 1; }
        i = i + 1;
    }
    if (vec_len(all) > lines) { sys_exit(82); }
    # \012 is the kernel's spelling of a line end in a path, and decodes to one.
    var has_nl_escape = 0;
    i = 0;
    while (i + 3 < len) {
        if (load8(text + i) == 92) {
            if (load8(text + i + 1) == 48) {
                if (load8(text + i + 2) == 49) {
                    if (load8(text + i + 3) == 50) { has_nl_escape = 1; }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < vec_len(all)) {
        var r = vec_get(all, i);
        # Only the first field can be absent: a line that opens with a space has no device.
        if (fuse_mount_mountpoint(r) == 0) { sys_exit(85); }
        if (fuse_mount_fstype(r) == 0) { sys_exit(85); }
        if (has_nl_escape == 0) {
            if (fuse_mount_device(r) != 0) {
                if (strchr(fuse_mount_device(r), 10) >= 0) { sys_exit(84); }
            }
            if (strchr(fuse_mount_mountpoint(r), 10) >= 0) { sys_exit(84); }
            if (strchr(fuse_mount_fstype(r), 10) >= 0) { sys_exit(84); }
        }
        i = i + 1;
    }
    i = 0;
    while (i < vec_len(only)) {
        var m = vec_get(only, i);
        if (fz_type_model(fuse_mount_fstype(m)) != 1) { sys_exit(83); }
        i = i + 1;
    }
    return 0;
}

fz_check_table(guard, 0);
var seed_table = "sshfs#a /mnt/a fuse.sshfs rw 0 0\nproc /proc proc rw 0 0\n/dev/sda1 /m\\040x fuseblk rw 0 0\n";
var seed_len = strlen(seed_table);
var alpha = " \t\n\\01234fuse.#/";
var alen = strlen(alpha);
var it = 0;
while (it < 30000) {
    var tl = fz_rand() % (seed_len + 1);
    var tb = guard - tl;
    memcpy(tb, seed_table, tl);
    var muts = fz_rand() % 6;
    var mi = 0;
    while (mi < muts) {
        if (tl > 0) { store8(tb + fz_rand() % tl, load8(alpha + fz_rand() % alen)); }
        mi = mi + 1;
    }
    fz_check_table(tb, tl);
    it = it + 1;
}

sys_write(1, "fuse_parse: ok\n", 15);
sys_exit(0);
